@inherits LayoutComponentBase
@using Mercantec.Tech.Web.Theming
@using Mercantec.Tech.Web.Navigation
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject LearningContext CourseContext
@inject DemoWorld World
@inject Mercantec.Tech.Web.Notebooks.NotebookClient Notebooks
@implements IDisposable

<ThemeDecorations />
<a class="skip-link" href="@SkipToContentHref">Spring til indhold</a>
<div class="lup @(IsNotionEditor ? "notion-ide-shell" : null)">
    <div class="app">
        <ViewAsStudentBanner />
        <header class="lup-header @(Auth.IsAuthenticated ? "member-header" : "public-header")">
            <a class="brand" href="@HomeHref" aria-label="LUP – Lokal UndervisningsPlatform">LUP</a>
            @if (Auth.IsAuthenticated)
            {
                <nav class="mainnav member-nav" id="campus-nav" aria-label="Hovednavigation">
                    <a href="/courses" class="@(HoldsIsCurrent ? "active" : null)" aria-current="@(HoldsIsCurrent ? "true" : null)">Mine hold</a>
                    <a href="/library" class="@(LibraryIsCurrent ? "active" : null)" aria-current="@(LibraryIsCurrent ? "true" : null)">Bibliotek</a>
                    <a href="/notion" class="@(NotebookIsCurrent ? "active" : null)" aria-current="@(NotebookIsCurrent ? "true" : null)">Notesbøger</a>
                    @if (IsTeacher) { <NavLink href="/teacher/planner">Min kalender</NavLink> }
                </nav>
                <details class="lup-mobile-nav">
                    <summary>Menu</summary>
                    <nav class="lup-mobile-menu" aria-label="Hovednavigation">
                        <a href="/courses" class="@(HoldsIsCurrent ? "active" : null)" aria-current="@(HoldsIsCurrent ? "true" : null)">Mine hold</a>
                        <a href="/library">Bibliotek</a>
                        <a href="/notion">Notesbøger</a>
                        @foreach (var link in NotebookLinks) { <NavLink href="@link.Href">@link.Label</NavLink> }
                        @if (IsTeacher) { <NavLink href="/teacher/planner">Min kalender</NavLink> }
                    </nav>
                </details>
                <div class="lup-tools">
                    <ThemePicker Value="@_theme" ValueChanged="SetTheme" />
                    <a class="lup-search-link" href="/search" aria-label="Søg"><UiIcon Name="search" /><span>Søg</span></a>
                    <NotificationBell />
                    <details class="lup-account v3-navgroup">
                        <summary aria-label="Profil og indstillinger"><span class="avatar lup-face">@if (World.Ready) { <AvatarIcon Size="32" Decorative="true" /> } else { @Initials }</span></summary>
                        <div class="v3-menu">
                            <p class="lup-account-name">@AccountDisplayName</p>
                            <p class="lup-account-sub">@(IsTeacher ? "Underviser" : ViewAs.IsActive ? "Elevvisning" : "Elev") · LUP</p>
                            @if (ViewAs.IsActive) { <button type="button" class="action" @onclick="ExitViewAs">Afslut elev-visning</button> }
                            <NavLink href="/profile" Match="NavLinkMatch.All">Min profil</NavLink>
                            @foreach (var link in NotebookLinks.Skip(1)) { <NavLink href="@link.Href">@link.Label</NavLink> }
                            <NavLink href="/universe" Match="NavLinkMatch.All">Mit univers</NavLink>
                            <NavLink href="/characters">Karakterer</NavLink>
                            <NavLink href="/settings" Match="NavLinkMatch.All">Indstillinger</NavLink>
                            @if (IsTeacher)
                            {
                                <NavLink href="/teacher/updates">Nyt i LUP</NavLink>
                                <NavLink href="/teacher/tools">Underviserværktøjer</NavLink>
                            }
                            <button type="button" class="secondary" @onclick="Logout">Log ud</button>
                        </div>
                    </details>
                </div>
            }
            else
            {
                <nav class="mainnav public-nav" aria-label="Hovednavigation">
                    <a class="@(PublicArea == "learning" ? "is-current" : null)" href="/" aria-current="@(PublicArea == "learning" ? "true" : null)">Undervisning</a>
                    <NavLink href="/library">Bibliotek</NavLink>
                    <NavLink href="/explore/projects">Projekter</NavLink>
                    <NavLink href="/characters">Karakterer</NavLink>
                    <NavLink href="/sources">Om LUP</NavLink>
                </nav>
                <details class="lup-mobile-nav"><summary>Menu</summary><nav class="lup-mobile-menu" aria-label="Hovednavigation"><a href="/">Undervisning</a><a href="/library">Bibliotek</a><a href="/explore/projects">Projekter</a><NavLink href="/characters">Karakterer</NavLink><a href="/sources">Om LUP</a></nav></details>
                <div class="lup-tools">
                    <ThemePicker Value="@_theme" ValueChanged="SetTheme" />
                    <button type="button" class="action" @onclick="StartLogin" disabled="@(_loginBusy || !Auth.IsInitialized)">@(_loginBusy ? "Sender…" : "Log ind")</button>
                </div>
            }
        </header>
        <main class="body" id="main-content">@Body</main>
        <footer class="footer"><span>LUP · Lokal UndervisningsPlatform</span><div class="footer-links"><a href="/courses/template">Undervisningsplaner</a><a href="/characters">Karakterer</a><a href="/help">Hjælp</a><a href="/privacy">Privatliv</a><a href="/sources">Om LUP</a></div></footer>
    </div>
</div>

@code {
    private string _theme = "light";
    private bool _loginBusy;
    private string? _notebookProfileAccount;
    private IReadOnlyList<NotebookNavigationLink> NotebookLinks => WorkspaceNavigation.NotebookLinks(IsTeacher);
    private bool NotebookIsCurrent => CurrentPath == "/journal" || CurrentPath.StartsWith("/notion", StringComparison.Ordinal) || CurrentPath.StartsWith("/notebook", StringComparison.Ordinal) || CurrentPath.StartsWith("/teacher/notebook", StringComparison.Ordinal);
    private bool IsTeacher => Redirect.ShowsTeacherChrome;
    private bool IsNotionEditor
    {
        get
        {
            if (!Auth.IsAuthenticated) return false;
            var segments = CurrentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length == 2 && string.Equals(segments[0], "notion", StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(segments[1], out _);
        }
    }
    private string HomeHref => IsTeacher ? "/teacher" : Auth.IsAuthenticated ? "/student" : "/";
    private string AccountDisplayName => ViewAs.IsActive ? ViewAs.DisplayName ?? Auth.DisplayName ?? "Elev" : Auth.DisplayName ?? "Bruger";
    private string PublicArea => CurrentPath is "/" or "/subjects" or "/courses/template" || CurrentPath.StartsWith("/subjects/") || CurrentPath.StartsWith("/courses/template/") ? "learning" : "";
    private bool HoldsIsCurrent => CurrentPath is "/courses" or "/afleveringer" || CurrentPath.StartsWith("/holds/") || CurrentPath.StartsWith("/polls/") || CurrentPath.StartsWith("/teacher/polls") || (CurrentPath.StartsWith("/courses/") && !CurrentPath.StartsWith("/courses/template")) || (CurrentPath.StartsWith("/quests/") && Guid.TryParse(CurrentPath.Split('/')[2], out _));
    private bool LibraryIsCurrent => CurrentPath is "/library" or "/subjects" or "/badges" or "/courses/template" || CurrentPath.StartsWith("/subjects/") || CurrentPath.StartsWith("/badges/") || CurrentPath.StartsWith("/explore/") || CurrentPath.StartsWith("/courses/template/") || CurrentPath.StartsWith("/learning/") || CurrentPath is "/learning" or "/education" or "/calendar" or "/quests";
    private string SkipToContentHref
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var fragment = relative.IndexOf('#');
            if (fragment >= 0) relative = relative[..fragment];
            return "/" + relative + "#main-content";
        }
    }
    private string CurrentPath
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(['?', '#']);
            if (cut >= 0) relative = relative[..cut];
            return "/" + relative.Trim('/');
        }
    }
    private string Initials
    {
        get
        {
            var parts = AccountDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0) return "?";
            return parts.Length == 1 ? char.ToUpperInvariant(parts[0][0]).ToString() : $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        }
    }
    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuthChanged;
        ViewAs.Changed += OnViewChanged;
        Nav.LocationChanged += OnLocation;
        World.Changed += OnWorldChanged;
        EnforceViewAsRoutes();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { await Js.InvokeVoidAsync("lupIcons"); return; }
        try
        {
            _theme = await Js.InvokeAsync<string>("lupTheme.get");
            if (Auth.IsAuthenticated) { await World.EnsureAsync(); await World.BindAvatarProfileAsync(Auth.Subject); await RegisterNotebookProfile(); }
            var storedCourse = await Js.InvokeAsync<string?>("lupCourse.get");
            if (storedCourse is not null) CourseContext.Select(storedCourse);
            await Js.InvokeVoidAsync("lupIcons");
            await Js.InvokeVoidAsync("lupTheme.mount");
        }
        catch (JSException) { return; }
        StateHasChanged();
    }
    private async Task SetTheme(string theme) { _theme = theme; await Js.InvokeVoidAsync("lupTheme.set", _theme); }
    private async Task StartLogin()
    {
        if (!Auth.IsInitialized || Auth.IsAuthenticated || _loginBusy) return;
        _loginBusy = true;
        try { await Auth.BeginLoginAsync(); } catch { _loginBusy = false; Nav.NavigateTo(Auth.LoginPath()); }
    }
    private async Task Logout() { ViewAs.Exit(); await Auth.LogoutLocalAsync(); Nav.NavigateTo("/"); }
    private void ExitViewAs() { var returnUrl = ViewAs.ReturnUrl ?? "/lectio"; ViewAs.Exit(); Nav.NavigateTo(returnUrl); }
    private void EnforceViewAsRoutes() { if (ViewAs.IsActive && ViewAsStudentContext.IsTeacherOnlyPath(CurrentPath)) Nav.NavigateTo("/student"); }
    private void OnAuthChanged() => InvokeAsync(async () => { if (Auth.IsAuthenticated) { await World.EnsureAsync(); await World.BindAvatarProfileAsync(Auth.Subject); await RegisterNotebookProfile(); } else { _notebookProfileAccount = null; await World.BindAvatarProfileAsync(null); } EnforceViewAsRoutes(); StateHasChanged(); });
    private void OnViewChanged() => InvokeAsync(() => { EnforceViewAsRoutes(); StateHasChanged(); });
    private void OnWorldChanged() => InvokeAsync(StateHasChanged);
    private async Task RegisterNotebookProfile()
    {
        var subject = Auth.Subject;
        if (string.IsNullOrEmpty(subject) || subject == _notebookProfileAccount) return;
        _notebookProfileAccount = subject;
        try { await Notebooks.Register(); }
        catch (Exception ex) when (ex is Mercantec.Tech.Web.Notebooks.NotebookException or HttpRequestException)
        { if (_notebookProfileAccount == subject) _notebookProfileAccount = null; }
    }
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        await Js.InvokeVoidAsync("lupNewYear.stop");
        _theme = await Js.InvokeAsync<string>("lupTheme.get");
        EnforceViewAsRoutes();
        StateHasChanged();
    });
    public void Dispose() { Auth.AuthStateChanged -= OnAuthChanged; ViewAs.Changed -= OnViewChanged; World.Changed -= OnWorldChanged; Nav.LocationChanged -= OnLocation; }
}
