<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../shared/Mercantec.Tech.Contracts.csproj" />
    <PackageReference Include="ColorCode.HTML" Version="2.0.15" />
    <PackageReference Include="Markdig" Version="0.41.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <Target Name="VersionNotionEditorAssets" BeforeTargets="GetAssemblyAttributes"
          Condition="Exists('wwwroot/notion-editor/editor.js') and Exists('wwwroot/notion-editor/editor.css')">
    <GetFileHash Files="wwwroot/notion-editor/editor.js;wwwroot/notion-editor/editor.css" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_NotionEditorAssetHashes" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>NotionEditorAssets</_Parameter1>
        <_Parameter2>@(_NotionEditorAssetHashes->'%(FileHash)', '-')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- Undgå at Development-API-URL (localhost:8080) ender i Docker/prod-image -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="wwwroot\appsettings.Development.json" />
    <None Include="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
