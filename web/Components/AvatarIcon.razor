@using Mercantec.Tech.Web.Demo
@inject DemoWorld World
@implements IDisposable

<span class="avatar-face-icon" style="@($"--avatar-icon-size:{Math.Clamp(Size, 16, 256)}px")" data-avatar-icon="@CurrentId" aria-hidden="@(Decorative ? "true" : null)">
    @if (CurrentId == AvatarCatalog.Bip01Id)
    {
        <img src="@ImageSource" width="@Size" height="@Size" alt="@(Decorative ? "" : $"BIP-01{ExpressionLabel}")" decoding="async" />
    }
    else
    {
        <svg viewBox="0 0 48 48" role="@(Decorative ? null : "img")" aria-label="@(Decorative ? null : "Din første avatar")" fill="none"><circle cx="24" cy="24" r="23" fill="var(--tint,#eaf0ff)" /><path d="M14 23c0-8 3-13 10-13s10 5 10 13v6c0 8-4 12-10 12s-10-4-10-12v-6Z" fill="#d8a17c" /><path d="M13 22c-1-10 5-15 12-15 8 0 12 5 11 14-7-1-9-6-9-6-3 5-8 6-14 7Z" fill="#43372e" /><circle cx="20" cy="27" r="1.5" fill="#283b54" /><circle cx="29" cy="27" r="1.5" fill="#283b54" /><path d="M21 33c2 2 4 2 6 0" stroke="#854b39" stroke-width="1.5" stroke-linecap="round" /></svg>
    }
</span>

@code {
    [Parameter] public string? AvatarId { get; set; }
    [Parameter] public string? Expression { get; set; }
    [Parameter] public int Size { get; set; } = 40;
    [Parameter] public bool Decorative { get; set; }
    private string CurrentId => AvatarId ?? (World.AvatarProfileReady ? World.SelectedAvatarId : AvatarCatalog.StarterId);
    private string ImageSource => Expression is "happy" or "wink" or "think" or "celebrate" ? $"/assets/avatars/bip-01/emoji-{Expression}.png" : "/assets/avatars/bip-01/face.png";
    private string ExpressionLabel => Expression switch { "happy" => ", glad", "wink" => ", blink", "think" => ", tænksom", "celebrate" => ", jubel", _ => "" };
    protected override void OnInitialized() => World.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => World.Changed -= OnChanged;
}
