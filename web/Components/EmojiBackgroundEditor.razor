@using Mercantec.Tech.Web.Emojis
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (File is not null)
{
    <div class="emoji-background-editor" role="group" aria-label="Billedredigering" aria-busy="@(_busy || _cropOpen ? "true" : "false")">
        @if (_preview is not null)
        {
            <div class="emoji-background-preview"><img src="@_preview" alt="Forhåndsvisning af emoji på ternet baggrund" /></div>
        }
        <div class="emoji-background-controls">
            @if (_cropOpen)
            {
                <p class="emoji-background-hint" role="status">Vælg dit udsnit, og tryk Brug beskæring. Billedet gemmes først ved upload.</p>
            }
            else if (_busy)
            {
                <p class="emoji-background-hint" role="status">Fjerner baggrund… Første gang kan tage lidt længere tid.</p>
                <button type="button" disabled="@Disabled" @onclick="StopProcessing">Stop</button>
            }
            else
            {
                @if (_processed is not null) { <button type="button" disabled="@Disabled" @onclick="RestoreOriginal">Brug original</button> }
                @if (!_backgroundRemoved) { <button type="button" disabled="@(Disabled || _preview is null)" @onclick="RemoveBackground">Fjern baggrund</button> }
                <button type="button" disabled="@(Disabled || _preview is null)" @onclick="OpenCrop">Beskær og zoom</button>
            }
            <p class="emoji-background-hint">Redigeres lokalt i browseren. Beskæring og baggrundsfjernelse giver et PNG-stillbillede.</p>
        </div>
        @if (_cropOpen)
        {
            <div class="emoji-crop-panel">
                <div @ref="_cropHost" class="emoji-crop-host" aria-label="Beskær emoji"></div>
                <div class="emoji-crop-actions">
                    <button type="button" disabled="@(Disabled || _cropHandle == 0 || _cropApplying)" @onclick="ApplyCrop">@(_cropApplying ? "Klargør…" : "Brug beskæring")</button>
                    <button type="button" disabled="@(Disabled || _cropApplying)" @onclick="CancelCrop">Annuller beskæring</button>
                </div>
            </div>
        }
        @if (_message is not null)
        {
            <p class="emoji-background-message" role="@(_failed ? "alert" : "status")">@_message</p>
        }
    </div>
}

@code {
    [Parameter] public IBrowserFile? File { get; set; }
    [Parameter] public EventCallback<IBrowserFile> FileChanged { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private IBrowserFile? _observed, _original, _processed;
    private string? _originalData, _processedData, _preview, _message, _jobId;
    private IJSObjectReference? _module;
    private Task<IJSObjectReference>? _moduleLoad;
    private IJSObjectReference? _cropModule;
    private ElementReference _cropHost;
    private int _cropHandle;
    private int _generation;
    private bool _busy, _failed, _disposed, _backgroundRemoved, _cropOpen, _mountCrop, _cropApplying;

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed || ReferenceEquals(File, _observed)) return;
        _observed = File;
        if (ReferenceEquals(File, _processed) && _processed is not null)
        {
            _preview = _processedData;
            return;
        }
        if (ReferenceEquals(File, _original) && _original is not null)
        {
            _preview = _originalData;
            return;
        }

        var generation = ++_generation;
        await CancelCurrent();
        await CloseCrop();
        if (_disposed || generation != _generation) return;
        _original = File;
        _processed = null;
        _backgroundRemoved = false;
        _originalData = _processedData = _preview = _message = null;
        _failed = false;
        if (File is null) return;
        var file = File;
        if (file.Size is <= 0 or > EmojiClient.MaxBytes)
        {
            _failed = true;
            _message = "Vælg et billede med indhold på højst 256 KB for at fjerne baggrunden.";
            return;
        }
        var type = MediaType(file);
        if (type is null)
        {
            _failed = true;
            _message = "Baggrunden kan fjernes fra PNG, JPEG, GIF eller WebP.";
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(EmojiClient.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            if (_disposed || generation != _generation) return;
            _originalData = $"data:{type};base64,{Convert.ToBase64String(buffer.ToArray())}";
            _preview = _originalData;
        }
        catch (Exception error) when (error is IOException or OperationCanceledException)
        {
            if (!_disposed && generation == _generation)
            {
                _failed = true;
                _message = "Billedet kunne ikke læses. Vælg det igen.";
            }
        }
    }

    private static string? MediaType(IBrowserFile file) => file.ContentType switch
    {
        "image/png" or "image/jpeg" or "image/gif" or "image/webp" => file.ContentType,
        _ => Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".gif" => "image/gif", ".webp" => "image/webp", _ => null
        }
    };

    private async Task<IJSObjectReference> GetModule()
    {
        var load = _moduleLoad ??= Js.InvokeAsync<IJSObjectReference>("import", "/js/emoji-background.js").AsTask();
        try
        {
            var module = await load;
            if (_disposed) throw new OperationCanceledException();
            return _module = module;
        }
        catch
        {
            if (ReferenceEquals(_moduleLoad, load)) _moduleLoad = null;
            throw;
        }
    }

    private async Task RemoveBackground()
    {
        if (_disposed || Disabled || _busy || _cropOpen || _preview is null || _original is null || _backgroundRemoved) return;
        var generation = ++_generation;
        var original = _original;
        var data = _preview;
        var job = Guid.NewGuid().ToString("N");
        _jobId = job;
        _message = null;
        _failed = false;
        _busy = true;
        await BusyChanged.InvokeAsync(true);
        try
        {
            var module = await GetModule();
            if (_disposed || generation != _generation) return;
            var result = await module.InvokeAsync<BackgroundResult>("removeBackground", data, job);
            if (_disposed || generation != _generation) return;
            var file = result?.ContentType == "image/png"
                ? new ExtensionEmojiDraft(Path.GetFileNameWithoutExtension(original.Name), result.ContentType, result.Base64).ToBrowserFile()
                : null;
            if (file is null) throw new InvalidDataException("Invalid processed image.");
            _processed = file;
            _backgroundRemoved = true;
            _processedData = $"data:image/png;base64,{result!.Base64}";
            _preview = _processedData;
            _observed = file;
            _message = "Baggrunden er fjernet. Gennemgå resultatet, før du gemmer.";
            await FileChanged.InvokeAsync(file);
        }
        catch (Exception error) when (error is JSException or IOException or InvalidDataException or OperationCanceledException)
        {
            if (!_disposed && generation == _generation)
            {
                _failed = true;
                _message = "Baggrunden kunne ikke fjernes. Originalbilledet er bevaret. Du kan prøve igen eller gemme originalen.";
            }
        }
        finally
        {
            if (!_disposed && generation == _generation)
            {
                _jobId = null;
                _busy = false;
                await BusyChanged.InvokeAsync(false);
            }
        }
    }

    private async Task CancelCurrent()
    {
        var job = _jobId;
        _jobId = null;
        if (job is not null && _module is not null)
        {
            try { await _module.InvokeVoidAsync("cancel", job); }
            catch (Exception error) when (error is JSException or OperationCanceledException) { }
        }
        if (_busy)
        {
            _busy = false;
            if (!_disposed) await BusyChanged.InvokeAsync(false);
        }
    }

    private async Task OpenCrop()
    {
        if (_disposed || Disabled || _busy || _cropOpen || _preview is null) return;
        ++_generation;
        _cropOpen = _mountCrop = true;
        _failed = false;
        _message = null;
        await BusyChanged.InvokeAsync(true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mountCrop || !_cropOpen || _disposed || _preview is null) return;
        _mountCrop = false;
        var generation = _generation;
        try
        {
            _cropModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/emoji-crop-adapter.js");
            if (_disposed || generation != _generation || !_cropOpen)
            {
                if (_disposed) await _cropModule.DisposeAsync();
                return;
            }
            var handle = await _cropModule.InvokeAsync<int>("mount", _cropHost, _preview);
            if (_disposed || generation != _generation || !_cropOpen) { await _cropModule.InvokeVoidAsync("destroy", handle); return; }
            _cropHandle = handle;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception error) when (error is JSException or OperationCanceledException or ObjectDisposedException)
        {
            if (!_disposed && generation == _generation)
            {
                await CloseCrop();
                _failed = true;
                _message = "Beskæringen kunne ikke åbnes. Det valgte billede er bevaret. Prøv igen.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ApplyCrop()
    {
        if (_disposed || Disabled || _cropApplying || !_cropOpen || _cropHandle == 0 || _cropModule is null || _original is null) return;
        var generation = _generation;
        _cropApplying = true;
        try
        {
            var result = await _cropModule.InvokeAsync<CropResult>("result", _cropHandle);
            if (_disposed || generation != _generation) return;
            if (result?.Changed == true)
            {
                var file = result.ContentType == "image/png"
                    ? new ExtensionEmojiDraft(Path.GetFileNameWithoutExtension(_original.Name), result.ContentType, result.Base64).ToBrowserFile() : null;
                if (file is null) throw new InvalidDataException("Invalid crop result.");
                _processed = file;
                _processedData = $"data:image/png;base64,{result.Base64}";
                _preview = _processedData;
                _observed = file;
                await FileChanged.InvokeAsync(file);
                _message = "Billedet er beskåret. Navn og beskrivelse er bevaret.";
            }
            else _message = "Hele billedet er valgt. Det tidligere billede er bevaret.";
            await CloseCrop();
            _failed = false;
        }
        catch (Exception error) when (error is JSException or IOException or InvalidDataException or OperationCanceledException)
        {
            if (!_disposed && generation == _generation)
            { _failed = true; _message = "Beskæringen kunne ikke anvendes. Det valgte billede er bevaret. Prøv igen."; }
        }
        finally { if (!_disposed && generation == _generation) _cropApplying = false; }
    }

    private async Task CloseCrop()
    {
        var wasOpen = _cropOpen;
        var handle = _cropHandle;
        _cropHandle = 0;
        _cropOpen = _mountCrop = _cropApplying = false;
        if (handle != 0 && _cropModule is not null)
        {
            try { await _cropModule.InvokeVoidAsync("destroy", handle); }
            catch (Exception error) when (error is JSException or OperationCanceledException or ObjectDisposedException) { }
        }
        if (wasOpen && !_disposed) await BusyChanged.InvokeAsync(false);
    }

    private async Task CancelCrop()
    {
        if (_disposed || Disabled || _cropApplying) return;
        ++_generation;
        await CloseCrop();
        _failed = false;
        _message = "Beskæringen er annulleret. Det valgte billede er bevaret.";
    }

    private async Task StopProcessing()
    {
        if (_disposed || Disabled || !_busy) return;
        ++_generation;
        await CancelCurrent();
        _failed = false;
        _message = "Behandlingen er stoppet. Originalbilledet er bevaret.";
    }

    private async Task RestoreOriginal()
    {
        if (_disposed || Disabled || _original is null) return;
        ++_generation;
        await CancelCurrent();
        await CloseCrop();
        _processed = null;
        _backgroundRemoved = false;
        _processedData = null;
        _preview = _originalData;
        _observed = _original;
        _failed = false;
        _message = "Originalbilledet er valgt igen.";
        await FileChanged.InvokeAsync(_original);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        ++_generation;
        await CancelCurrent();
        await CloseCrop();
        if (_moduleLoad is not null)
        {
            try { await (await _moduleLoad).DisposeAsync(); }
            catch (Exception error) when (error is JSException or OperationCanceledException) { }
        }
        if (_cropModule is not null)
        {
            try { await _cropModule.DisposeAsync(); }
            catch (Exception error) when (error is JSException or OperationCanceledException) { }
        }
    }

    private sealed record BackgroundResult(string? Base64, string? ContentType);
    private sealed record CropResult(bool Changed, string? Base64, string? ContentType);
}
