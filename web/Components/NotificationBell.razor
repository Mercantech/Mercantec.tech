@using Mercantec.Tech.Web.Activity
@inject ActionCenterService Actions
@inject NavigationManager Nav
@inject AuthService Auth
@inject ViewAsStudentContext ViewAs
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="notification-control" @ref="_root" @onkeydown="KeyDown">
    <button type="button" class="notification-bell" @ref="_trigger" @onclick="Toggle" aria-label="@($"Notifikationer: {Actions.Label}")" title="@Actions.Label" aria-expanded="@_open.ToString().ToLowerInvariant()" aria-controls="notification-preview" aria-busy="@Actions.IsLoading.ToString().ToLowerInvariant()" data-status="@Actions.Status.ToString().ToLowerInvariant()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4M12 2v1" /></svg>
        <span class="notification-indicator" aria-hidden="true"></span>
    </button>
    @if (_open)
    {
        <section class="notification-dropdown" id="notification-preview" role="region" aria-label="Notifikationer">
            <header class="notification-preview-header"><div><h2>Notifikationer</h2>@if (Actions.Items.Count > 0 && Actions.Error is null) { <p>@Actions.Label</p> }</div><button type="button" class="notification-close" aria-label="Luk notifikationer" title="Luk" @onclick="() => Close(true)"><span aria-hidden="true">×</span></button></header>
            <div class="notification-preview-body">
                @if (Actions.Error is not null)
                {
                    <div class="notification-preview-state" role="alert"><strong>Status kunne ikke hentes</strong><p>@Actions.Error</p><button type="button" class="secondary" disabled="@Actions.IsLoading" @onclick="Refresh">Prøv igen</button></div>
                }
                else if (Actions.Snapshot is null)
                {
                    <p class="notification-preview-loading" role="status">Henter dine handlinger…</p>
                }
                else if (Actions.Items.Count == 0)
                {
                    <div class="notification-preview-state notification-preview-clear"><span class="notification-clear-mark"><UiIcon Name="check" /></span><strong>@(Actions.IsLoading ? "Opdaterer…" : "Intet mangler")</strong></div>
                }
                else
                {
                    var items = PreviewItems;
                    @foreach (var severity in new[] { "important", "optional" })
                    {
                        var rows = items.Where(item => item.Severity == severity).ToArray();
                        @if (rows.Length > 0)
                        {
                            <div class="notification-preview-group @severity"><h3><span class="notification-row-dot" aria-hidden="true"></span>@(severity == "important" ? "Vigtigt" : "Det kan du gøre")</h3>
                                @foreach (var item in rows)
                                {
                                    <a class="notification-preview-link" href="@ActionCenterPresentation.Href(item)" @onclick="FollowLink"><span class="notification-preview-icon"><UiIcon Name="@ActionCenterPresentation.Icon(item)" /></span><span class="notification-preview-copy"><small>@item.HoldName</small><strong>@item.Title</strong><span>@ActionCenterPresentation.KindLabel(item)</span>@if (item.DeadlineUtc is DateTimeOffset deadline) { <time datetime="@deadline.ToString("O")">Frist @ActionCenterPresentation.DateLabel(deadline)</time> }</span><span class="notification-preview-arrow" aria-hidden="true">›</span></a>
                                }
                            </div>
                        }
                    }
                    @if (Actions.Items.Count > PreviewLimit) { <p class="notification-preview-more">Der er flere handlinger i oversigten.</p> }
                }
            </div>
            <footer class="notification-preview-footer"><a href="/notifications" @onclick="FollowLink">Se alle notifikationer <span aria-hidden="true">›</span></a></footer>
        </section>
    }
</div>
@code {
    private const int PreviewLimit = 6;
    private bool _open, _watching, _disposed;
    private ElementReference _root, _trigger;
    private IJSObjectReference? _module;
    private readonly SemaphoreSlim _bindings = new(1, 1);
    private readonly CancellationTokenSource _interopLife = new();
    private DotNetObjectReference<NotificationBell>? _reference;
    private ActionCenterItem[] PreviewItems => ActionCenterPresentation.Ordered(Actions.Items).Take(PreviewLimit).ToArray();
    protected override void OnInitialized()
    {
        Actions.Changed += StatusChanged; Nav.LocationChanged += LocationChanged;
        Auth.AuthStateChanged += AccountChanged; ViewAs.Changed += AccountChanged;
        _reference = DotNetObjectReference.Create(this);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Actions.EnsureAsync();
        if (_disposed) return;
        await _bindings.WaitAsync();
        try
        {
            if (_disposed) return;
            if (_open && !_watching)
            {
                _module ??= await Js.InvokeAsync<IJSObjectReference>("import", _interopLife.Token, "./js/notification-dropdown.js");
                if (_disposed || !_open) return;
                await _module.InvokeVoidAsync("watch", _interopLife.Token, _root, _reference);
                _watching = true;
            }
            else if (!_open && _watching)
            {
                if (_module is not null) await _module.InvokeVoidAsync("unwatch", _root);
                _watching = false;
            }
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSException) { _watching = false; }
        finally { _bindings.Release(); }
    }
    private async Task KeyDown(KeyboardEventArgs args)
    {
        if (_open && !_watching && args.Key == "Escape") await Close(true);
    }
    private async Task Toggle()
    {
        _open = !_open;
        if (_open) await Actions.RefreshAsync();
    }
    private Task Refresh() => Actions.RefreshAsync(force: true);
    private void FollowLink() => _open = false;
    private async Task Close(bool returnFocus)
    {
        _open = false;
        if (returnFocus && !_disposed) await _trigger.FocusAsync(preventScroll: true);
    }
    [JSInvokable] public Task DismissNotifications(bool returnFocus) => _disposed ? Task.CompletedTask : InvokeAsync(async () => { await Close(returnFocus); StateHasChanged(); });
    private void StatusChanged() => _ = InvokeAsync(StateHasChanged);
    private void AccountChanged() => _ = InvokeAsync(() => { _open = false; StateHasChanged(); });
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () => { _open = false; StateHasChanged(); await Actions.RefreshAsync(); });
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        Actions.Changed -= StatusChanged; Nav.LocationChanged -= LocationChanged;
        Auth.AuthStateChanged -= AccountChanged; ViewAs.Changed -= AccountChanged;
        await _interopLife.CancelAsync();
        await _bindings.WaitAsync();
        try
        {
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("unwatch", _root); await _module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
            }
            _reference?.Dispose();
            _interopLife.Dispose();
        }
        finally { _bindings.Release(); }
    }
}
