<canvas id="lup-newyear-sky" aria-hidden="true" hidden></canvas>
<aside class="newyear-launcher" aria-label="Nytårstema">
    <span class="newyear-launcher-label"><UiIcon Name="firework" />Nytår</span>
    <button type="button" data-newyear-action="start" aria-haspopup="dialog" aria-controls="lup-newyear-game">Start fyrværkeri</button>
</aside>
<dialog id="lup-newyear-game" class="newyear-game" aria-labelledby="newyear-game-title" aria-describedby="newyear-game-help">
    <img id="lup-newyear-player" src="images/newyear/lup-fireworks-player.png" data-muzzle-x="0.810" data-muzzle-y="0.158" data-foot-y="0.889" hidden alt="" />
    <canvas id="lup-newyear-canvas" tabindex="0" aria-label="Fyrværkerispil med den lilla figur. Flyt med piletasterne og skyd med mellemrum." aria-describedby="newyear-game-help"></canvas>
    <header class="newyear-hud" data-newyear-hud>
        <div class="newyear-game-name"><UiIcon Name="firework" /><div><h2 id="newyear-game-title">Fyrværkerifest</h2><span>Skyd bugs. Saml boosts.</span></div></div>
        <dl class="newyear-scoreboard">
            <div><dt>Point</dt><dd data-newyear-score>0</dd></div>
            <div><dt>Niveau</dt><dd data-newyear-level>1</dd></div>
            <div><dt>Ramt</dt><dd data-newyear-hits>0</dd></div>
        </dl>
        <div class="newyear-hud-actions">
            <button type="button" class="newyear-exit" data-newyear-action="stop">Afslut og gendan <span aria-hidden="true">×</span></button>
        </div>
        <div class="newyear-boost-strip" data-newyear-boosts role="group" aria-label="Aktive boosts">
            <span class="newyear-boost-empty" data-newyear-boost-empty>Skyd eller fang et boost</span>
            <span class="newyear-boost-chip" role="img" data-newyear-boost="multishot" hidden aria-label="Multiskud: tre skud ad gangen" title="Tre skud ad gangen"><span class="newyear-boost-full">3 skud</span><span class="newyear-boost-short">×3</span><i data-newyear-boost-meter aria-hidden="true"></i></span>
            <span class="newyear-boost-chip" role="img" data-newyear-boost="mega" hidden aria-label="Megaskud: større skud med ekstra skade" title="Større skud med ekstra skade"><span class="newyear-boost-full">Store skud</span><span class="newyear-boost-short">XL</span><i data-newyear-boost-meter aria-hidden="true"></i></span>
            <span class="newyear-boost-chip" role="img" data-newyear-boost="rapid" hidden aria-label="Hurtig ild: skyd oftere" title="Skyd oftere"><span class="newyear-boost-full">Hurtig ild</span><span class="newyear-boost-short">Ild+</span><i data-newyear-boost-meter aria-hidden="true"></i></span>
            <span class="newyear-boost-chip" role="img" data-newyear-boost="comet" hidden aria-label="Komet: skud gennem flere fejl" title="Skud gennem flere fejl"><span class="newyear-boost-full">Komet</span><span class="newyear-boost-short">Komet</span><i data-newyear-boost-meter aria-hidden="true"></i></span>
            <span class="newyear-boost-chip" role="img" data-newyear-boost="speed" hidden aria-label="Turbo: hurtigere figur og skud" title="Hurtigere figur og skud"><span class="newyear-boost-full">Turbo</span><span class="newyear-boost-short">Turbo</span><i data-newyear-boost-meter aria-hidden="true"></i></span>
        </div>
    </header>
    <div class="newyear-controls" data-newyear-controls>
        <p id="newyear-game-help">Flyt med musen eller <kbd>←</kbd> <kbd>→</kbd>. Klik eller hold <kbd>mellemrum</kbd> for at skyde. <span>Skyd programmeringsfejl. Fang eller skyd lysende boosts, og kombiner dem. Alt gendannes, når du afslutter.</span></p>
        <div class="newyear-touch-controls" aria-label="Spilstyring">
            <button type="button" class="newyear-restart" data-newyear-action="restart" aria-label="Start forfra" title="Start forfra">↻</button>
            <button type="button" data-newyear-action="left" aria-label="Flyt til venstre">←</button>
            <button type="button" class="newyear-fire" data-newyear-action="fire"><UiIcon Name="firework" />Skyd</button>
            <button type="button" data-newyear-action="right" aria-label="Flyt til højre">→</button>
        </div>
    </div>
    <p class="newyear-live" data-newyear-status role="status" aria-live="polite" aria-atomic="true"></p>
</dialog>
