<div class="project-gallery">@foreach (var project in DemoCatalog.Projects.Where(p => OwnedOnly || p.Visibility == "Fælles")) { <article class="project-card"><img src="lup/assets/@(project.Id == "rune" ? "game-cover.jpg" : "project-cover.jpg")" alt="" /><div class="project-card-body"><div class="project-card-meta"><span class="pill">@project.Tag</span><span class="pill @(project.Visibility == "Privat" ? "" : "green")">@(project.Visibility == "Privat" ? "Kun mig" : "Delt i galleriet")</span></div><h2>@project.Name</h2><p>@project.Desc</p><div class="person"><span class="avatar">AJ</span><span>@project.Owner</span></div><div class="project-reactions"><span><UiIcon Name="heart" />@project.Likes</span><span>@project.Comments.Length kommentarer</span></div>@foreach (var comment in project.Comments) { <blockquote><strong>@comment.Author</strong><p>@comment.Text</p></blockquote> }</div></article> }</div>
@code { [Parameter] public bool OwnedOnly { get; set; } }
