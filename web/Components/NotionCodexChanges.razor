@using System.Globalization
@using System.Text
@using System.Text.Json
@using Mercantec.Tech.Web.Notion
@inject NotionMcpClient Changes
@inject IJSRuntime Js
@implements IAsyncDisposable

<dialog @ref="_dialog" class="codex-changes" aria-labelledby="codex-changes-title" aria-describedby="codex-changes-description">
    <header>
        <div><h2 id="codex-changes-title">Codex-ændringer</h2><p id="codex-changes-description">Dine ændringer i denne kladde.</p></div>
        <button type="button" class="codex-close" aria-label="Luk Codex-ændringer" @onclick="Close"><UiIcon Name="close" /></button>
    </header>
    <div class="codex-history-tools"><span>Ændringer vises i dokumentet med det samme.</span><button type="button" class="secondary" disabled="@(_loading || _undoing)" @onclick="Reload">Opdatér historik</button></div>
    @if (_error is not null) { <p class="codex-history-error" role="alert">@_error</p> }
    @if (_notice is not null) { <p class="codex-history-notice" role="status">@_notice</p> }
    @if (_loading && _items.Length == 0) { <p class="codex-history-empty" role="status">Henter ændringer…</p> }
    else if (_items.Length == 0) { <div class="codex-history-empty"><h3>Ingen Codex-ændringer endnu</h3><p>Når Codex redigerer denne side, kan du se og fortryde ændringerne her.</p></div> }
    else
    {
        <div class="codex-history-body">
            <nav aria-label="Codex-ændringer på siden">
                @foreach (var item in _items)
                {
                    <button type="button" class="codex-history-item" aria-current="@(item.OperationId == _selectedId ? "true" : null)" disabled="@_undoing" @onclick="() => Select(item.OperationId)">
                        <strong>@item.Summary</strong><span>@Status(item.Status)</span><time datetime="@item.CreatedAtUtc.ToString("O")">@Date(item.CreatedAtUtc)</time>
                    </button>
                }
            </nav>
            <section class="codex-history-detail" aria-label="Valgt ændring" aria-busy="@_detailLoading">
                @if (_detailLoading) { <p role="status">Henter før og efter…</p> }
                else if (_selected is not null)
                {
                    <div class="codex-change-heading"><div><h3>@_selected.Summary</h3><p>@Status(_selected.Status) · @Date(_selected.CreatedAtUtc)</p></div>
                        @if (_selected.CanUndo) { <button type="button" class="secondary" disabled="@_undoing" @onclick="Undo">@(_undoing ? "Fortryder…" : "Fortryd ændring")</button> }
                    </div>
                    @if (_selected.Status is "pending" or "prepared") { <p role="status">Ændringen afventer bekræftet lagring. Opdatér historikken for at se resultatet.</p> }
                    @if (_selected.Status is "conflict" or "failed") { <p role="status">Denne handling blev ikke gennemført. Læs den aktuelle side i Codex, før du prøver igen.</p> }
                    <div class="codex-before-after"><section><h4>Før</h4><pre>@Readable(_selected.Before)</pre></section><section><h4>Efter</h4><pre>@Readable(_selected.After)</pre></section></div>
                    @if (_selected.CanUndo) { <p class="codex-history-hint">Fortrydelse bevarer dine senere redigeringer. Hvis den berørte tekst er ændret, bliver handlingen stoppet.</p> }
                }
            </section>
        </div>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public Guid PageId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<NotionCodexChanges>? _callback;
    private readonly CancellationTokenSource _life = new();
    private CancellationTokenSource? _detailRequest;
    private readonly Dictionary<Guid, Guid> _reversals = [];
    private NotionMcpChangeSummary[] _items = [];
    private NotionMcpChangeView? _selected;
    private Guid? _selectedId;
    private bool _loading, _detailLoading, _undoing, _disposed, _closing;
    private string? _error, _notice;

    protected override Task OnInitializedAsync() => Reload();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "/js/notion-codex-changes.js?v=1");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _callback = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("mount", _dialog, _callback);
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException or TaskCanceledException) { }
    }
    private async Task Reload()
    {
        if (_loading || _disposed) return;
        _loading = true; _error = null;
        try
        {
            var items = await Changes.List(PageId, _life.Token);
            if (_disposed) return;
            _items = items;
            var id = items.Any(i => i.OperationId == _selectedId) ? _selectedId : items.FirstOrDefault()?.OperationId;
            if (id is Guid selected) await Select(selected);
            else { _selectedId = null; _selected = null; }
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or NotionException) { if (!_disposed) _error = error.Message; }
        finally { _loading = false; }
    }
    private async Task Select(Guid id)
    {
        _detailRequest?.Cancel(); _detailRequest?.Dispose();
        _detailRequest = CancellationTokenSource.CreateLinkedTokenSource(_life.Token);
        var request = _detailRequest;
        _selectedId = id; _selected = null; _detailLoading = true; _error = null;
        try
        {
            var view = await Changes.Get(PageId, id, request.Token);
            if (!_disposed && !request.IsCancellationRequested) _selected = view;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or NotionException) { if (!_disposed && !request.IsCancellationRequested) _error = error.Message; }
        finally { if (ReferenceEquals(request, _detailRequest)) _detailLoading = false; }
    }
    private async Task Undo()
    {
        if (_selected is null || !_selected.CanUndo || _undoing) return;
        var id = _selected.OperationId;
        if (!_reversals.TryGetValue(id, out var reversal)) _reversals[id] = reversal = Guid.NewGuid();
        _undoing = true; _error = null; _notice = null;
        try
        {
            // Closing a dialog must not cancel an already submitted mutation.
            await Changes.Undo(PageId, id, reversal, CancellationToken.None);
            if (_disposed) return;
            _notice = "Ændringen er fortrudt i kladden.";
            await Reload();
        }
        catch (Exception error) when (error is HttpRequestException or NotionException) { if (!_disposed) _error = error.Message; }
        finally { _undoing = false; }
    }
    [JSInvokable] public Task Dismiss() => InvokeAsync(Close);
    private async Task Close() { if (_closing || _disposed) return; _closing = true; await OnClose.InvokeAsync(); }
    private static string Date(DateTimeOffset value) => value.ToLocalTime().ToString("d. MMM HH:mm", CultureInfo.GetCultureInfo("da-DK"));
    private static string Status(string value) => value switch { "applied" or "saved" => "Gemt i kladden", "undone" => "Fortrudt", "pending" or "prepared" => "Afventer lagring", "conflict" => "Konflikt · ikke gennemført", "failed" => "Ikke gennemført", _ => "Ændring" };
    private static string Readable(JsonElement value)
    {
        var text = new StringBuilder();
        void Visit(JsonElement node, int depth = 0)
        {
            if (depth > 512) return;
            if (node.ValueKind == JsonValueKind.Array) { foreach (var part in node.EnumerateArray()) Visit(part, depth + 1); return; }
            if (node.ValueKind != JsonValueKind.Object) return;
            if (node.TryGetProperty("insert", out var insert) && insert.ValueKind == JsonValueKind.String) text.Append(insert.GetString());
            if (node.TryGetProperty("blocks", out var blocks)) Visit(blocks, depth + 1);
            if (node.TryGetProperty("block", out var block)) Visit(block, depth + 1);
            if (node.TryGetProperty("delta", out var delta)) Visit(delta, depth + 1);
            if (node.TryGetProperty("children", out var children)) Visit(children, depth + 1);
            if (node.TryGetProperty("name", out var name))
            {
                var type = name.GetString();
                if (type == "mermaidDiagram" && node.TryGetProperty("attributes", out var attrs) && attrs.TryGetProperty("source", out var source)) text.AppendLine(source.GetString());
                if (type is "pageMedia" or "drawing" or "entityLink" or "pageLink") text.AppendLine(type == "drawing" ? "[Tegning]" : type == "pageMedia" ? "[Medie]" : "[Reference]");
                if (type is "entityMention" or "pageMention" or "studentMention") text.Append("[Reference]");
                if (type is "tableCell" or "tableHeader") text.Append('\t');
                if (type == "tableRow") text.AppendLine();
                if (type == "blockContainer") text.AppendLine().AppendLine();
            }
        }
        Visit(value);
        var result = text.ToString().Trim();
        return result.Length == 0 ? "Intet indhold" : result;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _life.Cancel(); _detailRequest?.Cancel();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", _dialog); await _module.DisposeAsync(); }
            catch (Exception error) when (error is JSException or JSDisconnectedException or TaskCanceledException) { }
        }
        _callback?.Dispose(); _detailRequest?.Dispose(); _life.Dispose();
    }
}
