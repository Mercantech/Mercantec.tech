@using Mercantec.Tech.Web.Courses
@inject CourseTheoryDocumentLoader TheoryLoader

@if (Course is null)
{
    <div class="empty">
        <h1>Forløbet findes ikke</h1>
        <p>Tjek staven, eller gå tilbage til oversigtet.</p>
        <a class="action" href="/courses/template">Alle undervisningsplaner</a>
    </div>
}
else
{
    <header class="page-title course-title">
        <div>
            <span class="context">@Course.KindLabel · @Course.DurationLabel</span>
            <h1>@Course.Short · @Course.Title</h1>
            <p>@Course.Lead</p>
        </div>
        <div class="actions">
            <a class="secondary" href="/courses/template">Alle planer</a>
            @if (Course.Kind != CourseKind.Skabelon && ShowLearningLink)
            {
                <a class="secondary" href="/learning">Min læring</a>
            }
        </div>
    </header>

    <div class="course-document">
        <aside class="course-toc">
            <h2>I denne plan</h2>
            @* Path+hash: fragment-only (#about) resolves against <base href="/"> to /#about (= forsiden). *@
            <a href="@($"{Course.Path}#about")">Om forløbet</a>
            <a href="@($"{Course.Path}#goals")">Mål</a>
            <a href="@($"{Course.Path}#content")">Indhold</a>
            @if (Course.HasTheory)
            {
                <a href="@($"{Course.Path}#theory")">Teori for dagen</a>
            }
            <a href="@($"{Course.Path}#weeks")">Ugeplan</a>
            <a href="@($"{Course.Path}#evaluation")">Evaluering</a>
            <a href="/courses/template">Skabelon-katalog</a>
        </aside>

        <article class="course-paper">
            <section id="about">
                <h2>@(Course.Kind == CourseKind.Skabelon ? "Sådan bruges skabelonen" : "Om forløbet")</h2>
                <p>@Course.Lead</p>
                <div class="callout">
                    <strong>Projekt · @Course.Project</strong>
                    <p>@Course.Holistic</p>
                </div>
                <p>@Course.Practice</p>
            </section>

            <section id="goals">
                <div class="headrow"><h2>Mål for undervisningen</h2><span>@Course.DurationLabel</span></div>
                <ul class="goals">
                    @foreach (var goal in Course.Goals)
                    {
                        <li>@goal</li>
                    }
                </ul>
                <h3>Forventningsniveau</h3>
                <ul class="goals">
                    @foreach (var item in Course.Expectations)
                    {
                        <li>@item</li>
                    }
                </ul>
            </section>

            <section id="content">
                <div class="headrow"><h2>Indhold i undervisningen</h2></div>
                <div class="subject-grid">
                    @foreach (var theme in Course.Themes)
                    {
                        <div class="subject-card">
                            <h3>@theme.Name</h3>
                            <p>@theme.Desc</p>
                        </div>
                    }
                </div>
                <h3>Helhedsorientering og differentiering</h3>
                <p>@Course.Holistic</p>
                <p>@Course.Differentiation</p>
            </section>

            @if (Course.HasTheoryDocument)
            {
                <section id="theory">
                    <div class="headrow">
                        <h2>Teori for dagen</h2>
                        <span>@(_theoryBlocks?.Length.ToString() ?? "…") blokke · fuld tekst</span>
                    </div>
                    <p class="course-theory-lead">
                        Komplet teori fra H2 Booking — alle 19 «Teori for dagen»-blokke med fuld brødtekst og kode.
                        Uden holddatoer, elevdata eller secrets. Blokkene kan klappes sammen efter behov.
                    </p>
                    @if (_theoryError is not null)
                    {
                        <p class="course-theory-error">Kunne ikke hente teorien: @_theoryError</p>
                    }
                    else if (_theoryBlocks is null)
                    {
                        <p class="course-theory-lead">Henter teoriblokke…</p>
                    }
                    else
                    {
                        <nav class="course-theory-index" aria-label="Teoriblokke">
                            @foreach (var block in _theoryBlocks)
                            {
                                <a href="@($"{Course.Path}#theory-{block.Number}")">@block.Number. @block.Title</a>
                            }
                        </nav>
                        @foreach (var block in _theoryBlocks)
                        {
                            <details class="course-theory-full" id="@($"theory-{block.Number}")" open>
                                <summary>
                                    <span class="week-number">@block.Number</span>
                                    <span>
                                        <strong>@block.Title</strong>
                                        <small>Teori for dagen · fuld tekst</small>
                                    </span>
                                    <span class="week-chevron">⌄</span>
                                </summary>
                                <div class="course-theory-body">
                                    <CourseMarkdownBody Markdown="@block.Markdown" />
                                </div>
                            </details>
                        }
                    }
                </section>
            }
            else if (Course.Theory is { Length: > 0 })
            {
                <section id="theory">
                    <div class="headrow"><h2>Teori og pensum</h2><span>@Course.Theory.Length blokke</span></div>
                    <p class="course-theory-lead">Generelt platform-pensum — uden holddatoer eller elevdata. Emnerne følger undervisningens teoriblokke og fagmål.</p>
                    @foreach (var block in Course.Theory)
                    {
                        <article class="course-theory-block">
                            <h3>@block.Title</h3>
                            <p>@block.Summary</p>
                            <ul class="goals">
                                @foreach (var point in block.Points)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        </article>
                    }
                </section>
            }

            <section id="weeks">
                <div class="headrow"><h2>Ugeplan</h2><span>@Course.Weeks.Length uger</span></div>
                @for (var i = 0; i < Course.Weeks.Length; i++)
                {
                    var week = Course.Weeks[i];
                    <details class="course-week" open="@(i == 0)">
                        <summary>
                            <span class="week-number">@(i + 1)</span>
                            <span>
                                <strong>@week.Title</strong>
                                <small>@(string.IsNullOrWhiteSpace(week.Focus) ? Course.Short : week.Focus)</small>
                            </span>
                            <span class="week-chevron">⌄</span>
                        </summary>
                        <div class="week-days">
                            @if (week.HasDetail && week.Topics is { Length: > 0 })
                            {
                                <ul class="goals week-topics">
                                    @foreach (var topic in week.Topics)
                                    {
                                        <li>@topic</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>Ugens retning følger forløbets temaer og projektet <strong>@Course.Project</strong>.</p>
                            }
                        </div>
                    </details>
                }
            </section>

            <section id="evaluation">
                <div class="headrow"><h2>Evaluering og bedømmelse</h2></div>
                <p>@Course.Evaluation</p>
                <h3>Kriterier</h3>
                <ul class="goals">
                    @foreach (var c in Course.Criteria)
                    {
                        <li>@c</li>
                    }
                </ul>
            </section>
        </article>
    </div>
}

@code {
    [Parameter] public CourseTemplate? Course { get; set; }
    [Parameter] public bool ShowLearningLink { get; set; } = true;

    private CourseTheoryDocumentBlock[]? _theoryBlocks;
    private string? _theoryError;
    private string? _loadedPath;

    protected override async Task OnParametersSetAsync()
    {
        if (Course is null || !Course.HasTheoryDocument)
        {
            _theoryBlocks = null;
            _theoryError = null;
            _loadedPath = null;
            return;
        }

        var path = Course.TheoryDocumentPath!;
        if (string.Equals(_loadedPath, path, StringComparison.OrdinalIgnoreCase) && _theoryBlocks is not null)
            return;

        _theoryError = null;
        try
        {
            _theoryBlocks = await TheoryLoader.LoadAsync(path);
            _loadedPath = path;
        }
        catch (Exception ex)
        {
            _theoryBlocks = null;
            _loadedPath = null;
            _theoryError = ex.Message;
        }
    }
}
