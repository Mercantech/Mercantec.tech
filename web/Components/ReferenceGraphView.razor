@using System.Globalization
@using System.Text.Json
@using Mercantec.Tech.Web.Notion
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AuthService Auth
@inject EmojiClient Emojis
@implements IAsyncDisposable

<section class="reference-graph" aria-label="Forbindelser på tværs af LUP">
    <div class="reference-toolbar">
        <label class="field reference-search">Søg i indhold<input type="search" value="@_query" @oninput="Search" placeholder="Note, teori, opgave eller materiale…" /></label>
        <label class="field reference-type">Vis type<select @bind="_type" @bind:after="FilterChanged"><option value="">Alt indhold</option>@foreach (var kind in _nodes.Select(n => n.Entity.Reference.Kind).Distinct().Order()) { <option value="@kind">@ReferencePresentation.KindLabel(kind)</option> }</select></label>
        <div class="reference-toolbar-actions">
            <button type="button" class="secondary" @ref="_settingsToggle" aria-expanded="@_settingsOpen.ToString().ToLowerInvariant()" aria-controls="@_settingsId" @onclick="ToggleSettings"><span aria-hidden="true">☷</span> Visningsindstillinger</button>
            <button type="button" class="secondary" disabled="@_loading" @onclick="() => Load(false)">Opdatér graf</button>
        </div>
    </div>
    @if (_searching) { <p class="reference-status" role="status">Søger i indhold…</p> }
    @if (_matches.Length > 0)
    {
        <ul class="reference-results" aria-label="Søgeresultater">@foreach (var match in _matches) { <li><button type="button" class="secondary" @onclick="() => Focus(match.Reference)"><strong><EmojiText Text="@match.Title" /></strong><small>@match.ContextLabel · @ReferencePresentation.KindLabel(match.Reference.Kind)</small></button></li> }</ul>
    }
    @if (_error is not null) { <p role="alert">@_error <button type="button" class="secondary" @onclick="() => Load(false)">Prøv igen</button></p> }
    @if (_loading) { <p class="reference-status" role="status">Henter forbindelser…</p> }
    <div class="reference-workspace" data-settings-open="@_settingsOpen.ToString().ToLowerInvariant()">
        <aside class="reference-settings" id="@_settingsId" aria-label="Grafens visningsindstillinger" hidden="@(!_settingsOpen)" @onkeydown="SettingsKeyDown" @onkeydown:stopPropagation>
            <div class="reference-settings-heading"><h2>Visning</h2><button type="button" class="secondary reference-close" aria-label="Skjul visningsindstillinger" @onclick="CloseSettings">×</button></div>
            <fieldset><legend>Størrelser og tekst</legend>
                <label class="reference-range"><span>Punktstørrelse<output>@Percent(_settings.NodeSize)</output></span><input aria-label="Punktstørrelse" type="range" min="0.2" max="3" step="0.1" @bind="_settings.NodeSize" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <label class="reference-range"><span>Tekststørrelse<output>@Percent(_settings.LabelSize)</output></span><input aria-label="Tekststørrelse" type="range" min="0.6" max="2" step="0.1" @bind="_settings.LabelSize" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <label class="reference-range"><span>Forbindelsernes tykkelse<output>@Percent(_settings.LinkThickness)</output></span><input aria-label="Forbindelsernes tykkelse" type="range" min="0.2" max="3" step="0.1" @bind="_settings.LinkThickness" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <label class="field reference-weight">Tekstvægt<select aria-label="Tekstvægt" @bind="_settings.LabelWeight" @bind:after="SettingsChanged"><option value="400">Let</option><option value="500">Normal</option><option value="700">Fed</option></select></label>
            </fieldset>
            <fieldset><legend>Fremhævning</legend>
                <label class="reference-check"><input type="checkbox" @bind="_settings.ShowLabels" @bind:after="SettingsChanged" /> Vis titler</label>
                <label class="reference-check"><input type="checkbox" @bind="_settings.ShowArrows" @bind:after="SettingsChanged" /> Vis pile</label>
                <label class="reference-check"><input type="checkbox" @bind="_settings.HighlightConnections" @bind:after="SettingsChanged" /> Fremhæv forbindelser</label>
                <label class="reference-check"><input type="checkbox" @bind="_settings.DimUnrelated" @bind:after="SettingsChanged" /> Dæmp øvrige punkter</label>
                <label class="reference-range"><span>Titler fra zoom<output>@Factor(_settings.LabelThreshold)</output></span><input aria-label="Titler fra zoom" type="range" min="0.2" max="3" step="0.1" disabled="@(!_settings.ShowLabels)" @bind="_settings.LabelThreshold" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <p class="reference-help">Klik på et punkt for at fremhæve dets forbindelser. Dobbeltklik for at åbne indholdet.</p>
            </fieldset>
            <details class="reference-physics"><summary>Placering</summary>
                <label class="reference-range"><span>Spredning<output>@Percent(_settings.RepelForce)</output></span><input aria-label="Spredning" type="range" min="0" max="3" step="0.1" @bind="_settings.RepelForce" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <label class="reference-range"><span>Samling i midten<output>@Percent(_settings.CenterForce)</output></span><input aria-label="Samling i midten" type="range" min="0" max="3" step="0.1" @bind="_settings.CenterForce" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <label class="reference-range"><span>Forbindelsernes længde<output>@Percent(_settings.LinkDistance)</output></span><input aria-label="Forbindelsernes længde" type="range" min="0.2" max="3" step="0.1" @bind="_settings.LinkDistance" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
                <label class="reference-range"><span>Forbindelsernes styrke<output>@Percent(_settings.LinkForce)</output></span><input aria-label="Forbindelsernes styrke" type="range" min="0" max="3" step="0.1" @bind="_settings.LinkForce" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="SettingsChanged" /></label>
            </details>
            <button type="button" class="secondary reference-reset" @onclick="ResetSettings">Nulstil indstillinger</button>
            <p class="reference-help">Visningen gemmes i denne browser.</p>
        </aside>
        <div class="reference-main">
            @if (_nodes.Length > 0)
            {
                <div class="notion-graph-stage" tabindex="0" aria-label="Interaktiv graf. Klik for at fremhæve, dobbeltklik for at åbne. Brug listen nedenfor med tastatur.">
                    <div class="reference-canvas" @ref="_host"></div>
                    <div class="reference-zoom"><button type="button" class="secondary" disabled="@_failed" @onclick="() => Zoom(-1)" aria-label="Zoom ud">−</button><button type="button" class="secondary" disabled="@_failed" @onclick="() => Zoom(1)" aria-label="Zoom ind">+</button><button type="button" class="secondary" disabled="@_failed" @onclick="() => Zoom(0)">Tilpas</button></div>
                </div>
                <div class="reference-caption"><p class="reference-count">@VisibleNodes.Count() af @_total tilgængelige elementer · @VisibleEdges.Count() forbindelser</p><p class="reference-help">Træk for at flytte · rul for at zoome · dobbeltklik for at åbne</p></div>
                @if (_hasMore) { <button type="button" class="secondary" disabled="@_loading" @onclick="() => Load(true)">Hent næste udsnit · højst 400 noder</button> }
                @if (_focus is not null) { <button type="button" class="secondary" @onclick="Reset">Tilbage til oversigten</button> }
                @if (_selected is { } selected)
                {
                    <div class="panel reference-selected" aria-label="Valgt indhold"><div><h3><EmojiText Text="@selected.Title" /></h3><p>@selected.ContextLabel · @ReferencePresentation.KindLabel(selected.Reference.Kind)</p></div><div class="reference-selected-actions"><a class="action" href="@selected.Href">Åbn</a><button type="button" class="secondary" @onclick="() => Focus(selected.Reference)">Udvid forbindelser</button><button type="button" class="secondary" @onclick="ClearSelection">Fjern markering</button></div></div>
                }
                @if (_failed) { <p class="reference-help" role="status">Den interaktive graf kunne ikke vises. Du kan stadig bruge listen.</p> }
                <details class="reference-list" open="@_failed"><summary>Indhold og forbindelser som liste</summary><ul>@foreach (var node in VisibleNodes) { <li><div><a href="@node.Entity.Href"><EmojiText Text="@node.Entity.Title" /></a><small>@node.Entity.ContextLabel · @ReferencePresentation.KindLabel(node.Entity.Reference.Kind)</small></div><button type="button" class="secondary" @onclick="() => SelectNode(node.Entity.Reference)">Fremhæv</button><button type="button" class="secondary" @onclick="() => Focus(node.Entity.Reference)">Vis forbindelser</button></li> }</ul><ul>@foreach (var edge in VisibleEdges) { var from = _nodes.First(n => n.Key == edge.FromKey); var to = _nodes.First(n => n.Key == edge.ToKey); <li><a href="@from.Entity.Href"><EmojiText Text="@from.Entity.Title" /></a><span aria-hidden="true">→</span><a href="@to.Entity.Href"><EmojiText Text="@to.Entity.Title" /></a></li> }</ul></details>
            }
            else if (!_loading) { <div class="reference-empty"><h2>Find forbindelser i dit indhold</h2><p>Søg efter en note, teoriside, opgave eller et materiale. Links og referencer mellem indhold bliver vist her.</p></div> }
        </div>
    </div>
</section>

@code {
    [Parameter] public string? ScopeKind { get; set; }
    [Parameter] public string? ScopeId { get; set; }
    [Parameter] public bool PublishedOnly { get; set; }
    private const string ModulePath = "/js/notion-graph.js?v=connections-emoji-20261110";
    private readonly string _settingsId = "reference-graph-settings-" + Guid.NewGuid().ToString("N");
    private string? _scope;
    private EntityReference? _focus;
    private ReferenceGraphNode[] _nodes = [];
    private ReferenceGraphEdge[] _edges = [];
    private ResolvedReference[] _matches = [];
    private ResolvedReference? _selected;
    private IReadOnlyDictionary<string, CustomEmojiItem> _titleEmojis = EmojiTextParts.Index([]);
    private GraphSettings _settings = new();
    private string _query = "", _type = "";
    private string? _error;
    private int _total, _offset, _unmounting;
    private bool _loading, _searching, _hasMore, _dataDirty, _visualDirty, _mounted, _failed, _disposed, _settingsOpen, _settingsLoaded, _renderingGraph;
    private ElementReference _host, _settingsToggle;
    private IJSObjectReference? _module;
    private Task<IJSObjectReference>? _moduleTask;
    private TaskCompletionSource? _renderFinished;
    private readonly SemaphoreSlim _unmountGate = new(1, 1);
    private DotNetObjectReference<ReferenceGraphView>? _callback;
    private readonly CancellationTokenSource _life = new();
    private CancellationTokenSource? _search, _load, _save;
    private static bool IsContent(EntityReference reference) => reference.Kind is not ("person" or "member" or "poll");
    private IEnumerable<ReferenceGraphNode> VisibleNodes => _nodes.Where(n => _type.Length == 0 || n.Entity.Reference.Kind == _type);
    private IEnumerable<ReferenceGraphEdge> VisibleEdges { get { var keys = VisibleNodes.Select(n => n.Key).ToHashSet(); return _edges.Where(e => keys.Contains(e.FromKey) && keys.Contains(e.ToKey)); } }
    private string? ActiveId => _selected?.Reference.Key ?? _focus?.Key;
    private static string Percent(double value) => value.ToString("0%", CultureInfo.CurrentCulture);
    private static string Factor(double value) => value.ToString("0.0", CultureInfo.CurrentCulture) + "×";

    protected override void OnInitialized() => Auth.AuthStateChanged += Changed;
    private void CancelSearch() { _search?.Cancel(); _query = ""; _matches = []; _searching = false; }
    private void Changed() => _ = InvokeAsync(async () => { if (_disposed) return; var scope = _scope; _load?.Cancel(); CancelSearch(); await Unmount(); if (_disposed || scope != _scope) return; _nodes = []; _edges = []; _selected = null; _focus = null; _loading = false; if (Auth.IsAuthenticated) await Load(false); StateHasChanged(); });
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ScopeKind}:{ScopeId}:{PublishedOnly}";
        if (_scope == key) return; _scope = key; _focus = null;
        _load?.Cancel(); CancelSearch();
        await Unmount(); if (_disposed || _scope != key) return;
        _nodes = []; _edges = []; _selected = null; _loading = false; if (Auth.IsAuthenticated) await Load(false);
    }
    private async Task Load(bool more)
    {
        _load?.Cancel(); _load?.Dispose(); _load = CancellationTokenSource.CreateLinkedTokenSource(_life.Token); var ct = _load.Token;
        _loading = true; _error = null; _failed = false; var offset = more ? _offset + 400 : 0;
        try
        {
            var graph = await new ReferenceClient(Http).Graph(new(_focus, ScopeKind, ScopeId, offset, 400, PublishedOnly), ct);
            if (ct.IsCancellationRequested) return;
            var nodes = graph.Nodes.Where(n => IsContent(n.Entity.Reference)).DistinctBy(n => n.Key).ToArray();
            if (nodes.Length == 0) await Unmount();
            if (ct.IsCancellationRequested || _disposed) return;
            var keys = nodes.Select(n => n.Key).ToHashSet();
            _nodes = nodes; _edges = graph.Edges.Where(e => keys.Contains(e.FromKey) && keys.Contains(e.ToKey)).ToArray();
            _offset = offset; _total = Math.Max(nodes.Length, graph.Total - (graph.Nodes.Length - nodes.Length)); _hasMore = graph.HasMore; _dataDirty = true;
            if (_type.Length > 0 && !nodes.Any(n => n.Entity.Reference.Kind == _type)) _type = "";
            _selected = null;
            if (nodes.Any(node => node.Entity.Title.Contains(':')))
            {
                var emojis = LoadTitleEmojis(ct);
                if (!emojis.IsCompleted) { _loading = false; StateHasChanged(); }
                await emojis;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { if (!ct.IsCancellationRequested) _error = "Forbindelserne kunne ikke hentes."; }
        finally { if (!ct.IsCancellationRequested) _loading = false; }
    }
    private async Task LoadTitleEmojis(CancellationToken ct, bool refresh = false)
    {
        try
        {
            var items = await Emojis.List(refresh: refresh, ct: ct);
            if (_disposed || ct.IsCancellationRequested) return;
            _titleEmojis = EmojiTextParts.Index(items);
            _dataDirty = true;
        }
        catch (Exception ex) when (ex is EmojiException or JsonException or OperationCanceledException)
        {
            // Keep graph titles usable while the emoji catalogue is unavailable.
        }
    }

    private sealed record GraphTitlePart(string Text, string? ImageUrl, string? Alt);
    private GraphTitlePart[]? TitleParts(string title)
    {
        if (_titleEmojis.Count == 0 || !title.Contains(':')) return null;
        var parts = EmojiTextParts.Split(title, _titleEmojis);
        if (!parts.Any(part => part.Emoji is not null)) return null;
        return parts.Select(part => part.Emoji is { } emoji
            ? new GraphTitlePart($":{emoji.Name}:", emoji.ContentUrl, emoji.AltText)
            : new GraphTitlePart(part.Text, null, null)).ToArray();
    }

    private async Task Search(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? ""; _search?.Cancel(); _search?.Dispose(); _search = CancellationTokenSource.CreateLinkedTokenSource(_life.Token); var ct = _search.Token; _matches = [];
        if (_query.Trim().Length == 0) { _searching = false; return; } _searching = true;
        try { await Task.Delay(200, ct); var result = await new ReferenceClient(Http).Search(_query, ct, ScopeKind, ScopeId, PublishedOnly, contentOnly: true); if (!ct.IsCancellationRequested) _matches = result.Items.Where(m => IsContent(m.Reference)).ToArray(); }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { if (!ct.IsCancellationRequested) _error = "Søgningen kunne ikke hentes."; }
        finally { if (!ct.IsCancellationRequested) _searching = false; }
    }
    private async Task Focus(EntityReference target)
    {
        if (!IsContent(target)) return;
        _focus = target; _query = ""; _matches = []; _selected = null; await Load(false);
    }
    private async Task Reset() { _focus = null; await Load(false); }
    private void FilterChanged() { if (_selected is not null && !VisibleNodes.Any(n => n.Entity.Reference == _selected.Reference)) _selected = null; _dataDirty = true; }
    private async Task ToggleSettings() { if (_settingsOpen) await CloseSettings(); else _settingsOpen = true; }
    private async Task CloseSettings()
    {
        _settingsOpen = false;
        try { if (!_disposed) await _settingsToggle.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }
    private async Task SettingsKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") await CloseSettings(); }
    private void SettingsChanged()
    {
        _settings.Normalize(); _visualDirty = true;
        _save?.Cancel(); _save?.Dispose(); _save = CancellationTokenSource.CreateLinkedTokenSource(_life.Token);
        _ = PersistSettings(_save.Token);
    }
    private async Task PersistSettings(CancellationToken ct)
    {
        try { await Task.Delay(220, ct); if (_module is not null && !_disposed) await _module.InvokeVoidAsync("saveSettings", ct, _settings); }
        catch (Exception ex) when (ex is OperationCanceledException or JSException or InvalidOperationException) { }
    }
    private async Task ResetSettings()
    {
        _save?.Cancel(); _settings = new(); _visualDirty = true;
        try { if (_module is not null) await _module.InvokeVoidAsync("resetSettings"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }
    private object Options() => new { showLabels = _settings.ShowLabels, showArrows = _settings.ShowArrows, nodeSize = _settings.NodeSize, labelSize = _settings.LabelSize, labelWeight = _settings.LabelWeight, linkThickness = _settings.LinkThickness, labelThreshold = _settings.LabelThreshold, highlightConnections = _settings.HighlightConnections, dimUnrelated = _settings.DimUnrelated, centerForce = _settings.CenterForce, repelForce = _settings.RepelForce, linkDistance = _settings.LinkDistance, linkForce = _settings.LinkForce, activeId = ActiveId };
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _renderingGraph || _unmounting > 0) return;
        _renderingGraph = true; var finished = _renderFinished = new(TaskCreationOptions.RunContinuationsAsynchronously);
        try
        {
            _moduleTask ??= Js.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask(); _module ??= await _moduleTask;
            if (_disposed) return;
            if (!_settingsLoaded)
            {
                _settingsLoaded = true;
                try { _settings = await _module.InvokeAsync<GraphSettings?>("readSettings") ?? new(); _settings.Normalize(); }
                catch (Exception ex) when (ex is JSException or InvalidOperationException or JsonException) { _settings = new(); }
                _visualDirty = true; StateHasChanged();
            }
            if (_disposed) return;
            if (_nodes.Length == 0 || _failed || !_dataDirty && !_visualDirty) return;
            _callback ??= DotNetObjectReference.Create(this);
            var visible = VisibleNodes.ToArray(); var keys = visible.Select(n => n.Key).ToHashSet();
            if (_dataDirty || !_mounted)
            {
                var payload = new { nodes = visible.Select(n => new { id = n.Key, title = n.Entity.Title, titleParts = TitleParts(n.Entity.Title), inbound = _edges.Count(e => e.ToKey == n.Key) }), edges = _edges.Where(e => keys.Contains(e.FromKey) && keys.Contains(e.ToKey)).Select(e => new { fromId = e.FromKey, toId = e.ToKey }), options = Options() };
                _dataDirty = _visualDirty = false;
                if (_mounted) await _module.InvokeVoidAsync("update", _host, payload);
                else await _module.InvokeVoidAsync("mount", _host, _callback, payload);
                _mounted = true;
            }
            else { _visualDirty = false; await _module.InvokeVoidAsync("configure", _host, Options()); }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { if (!_disposed) { if (_module is null) _moduleTask = null; _failed = true; StateHasChanged(); } }
        finally { _renderingGraph = false; finished.TrySetResult(); if (!_disposed && _unmounting == 0 && !_failed && _nodes.Length > 0 && (_dataDirty || _visualDirty)) StateHasChanged(); }
    }
    private async Task SelectNode(EntityReference target)
    {
        if (!IsContent(target)) return;
        _selected = _nodes.FirstOrDefault(n => n.Entity.Reference == target)?.Entity; _visualDirty = true;
        if (_module is not null && _mounted && _selected is not null) await _module.InvokeVoidAsync("focus", _host, _selected.Reference.Key);
    }
    private async Task ClearSelection()
    {
        _selected = null; _visualDirty = true;
        if (_module is not null && _mounted) await _module.InvokeVoidAsync("focus", _host, "");
    }
    private async Task Zoom(int direction) { if (_module is not null && _mounted) await _module.InvokeVoidAsync("zoom", _host, direction); }
    [JSInvokable] public Task OnGraphOpen(string key) { var node = _nodes.FirstOrDefault(n => n.Key == key); if (!_disposed && node is not null && IsContent(node.Entity.Reference)) Nav.NavigateTo(node.Entity.Href); return Task.CompletedTask; }
    [JSInvokable] public Task OnGraphMenu(string key, double x, double y) => _disposed ? Task.CompletedTask : InvokeAsync(() => { if (_disposed) return; _selected = _nodes.FirstOrDefault(n => n.Key == key)?.Entity; _visualDirty = true; StateHasChanged(); });
    [JSInvokable]
    public Task OnGraphEmojiError() => _disposed ? Task.CompletedTask : InvokeAsync(async () =>
    {
        if (_disposed || _load is null || _load.IsCancellationRequested) return;
        await LoadTitleEmojis(_load.Token, refresh: true);
        if (!_disposed) StateHasChanged();
    });

    private async Task Unmount()
    {
        _unmounting++;
        try
        {
            await _unmountGate.WaitAsync();
            try
            {
                if (_renderingGraph && _renderFinished is not null) await _renderFinished.Task;
                if (_mounted && _module is not null) { var host = _host; _mounted = false; await _module.InvokeVoidAsync("destroy", host); }
            }
            finally { _unmountGate.Release(); }
        }
        finally { _unmounting--; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Auth.AuthStateChanged -= Changed; _life.Cancel(); _load?.Cancel(); _search?.Cancel(); _save?.Cancel();
        if (_renderingGraph && _renderFinished is not null) await _renderFinished.Task;
        try { await Unmount(); if (_module is not null) await _module.DisposeAsync(); } catch (JSException) { }
        _callback?.Dispose(); _load?.Dispose(); _search?.Dispose(); _save?.Dispose(); _life.Dispose();
    }
    public sealed class GraphSettings
    {
        private const double DefaultLabelThreshold = .2;

        public bool ShowLabels { get; set; } = true;
        public bool ShowArrows { get; set; }
        public double NodeSize { get; set; } = 1;
        public double LabelSize { get; set; } = 1;
        public int LabelWeight { get; set; } = 500;
        public double LinkThickness { get; set; } = 1;
        public double LabelThreshold { get; set; } = DefaultLabelThreshold;
        public bool HighlightConnections { get; set; } = true;
        public bool DimUnrelated { get; set; } = true;
        public double CenterForce { get; set; } = 1;
        public double RepelForce { get; set; } = 1;
        public double LinkDistance { get; set; } = 1;
        public double LinkForce { get; set; } = 1;
        public void Normalize()
        {
            NodeSize = Bound(NodeSize, .2, 3, 1); LabelSize = Bound(LabelSize, .6, 2, 1); LinkThickness = Bound(LinkThickness, .2, 3, 1);
            LabelThreshold = Bound(LabelThreshold, .2, 3, DefaultLabelThreshold); CenterForce = Bound(CenterForce, 0, 3, 1); RepelForce = Bound(RepelForce, 0, 3, 1);
            LinkDistance = Bound(LinkDistance, .2, 3, 1); LinkForce = Bound(LinkForce, 0, 3, 1);
            LabelWeight = LabelWeight < 450 ? 400 : LabelWeight >= 600 ? 700 : 500;
        }
        private static double Bound(double value, double min, double max, double fallback) => double.IsFinite(value) ? Math.Clamp(value, min, max) : fallback;
    }
}
