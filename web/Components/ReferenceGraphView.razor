@using Mercantec.Tech.Web.Notion
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AuthService Auth
@implements IAsyncDisposable

<section class="reference-graph" aria-label="Forbindelser på tværs af LUP">
    <div class="reference-toolbar"><label class="field">Søg i hele LUP<input type="search" value="@_query" @oninput="Search" placeholder="Side, person, opgave, teori…" /></label><label class="field">Vis type<select @bind="_type" @bind:after="Refresh"><option value="">Alle typer</option>@foreach (var kind in _nodes.Select(n => n.Entity.Reference.Kind).Distinct().Order()) { <option value="@kind">@ReferencePresentation.KindLabel(kind)</option> }</select></label><label><input type="checkbox" @bind="_labels" @bind:after="Refresh" /> Titler</label><label><input type="checkbox" @bind="_arrows" @bind:after="Refresh" /> Pile</label><button class="secondary" disabled="@_loading" @onclick="() => Load(false)">Opdatér graf</button></div>
    @if (_searching) { <p role="status">Søger…</p> }
    @if (_matches.Length > 0) { <ul class="reference-results">@foreach (var match in _matches) { <li><button type="button" class="secondary" @onclick="() => Focus(match.Reference)"><strong>@match.Title</strong><small>@match.ContextLabel · @ReferencePresentation.KindLabel(match.Reference.Kind)</small></button></li> }</ul> }
    @if (_error is not null) { <p role="alert">@_error <button class="secondary" @onclick="() => Load(false)">Prøv igen</button></p> }
    @if (_loading) { <p role="status">Henter forbindelser…</p> }
    @if (_nodes.Length > 0)
    {
        <div class="notion-graph-stage" tabindex="0" aria-label="Interaktiv graf. Åbn en node med dobbeltklik; brug listen nedenfor med tastatur."><div class="reference-canvas" @ref="_host"></div><div class="reference-zoom"><button type="button" class="secondary" @onclick="() => Zoom(-1)" aria-label="Zoom ud">−</button><button type="button" class="secondary" @onclick="() => Zoom(1)" aria-label="Zoom ind">+</button><button type="button" class="secondary" @onclick="() => Zoom(0)">Tilpas</button></div></div>
        <p class="reference-count">@_nodes.Length af @_total tilgængelige elementer · @_edges.Length forbindelser</p>
        @if (_hasMore) { <button class="secondary" disabled="@_loading" @onclick="() => Load(true)">Hent næste udsnit · højst 400 noder</button> }
        @if (_focus is not null) { <button class="secondary" @onclick="Reset">Tilbage til notesbogen / holdet</button> }
        @if (_selected is { } selected) { <div class="panel reference-selected"><h3>@selected.Title</h3><p>@selected.ContextLabel · @ReferencePresentation.KindLabel(selected.Reference.Kind)</p><a class="action" href="@selected.Href">Åbn</a><button class="secondary" @onclick="() => Focus(selected.Reference)">Udvid forbindelser</button>@if (selected.CanRename) { <a class="secondary" href="@selected.Href">Rediger titel på siden</a> }</div> }
        <details class="reference-list" open="@_failed"><summary>Elementer og forbindelser som liste</summary><ul>@foreach (var node in VisibleNodes) { <li><a href="@node.Entity.Href">@node.Entity.Title</a><small>@node.Entity.ContextLabel · @ReferencePresentation.KindLabel(node.Entity.Reference.Kind)</small><button class="secondary" @onclick="() => Focus(node.Entity.Reference)">Vis forbindelser</button></li> }</ul><ul>@foreach (var edge in _edges) { var from = _nodes.FirstOrDefault(n => n.Key == edge.FromKey); var to = _nodes.FirstOrDefault(n => n.Key == edge.ToKey); @if (from is not null && to is not null) { <li><a href="@from.Entity.Href">@from.Entity.Title</a> → <a href="@to.Entity.Href">@to.Entity.Title</a></li> } }</ul></details>
    }
    else if (!_loading) { <p>Find et element med søgningen, eller indsæt en mention for at forbinde indhold.</p> }
</section>

@code {
    [Parameter] public string? ScopeKind { get; set; }
    [Parameter] public string? ScopeId { get; set; }
    [Parameter] public bool PublishedOnly { get; set; }
    private string? _scope;
    private EntityReference? _focus;
    private ReferenceGraphNode[] _nodes = [];
    private ReferenceGraphEdge[] _edges = [];
    private ResolvedReference[] _matches = [];
    private ResolvedReference? _selected;
    private string _query = "", _type = "";
    private string? _error;
    private int _total, _offset;
    private bool _loading, _searching, _hasMore, _labels = true, _arrows, _dirty, _mounted, _failed, _disposed;
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ReferenceGraphView>? _callback;
    private readonly CancellationTokenSource _life = new();
    private CancellationTokenSource? _search, _load;
    private IEnumerable<ReferenceGraphNode> VisibleNodes => _nodes.Where(n => _type.Length == 0 || n.Entity.Reference.Kind == _type);
    protected override void OnInitialized() => Auth.AuthStateChanged += Changed;
    private void Changed() => _ = InvokeAsync(async () => { _load?.Cancel(); _search?.Cancel(); await Unmount(); _nodes = []; _edges = []; _matches = []; _selected = null; _focus = null; if (Auth.IsAuthenticated) await Load(false); StateHasChanged(); });
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ScopeKind}:{ScopeId}:{PublishedOnly}";
        if (_scope == key) return; _scope = key; _focus = null;
        await Unmount(); _nodes = []; _edges = []; _selected = null; if (Auth.IsAuthenticated) await Load(false);
    }
    private async Task Load(bool more)
    {
        _load?.Cancel(); _load?.Dispose(); _load = CancellationTokenSource.CreateLinkedTokenSource(_life.Token); var ct = _load.Token;
        _loading = true; _error = null; _offset = more ? _offset + 400 : 0;
        try
        {
            var graph = await new ReferenceClient(Http).Graph(new(_focus, ScopeKind, ScopeId, _offset, 400, PublishedOnly), ct);
            if (ct.IsCancellationRequested) return;
            if (graph.Nodes.Length == 0) await Unmount();
            _nodes = graph.Nodes; _edges = graph.Edges; _total = graph.Total; _hasMore = graph.HasMore; _dirty = true;
            _selected = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { if (!ct.IsCancellationRequested) _error = "Forbindelserne kunne ikke hentes."; }
        finally { if (!ct.IsCancellationRequested) _loading = false; }
    }
    private async Task Search(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? ""; _search?.Cancel(); _search?.Dispose(); _search = CancellationTokenSource.CreateLinkedTokenSource(_life.Token); var ct = _search.Token; _matches = [];
        if (_query.Trim().Length == 0) { _searching = false; return; } _searching = true;
        try { await Task.Delay(200, ct); var result = await new ReferenceClient(Http).Search(_query, ct, ScopeKind, ScopeId, PublishedOnly); if (!ct.IsCancellationRequested) _matches = result.Items; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { if (!ct.IsCancellationRequested) _error = "Søgningen kunne ikke hentes."; }
        finally { if (!ct.IsCancellationRequested) _searching = false; }
    }
    private async Task Focus(EntityReference target) { _focus = target; _query = ""; _matches = []; await Load(false); }
    private async Task Reset() { _focus = null; await Load(false); }
    private void Refresh() => _dirty = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dirty || _nodes.Length == 0 || _disposed || _failed) return; _dirty = false;
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/notion-graph.js"); _callback ??= DotNetObjectReference.Create(this);
            var visible = VisibleNodes.ToArray(); var keys = visible.Select(n => n.Key).ToHashSet();
            var payload = new { nodes = visible.Select(n => new { id = n.Key, title = n.Entity.Title, inbound = _edges.Count(e => e.ToKey == n.Key) }), edges = _edges.Where(e => keys.Contains(e.FromKey) && keys.Contains(e.ToKey)).Select(e => new { fromId = e.FromKey, toId = e.ToKey }), options = new { showLabels = _labels, showArrows = _arrows, activeId = _focus is null ? null : _focus.Kind + ":" + _focus.Id } };
            if (_mounted) await _module.InvokeVoidAsync("update", _host, payload);
            else await _module.InvokeVoidAsync("mount", _host, _callback, payload);
            _mounted = true;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { _failed = true; StateHasChanged(); }
    }
    private async Task Zoom(int direction) { if (_module is not null && _mounted) await _module.InvokeVoidAsync("zoom", _host, direction); }
    [JSInvokable] public Task OnGraphOpen(string key) { var node = _nodes.FirstOrDefault(n => n.Key == key); if (node is not null) Nav.NavigateTo(node.Entity.Href); return Task.CompletedTask; }
    [JSInvokable] public Task OnGraphMenu(string key, double x, double y) => InvokeAsync(() => { _selected = _nodes.FirstOrDefault(n => n.Key == key)?.Entity; StateHasChanged(); });
    private async Task Unmount() { if (_mounted && _module is not null) await _module.InvokeVoidAsync("destroy", _host); _mounted = false; }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Auth.AuthStateChanged -= Changed; _life.Cancel(); _load?.Cancel(); _search?.Cancel();
        try { await Unmount(); if (_module is not null) await _module.DisposeAsync(); } catch (JSException) { }
        _callback?.Dispose(); _load?.Dispose(); _search?.Dispose(); _life.Dispose();
    }
}
