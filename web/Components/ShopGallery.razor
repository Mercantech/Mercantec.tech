<div class="v4-shop-summary"><div><strong><i class="v3-gold-dot"></i>@DemoCatalog.Gold guld</strong><p>Level @DemoCatalog.Level · Nye ting fra level 8</p></div><a class="secondary" href="/universe/unlocks">Se level- og badge-oplåsninger</a></div>
<div class="v4-shop-tabs">@foreach (var kind in new[] { "Tøj", "Møbler", "Alle" }) { <button class="filter" aria-pressed="@(_kind == kind)" @onclick="() => _kind = kind">@(kind == "Tøj" ? "Avatartøj" : kind)</button> }<a class="secondary" href="/profile/character">Min garderobe</a></div>
<div class="v4-shop-grid">@foreach (var item in DemoCatalog.Shop.Where(i => _kind == "Alle" || i.Kind == _kind)) { <article class="v4-product @(!item.Available ? "is-locked" : "")"><ProductArt Kind="@item.Kind" Design="@item.Design" Color="@item.Color" /><h2>@item.Name</h2><p>@item.Desc</p><div class="v4-product-lock @(item.Available ? "is-ready" : "")"><UiIcon Name="@(item.Available ? "check" : "lock")" /><span>Level @item.Level @if (item.BadgeId is not null) { <span> + <a href="/badges/@item.BadgeId">@DemoCatalog.Badges.First(b => b.Id == item.BadgeId).Name@(item.BadgeRank > 1 ? " · " + DemoCatalog.RankNames[item.BadgeRank - 1] : "")</a></span> }</span></div><div class="v4-product-price">@(item.Cost == 0 ? "Dit startsæt" : item.Cost + " guld")</div><div class="actions">@if (item.Cost == 0) { <a class="secondary" href="@(item.Kind == "Tøj" ? "/profile/character" : "/apartment")">Ejet · Se inventar</a> } else { <button class="secondary" type="button" disabled title="Køb bliver tilgængeligt, når butikken er tilkoblet din konto">@(item.Available ? "Køb med guld" : "Låst")</button> }</div></article> }</div>
<p class="small muted" style="margin-top:18px">Et level eller badge åbner købet. Du ejer først varen, når du har købt den med guld.</p>
@code { private string _kind = "Tøj"; }
