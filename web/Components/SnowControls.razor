@inject IJSRuntime Js
@implements IAsyncDisposable
<div class="snow-controls">
    <button class="snow-toggle" @onclick="Toggle" aria-label="@(_state.Paused ? "Start sneen" : "Sæt sneen på pause")" title="@Explanation"><UiIcon Name="snow" /><span>@(_state.Paused ? "Start sne" : "Pause sne")</span></button>
    <details class="snow-settings">
        <summary aria-label="Sneindstillinger">⌄</summary>
        <div class="snow-panel">
            <h2>Sne i baggrunden</h2>
            <label>Bevægelse<select value="@_state.Mode" @onchange="ChangeMode"><option value="auto">Følg systemet</option><option value="on">Bevægelig sne</option><option value="off">Stille sne</option></select></label>
            <p role="status">@Explanation</p>
        </div>
    </details>
</div>
@code {
    private SnowState _state = new();
    private DotNetObjectReference<SnowControls>? _reference;
    private int _observer;
    private string Explanation => _state.Hidden ? "Sneen bevæger sig, når fanen er aktiv." : _state.Mode == "auto" && _state.ReducedMotion ? "Din enhed bruger reduceret bevægelse. Vælg Bevægelig sne, eller tryk Start sne for at sætte den i gang." : _state.Mode == "off" ? "Sneen er sat på pause i denne browser." : _state.Mode == "on" ? "Du har valgt bevægelig sne. Bevæg musen for at påvirke vinden." : "Sneen følger enhedens indstilling for bevægelse.";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _state = await Js.InvokeAsync<SnowState>("lupTheme.snowState");
        _reference = DotNetObjectReference.Create(this);
        _observer = await Js.InvokeAsync<int>("lupTheme.observeSnow", _reference);
        StateHasChanged();
    }
    [JSInvokable] public Task SnowChanged(SnowState state) => InvokeAsync(() => { _state = state; StateHasChanged(); });
    private async Task Toggle() { await Js.InvokeVoidAsync("lupTheme.toggleSnow"); _state = await Js.InvokeAsync<SnowState>("lupTheme.snowState"); }
    private async Task ChangeMode(ChangeEventArgs e) => _state = await Js.InvokeAsync<SnowState>("lupTheme.setSnowMode", e.Value?.ToString() ?? "auto");
    public async ValueTask DisposeAsync()
    {
        try { if (_observer != 0) await Js.InvokeVoidAsync("lupTheme.unobserveSnow", _observer); }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
    public sealed class SnowState
    {
        public string Mode { get; set; } = "auto";
        public bool Paused { get; set; }
        public bool ReducedMotion { get; set; }
        public bool Hidden { get; set; }
    }
}
