<div class="v4-unlock-row"><ProductArt Kind="@Item.Kind" Design="@Item.Design" Color="@Item.Color" /><div><strong>@Item.Name</strong><small>@Item.Kind · @(Item.Cost == 0 ? "Startinventar" : Item.Cost + " guld")@if (Item.BadgeId is not null) { <span> · Kræver <a href="/badges/@Item.BadgeId">@DemoCatalog.Badges.First(b => b.Id == Item.BadgeId).Name@(Item.BadgeRank > 1 ? " på " + DemoCatalog.RankNames[Item.BadgeRank - 1] : "")</a></span> }</small></div><a href="/universe/shop">@(Item.Cost == 0 ? "Ejet" : Item.Available ? "Se varen" : "Se krav")</a></div>
@code { [Parameter, EditorRequired] public DemoCatalog.ShopItem Item { get; set; } = default!; }
