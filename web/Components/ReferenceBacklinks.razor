@using Mercantec.Tech.Web.Notion
@inject HttpClient Http
@inject AuthService Auth
@implements IDisposable
<section class="panel" aria-label="Tilbagelinks"><h3>Sider, der linker hertil</h3>@if (_error) { <p>Tilbagelinks kunne ikke hentes.</p><button class="secondary" @onclick="Load">Prøv igen</button> } else if (_items.Length == 0) { <p>Ingen tilgængelige sider linker hertil endnu.</p> } else { <nav aria-label="Tilbagelinks">@foreach (var item in _items) { <p><a href="@item.Href"><EmojiText Text="@item.Title" /></a> <small>@item.ContextLabel</small></p> }</nav> }</section>
@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public long Revision { get; set; }
    [Parameter] public bool PublishedOnly { get; set; }
    private ResolvedReference[] _items = [];
    private CancellationTokenSource _request = new();
    private string? _key;
    private bool _error;
    protected override void OnInitialized() => Auth.AuthStateChanged += Changed;
    private void Changed() => _ = InvokeAsync(async () => { _items = []; await Load(); StateHasChanged(); });
    protected override async Task OnParametersSetAsync() { var key = $"{Kind}:{Id}:{Revision}:{PublishedOnly}"; if (_key == key) return; _key = key; await Load(); }
    private async Task Load()
    {
        _request.Cancel(); _request.Dispose(); _request = new(); var ct = _request.Token; _items = []; _error = false;
        if (!Auth.IsAuthenticated) return;
        try { var items = await new ReferenceClient(Http).Backlinks(Kind, Id, ct, PublishedOnly); if (!ct.IsCancellationRequested) _items = items; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { if (!ct.IsCancellationRequested) _error = true; }
    }
    public void Dispose() { Auth.AuthStateChanged -= Changed; _request.Cancel(); _request.Dispose(); }
}
