@using Mercantec.Tech.Web.Courses
@inject IJSRuntime Js

<div class="@_rootClass" data-language="@_langKey">
    <div class="course-code-bar">
        <span class="course-code-lang">@_label</span>
        <button type="button"
                class="course-code-copy@(_copied ? " is-copied" : "")"
                @onclick="CopyAsync"
                aria-label="Kopiér kode"
                disabled="@_busy">
            @_buttonText
        </button>
        <span class="visually-hidden" role="status">@_feedback</span>
    </div>
    <div class="course-code-body" tabindex="0" role="region" aria-label="@($"Kodeeksempel · {_label}")">
        @CourseMarkdown.HighlightCode(Code, Language)
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;
    [Parameter] public string Language { get; set; } = string.Empty;

    private string _label = "Kode";
    private string _langKey = "";
    private string _rootClass = "course-code";
    private string _buttonText = "Kopiér";
    private string _feedback = "";
    private int _copyVersion;
    private bool _copied;
    private bool _busy;

    protected override void OnParametersSet()
    {
        _label = CourseMarkdown.DisplayLanguage(Language);
        _langKey = (Language ?? string.Empty).Trim().ToLowerInvariant();
        // Hook til separat Mermaid-PR: .course-code--mermaid[data-language=mermaid]
        _rootClass = _langKey == "mermaid" ? "course-code course-code--mermaid" : "course-code";
    }

    private async Task CopyAsync()
    {
        if (_busy)
            return;

        var version = ++_copyVersion;
        _busy = true;
        try
        {
            _copied = await Js.InvokeAsync<bool>("courseCode.copy", Code ?? string.Empty);
        }
        catch
        {
            _copied = false;
        }
        finally
        {
            _busy = false;
            _buttonText = _copied ? "Kopieret" : "Fejl";
            _feedback = _copied ? "Koden er kopieret." : "Koden kunne ikke kopieres.";
            StateHasChanged();
        }

        await Task.Delay(1600);
        if (version != _copyVersion)
            return;

        _copied = false;
        _buttonText = "Kopiér";
        _feedback = "";
    }
}
