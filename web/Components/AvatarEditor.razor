@using Mercantec.Tech.Web.Demo
@using Mercantec.Tech.Web.Characters
@inject DemoWorld World
@inject AuthService Auth
@inject GiftMailboxClient Mailbox
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (World.AvatarProfileError is not null && !World.AvatarProfileReady)
{
    <div class="avatar-notice" role="alert">
        <p>@World.AvatarProfileError</p>
        <button type="button" class="secondary" disabled="@World.AvatarBusy" @onclick="World.ReloadAvatarProfileAsync">Prøv igen</button>
    </div>
}
else if (!World.Ready || !World.AvatarProfileReady)
{
    <p role="status">Indlæser din avatarsamling…</p>
}
else
{
    <section class="avatar-current" aria-label="Din valgte avatar">
        <AvatarIcon Size="48" Decorative="true" />
        <div><span>Du bruger</span><strong data-testid="selected-avatar-name">@World.SelectedAvatar.Name</strong></div>
        <p>Din samling gemmes på din konto og følger dig mellem computere.</p>
        <span class="avatar-wallet"><i class="v3-gold-dot" aria-hidden="true"></i><strong data-testid="avatar-gold">@World.Gold</strong> guld</span>
    </section>
    <div class="avatar-collection-layout">
        <section class="avatar-preview" aria-labelledby="avatar-preview-title">
            <div class="avatar-preview-top"><span>Forhåndsvisning</span><span class="avatar-edition">@PreviewDefinition.Edition</span></div>
            <div class="avatar-preview-canvas" role="group" aria-label="@($"{PreviewDefinition.Name} – forhåndsvisning")">
                @if (PreviewDefinition.Id == AvatarCatalog.StarterId)
                {
                    <ArenaStarterPreview Size="248" />
                }
                else
                {
                    <AvatarLayerPreview @key="_previewId" AvatarId="@_previewId" Animation="@_animation" ReplayKey="@_replayKey" Paused="@_animationPaused" Size="248" />
                }
            </div>
            <h2 id="avatar-preview-title">@PreviewDefinition.Name</h2>
            <p>@PreviewDefinition.Description</p>
            @if (PreviewDefinition.Animations.Count > 0)
            {
                <div class="avatar-preview-playback" aria-label="Afspilning af animation">
                    <button type="button" class="secondary" @onclick="ReplayAnimation">Afspil igen</button>
                    <button type="button" class="secondary" aria-pressed="@DemoWorld.Pressed(_animationPaused)" @onclick="() => _animationPaused = !_animationPaused">@(_animationPaused ? "Fortsæt animation" : "Pause animation")</button>
                    <button type="button" class="secondary" data-testid="avatar-action-sound" @onclick="PlayActionSound">♫ Hør lyd</button>
                </div>
                <div class="avatar-animation-groups" aria-label="@($"Prøv alle bevægelser med {PreviewDefinition.Name}")">
                    @foreach (var group in PreviewDefinition.Actions.GroupBy(action => action.Group))
                    {
                        <fieldset class="avatar-action-group">
                            <legend>@group.Key</legend>
                            <div class="avatar-move-buttons">
                                @foreach (var action in group)
                                {
                                    <button type="button" class="secondary" data-action-id="@action.Id" aria-pressed="@DemoWorld.Pressed(_animation == action.Id)" @onclick="() => SetAction(action)">@action.Label</button>
                                }
                            </div>
                        </fieldset>
                    }
                </div>
                @if (PreviewAction is { } currentAction)
                {
                    <div class="avatar-action-description" role="status"><strong>@currentAction.Label</strong><p>@currentAction.Description</p></div>
                }
                @if (_actionAudioNotice is not null) { <p class="avatar-audio-notice" role="status">@_actionAudioNotice</p> }
                <div class="avatar-included"><span>@PreviewDefinition.Animations.Count bevægelser</span><span>@PreviewDefinition.Actions.Count lydeffekter</span><span>@PreviewDefinition.AudioFiles.Count indtalte replikker</span><span>@PreviewDefinition.Emojis.Count emojis</span></div>
            }
            @if (PreviewDefinition.CharacterProfilePath is not null)
            {
                <a class="avatar-character-link" href="@PreviewDefinition.CharacterProfilePath">Lær @PreviewDefinition.Name at kende <span aria-hidden="true">↗</span></a>
            }
            <a class="avatar-game-link" href="@ArenaFighters.PlayPath">Se kæmpere i LUP Arena</a>
            <a class="avatar-game-link" href="/games/arena">Prøv din valgte avatar i LUP Arena <span aria-hidden="true">↗</span></a>
        </section>
        <section class="avatar-library" aria-labelledby="avatar-library-title">
            <div class="avatar-section-heading"><div><h2 id="avatar-library-title">Vælg din figur</h2><p>Opfyld figurens krav, og lås den op én gang.</p></div><span>@World.OwnedAvatarIds.Count / @AvatarCatalog.All.Count</span></div>
            @if (AvatarCatalog.All.Any(avatar => !World.OwnsAvatar(avatar.Id) && avatar.UnlockRequirements.Count > 0))
            {
                <div class="avatar-requirements-help">
                    <div>@if (HasChristmasGiftRequirement) { <p>Julemanden kræver gaver til tre forskellige brugere. Vælg temaet <strong>Jul</strong>, og send via gaveikonet.</p> } @if (HasGameUploadRequirement) { <p>LUPP er gratis, når du har <a href="@Mercantec.Tech.Web.Games.GamesCatalog.UploadGameProjectPath">uploadet dit eget spil</a>. Dit spil behøver ikke være offentligt.</p> }</div>
                    <button type="button" class="secondary" disabled="@World.AvatarBusy" @onclick="RefreshRequirements">@(World.AvatarBusy ? "Henter krav…" : "Opdatér krav")</button>
                </div>
            }
            <div class="avatar-available-grid">
                @foreach (var avatar in AvatarCatalog.All)
                {
                    var owned = World.OwnsAvatar(avatar.Id);
                    var selected = World.SelectedAvatarId == avatar.Id;
                    <article class="avatar-collectible @(selected ? "is-selected" : null) @(!owned ? "is-locked" : null)" data-avatar-id="@avatar.Id">
                        <button type="button" class="avatar-inspect" aria-label="@($"Se {avatar.Name}")" aria-pressed="@DemoWorld.Pressed(_previewId == avatar.Id)" @onclick="() => Preview(avatar.Id)">
                            <AvatarIcon AvatarId="@avatar.Id" Size="76" Decorative="true" />
                            <strong>@avatar.Name</strong><span>@(selected ? "Din valgte figur" : owned ? "I din samling" : World.CanUnlockAvatar(avatar.Id) ? "Klar til at blive låst op" : "Se krav for oplåsning")</span>
                        </button>
                        <div class="avatar-card-action">
                            @if (selected)
                            {
                                <button type="button" class="secondary avatar-selected-button" disabled><UiIcon Name="check" /> Valgt</button>
                            }
                            else if (owned)
                            {
                                <button type="button" class="action" disabled="@World.AvatarBusy" @onclick="() => Choose(avatar.Id)">Brug avatar</button>
                            }
                            else
                            {
                                <span class="avatar-requirement"><UiIcon Name="lock" /> @(avatar.Cost == 0 ? "Gratis" : $"Level {avatar.Level} · {avatar.Cost} guld")</span>
                                @if (avatar.UnlockRequirements.Count > 0)
                                {
                                    <ul class="avatar-unlock-requirements" aria-label="@($"Oplåsningskrav for {avatar.Name}")">
                                        @foreach (var requirement in avatar.UnlockRequirements)
                                        {
                                            var progress = World.GetAvatarUnlockProgress(avatar.Id).First(value => value.RequirementId == requirement.Id);
                                            <li class="@(progress.IsMet ? "is-met" : null)" data-requirement-id="@requirement.Id">
                                                <span>@requirement.Description</span>
                                                <strong role="status" data-testid="@($"requirement-progress-{avatar.Id}-{requirement.Id}")">@Math.Min(progress.Current, progress.Required) / @progress.Required @(RequirementUnit(requirement.Kind)) @(progress.IsMet ? "· Opfyldt" : "")</strong>
                                                <progress max="@progress.Required" value="@Math.Min(progress.Current, progress.Required)" aria-label="@requirement.Description"></progress>
                                            </li>
                                        }
                                    </ul>
                                }
                                <button type="button" class="action" disabled="@(World.AvatarBusy || !World.CanUnlockAvatar(avatar.Id))" data-testid="@(avatar.Id == AvatarCatalog.Bip01Id ? "unlock-robot" : $"unlock-{avatar.Id}")" @onclick="() => Unlock(avatar.Id)">@(World.AvatarBusy ? "Gemmer…" : World.CanUnlockAvatar(avatar.Id) ? avatar.Cost == 0 ? "Lås op gratis" : $"Lås op · {avatar.Cost} guld" : World.AvatarRequirementText(avatar.Id))</button>
                            }
                        </div>
                    </article>
                }
            </div>
            @if (HasChristmasGiftRequirement)
            {
                <p class="avatar-requirements-history">Gavens tema gemmes ved afsendelse. Ældre gaver uden gemt tema tæller ikke med i kravet.</p>
            }
            @if (World.AvatarProfileError is not null)
            {
                <div class="avatar-notice" role="alert"><p>@World.AvatarProfileError</p><button type="button" class="secondary" disabled="@World.AvatarBusy" @onclick="World.ReloadAvatarProfileAsync">Hent samlingen igen</button></div>
            }
            @if (World.NoticeArea == "avatar" && World.Notice is not null) { <p class="avatar-notice" role="status" aria-live="polite">@World.Notice</p> }
            @if (PreviewDefinition.FaceImage is not null)
            {
                <section class="avatar-expressions" aria-labelledby="avatar-expressions-title">
                    <div>
                        <h3 id="avatar-expressions-title">@(PreviewDefinition.Emojis.Count == 0 ? "Profilikon" : "Et ansigt til hver anledning")</h3>
                        @if (PreviewDefinition.Emojis.Count > 0)
                        {
                            <p>Et profilikon og @PreviewDefinition.Emojis.Count små reaktioner følger med @PreviewDefinition.Name.</p>
                        }
                    </div>
                    <div class="avatar-emoji-row">
                        <AvatarIcon AvatarId="@PreviewDefinition.Id" Size="56" />
                        @foreach (var emoji in PreviewDefinition.Emojis)
                        {
                            <a href="@emoji.Image" download="@($"{PreviewDefinition.Id}-{emoji.Id}.{emoji.Extension}")" title="@($"Hent emoji: {emoji.Label}")" aria-label="@($"Hent emoji: {emoji.Label}")"><AvatarIcon AvatarId="@PreviewDefinition.Id" Expression="@emoji.Id" Size="56" Decorative="true" /></a>
                        }
                    </div>
                    <a class="avatar-icon-download" href="@PreviewDefinition.FaceImage" download="@($"{PreviewDefinition.Id}-avatar.{PreviewDefinition.FaceExtension}")">Hent ansigtsikon · @PreviewDefinition.FaceExtension.ToUpperInvariant()</a>
                </section>
                <section class="avatar-phrases" aria-labelledby="avatar-phrases-title">
                    <h3 id="avatar-phrases-title">@PreviewDefinition.Name har noget at sige</h3>
                    <blockquote>“@PreviewDefinition.Catchphrases[_phraseIndex].Text”</blockquote>
                    <div class="avatar-phrase-actions"><button type="button" class="secondary" @onclick="NextPhrase">Næste replik</button>@if (PreviewDefinition.AudioFiles.Count == PreviewDefinition.Catchphrases.Count) { <button type="button" class="secondary" @onclick="PlayPhrase">♫ Hør replikken</button> }</div>
                    @if (_audioNotice is not null) { <p class="avatar-audio-notice" role="status">@_audioNotice</p> }
                </section>
            }
        </section>
    </div>
    <section class="avatar-future" aria-labelledby="avatar-future-title">
        <div class="avatar-section-heading"><div><h2 id="avatar-future-title">Der er flere figurer på vej</h2><p>Nye personligheder. Nye udtryk. Din samling er kun lige begyndt.</p></div><span>12 kommende pladser</span></div>
        <div class="avatar-mystery-grid">
            @for (var i = 1; i <= 12; i++)
            {
                <article class="avatar-mystery" aria-label="@($"Kommende avatar, plads {i}. Ikke tilgængelig endnu.")"><span class="avatar-mystery-face" aria-hidden="true">?</span><strong>Kommer senere</strong><span>En ny figur venter</span><UiIcon Name="lock" /></article>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string? RequestedAvatarId { get; set; }

    private string? _handledAvatarRequest;
    private string _previewId = AvatarCatalog.Bip01Id;
    private string _animation = "idle";
    private int _replayKey;
    private bool _animationPaused;
    private bool _disposed;
    private int _phraseIndex;
    private string? _audioNotice;
    private string? _actionAudioNotice;
    private int _audioVersion;
    private AvatarDefinition PreviewDefinition => AvatarCatalog.Find(_previewId) ?? AvatarCatalog.All[0];
    private bool HasGameUploadRequirement => AvatarCatalog.All.Any(avatar => !World.OwnsAvatar(avatar.Id)
        && avatar.UnlockRequirements.Any(requirement => requirement.Kind == AvatarRequirementKinds.UploadedGames));
    private static string RequirementUnit(string kind) => kind switch
    {
        AvatarRequirementKinds.SentGiftsDistinctRecipients => "forskellige brugere",
        AvatarRequirementKinds.UploadedGames => "uploadet spil",
        _ => ""
    };
    private bool HasChristmasGiftRequirement => AvatarCatalog.All.Any(avatar => !World.OwnsAvatar(avatar.Id)
        && avatar.UnlockRequirements.Any(requirement => requirement.Kind == AvatarRequirementKinds.SentGiftsDistinctRecipients && requirement.Target == "christmas"));
    private AvatarAction? PreviewAction => PreviewDefinition.Actions.FirstOrDefault(action => action.Id == _animation);
    private async Task Preview(string id)
    {
        if (AvatarCatalog.Find(id) is null) return;
        _previewId = id; _animation = "idle"; _phraseIndex = 0; _audioNotice = null; _actionAudioNotice = null;
        _replayKey++; _animationPaused = false;
        await StopAudio();
    }
    private async Task Choose(string id) { if (await World.SelectAvatarAsync(id)) await Preview(id); }
    private async Task Unlock(string id) { if (await World.TryUnlockAvatarAsync(id)) { await Preview(id); _animation = "celebrate"; _phraseIndex = 4; } }
    private async Task SetAction(AvatarAction action)
    {
        _animation = action.Id; _replayKey++; _animationPaused = false; _actionAudioNotice = null;
        await StopAudio();
    }
    private void ReplayAnimation() { _replayKey++; _animationPaused = false; }
    private async Task NextPhrase() { _phraseIndex = (_phraseIndex + 1) % PreviewDefinition.Catchphrases.Count; _audioNotice = null; await StopAudio(); }
    private async Task StopAudio()
    {
        _audioVersion++; _audioNotice = null; _actionAudioNotice = null;
        try { await Js.InvokeVoidAsync("lupAvatars.stop"); }
        catch (Exception error) when (error is JSException or OperationCanceledException or ObjectDisposedException) { /* Audio can be unavailable while the page is leaving. */ }
    }
    private async Task PlayActionSound()
    {
        if (PreviewAction is not { } action || PreviewDefinition.SpriteAssetRoot is null) return;
        var version = ++_audioVersion;
        try
        {
            var played = await Js.InvokeAsync<bool>("lupAvatars.play", $"{PreviewDefinition.SpriteAssetRoot}/audio/{action.SoundFile}");
            if (!_disposed && version == _audioVersion) _actionAudioNotice = played ? null : "Lyden kunne ikke afspilles. Prøv igen.";
        }
        catch (Exception error) when (error is JSException or OperationCanceledException or ObjectDisposedException)
        { if (!_disposed && version == _audioVersion) _actionAudioNotice = "Lyden kunne ikke afspilles. Prøv igen."; }
    }
    private async Task PlayPhrase()
    {
        if (PreviewDefinition.AudioFiles.Count != PreviewDefinition.Catchphrases.Count || PreviewDefinition.SpriteAssetRoot is null) return;
        var version = ++_audioVersion;
        try
        {
            var played = await Js.InvokeAsync<bool>("lupAvatars.play", $"{PreviewDefinition.SpriteAssetRoot}/audio/{PreviewDefinition.AudioFiles[_phraseIndex]}");
            if (!_disposed && version == _audioVersion) _audioNotice = played ? null : "Lyden kunne ikke afspilles. Prøv igen.";
        }
        catch (Exception error) when (error is JSException or OperationCanceledException or ObjectDisposedException)
        { if (!_disposed && version == _audioVersion) _audioNotice = "Lyden kunne ikke afspilles. Teksten er stadig her."; }
    }
    protected override async Task OnInitializedAsync()
    {
        World.Changed += OnChanged;
        Mailbox.GiftSent += OnGiftSent;
        await World.EnsureAsync();
        await World.BindAvatarProfileAsync(Auth.Subject);
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_handledAvatarRequest == RequestedAvatarId)
            return;

        _handledAvatarRequest = RequestedAvatarId;
        if (AvatarCatalog.Find(RequestedAvatarId) is { } avatar && avatar.Id != _previewId)
            await Preview(avatar.Id);
    }
    private void OnChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void OnGiftSent() { if (!_disposed) _ = InvokeAsync(RefreshRequirements); }
    private async Task RefreshRequirements()
    {
        if (_disposed || !Auth.IsAuthenticated) return;
        await World.BindAvatarProfileAsync(Auth.Subject);
        if (!_disposed) await World.ReloadAvatarProfileAsync();
    }
    public async ValueTask DisposeAsync() { _disposed = true; World.Changed -= OnChanged; Mailbox.GiftSent -= OnGiftSent; await StopAudio(); }
}
