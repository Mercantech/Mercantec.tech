@inject AuthService Auth
@inject IJSRuntime Js
<div class="cols"><section class="panel"><div class="v2-avatar-stage" role="img" aria-label="Din valgte avatar"><AvatarSprite Skin="@_skin" Hair="@_hair" Style="@_style" /></div><h2>Basis-T-shirt</h2><div class="actions"><a class="action" href="/games/avatar-demo">Prøv avataren i et spil</a><a class="secondary" href="/universe/shop">Find tøj i butikken</a></div><div class="headrow"><h2>Min garderobe</h2><span>Dit startsæt</span></div><div class="v4-wardrobe"><button aria-pressed="true"><span class="v4-shirt basic"></span><span>Basis-T-shirt</span><span>✓ På</span></button></div><a href="/universe/unlocks">Se kommende tøj og oplåsninger</a></section>
<aside class="panel"><h2>Dit udtryk</h2><strong class="small">Hudtone</strong><div class="v2-options">@foreach (var color in Skins) { <button class="v2-swatch" style="--swatch:@color.Hex" aria-label="Hudtone: @color.Name" aria-pressed="@(_skin == color.Hex)" @onclick="() => SetColor(true, color.Hex)"></button> }</div><strong class="small">Hårfarve</strong><div class="v2-options">@foreach (var color in HairColors) { <button class="v2-swatch" style="--swatch:@color.Hex" aria-label="Hårfarve: @color.Name" aria-pressed="@(_hair == color.Hex)" @onclick="() => SetColor(false, color.Hex)"></button> }</div><strong class="small">Hår og tilbehør</strong><div class="v2-options">@foreach (var style in new[] { ("short", "Kort hår"), ("long", "Langt hår"), ("cap", "Kasket") }) { <button class="filter" aria-pressed="@(_style == style.Item1)" @onclick="() => SetStyle(style.Item1)">@style.Item2</button> }</div><p class="tiny muted" role="status">@_notice</p></aside></div>
@code {
    private string _skin = "#c98d69", _hair = "#42302a", _style = "short", _notice = "Dit udtryk gemmes i denne browser.";
    private static readonly (string Hex, string Name)[] Skins = [("#edc5a2", "Lys"), ("#c98d69", "Mellem"), ("#8d5e44", "Brun"), ("#553b33", "Mørk")];
    private static readonly (string Hex, string Name)[] HairColors = [("#42302a", "Mørk"), ("#a76636", "Brun"), ("#d5ac62", "Lys"), ("#545ca0", "Lilla")];
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; var data = await Js.InvokeAsync<string?>("lupAppearance.get", Auth.Subject); if (data is not null) { try { var a = System.Text.Json.JsonSerializer.Deserialize<string[]>(data); if (a?.Length == 3) { _skin = Skins.Any(c => c.Hex == a[0]) ? a[0] : _skin; _hair = HairColors.Any(c => c.Hex == a[1]) ? a[1] : _hair; _style = new[] { "short", "long", "cap" }.Contains(a[2]) ? a[2] : _style; } } catch (System.Text.Json.JsonException) {} StateHasChanged(); } }
    private async Task SetColor(bool skin, string value) { if (skin) _skin = value; else _hair = value; await Save(); }
    private async Task SetStyle(string value) { _style = value; await Save(); }
    private async Task Save() { var saved = await Js.InvokeAsync<bool>("lupAppearance.set", Auth.Subject, System.Text.Json.JsonSerializer.Serialize(new[] { _skin, _hair, _style })); _notice = saved ? "Dit udtryk er gemt i denne browser." : "Dit udtryk er ændret. Browseren tillader ikke lagring."; }
}
