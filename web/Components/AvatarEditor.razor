@using Mercantec.Tech.Web.Demo
@inject DemoWorld World
@inject AuthService Auth
@inject IJSRuntime Js
@implements IDisposable

@if (World.AvatarProfileError is not null && !World.AvatarProfileReady)
{
    <div class="avatar-notice" role="alert">
        <p>@World.AvatarProfileError</p>
        <button type="button" class="secondary" disabled="@World.AvatarBusy" @onclick="World.ReloadAvatarProfileAsync">Prøv igen</button>
    </div>
}
else if (!World.Ready || !World.AvatarProfileReady)
{
    <p role="status">Indlæser din avatarsamling…</p>
}
else
{
    <section class="avatar-current" aria-label="Din valgte avatar">
        <AvatarIcon Size="48" Decorative="true" />
        <div><span>Du bruger</span><strong data-testid="selected-avatar-name">@World.SelectedAvatar.Name</strong></div>
        <p>Din samling gemmes på din konto og følger dig mellem computere.</p>
        <span class="avatar-wallet"><i class="v3-gold-dot" aria-hidden="true"></i><strong data-testid="avatar-gold">@World.Gold</strong> guld</span>
    </section>
    <div class="avatar-collection-layout">
        <section class="avatar-preview" aria-labelledby="avatar-preview-title">
            <div class="avatar-preview-top"><span>Forhåndsvisning</span><span class="avatar-edition">@(PreviewDefinition.Id == AvatarCatalog.Bip01Id ? "Den første robot" : "Din startfigur")</span></div>
            <div class="avatar-preview-canvas" role="img" aria-label="@($"{PreviewDefinition.Name} – forhåndsvisning")"><AvatarSprite AvatarId="@_previewId" Animation="@_animation" Size="248" /></div>
            <h2 id="avatar-preview-title">@PreviewDefinition.Name</h2>
            <p>@PreviewDefinition.Description</p>
            @if (PreviewDefinition.Id == AvatarCatalog.Bip01Id)
            {
                <div class="avatar-move-buttons" aria-label="Prøv robotbevægelser">
                    <button type="button" class="secondary" aria-pressed="@DemoWorld.Pressed(_animation == "idle")" @onclick="ShowIdle">Stå klar</button>
                    <button type="button" class="secondary" aria-pressed="@DemoWorld.Pressed(_animation == "wave")" @onclick="ShowWave">Vink</button>
                    <button type="button" class="secondary" aria-pressed="@DemoWorld.Pressed(_animation == "celebrate")" @onclick="ShowCelebration">Jubel</button>
                </div>
                <div class="avatar-included"><span>28 bevægelser</span><span>5 replikker</span><span>4 emojis</span></div>
            }
            <a class="avatar-game-link" href="/games/avatar-demo">Prøv din valgte avatar i Rune Run <span aria-hidden="true">↗</span></a>
        </section>
        <section class="avatar-library" aria-labelledby="avatar-library-title">
            <div class="avatar-section-heading"><div><h2 id="avatar-library-title">Vælg din figur</h2><p>Lås en figur op én gang. Skift mellem dem, du ejer.</p></div><span>@World.OwnedAvatarIds.Count / @AvatarCatalog.All.Count</span></div>
            <div class="avatar-available-grid">
                @foreach (var avatar in AvatarCatalog.All)
                {
                    var owned = World.OwnsAvatar(avatar.Id);
                    var selected = World.SelectedAvatarId == avatar.Id;
                    <article class="avatar-collectible @(selected ? "is-selected" : null) @(!owned ? "is-locked" : null)" data-avatar-id="@avatar.Id">
                        <button type="button" class="avatar-inspect" aria-label="@($"Se {avatar.Name}")" aria-pressed="@DemoWorld.Pressed(_previewId == avatar.Id)" @onclick="() => Preview(avatar.Id)">
                            <AvatarIcon AvatarId="@avatar.Id" Size="76" Decorative="true" />
                            <strong>@avatar.Name</strong><span>@(selected ? "Din valgte figur" : owned ? "I din samling" : "Klar til at blive låst op")</span>
                        </button>
                        <div class="avatar-card-action">
                            @if (selected)
                            {
                                <button type="button" class="secondary avatar-selected-button" disabled><UiIcon Name="check" /> Valgt</button>
                            }
                            else if (owned)
                            {
                                <button type="button" class="action" disabled="@World.AvatarBusy" @onclick="() => Choose(avatar.Id)">Brug avatar</button>
                            }
                            else
                            {
                                <span class="avatar-requirement"><UiIcon Name="lock" /> Level @avatar.Level · @avatar.Cost guld</span>
                                <button type="button" class="action" disabled="@(World.AvatarBusy || !World.CanUnlockAvatar(avatar.Id))" data-testid="unlock-robot" @onclick="() => Unlock(avatar.Id)">@(World.AvatarBusy ? "Gemmer…" : World.CanUnlockAvatar(avatar.Id) ? $"Lås op · {avatar.Cost} guld" : World.AvatarRequirementText(avatar.Id))</button>
                            }
                        </div>
                    </article>
                }
            </div>
            @if (World.AvatarProfileError is not null)
            {
                <div class="avatar-notice" role="alert"><p>@World.AvatarProfileError</p><button type="button" class="secondary" disabled="@World.AvatarBusy" @onclick="World.ReloadAvatarProfileAsync">Hent samlingen igen</button></div>
            }
            @if (World.NoticeArea == "avatar" && World.Notice is not null) { <p class="avatar-notice" role="status" aria-live="polite">@World.Notice</p> }
            @if (PreviewDefinition.Id == AvatarCatalog.Bip01Id)
            {
                <section class="avatar-expressions" aria-labelledby="avatar-expressions-title">
                    <div><h3 id="avatar-expressions-title">Et ansigt til hver anledning</h3><p>Et profilikon og fire små robotreaktioner følger med BIP-01.</p></div>
                    <div class="avatar-emoji-row">
                        <AvatarIcon AvatarId="@AvatarCatalog.Bip01Id" Size="56" />
                        @foreach (var emoji in Emojis)
                        {
                            <a href="@($"{AssetRoot}/emoji-{emoji.Id}.png")" download="@($"bip01-{emoji.Id}.png")" title="@($"Hent emoji: {emoji.Label}")" aria-label="@($"Hent emoji: {emoji.Label}")"><AvatarIcon AvatarId="@AvatarCatalog.Bip01Id" Expression="@emoji.Id" Size="56" Decorative="true" /></a>
                        }
                    </div>
                    <a class="avatar-icon-download" href="@($"{AssetRoot}/face.png")" download="bip01-avatar.png">Hent ansigtsikon · PNG</a>
                </section>
                <section class="avatar-phrases" aria-labelledby="avatar-phrases-title">
                    <h3 id="avatar-phrases-title">Robotten har noget at sige</h3>
                    <blockquote>“@PreviewDefinition.Catchphrases[_phraseIndex].Text”</blockquote>
                    <div class="avatar-phrase-actions"><button type="button" class="secondary" @onclick="NextPhrase">Næste replik</button><button type="button" class="secondary" @onclick="PlayPhrase">♫ Hør replikken</button></div>
                    @if (_audioNotice is not null) { <p class="avatar-audio-notice" role="status">@_audioNotice</p> }
                </section>
            }
        </section>
    </div>
    <section class="avatar-future" aria-labelledby="avatar-future-title">
        <div class="avatar-section-heading"><div><h2 id="avatar-future-title">Der er flere figurer på vej</h2><p>Nye personligheder. Nye udtryk. Din samling er kun lige begyndt.</p></div><span>12 kommende pladser</span></div>
        <div class="avatar-mystery-grid">
            @for (var i = 1; i <= 12; i++)
            {
                <article class="avatar-mystery" aria-label="@($"Kommende avatar, plads {i}. Ikke tilgængelig endnu.")"><span class="avatar-mystery-face" aria-hidden="true">?</span><strong>Kommer senere</strong><span>En ny figur venter</span><UiIcon Name="lock" /></article>
            }
        </div>
    </section>
}

@code {
    private const string AssetRoot = "/assets/avatars/bip-01";
    private static readonly (string Id, string Label)[] Emojis = [("happy", "Glad"), ("wink", "Blink"), ("think", "Tænksom"), ("celebrate", "Jubel")];
    private static readonly string[] AudioFiles = ["phrase_1_welcome.wav", "phrase_2_start.wav", "phrase_3_success.wav", "phrase_4_retry.wav", "phrase_5_milestone.wav"];
    private string _previewId = AvatarCatalog.Bip01Id;
    private string _animation = "idle";
    private int _phraseIndex;
    private string? _audioNotice;
    private AvatarDefinition PreviewDefinition => AvatarCatalog.Find(_previewId) ?? AvatarCatalog.All[0];
    private void Preview(string id) { if (AvatarCatalog.Find(id) is not null) { _previewId = id; _animation = "idle"; _phraseIndex = 0; _audioNotice = null; } }
    private async Task Choose(string id) { if (await World.SelectAvatarAsync(id)) Preview(id); }
    private async Task Unlock(string id) { if (await World.TryUnlockAvatarAsync(id)) { Preview(id); _animation = "celebrate"; _phraseIndex = 4; } }
    private void ShowIdle() => _animation = "idle";
    private void ShowWave() => _animation = "wave";
    private void ShowCelebration() => _animation = "celebrate";
    private void NextPhrase() { _phraseIndex = (_phraseIndex + 1) % PreviewDefinition.Catchphrases.Count; _audioNotice = null; }
    private async Task PlayPhrase()
    {
        try { _audioNotice = await Js.InvokeAsync<bool>("lupAvatars.play", $"{AssetRoot}/audio/{AudioFiles[_phraseIndex]}") ? null : "Lyden kunne ikke afspilles. Prøv igen."; }
        catch (JSException) { _audioNotice = "Lyden kunne ikke afspilles. Teksten er stadig her."; }
    }
    protected override async Task OnInitializedAsync()
    {
        World.Changed += OnChanged;
        await World.EnsureAsync();
        await World.BindAvatarProfileAsync(Auth.Subject);
    }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => World.Changed -= OnChanged;
}
