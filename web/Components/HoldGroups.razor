@using Mercantec.Tech.Web.Notion
@inject NotionClient Client
@inject AuthService Auth
@inject ViewAsStudentContext ViewAs
@implements IDisposable

<section class="hold-groups" aria-label="Holdets elever og grupper">
    <div class="hold-groups-heading">
        <div><h2>Elever og grupper</h2><p>Projektgrupper, makkerpar og nye konstellationer. En elev kan være med i flere grupper.</p></div>
        <button type="button" class="secondary" @onclick="Refresh" disabled="@(_busy || _loading)">Opdatér</button>
    </div>
    @if (_error is not null) { <p class="hold-groups-error" role="alert">@_error</p> }
    @if (_notice is not null) { <p class="hold-groups-notice" role="status">@_notice</p> }
    @if (_loading) { <p role="status">Henter elever og grupper…</p> }
    else
    {
        @if (_canManage)
        {
            <div class="hold-group-modes" aria-label="Vælg gruppemetode">
                <button type="button" class="@(!_roulette ? "action" : "secondary")" aria-pressed="@(!_roulette)" disabled="@_busy" @onclick="() => SetMode(false)">Opret manuelt</button>
                <button type="button" class="@(_roulette ? "action" : "secondary")" aria-pressed="@_roulette" disabled="@_busy" @onclick="() => SetMode(true)">Grupperoulette</button>
            </div>
            @if (_roulette)
            {
                <form class="hold-group-form hold-roulette-form" @onsubmit="Draw" @onsubmit:preventDefault>
                    <div><h3>Find en ny fordeling</h3><p>Se et forslag, bland igen, og gem først når grupperne passer.</p></div>
                    <div class="hold-group-fields">
                        <label class="field">Deltagere<select @bind="_pool" @bind:after="ClearPreview" disabled="@_busy"><option value="all">Alle holdets elever (@_members.Length)</option><option value="selected">Kun valgte elever (@_selected.Count)</option></select></label>
                        <label class="field">Fordel efter<select @bind="_distribution" @bind:after="ClearPreview" disabled="@_busy"><option value="size">Elever pr. gruppe</option><option value="count">Antal grupper</option></select></label>
                        <label class="field">@(_distribution == "size" ? "Højst elever pr. gruppe" : "Antal grupper")<input type="number" min="1" max="250" @bind="_amount" @bind:after="ClearPreview" disabled="@_busy" /></label>
                        <label class="field">Navne starter med<input @bind="_prefix" @bind:after="ClearPreview" maxlength="110" placeholder="Projektgruppe" disabled="@_busy" /></label>
                    </div>
                    <label class="hold-group-check"><input type="checkbox" @bind="_avoidPairs" @bind:after="ClearPreview" disabled="@_busy" /><span>Undgå makkerpar fra gemte grupper</span></label>
                    <div class="actions"><button class="action" disabled="@(_busy || _members.Length == 0 || (_pool == "selected" && _selected.Count == 0))">@(_preview.Length > 0 ? "Bland igen" : "Fordel elever")</button><span class="hold-group-help">Gruppernes størrelse varierer højst med én elev.</span></div>
                </form>
                @if (_preview.Length > 0)
                {
                    <section class="hold-group-preview" aria-label="Forslag til grupper" aria-live="polite">
                        <div class="hold-groups-heading"><div><h3>Forslag: @_preview.Length grupper</h3><p>@_preview.Sum(g => g.Members.Length) elever fordelt. Tilpas gruppenavnene før du gemmer.</p></div><button type="button" class="action" disabled="@_busy" @onclick="SaveBatch">@(_busy ? "Gemmer…" : "Gem alle grupper")</button></div>
                        <div class="hold-group-grid">
                            @foreach (var draft in _preview)
                            {
                                <article class="hold-group-card"><label class="field">Gruppenavn<input @bind="draft.Name" maxlength="120" disabled="@_busy" /></label><ul>@foreach (var member in draft.Members) { <li>@member.DisplayName</li> }</ul></article>
                            }
                        </div>
                        <p class="hold-group-help">De nye grupper tilføjes til holdet. Elevernes øvrige grupper bevares.</p>
                    </section>
                }
            }
            else
            {
                <form class="hold-group-form" @onsubmit="Save" @onsubmit:preventDefault>
                    <div><h3>@(_editing is null ? "Sammensæt en gruppe" : "Redigér gruppe")</h3><p>@_selected.Count elever valgt. Markér elever i listen herunder.</p></div>
                    <label class="field">Gruppenavn<input @bind="_name" maxlength="120" required placeholder="Fx Projektgruppe 1" disabled="@_busy" /></label>
                    <div class="actions"><button class="action" disabled="@(_busy || _selected.Count == 0 || string.IsNullOrWhiteSpace(_name))">@(_busy ? "Gemmer…" : _editing is null ? "Gem gruppe" : "Gem ændringer")</button>@if (_editing is not null || _selected.Count > 0) { <button type="button" class="secondary" @onclick="Reset" disabled="@_busy">Nulstil valg</button> }</div>
                </form>
            }
            <div class="hold-group-roster-tools"><span>@_selected.Count af @_members.Length valgt</span><button type="button" class="secondary" @onclick="SelectAll" disabled="@(_busy || _members.Length == 0)">Vælg alle</button><button type="button" class="secondary" @onclick="ClearSelection" disabled="@(_busy || _selected.Count == 0)">Fravælg alle</button></div>
        }
        <div class="hold-members-scroll"><table class="hold-members-table"><thead><tr>@if (_canManage) { <th scope="col">Vælg</th> }<th scope="col">Elev</th><th scope="col">Grupper</th>@if (_canManage) { <th scope="col"><span class="hold-visually-hidden">Opret gruppe</span></th> }</tr></thead><tbody>
            @foreach (var member in _members)
            {
                <tr>@if (_canManage) { <td><input type="checkbox" aria-label="@($"Vælg {member.DisplayName}")" checked="@_selected.Contains(member.Id)" disabled="@_busy" @onchange="e => SelectMember(member.Id, e)" /></td> }<td><a href="/notion/holds/@HoldId/students/@member.Id">@member.DisplayName</a></td><td>@if (member.GroupIds.Length == 0) { <span class="muted">Ingen gruppe</span> } else { @foreach (var group in _groups.Where(g => member.GroupIds.Contains(g.Id))) { <span class="pill">@group.Name</span> } }</td>@if (_canManage) { <td><button type="button" class="secondary" disabled="@_busy" @onclick="() => StartWith(member.Id)" aria-label="@($"Opret gruppe med {member.DisplayName}")">Ny gruppe</button></td> }</tr>
            }
        </tbody></table></div>
        @if (_members.Length == 0) { <p>Holdet har endnu ingen elever. Tilføj elever på holdet for at oprette grupper.</p> }
        <div class="hold-saved-groups">
            <h3>Gemte grupper <span class="hold-group-count">@_groups.Length</span></h3>
            @if (_groups.Length == 0) { <p>Der er ingen gemte grupper endnu.</p> }
            <div class="hold-group-grid">@foreach (var group in _groups) { <article class="hold-group-card"><div class="hold-groups-heading"><strong>@group.Name</strong>@if (_canManage) { <button type="button" class="secondary" @onclick="() => Edit(group)" disabled="@_busy">Redigér</button> }</div><ul>@foreach (var member in group.Members) { <li>@member.DisplayName</li> }</ul><span class="hold-group-help">@group.Members.Length elever</span></article> }</div>
        </div>
    }
</section>

@code {
    [Parameter] public Guid HoldId { get; set; }
    [Parameter] public Guid[] InitialSelection { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    private readonly CancellationTokenSource _life = new();
    private NotionHoldMember[] _members = [];
    private NotionGroupView[] _groups = [];
    private GroupDraft[] _preview = [];
    private readonly HashSet<Guid> _selected = [];
    private Guid? _editing;
    private (Guid Hold, string? Account, bool Preview, bool Authenticated)? _context;
    private (Guid Hold, string? Account, bool Preview, bool Authenticated) CurrentContext => (HoldId, Auth.Subject, ViewAs.IsActive, Auth.IsAuthenticated);
    private string? _selectionKey, _error, _notice;
    private string _name = "", _prefix = "Projektgruppe", _pool = "all", _distribution = "size";
    private int _version, _amount = 3, _loadVersion;
    private bool _loading, _busy, _canManage, _disposed, _roulette, _avoidPairs;

    protected override void OnInitialized() { Auth.AuthStateChanged += Changed; ViewAs.Changed += Changed; }
    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsInitialized || !Auth.IsAuthenticated) return;
        if (_context != CurrentContext) { Reset(); _members = []; _groups = []; _canManage = false; await Load(); }
        var key = string.Join(",", InitialSelection.Order());
        if (_selectionKey != key) { _selectionKey = key; Reset(); foreach (var id in InitialSelection.Where(id => _members.Any(m => m.Id == id))) _selected.Add(id); }
    }
    private void Changed() => _ = InvokeAsync(async () =>
    {
        // Preserve manual selections and roulette previews during routine token renewal.
        if (_disposed || _context == CurrentContext) return;
        _members = []; _groups = []; _canManage = false; Reset();
        await Load();
        if (!_disposed) StateHasChanged();
    });
    private async Task Refresh() { ClearPreview(); await Load(); }
    private async Task Load()
    {
        _context = CurrentContext;
        var version = ++_loadVersion;
        if (!Auth.IsAuthenticated || HoldId == Guid.Empty || _disposed) { _loading = false; return; }
        _loading = true; _error = null;
        var subject = Auth.Subject; var holdId = HoldId; var preview = ViewAs.IsActive;
        try
        {
            var holds = await Client.Holds(_life.Token);
            var members = await Client.Members(holdId, _life.Token);
            var groups = await Client.Groups(holdId, _life.Token);
            if (subject != Auth.Subject || holdId != HoldId || preview != ViewAs.IsActive || version != _loadVersion || _disposed) return;
            _canManage = !preview && holds.Any(h => h.Id == holdId && h.CanManage);
            _members = members; _groups = groups; _selected.RemoveWhere(id => !members.Any(m => m.Id == id));
        }
        catch (Exception ex) when (ex is NotionException or HttpRequestException or OperationCanceledException) { if (!_disposed && subject == Auth.Subject && holdId == HoldId && preview == ViewAs.IsActive && version == _loadVersion) _error = ex is NotionException ? ex.Message : "Grupperne kunne ikke hentes. Prøv igen."; }
        finally { if (version == _loadVersion) _loading = false; }
    }
    private void ClearPreview() { _preview = []; _notice = null; }
    private void SetMode(bool roulette) { _roulette = roulette; _editing = null; _version = 0; ClearPreview(); }
    private void SelectMember(Guid id, ChangeEventArgs e) { if (e.Value is true) _selected.Add(id); else _selected.Remove(id); ClearPreview(); }
    private void SelectAll() { foreach (var member in _members) _selected.Add(member.Id); ClearPreview(); }
    private void ClearSelection() { _selected.Clear(); ClearPreview(); }
    private void StartWith(Guid id) { Reset(); _roulette = false; _selected.Add(id); }
    private void Reset() { _editing = null; _version = 0; _name = ""; _selected.Clear(); ClearPreview(); }
    private void Edit(NotionGroupView group) { _roulette = false; _editing = group.Id; _version = group.Version; _name = group.Name; _selected.Clear(); foreach (var m in group.Members) _selected.Add(m.Id); ClearPreview(); }
    private void Draw()
    {
        if (_busy || !_canManage) return;
        _error = null; _notice = null;
        try
        {
            var participants = _members.Where(m => _pool == "all" || _selected.Contains(m.Id)).ToArray();
            var groups = GroupRoulette.Draw(participants.Select(m => m.Id).ToArray(), _amount, _distribution == "size",
                _avoidPairs ? _groups.Select(g => g.Members.Select(m => m.Id).ToArray()).ToArray() : null);
            var prefix = string.IsNullOrWhiteSpace(_prefix) ? "Gruppe" : _prefix.Trim();
            _preview = groups.Select((ids, i) => new GroupDraft { Name = $"{prefix} {i + 1}", Members = ids.Select(id => participants.Single(m => m.Id == id)).ToArray() }).ToArray();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { _preview = []; _error = ex.Message; }
    }
    private async Task SaveBatch()
    {
        if (_busy || !_canManage || _preview.Length == 0) return;
        if (_preview.Any(g => string.IsNullOrWhiteSpace(g.Name)) || _preview.Select(g => g.Name.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _preview.Length)
        { _error = "Giv alle grupper et navn. Navnene i forslaget skal være forskellige."; return; }
        _busy = true; _error = null;
        var account = Auth.Subject; var hold = HoldId; var count = _preview.Length;
        try
        {
            await Client.CreateGroupBatch(hold, _preview.Select(g => new SaveNotionGroup(g.Name.Trim(), g.Members.Select(m => m.Id).ToArray())).ToArray(), _life.Token);
            if (account != Auth.Subject || hold != HoldId || _disposed) return;
            ClearPreview(); await Load(); _notice = $"{count} grupper er gemt på holdet.";
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) when (ex is NotionException or HttpRequestException or OperationCanceledException) { if (!_disposed && account == Auth.Subject && hold == HoldId) _error = ex is NotionException ? ex.Message : "Grupperne kunne ikke gemmes. Prøv igen."; }
        finally { _busy = false; }
    }
    private async Task Save()
    {
        if (_busy || !_canManage || _selected.Count == 0 || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true; _error = null;
        var account = Auth.Subject; var hold = HoldId;
        try
        {
            var ids = _selected.Order().ToArray();
            if (_editing is Guid id) await Client.UpdateGroup(hold, id, _name.Trim(), ids, _version, _life.Token);
            else await Client.CreateGroup(hold, _name.Trim(), ids, _life.Token);
            if (account != Auth.Subject || hold != HoldId || _disposed) return;
            Reset(); await Load(); _notice = "Gruppen er gemt på holdet.";
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) when (ex is NotionException or HttpRequestException or OperationCanceledException) { if (!_disposed && account == Auth.Subject && hold == HoldId) _error = ex is NotionException ? ex.Message : "Gruppen kunne ikke gemmes. Prøv igen."; }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; Auth.AuthStateChanged -= Changed; ViewAs.Changed -= Changed; _life.Cancel(); _life.Dispose(); }
    private sealed class GroupDraft { public string Name { get; set; } = ""; public NotionHoldMember[] Members { get; set; } = []; }
}
