@using Mercantec.Tech.Web.Public
@if (PublicCatalog.FindBadge(BadgeId) is { } badge)
{
    <nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/library?category=badges">Bibliotek</a><span>›</span><a href="/badges">Badges og krav</a><span>›</span><span aria-current="page">@badge.Name</span></nav>
    <header class="page-title"><div><h1>@badge.Name</h1><p>@badge.Description</p></div></header>
    <div class="cols"><article class="panel"><h2>@(badge.Special ? "Krav" : "Krav for hvert niveau")</h2>
        @if (badge.Special)
        {
            <p>@badge.Description</p><p>Kriterierne aftales med underviseren.</p>
        }
        else
        {
            @for (var i = 0; i < DemoCatalog.RankNames.Length; i++)
            {
                <section class="v2-rank"><span class="rank-dot">@(i + 1)</span><div><h3>@DemoCatalog.RankNames[i]</h3><p>@DemoCatalog.RankCriteria[i]</p></div></section>
            }
        }
    </article><aside class="panel"><BadgeMark Rank="1" Icon="@badge.Icon" /><h2>@badge.Topic</h2><a href="/subjects">Find fag og emner</a>@if (badge.Id is "hawaii" or "friday") { <p>@(badge.Id == "hawaii" ? "Hawaii-badget giver adgang til at købe Hawaii-skjorten med guld." : "Fancy Friday giver adgang til at købe Fancy Friday-sættet med guld.")</p> }</aside></div>
}
else
{
    <div class="empty"><h1>Badget findes ikke</h1><a href="/badges">Alle badgekrav</a></div>
}
@code { [Parameter] public string? BadgeId { get; set; } }
