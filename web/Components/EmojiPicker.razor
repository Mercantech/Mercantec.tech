@using Mercantec.Tech.Web.Emojis
@inject EmojiClient Emojis
@inject AuthRedirect Redirect
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="emoji-picker">
    <button @ref="_trigger" type="button" class="secondary emoji-picker-toggle" @onclick="Toggle" disabled="@Disabled" aria-expanded="@(_open ? "true" : "false")" aria-haspopup="dialog" aria-controls="@(_open ? _panelId : null)">Emoji</button>
    @if (_open)
    {
        var visible = EmojiPickerCatalog.Filter(_items ?? [], _query, _category);
        var preview = visible.FirstOrDefault(item => item.Id == _previewId) ?? visible.FirstOrDefault();
        <div @ref="_panel" id="@_panelId" class="emoji-picker-panel" role="dialog" aria-label="Vælg emoji" data-upload-draft="@(_uploadFile is not null ? "true" : "false")" data-upload-busy="@(_uploadBusy ? "true" : "false")">
            <div class="emoji-picker-heading">
                <strong>@(_uploadFile is null ? "Vælg emoji" : "Ny emoji")</strong>
                <div class="emoji-picker-heading-actions">
                    @if (Redirect.ShowsTeacherChrome)
                    {
                        <label class="emoji-picker-add" title="Tilføj emoji">
                            <span aria-hidden="true">+</span>
                            <InputFile @key="_fileVersion" class="emoji-picker-file" OnChange="SelectUpload" accept="image/png,image/jpeg,image/gif,image/webp" aria-label="Tilføj emoji" disabled="@_uploadBusy" />
                        </label>
                    }
                    <button type="button" class="emoji-picker-close" aria-label="Luk emoji-vælger" title="Luk (Escape)" disabled="@_uploadBusy" @onclick="() => Dismiss(true)">×</button>
                </div>
            </div>
            @if (_uploadFile is not null)
            {
                <div class="emoji-picker-upload" aria-busy="@(_uploadBusy ? "true" : "false")">
                    <div class="emoji-picker-upload-file">
                        @if (_uploadPreview is not null) { <img src="@_uploadPreview" alt="Forhåndsvisning" /> }
                        <span>@_uploadFile.Name</span>
                    </div>
                    <label class="emoji-picker-upload-label">
                        <span>Emoji-navn</span>
                        <input class="emoji-picker-upload-name" value="@_uploadName" @oninput="EditUploadName" aria-label="Emoji-navn" maxlength="32" autocomplete="off" spellcheck="false" disabled="@_uploadBusy" aria-describedby="@(_panelId + "-upload-hint")" />
                    </label>
                    <p class="emoji-picker-upload-hint" id="@(_panelId + "-upload-hint")">2–32 tegn: bogstaver, tal og _. Bliver til <strong>:@NormalizedUploadName:</strong></p>
                    <label class="emoji-picker-upload-label"><span>ALT-tekst</span><input class="emoji-picker-upload-name" value="@_uploadAltText" @oninput="EditUploadAltText" aria-label="ALT-tekst" maxlength="240" disabled="@_uploadBusy" /></label>
                    <label class="emoji-picker-upload-label"><span>Kategori</span><select class="emoji-picker-upload-name" value="@_uploadCategory" @onchange="EditUploadCategory" aria-label="Kategori" disabled="@_uploadBusy">
                        @foreach (var category in EmojiPickerCatalog.Categories.Where(item => item.Id != "all"))
                        { <option value="@category.Id">@(category.Id == "custom" ? "Andet" : category.Label)</option> }
                    </select></label>
                    <label class="emoji-picker-upload-label"><span>Søgeord</span><input class="emoji-picker-upload-name" value="@_uploadKeywords" @oninput="EditUploadKeywords" aria-label="Søgeord" maxlength="500" placeholder="Adskil med komma" disabled="@_uploadBusy" /></label>
                    <p class="emoji-picker-upload-hint">Højst 12 søgeord på hver højst 32 tegn.</p>
                    @if (_analysisBusy)
                    { <p class="emoji-picker-upload-hint" role="status">Analyserer billedet og foreslår metadata…</p><button type="button" class="emoji-picker-analysis-stop" @onclick="StopAnalysis">Stop analyse</button> }
                    else if (_analysisMessage is not null)
                    { <p class="emoji-picker-upload-hint" role="status">@_analysisMessage</p> }
                    @if (_uploadError is not null) { <p class="emoji-picker-upload-error" role="alert">@_uploadError</p> }
                    <div class="emoji-picker-upload-actions">
                        <button type="button" class="emoji-picker-upload-save" disabled="@(_uploadBusy || _analysisBusy || !_uploadFileValid || !ValidUploadMetadata)" @onclick="SaveUpload">@(_uploadBusy ? "Gemmer…" : "Gem og brug")</button>
                        <button type="button" disabled="@_uploadBusy" @onclick="CancelUploadDraft">Annuller</button>
                    </div>
                    @if (_uploadBusy) { <p class="emoji-picker-upload-hint" role="status">Gemmer emoji…</p> }
                    else { <p class="emoji-picker-upload-hint">PNG, JPEG, GIF eller WebP · højst 256 KB.</p> }
                </div>
            }
            else
            {
            <label class="emoji-picker-search-label">
                <span class="emoji-picker-sr-only">Søg efter emoji</span>
                <input class="emoji-picker-search" type="search" value="@_query" @oninput="Search" placeholder="Søg navn eller fx glad, raket…" autocomplete="off" spellcheck="false" maxlength="100" disabled="@(_items is null)" />
            </label>
            <div class="emoji-picker-categories" role="group" aria-label="Emojikategorier">
                @foreach (var category in EmojiPickerCatalog.Categories)
                {
                    <button type="button" class="emoji-picker-category" aria-pressed="@(_category == category.Id ? "true" : "false")" @onclick="() => SetCategory(category.Id)">@category.Label</button>
                }
            </div>
            <div class="emoji-picker-results">
                @if (_error is not null)
                {
                    <div class="emoji-picker-empty" role="alert"><p>@_error</p><button type="button" @onclick="() => Load(true)">Prøv igen</button></div>
                }
                else if (_items is null)
                {
                    <p class="emoji-picker-empty" role="status">Henter emojis…</p>
                }
                else if (_items.Count == 0)
                {
                    <p class="emoji-picker-empty">Ingen emojis endnu. <a href="/emojis">Åbn biblioteket</a></p>
                }
                else if (visible.Count == 0)
                {
                    <div class="emoji-picker-empty">
                        <p>@(_category == "custom" && string.IsNullOrWhiteSpace(_query) ? "Ingen egne emojis endnu." : "Ingen emojis matcher dine valg.")</p>
                        <button type="button" @onclick="Reset">Vis alle emojis</button>
                    </div>
                }
                else
                {
                    <div class="emoji-picker-grid" role="listbox" aria-label="Emojis">
                        @foreach (var item in visible)
                        {
                            <button @key="item.Id" type="button" class="emoji-picker-option" role="option" aria-selected="false" title="@($":{item.Name}:")" aria-label="@($":{item.Name}:")" @onmouseenter="() => _previewId = item.Id" @onfocus="() => _previewId = item.Id" @onclick="() => Choose(item)">
                                <img src="@item.ContentUrl" alt="" draggable="false" />
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="emoji-picker-footer">
                @if (preview is not null)
                {
                    <span class="emoji-picker-preview"><img src="@preview.ContentUrl" alt="" /><span>:@preview.Name:</span></span>
                }
                else
                {
                    <span class="emoji-picker-preview">Find din næste emoji</span>
                }
                <span class="emoji-picker-count" role="status" aria-live="polite" aria-atomic="true">@visible.Count @(visible.Count == 1 ? "emoji" : "emojis")</span>
            </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<CustomEmojiItem> OnPick { get; set; }
    private readonly string _panelId = "emoji-picker-" + Guid.NewGuid().ToString("N");
    private bool _open, _focusSearch, _disposed, _moduleDisposed;
    private bool _uploadBusy, _uploadFileValid;
    private IBrowserFile? _uploadFile;
    private string _uploadName = "";
    private string _uploadAltText = "", _uploadCategory = "custom", _uploadKeywords = "";
    private bool _analysisBusy;
    private string? _analysisMessage;
    private CancellationTokenSource? _analysisRequest;
    private readonly HashSet<string> _editedMetadata = [];
    private string? _uploadError, _uploadPreview;
    private int _fileVersion, _previewGeneration;
    private string NormalizedUploadName => _uploadName.Trim().Trim(':').ToLowerInvariant();
    private bool ValidUploadMetadata => EmojiUploadDraft.IsValidName(NormalizedUploadName)
        && !string.IsNullOrWhiteSpace(_uploadAltText) && _uploadAltText.Length <= 240
        && EmojiUploadDraft.ParseKeywords(_uploadKeywords) is var words && words.Count <= 12 && words.All(word => word.Length <= 32);
    private string _query = "", _category = "all";
    private string? _error;
    private Guid? _previewId;
    private IReadOnlyList<CustomEmojiItem>? _items;
    private ElementReference _trigger, _panel;
    private IJSObjectReference? _positioner;
    private Task<IJSObjectReference>? _positionerLoad;
    private DotNetObjectReference<EmojiPicker>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !_open) return;
        var positioner = await (_positionerLoad ??= Js.InvokeAsync<IJSObjectReference>("import", "/js/emoji-picker.js?v=4").AsTask());
        if (_disposed)
        {
            await DisposeModule(positioner);
            return;
        }
        _positioner = positioner;
        if (!_open) return;
        _reference ??= DotNetObjectReference.Create(this);
        try
        {
            if (await positioner.InvokeAsync<bool>("mount", _trigger, _panel, _reference, _focusSearch))
                _focusSearch = false;
        }
        catch (JSException) when (_disposed) { }
    }

    private async Task Toggle()
    {
        if (_uploadBusy) return;
        if (_open) { await Close(true); return; }
        if (_disposed || Disabled) return;
        _open = true;
        _focusSearch = true;
        await Load(true);
    }

    private async Task Load(bool refresh = false)
    {
        try
        {
            var items = await Emojis.List(refresh);
            if (_disposed) return;
            _items = items;
            _error = null;
        }
        catch (EmojiException ex)
        {
            if (_disposed) return;
            _error = ex.Message;
            _items = [];
        }
    }

    private void Search(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? "";
        _previewId = null;
    }

    private void SetCategory(string category)
    {
        _category = category;
        _previewId = null;
    }

    private void Reset()
    {
        _query = "";
        _category = "all";
        _previewId = null;
        _focusSearch = true;
    }

    private async Task Choose(CustomEmojiItem item)
    {
        await Close(true);
        await OnPick.InvokeAsync(item);
    }

    [JSInvokable]
    public Task Dismiss(bool restoreFocus) => InvokeAsync(async () =>
    {
        if (_disposed || !_open || _uploadBusy) return;
        if (_uploadFile is not null && restoreFocus)
        {
            CancelUploadDraft();
            StateHasChanged();
            return;
        }
        await Close(restoreFocus);
        StateHasChanged();
    });

    private async Task Close(bool restoreFocus)
    {
        if (_uploadBusy) return;
        _open = false;
        _focusSearch = false;
        ClearUploadDraft();
        await StopPositioning(restoreFocus);
    }

    private async Task SelectUpload(InputFileChangeEventArgs args)
    {
        if (_disposed || _uploadBusy || !Redirect.ShowsTeacherChrome) return;
        CancelAnalysisRequest();
        _editedMetadata.Clear();
        var file = args.File;
        var generation = ++_previewGeneration;
        _uploadFile = file;
        _uploadName = EmojiUploadDraft.SuggestName(file.Name, (_items ?? []).Select(item => item.Name));
        _uploadAltText = _uploadName.Replace('_', ' ');
        _uploadCategory = "custom";
        _uploadKeywords = "";
        _analysisMessage = null;
        _uploadPreview = _uploadError = null;
        _uploadFileValid = false;
        _focusSearch = true;
        if (file.Size == 0) { _uploadError = "Vælg et billede med indhold."; return; }
        if (file.Size > EmojiClient.MaxBytes) { _uploadError = "Billedet må højst være 256 KB."; return; }
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var type = extension switch { ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".gif" => "image/gif", ".webp" => "image/webp", _ => null };
        if (type is null) { _uploadError = "Brug et PNG-, JPEG-, GIF- eller WebP-billede."; return; }
        try
        {
            await using var stream = file.OpenReadStream(EmojiClient.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            if (_disposed || generation != _previewGeneration) return;
            _uploadPreview = $"data:{type};base64,{Convert.ToBase64String(buffer.ToArray())}";
            _uploadFileValid = true;
            await AnalyzeUpload(file, generation);
        }
        catch (Exception error) when (error is IOException or JSException or OperationCanceledException)
        {
            if (!_disposed && generation == _previewGeneration) _uploadError = "Billedet kunne ikke læses. Vælg filen igen.";
        }
    }

    private void EditUploadName(ChangeEventArgs args)
    {
        _uploadName = args.Value?.ToString() ?? "";
        _editedMetadata.Add("name");
        _uploadError = null;
    }

    private void EditUploadAltText(ChangeEventArgs args) => EditMetadata("alt", args);
    private void EditUploadCategory(ChangeEventArgs args) => EditMetadata("category", args);
    private void EditUploadKeywords(ChangeEventArgs args) => EditMetadata("keywords", args);

    private void EditMetadata(string field, ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? "";
        if (field == "alt") _uploadAltText = value;
        else if (field == "category") _uploadCategory = value;
        else if (field == "keywords") _uploadKeywords = value;
        _editedMetadata.Add(field);
        _uploadError = null;
    }

    private async Task AnalyzeUpload(IBrowserFile file, int generation)
    {
        var request = new CancellationTokenSource();
        _analysisRequest = request;
        _analysisBusy = true;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(EmojiClient.MaxBytes, request.Token);
            var analysis = await Emojis.Analyze(stream, file.Name, request.Token);
            if (_disposed || request.IsCancellationRequested || generation != _previewGeneration) return;
            if (!_editedMetadata.Contains("alt")) _uploadAltText = analysis.AltText;
            if (!_editedMetadata.Contains("category")) _uploadCategory = EmojiPickerCatalog.Categories.Any(item => item.Id == analysis.Category && item.Id != "all") ? analysis.Category : "custom";
            if (!_editedMetadata.Contains("keywords")) _uploadKeywords = string.Join(", ", analysis.Keywords ?? []);
            _analysisMessage = "AI har foreslået metadata. Du kan rette alle felterne før gemning.";
        }
        catch (OperationCanceledException) { }
        catch (Exception error) when (error is EmojiException or IOException or JSException)
        {
            if (!_disposed && generation == _previewGeneration && !request.IsCancellationRequested)
                _analysisMessage = error is EmojiException ? error.Message : "Analysen kunne ikke gennemføres. Udfyld felterne manuelt.";
        }
        finally
        {
            if (ReferenceEquals(_analysisRequest, request)) { _analysisRequest = null; _analysisBusy = false; }
            request.Dispose();
        }
    }

    private void CancelAnalysisRequest()
    {
        _analysisRequest?.Cancel();
        _analysisRequest = null;
        _analysisBusy = false;
    }

    private void StopAnalysis()
    {
        CancelAnalysisRequest();
        _analysisMessage = "Analysen er stoppet. Du kan udfylde felterne manuelt.";
    }

    [JSInvokable]
    public async Task SaveUpload()
    {
        if (_disposed || _uploadBusy || _analysisBusy || !Redirect.ShowsTeacherChrome || _uploadFile is null || !_uploadFileValid || !ValidUploadMetadata) return;
        _uploadBusy = true;
        _uploadError = null;
        StateHasChanged();
        try
        {
            await using var stream = _uploadFile.OpenReadStream(EmojiClient.MaxBytes);
            var metadata = new EmojiUploadMetadata(_uploadAltText.Trim(), _uploadCategory, EmojiUploadDraft.ParseKeywords(_uploadKeywords));
            var created = await Emojis.Upload(NormalizedUploadName, stream, _uploadFile.Name, CancellationToken.None, metadata);
            if (_disposed) return;
            _items = (_items ?? []).Where(item => item.Id != created.Id).Append(created).OrderBy(item => item.Name).ToList();
            _uploadBusy = false;
            await Choose(created);
        }
        catch (EmojiException error) { if (!_disposed) _uploadError = error.Message; }
        catch (Exception error) when (error is IOException or JSException or OperationCanceledException) { if (!_disposed) _uploadError = "Billedet kunne ikke læses. Vælg filen igen."; }
        finally { _uploadBusy = false; }
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable]
    public void CancelUploadDraft()
    {
        if (_uploadBusy || _disposed) return;
        ClearUploadDraft();
        _focusSearch = true;
        StateHasChanged();
    }

    private void ClearUploadDraft()
    {
        CancelAnalysisRequest();
        _editedMetadata.Clear();
        _analysisMessage = null;
        _uploadAltText = _uploadKeywords = "";
        _uploadCategory = "custom";
        _previewGeneration++;
        _uploadFile = null;
        _uploadPreview = _uploadError = null;
        _uploadName = "";
        _uploadFileValid = false;
        _fileVersion++;
    }

    private async Task StopPositioning(bool restoreFocus = false)
    {
        if (_positioner is null || _moduleDisposed) return;
        try { await _positioner.InvokeVoidAsync("destroy", _trigger, restoreFocus); }
        catch (Exception error) when (error is JSException or JSDisconnectedException) { }
    }

    private async ValueTask DisposeModule(IJSObjectReference module)
    {
        if (_moduleDisposed) return;
        _moduleDisposed = true;
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelAnalysisRequest();
        _open = false;
        await StopPositioning();
        _reference?.Dispose();
        if (_positioner is not null) await DisposeModule(_positioner);
    }
}
