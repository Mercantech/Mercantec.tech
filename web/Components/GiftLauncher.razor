@inject GiftMailboxClient Mailbox
@inject AuthService Auth
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IAsyncDisposable

<button type="button" disabled="@(ViewAs.IsActive || _busy)" class="christmas-present gift-launcher" data-unread="@(Mailbox.Unread > 0 ? "true" : null)" @onclick="Show" aria-haspopup="dialog" aria-controls="lup-gift-dialog" aria-label="@(Mailbox.Unread > 0 ? $"Gaver, {Mailbox.Unread} uåbnede" : "Send eller åbn en gave")"><UiIcon Name="gift" />@if (Mailbox.Unread > 0) { <span class="gift-count">@Mailbox.Unread</span> }</button>
<dialog id="lup-gift-dialog" class="gift-dialog" aria-labelledby="gift-title" @onkeydown="DialogKey">
    <div class="gift-dialog-head"><div><span class="gift-eyebrow">En lille ting til hinanden</span><h2 id="gift-title">Gaver i LUP</h2></div><button type="button" class="gift-close" @onclick="Close" aria-label="Luk gavevinduet">×</button></div>
    @if (_open)
    {
        @if (_notice is not null) { <p id="gift-feedback" class="gift-feedback" role="status" tabindex="-1"><UiIcon Name="check" />@_notice</p> }
        @if (_error is not null) { <p id="gift-error" class="gift-error" role="alert" tabindex="-1">@_error</p> }
        @if (!Auth.IsAuthenticated)
        {
            @if (_selected is null)
            {
                <div class="gift-welcome"><span class="gift-welcome-art"><UiIcon Name="gift" /></span><h3 id="gift-welcome-title" tabindex="-1">Gør en andens dag lidt varmere</h3><p>Log ind for at vælge en modtager og sende en julehilsen i en pakke.</p><a href="@Auth.LoginPath()" class="gift-primary" @onclick="Close">Log ind</a><button type="button" class="gift-secondary" disabled="@_busy" @onclick="Preview">Se gaveoplevelsen</button></div>
            }
        }
        else if (!ViewAs.IsActive)
        {
            <nav class="gift-tabs" aria-label="Gavevisninger">
                <button type="button" disabled="@_busy" aria-pressed="@(_tab == "inbox" ? "true" : "false")" @onclick='() => SetTab("inbox")'>Modtaget @if (Mailbox.Unread > 0) { <span>@Mailbox.Unread</span> }</button>
                <button type="button" disabled="@_busy" aria-pressed="@(_tab == "send" ? "true" : "false")" @onclick='() => SetTab("send")'>Send en gave</button>
                <button type="button" disabled="@_busy" aria-pressed="@(_tab == "sent" ? "true" : "false")" @onclick='() => SetTab("sent")'>Sendt</button>
            </nav>
            @if (Mailbox.Error is not null)
            {
                <div id="gift-connection" class="gift-connection" role="status" tabindex="-1"><p>@Mailbox.Error</p><button type="button" class="gift-secondary" disabled="@(_loading || _busy)" @onclick="Reload">@(_loading ? "Prøver igen…" : "Prøv igen")</button></div>
            }
            @if (_selected is null)
            {
                @if (_tab == "send")
                {
                    <GiftComposer Recipients="Mailbox.Recipients" @bind-RecipientId="_recipient" @bind-Kind="_kind" @bind-Wrapping="_wrapping" @bind-Message="_message" Busy="_busy" Loading="_loading" HasError="@(Mailbox.Error is not null)" ScopeDescription="@RecipientScope" OnReload="Reload" OnPreview="Preview" OnSend="Send" />
                }
                else
                {
                    var items = _tab == "sent" ? Mailbox.Sent : Mailbox.Received;
                    <h3 id="gift-list-title" class="gift-list-title" tabindex="-1">@(_tab == "sent" ? "Dine sendte gaver" : "Dine modtagne gaver")</h3>
                    @if (_loading) { <p class="gift-list-loading" role="status">Henter dine gaver…</p> }
                    else if (Mailbox.Error is null && items.Count == 0)
                    {
                        <div class="gift-empty"><UiIcon Name="gift" /><h3>@(_tab == "sent" ? "Din første gave starter her" : "Der venter ingen pakker endnu")</h3><p>@(_tab == "sent" ? "En lille hilsen kan gøre en stor forskel." : "Når nogen sender dig en gave, finder du den her.")</p><button type="button" class="gift-secondary" disabled="@_busy" @onclick='() => SetTab("send")'>Send en gave</button></div>
                    }
                    <div class="gift-list">
                        @foreach (var gift in items)
                        {
                            <button type="button" class="gift-list-item" disabled="@_busy" @onclick="() => Select(gift)"><span class="gift-mini @gift.Wrapping"><UiIcon Name="gift" /></span><span><strong>@(_tab == "sent" ? "Til " + gift.RecipientName : "Fra " + gift.SenderName)</strong><small>@(gift.OpenedAtUtc is null ? _tab == "sent" ? "Leveret · ikke åbnet" : "En pakke venter på dig" : "Åbnet " + gift.OpenedAtUtc.Value.ToLocalTime().ToString("d. MMM"))</small></span><span class="gift-item-status" aria-hidden="true">@(gift.OpenedAtUtc is null ? "●" : "✓")</span></button>
                        }
                    </div>
                }
            }
        }
        @if (_selected is not null && !ViewAs.IsActive)
        {
            var opened = _selected.OpenedAtUtc is not null;
            var kind = Kinds.FirstOrDefault(k => k.Id == _selected.Kind, Kinds[0]);
            <GiftReveal Sender="@_selected.SenderName" Recipient="@_selected.RecipientName" Title="@kind.Title" Icon="@kind.Icon" Message="@_selected.Message" Wrapping="@_selected.Wrapping" HeadingId="gift-preview-title" BackLabel="@(_preview && Auth.IsAuthenticated ? "Tilbage til din gave" : _preview ? "Tilbage" : "Tilbage til gaver")" Revealed="@(opened || (!_preview && _tab == "sent"))" Busy="_busy" CanOpen="@(_preview || _tab != "sent")" Preview="_preview" OnOpen="OpenGift" OnBack="BackToList" @key="_selected.Id" />
        }
    }
</dialog>

@code {
    private bool _open, _showDialog, _busy, _loading, _preview;
    private string _tab = "inbox", _kind = "cheer", _wrapping = "berry", _message = "";
    private string? _notice, _error, _user, _focusSelector;
    private Guid? _recipient;
    private Guid _request = Guid.NewGuid();
    private GiftMessage? _selected;
    private CancellationTokenSource? _session;
    private Task? _poll;
    private static readonly (string Id, string Title, string Icon)[] Kinds = [("cheer", "En pose juleglæde", "tree"), ("thanks", "Tak for hjælpen", "heart"), ("warmth", "Lidt ekstra varme", "star")];
    private string RecipientScope => Auth.Roles.Any(role => role.Equals("Admin", StringComparison.OrdinalIgnoreCase) || role.Equals("Underviser", StringComparison.OrdinalIgnoreCase) || role.Equals("Teacher", StringComparison.OrdinalIgnoreCase) || role.Equals("Instructor", StringComparison.OrdinalIgnoreCase))
        ? "Vælg mellem registrerede personer i LUP."
        : "Du kan give til undervisere og personer fra dit hold. Mangler dit hold, skal din konto kobles til det i Lectio.";

    protected override void OnInitialized() { Auth.AuthStateChanged += OnAuth; ViewAs.Changed += OnAuth; Mailbox.Changed += OnChanged; Nav.LocationChanged += OnLocation; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await UpdateSession();
        if (_showDialog) { _showDialog = false; await Js.InvokeVoidAsync("lupGiftUi.open", "lup-gift-dialog"); }
        if (_open && _focusSelector is { } selector)
        {
            _focusSelector = null;
            await Js.InvokeVoidAsync("lupGiftUi.focus", "lup-gift-dialog", selector);
        }
    }
    private void OnAuth() => _ = InvokeAsync(UpdateSession);
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(Close);
    private async Task UpdateSession()
    {
        var next = Auth.IsAuthenticated && !ViewAs.IsActive ? Auth.Subject : null;
        if (next == _user) return;
        _user = next; _selected = null; _open = _showDialog = _preview = false; _notice = _error = _focusSelector = null;
        _recipient = null; _message = ""; _kind = "cheer"; _wrapping = "berry"; _request = Guid.NewGuid();
        await Js.InvokeVoidAsync("lupGiftUi.close", "lup-gift-dialog");
        Mailbox.Clear(); await StopPolling();
        if (next is not null) { _session = new(); _poll = Poll(_session.Token); }
    }
    private async Task Poll(CancellationToken ct)
    {
        try { await Mailbox.RefreshAsync(ct: ct); using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20)); while (await timer.WaitForNextTickAsync(ct)) await Mailbox.RefreshAsync(recipients: _open && _tab == "send", ct: ct); }
        catch (OperationCanceledException) { }
    }
    private async Task StopPolling() { if (_session is null) return; await _session.CancelAsync(); if (_poll is not null) await _poll; _session.Dispose(); _session = null; }
    private async Task Show()
    {
        if (ViewAs.IsActive || _busy) return;
        _request = Guid.NewGuid(); _open = _showDialog = true; _selected = null; _preview = false;
        _tab = Mailbox.Unread > 0 ? "inbox" : "send"; _notice = _error = null;
        _focusSelector = Auth.IsAuthenticated ? _tab == "send" ? "#gift-compose-title" : "#gift-list-title" : "#gift-welcome-title";
        if (Auth.IsAuthenticated) await Reload();
    }
    private async Task Reload()
    {
        if (_busy || _loading || !Auth.IsAuthenticated || ViewAs.IsActive) return;
        _loading = true;
        try
        {
            await Mailbox.RefreshAsync(recipients: true, ct: _session?.Token ?? default);
            if (_recipient is Guid selected && !Mailbox.Recipients.Any(person => person.UserSub == selected)) _recipient = null;
        }
        catch (OperationCanceledException) { }
        finally { _loading = false; }
    }
    private async Task Close() { _open = _showDialog = false; _selected = null; _notice = _error = _focusSelector = null; await Js.InvokeVoidAsync("lupGiftUi.close", "lup-gift-dialog"); }
    private async Task DialogKey(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
    private void SetTab(string tab)
    {
        if (_busy || !Auth.IsAuthenticated || ViewAs.IsActive) return;
        _tab = tab; _selected = null; _preview = false; _notice = _error = null;
        _focusSelector = tab == "send" ? "#gift-compose-title" : "#gift-list-title";
    }
    private void Select(GiftMessage gift)
    {
        if (_busy || !Auth.IsAuthenticated || ViewAs.IsActive) return;
        _selected = gift; _preview = false; _notice = _error = null; _focusSelector = "#gift-preview-title";
    }
    private void BackToList()
    {
        if (_busy || ViewAs.IsActive) return;
        _selected = null; _preview = false;
        _focusSelector = !Auth.IsAuthenticated ? "#gift-welcome-title" : _tab == "send" ? "#gift-compose-title" : "#gift-list-title";
    }
    private void Preview()
    {
        if (_busy || ViewAs.IsActive) return;
        _preview = true; _notice = _error = null;
        _selected = new(Guid.Empty, Auth.DisplayName ?? "En fra dit hold", Mailbox.Recipients.FirstOrDefault(person => person.UserSub == _recipient)?.DisplayName ?? "", _kind, _wrapping, _message, DateTime.UtcNow, null);
        _focusSelector = "#gift-preview-title";
    }
    private async Task Send()
    {
        if (!Auth.IsAuthenticated || ViewAs.IsActive || _busy || _loading || Mailbox.Error is not null || _recipient is not Guid recipient) return;
        var person = Mailbox.Recipients.FirstOrDefault(candidate => candidate.UserSub == recipient);
        if (person is null) return;
        _busy = true; _error = _notice = null;
        var subject = Auth.Subject;
        try
        {
            await Mailbox.SendAsync(new(_request, recipient, _kind, _wrapping, _message), _session?.Token ?? default);
            if (subject != Auth.Subject || ViewAs.IsActive) return;
            _request = Guid.NewGuid(); _message = ""; _selected = null; _preview = false; _tab = "sent";
            if (_open) { _notice = "Din gave er sendt til " + person.DisplayName + "."; _focusSelector = "#gift-feedback"; }
        }
        catch (Exception ex) when (ex is GiftException or HttpRequestException or OperationCanceledException)
        {
            if (subject == Auth.Subject && !ViewAs.IsActive && _open)
            {
                _error = ex is GiftException ? ex.Message : "Gaven kunne ikke sendes. Dine valg er bevaret, så du kan prøve igen.";
                _focusSelector = "#gift-error";
            }
        }
        finally { _busy = false; }
    }
    private async Task OpenGift()
    {
        if (_selected is null || _busy || ViewAs.IsActive || (!_preview && !Auth.IsAuthenticated)) return;
        _busy = true; _error = null;
        var subject = Auth.Subject;
        var selected = _selected;
        try
        {
            var opened = _preview ? selected with { OpenedAtUtc = DateTime.UtcNow } : await Mailbox.OpenAsync(selected.Id, _session?.Token ?? default);
            if (subject == Auth.Subject && !ViewAs.IsActive && _open && _selected?.Id == selected.Id) _selected = opened;
        }
        catch (Exception ex) when (ex is GiftException or HttpRequestException or OperationCanceledException)
        {
            if (subject == Auth.Subject && !ViewAs.IsActive && _open) { _error = "Pakken kunne ikke åbnes lige nu. Prøv igen."; _focusSelector = "#gift-error"; }
        }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync() { Auth.AuthStateChanged -= OnAuth; ViewAs.Changed -= OnAuth; Mailbox.Changed -= OnChanged; Nav.LocationChanged -= OnLocation; await StopPolling(); }
}
