@using Mercantec.Tech.Web.Demo
@inject DemoWorld World
@implements IDisposable

@if (!World.Ready)
{
    <p>Indlæser…</p>
}
else
{
    var robot = AvatarCatalog.Find(AvatarCatalog.Bip01Id)!;
    <section class="panel" style="margin-bottom:18px">
        <div class="row">
            <span class="mark" aria-hidden="true"><UiIcon Name="chip" /></span>
            <div>
                <h2>@robot.Name <span class="pill">@(World.OwnsAvatar(robot.Id) ? "I din samling" : "Avatar")</span></h2>
                <p>@robot.Description</p>
                <p class="tiny muted">Level @robot.Level · @robot.Cost guld · @World.AvatarRequirementText(robot.Id)</p>
            </div>
            <a class="secondary" href="/profile/character">Se avatarsamlingen</a>
        </div>
    </section>
    <div class="v4-shop-summary">
        <div>
            <strong>Level @World.CurrentLevel</strong>
            <p>160 XP til næste level · @World.Gold guld</p>
        </div>
        <a class="secondary" href="/universe/shop">Til butikken</a>
    </div>
    <div class="v4-roadmap">
        @foreach (var level in Upcoming)
        {
            <section class="v4-level-node @(level == Next ? "next" : null)">
                <h2>Level @level <span class="pill">@(level == Next ? "Næste oplåsning" : "Låst")</span></h2>
                @foreach (var item in FurnitureGoods.Where(g => g.Level == level))
                {
                    <UnlockRow Item="item" />
                }
            </section>
        }
    </div>
    <details class="v4-past-levels">
        <summary>Se allerede nåede levels</summary>
        <div class="v4-roadmap">
            @foreach (var level in Reached)
            {
                <section class="v4-level-node reached">
                    <h2>Level @level <span class="pill green">✓ Level nået</span></h2>
                    @foreach (var item in FurnitureGoods.Where(g => g.Level == level))
                    {
                        <UnlockRow Item="item" />
                    }
                </section>
            }
        </div>
    </details>
    <div class="v4-section"><h2>Badges åbner særlige møbler</h2><p>Level og badge skal begge være på plads, hvis møblet har begge krav.</p></div>
    <section class="panel">
        @foreach (var item in FurnitureGoods.Where(g => g.Badge is not null))
        {
            <UnlockRow Item="item" />
        }
        <div class="v4-unlock-row">
            <div class="v4-product-art"><span class="v2-furniture board" aria-hidden="true"></span></div>
            <div><strong>@DemoWorld.Gift.Name</strong><small>Gave · level @DemoWorld.Gift.Level · står ikke i butikken</small></div>
            <a href="/apartment">Stil den op</a>
        </div>
    </section>
}

@code {
    private static IEnumerable<DemoGoods> FurnitureGoods => DemoWorld.Goods.Where(g => g.Kind == "Møbler");
    private IEnumerable<int> Levels => FurnitureGoods.Select(g => g.Level).Distinct().Order();
    private int? Next => Levels.Cast<int?>().FirstOrDefault(level => level > World.CurrentLevel);
    private IEnumerable<int> Upcoming => Levels.Where(level => level > World.CurrentLevel);
    private IEnumerable<int> Reached => Levels.Where(level => level <= World.CurrentLevel);

    protected override async Task OnInitializedAsync()
    {
        World.Changed += OnChanged;
        await World.EnsureAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => World.Changed -= OnChanged;
}
