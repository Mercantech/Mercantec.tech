<div class="v2-sprite @Style wear-@Wear @(Mini ? "mini" : "")" style="--skin:@Skin;--hair:@Hair;--outfit:@Color" aria-hidden="true"><span class="hair"></span><span class="face"></span><span class="arms"></span><span class="torso"></span><span class="legs"></span></div>
@code {
    [Parameter] public bool Mini { get; set; }
    [Parameter] public string Skin { get; set; } = "#c98d69";
    [Parameter] public string Hair { get; set; } = "#42302a";
    [Parameter] public string Color { get; set; } = "#2452e8";
    [Parameter] public string Style { get; set; } = "short";
    [Parameter] public string Wear { get; set; } = "basic";
}
