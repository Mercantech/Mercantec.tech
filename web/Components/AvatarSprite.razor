@using Mercantec.Tech.Web.Demo
@inject DemoWorld World
@implements IDisposable

@if (CurrentId == AvatarCatalog.Bip01Id)
{
    <span class="avatar-robot @(Mini ? "mini" : null)" data-avatar="bip01" data-animation="@SafeAnimation" style="@RobotStyle" aria-hidden="true"></span>
}
else
{
    <span class="avatar-legacy-host @(Mini ? "mini" : null)" style="@($"--avatar-size:{Size}px")" aria-hidden="true">
        <span class="v2-sprite @World.HairStyle wear-@World.Equipped.Style @(Mini ? "mini" : null)" style="@LegacyStyle">
            <span class="hair"></span><span class="face"></span><span class="arms"></span><span class="torso"></span><span class="legs"></span>
        </span>
    </span>
}

@code {
    [Parameter] public bool Mini { get; set; }
    [Parameter] public int Size { get; set; } = 136;
    [Parameter] public string? AvatarId { get; set; }
    [Parameter] public string Animation { get; set; } = "idle";
    private static readonly HashSet<string> Animations = ["idle", "blink", "wave", "think", "talk", "point", "celebrate", "encourage", "surprised", "unlock", "walk", "run", "jump", "land", "sit", "sleep", "pickup", "interact", "hit", "knockout", "respawn", "ability_1_pulse", "ability_2_magnet", "ability_3_shield", "ability_4_dash", "ability_5_repair", "ultimate_charge", "ultimate_release"];
    private string CurrentId => AvatarId ?? (World.AvatarProfileReady ? World.SelectedAvatarId : AvatarCatalog.StarterId);
    private string SafeAnimation => Animations.Contains(Animation) ? Animation : "idle";
    private string Duration => SafeAnimation.StartsWith("ability_", StringComparison.Ordinal) ? "1s" : SafeAnimation switch { "sleep" => "1.333s", "think" or "idle" => "1s", "run" => ".667s", "ultimate_charge" or "ultimate_release" => "1.6s", _ => ".8s" };
    private string RobotStyle => $"--avatar-size:{Math.Clamp(Size, 24, 512)}px;--avatar-cycle:{Duration};background-image:url('/assets/avatars/bip-01/sprites/{SafeAnimation}.png')";
    private string LegacyStyle => $"--skin:{World.Skin};--outfit:{World.OutfitColor};--hair:{World.Hair}" + (Mini ? "" : $";transform:scale({(Size / 136d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})");

    protected override void OnInitialized() => World.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => World.Changed -= OnChanged;
}
