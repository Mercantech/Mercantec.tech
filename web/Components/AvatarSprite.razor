@using Mercantec.Tech.Web.Demo
@inject DemoWorld World
@implements IDisposable

@if (CurrentDefinition.SpriteAssetRoot is not null)
{
    <span @key="AnimationIdentity" class="avatar-sheet avatar-grid-4x2 @(Mini ? "mini" : null)" data-avatar="@CurrentDefinition.Id" data-animation="@SafeAnimation" data-frames="8" data-fps="@CurrentAction?.Fps" data-loop="@DemoWorld.Pressed(CurrentAction?.Loop == true)" style="@SpriteStyle" aria-hidden="true"></span>
}
else
{
    <span class="avatar-legacy-host @(Mini ? "mini" : null)" style="@($"--avatar-size:{Size}px")" aria-hidden="true">
        <span class="v2-sprite @World.HairStyle wear-@World.Equipped.Style @(Mini ? "mini" : null)" style="@LegacyStyle">
            <span class="hair"></span><span class="face"></span><span class="arms"></span><span class="torso"></span><span class="legs"></span>
        </span>
    </span>
}

@code {
    [Parameter] public bool Mini { get; set; }
    [Parameter] public int Size { get; set; } = 136;
    [Parameter] public string? AvatarId { get; set; }
    [Parameter] public string Animation { get; set; } = "idle";
    [Parameter] public int ReplayKey { get; set; }
    [Parameter] public bool Paused { get; set; }
    private AvatarDefinition CurrentDefinition => AvatarCatalog.Find(AvatarId ?? (World.AvatarProfileReady ? World.SelectedAvatarId : AvatarCatalog.StarterId)) ?? AvatarCatalog.All[0];
    private string SafeAnimation => CurrentDefinition.Animations.Contains(Animation) ? Animation : "idle";
    private AvatarAction? CurrentAction => CurrentDefinition.Actions.FirstOrDefault(action => action.Id == SafeAnimation);
    private string AnimationIdentity => $"{CurrentDefinition.Id}:{SafeAnimation}:{ReplayKey}";
    private string Duration => (CurrentAction?.DurationSeconds ?? 1).ToString("0.######", System.Globalization.CultureInfo.InvariantCulture) + "s";
    private string SpriteStyle => $"--avatar-size:{Math.Clamp(Size, 24, 512)}px;--avatar-cycle:{Duration};--avatar-repeats:{(CurrentAction?.Loop == true ? "infinite" : "1")};animation-play-state:{(Paused ? "paused" : "running")};background-image:url('{CurrentDefinition.SpriteAssetRoot}/sprites/{SafeAnimation}.png')";
    private string LegacyStyle => $"--skin:{World.Skin};--outfit:{World.OutfitColor};--hair:{World.Hair}" + (Mini ? "" : $";transform:scale({(Size / 136d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})");

    protected override void OnInitialized() => World.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => World.Changed -= OnChanged;
}
