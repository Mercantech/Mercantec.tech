@using Mercantec.Tech.Web.Emojis
@inject EmojiClient Emojis

<span class="emoji-text">@foreach (var part in _parts)
{
    if (part.Emoji is null)
    {
        @part.Text
    }
    else
    {
        <img class="custom-emoji" src="@part.Emoji.ContentUrl" loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(part.Emoji.AltText) ? $":{part.Emoji.Name}:" : part.Emoji.AltText)" title="@($":{part.Emoji.Name}:")" @onerror="Reload" />
    }
}</span>

@code {
    [Parameter] public string? Text { get; set; }
    private IReadOnlyList<EmojiTextPart> _parts = [];
    private string? _loadedFor;
    private bool _loaded;
    private bool _retried;
    private int _loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedFor == Text) return;
        _retried = false;
        await Load();
    }

    private async Task Reload()
    {
        if (_retried) return;
        _retried = true;
        Emojis.Invalidate();
        await Load();
    }

    private async Task Load()
    {
        var text = Text;
        var version = ++_loadVersion;
        _loaded = false;
        IReadOnlyList<EmojiTextPart> parts = [new(text ?? "", null)];
        _parts = parts;
        try
        {
            if (text?.Contains(':') == true) parts = EmojiTextParts.Split(text, await Emojis.List());
        }
        catch (EmojiException)
        {
            // Keep the original title readable if the catalog cannot be loaded.
        }
        if (version != _loadVersion || text != Text) return;
        _parts = parts;
        _loadedFor = text;
        _loaded = true;
    }
}
