@using Mercantec.Tech.Web.Emojis
@inject EmojiClient Emojis

<span class="emoji-text">@foreach (var part in _parts)
{
    if (part.Emoji is null)
    {
        @part.Text
    }
    else
    {
        <img class="custom-emoji" src="@part.Emoji.ContentUrl" loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(part.Emoji.AltText) ? $":{part.Emoji.Name}:" : part.Emoji.AltText)" title="@($":{part.Emoji.Name}:")" @onerror="Reload" />
    }
}</span>

@code {
    [Parameter] public string? Text { get; set; }
    private IReadOnlyList<EmojiTextPart> _parts = [];
    private string? _loadedFor;
    private bool _loaded;
    private bool _retried;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedFor == Text) return;
        _retried = false;
        await Load();
    }

    private async Task Reload()
    {
        if (_retried) return;
        _retried = true;
        Emojis.Invalidate();
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _parts = Text?.Contains(':') == true ? EmojiTextParts.Split(Text, await Emojis.List()) : [new(Text ?? "", null)];
        }
        catch (EmojiException)
        {
            _parts = [new(Text ?? "", null)];
        }
        _loadedFor = Text;
        _loaded = true;
    }
}
