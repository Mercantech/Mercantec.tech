<div class="quest-list">@foreach (var quest in DemoCatalog.Quests.Where(q => (CourseId is null || q.Course == CourseId) && (Filter == "Alle" || q.Type == Filter))) { <article class="v3-task"><span class="quest-type-mark @quest.Type.ToLowerInvariant()"><UiIcon Name="@(quest.Type == "Main" ? "target" : quest.Type == "Daily" ? "loop" : "star")" /></span><div><h3><a href="/quests/@quest.Id">@quest.Name</a></h3><p>@quest.Desc</p><div class="v3-quest-group"><span class="pill">@quest.Type</span><span class="tiny muted">@(quest.Course == "h3" ? "H3" : "Game Design")</span></div></div><a class="secondary" href="/quests/@quest.Id">Åbn quest</a></article> }</div>
@code { [Parameter] public string Filter { get; set; } = "Alle"; [Parameter] public string? CourseId { get; set; } }
