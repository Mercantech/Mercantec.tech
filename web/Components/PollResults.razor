@inject DemoWorld World
<div class="v4-results">
    @for (var i = 0; i < Poll.Options.Length; i++)
    {
        var count = Poll.Counts[i] + (World.VoteOf(Poll.Question) == i ? 1 : 0);
        var total = Math.Max(1, Poll.Counts.Sum() + (World.VoteOf(Poll.Question) is null ? 0 : 1));
        <div class="v4-result-row">
            <span>@Poll.Options[i]</span>
            <div class="v4-result-track" aria-hidden="true"><span style="@($"width:{count * 100 / total}%")"></span></div>
            <strong>@count</strong>
        </div>
    }
</div>
@code { [Parameter, EditorRequired] public DemoCatalog.Poll Poll { get; set; } = default!; }
