@page "/lectio"
@using System.Text.Json
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Lectio</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="/login">Log ind</a></p>
}
else
{
    var isTeacher = Redirect.CurrentAppRole() == AppRole.Underviser;

    <h1>Lectio</h1>
    <p class="text-muted mb-2">
        Data fra Lectio-Collector.
        @(isTeacher ? "Som underviser kan du se alle elever." : "Som elev ser du kun dig selv (efter kobling).")
    </p>
    <p class="mb-3">
        App-rolle: <strong>@(isTeacher ? "underviser" : "elev")</strong>
        @if (Auth.Roles.Count > 0)
        {
            <span class="text-muted"> · Auth: @string.Join(", ", Auth.Roles)</span>
        }
    </p>

    @if (isTeacher)
    {
        <div class="mb-4 d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="https://lc.mags.dk/programmeringselever" target="_blank" rel="noopener">
                Åbn fuld Lectio-Collector
            </a>
            <button class="btn btn-outline-secondary" disabled="@_loading" @onclick="LoadAsync">
                @(_loading ? "Henter…" : "Genindlæs liste")
            </button>
        </div>
        <p class="text-muted small">
            Collector har studieplaner, hold, sync og cookies. Listen herunder er et uddrag via Mercantec.tech.
            Elever kobler selv via navnematch; underviser kan stadig koble manuelt i Collector.
        </p>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_loading)
    {
        <p>Henter Lectio-data…</p>
    }
    else if (isTeacher)
    {
        <section class="mb-4">
            <h2 class="h5">Programmeringselever (@_students.Count)</h2>
            @if (_students.Count == 0 && _error is null)
            {
                <p class="text-muted">Ingen elever returneret. Tjek at Collector er synkroniseret, eller åbn Collector direkte.</p>
            }
            else if (_students.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Navn</th>
                                <th>Lectio-id</th>
                                <th>Klasse</th>
                                <th>XPRS</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _students)
                            {
                                <tr>
                                    <td>@s.Name</td>
                                    <td><code>@s.LectioId</code></td>
                                    <td>@(s.ClassName ?? "—")</td>
                                    <td>@(s.Xprs ?? "—")</td>
                                    <td>
                                        <a href="@($"https://lc.mags.dk/elev/{s.LectioId}")" target="_blank" rel="noopener">Åbn</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (_linked)
    {
        <section class="mb-4">
            <h2 class="h5">Mine data</h2>
            @if (_linkOk)
            {
                <p class="text-success">Kobling gemt.</p>
            }
            @if (_meStudent is not null)
            {
                <pre class="bg-light border rounded p-3 small">@_meStudent</pre>
            }
            else if (_meJson is not null)
            {
                <pre class="bg-light border rounded p-3 small">@_meJson</pre>
            }
        </section>
    }
    else
    {
        <section class="mb-4">
            <h2 class="h5">Kobl din Lectio-profil</h2>
            <p class="text-muted">
                Vi foreslår kun profiler der matcher dit Auth-navn
                @if (!string.IsNullOrWhiteSpace(_authName))
                {
                    <text>(<strong>@_authName</strong>)</text>
                }
                — du kan ikke se andre elevers data.
            </p>

            @if (_candidates.Count == 1)
            {
                var c = _candidates[0];
                <div class="border rounded p-3 mb-3" style="max-width: 32rem;">
                    <p class="mb-2">Er du <strong>@c.Name</strong>?</p>
                    <p class="small text-muted mb-3">
                        @(c.ClassName ?? "Ukendt klasse")
                        @if (!string.IsNullOrWhiteSpace(c.Xprs))
                        {
                            <text> · @c.Xprs</text>
                        }
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" disabled="@_busy" @onclick="() => LinkCandidateAsync(c.LectioId)">
                            @(_busy ? "Kobler…" : "Ja — kobl mig")
                        </button>
                        <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="DismissCandidates">
                            Nej
                        </button>
                    </div>
                </div>
            }
            else if (_candidates.Count > 1)
            {
                <p>Vælg dig selv blandt forslagene:</p>
                <div class="list-group mb-3" style="max-width: 32rem;">
                    @foreach (var c in _candidates)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(_selectedLectioId == c.LectioId ? "active" : null)"
                                disabled="@_busy"
                                @onclick="() => _selectedLectioId = c.LectioId">
                            <strong>@c.Name</strong>
                            <span class="d-block small @( _selectedLectioId == c.LectioId ? "" : "text-muted")">
                                @(c.ClassName ?? "Ukendt klasse")
                                @if (!string.IsNullOrWhiteSpace(c.Xprs))
                                {
                                    <text> · @c.Xprs</text>
                                }
                            </span>
                        </button>
                    }
                </div>
                <button class="btn btn-primary"
                        disabled="@(_busy || string.IsNullOrEmpty(_selectedLectioId))"
                        @onclick="() => LinkCandidateAsync(_selectedLectioId!)">
                    @(_busy ? "Kobler…" : "Bekræft kobling")
                </button>
            }
            else if (_dismissed || _candidates.Count == 0)
            {
                <div class="alert alert-warning" style="max-width: 36rem;">
                    <p class="mb-2">Ingen automatisk match på dit Auth-navn.</p>
                    <p class="mb-0 small">
                        Bed en underviser om at koble dig i Lectio-Collector
                        (<a href="https://lc.mags.dk" target="_blank" rel="noopener">lc.mags.dk</a>).
                        Af sikkerhedshensyn kan du ikke indtaste et vilkårligt Lectio-id her.
                    </p>
                </div>
            }
        </section>
    }

    <p><a href="@Redirect.PostLoginPath()">Tilbage til dashboard</a></p>
}

@code {
    private string? _error;
    private string? _meJson;
    private string? _meStudent;
    private string? _authName;
    private string? _selectedLectioId;
    private bool _busy;
    private bool _linkOk;
    private bool _loading;
    private bool _linked;
    private bool _dismissed;
    private readonly List<StudentRow> _students = [];
    private readonly List<CandidateRow> _candidates = [];

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _loading = true;
        _error = null;
        _students.Clear();
        _candidates.Clear();
        _linked = false;
        _meStudent = null;
        StateHasChanged();

        try
        {
            var meRes = await Http.GetAsync("lectio/me");
            var meBody = await meRes.Content.ReadAsStringAsync();
            if (!meRes.IsSuccessStatusCode)
            {
                _error = $"Kunne ikke hente /lectio/me ({(int)meRes.StatusCode}): {Trim(meBody)}";
                return;
            }

            _meJson = Pretty(meBody);
            _linked = HasLectioLink(meBody);

            if (Redirect.CurrentAppRole() == AppRole.Elev)
            {
                if (_linked)
                {
                    var studentRes = await Http.GetAsync("lectio/me/student");
                    var studentBody = await studentRes.Content.ReadAsStringAsync();
                    if (studentRes.IsSuccessStatusCode)
                        _meStudent = Pretty(studentBody);
                    else if ((int)studentRes.StatusCode != 403)
                        _error = $"Mine data ({(int)studentRes.StatusCode}): {Trim(studentBody)}";
                }
                else if (!_dismissed)
                {
                    await LoadCandidatesAsync();
                }
            }
            else
            {
                var listRes = await Http.GetAsync("lectio/programmeringselever");
                var listBody = await listRes.Content.ReadAsStringAsync();
                if (!listRes.IsSuccessStatusCode)
                {
                    _error = $"Programmeringselever ({(int)listRes.StatusCode}): {Trim(listBody)}. " +
                             "Åbn Collector direkte, eller tjek at din Auth-rolle er Underviser/Admin.";
                    return;
                }

                ParseStudents(listBody);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCandidatesAsync()
    {
        var res = await Http.GetAsync("lectio/me/lectio-candidates");
        var body = await res.Content.ReadAsStringAsync();
        if (!res.IsSuccessStatusCode)
        {
            _error = $"Kandidater ({(int)res.StatusCode}): {Trim(body)}";
            return;
        }

        using var doc = JsonDocument.Parse(body);
        var root = doc.RootElement;
        _authName = GetString(root, "authName");
        if (!root.TryGetProperty("candidates", out var arr) || arr.ValueKind != JsonValueKind.Array)
            return;

        foreach (var item in arr.EnumerateArray())
        {
            _candidates.Add(new CandidateRow(
                LectioId: GetString(item, "lectioId") ?? "",
                Name: GetString(item, "name") ?? "—",
                ClassName: GetString(item, "className"),
                Xprs: GetString(item, "xprs")
            ));
        }

        if (_candidates.Count == 1)
            _selectedLectioId = _candidates[0].LectioId;
    }

    private void ParseStudents(string json)
    {
        using var doc = JsonDocument.Parse(json);
        if (!doc.RootElement.TryGetProperty("students", out var arr) || arr.ValueKind != JsonValueKind.Array)
            return;

        foreach (var item in arr.EnumerateArray())
        {
            _students.Add(new StudentRow(
                LectioId: GetString(item, "lectioId") ?? "",
                Name: GetString(item, "name") ?? "—",
                ClassName: GetString(item, "className"),
                Xprs: GetString(item, "xprsElevType")
            ));
        }
    }

    private async Task LinkCandidateAsync(string lectioId)
    {
        if (string.IsNullOrWhiteSpace(lectioId)) return;
        _busy = true;
        _linkOk = false;
        _error = null;
        try
        {
            var res = await Http.PutAsJsonAsync("lectio/me/lectio-link", new { lectioId = lectioId.Trim() });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _error = Trim(body);
                return;
            }

            _linkOk = true;
            _dismissed = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void DismissCandidates()
    {
        _dismissed = true;
        _candidates.Clear();
        _selectedLectioId = null;
    }

    private static bool HasLectioLink(string meJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(meJson);
            if (!doc.RootElement.TryGetProperty("lectio", out var lectio))
                return false;
            if (lectio.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
                return false;
            return lectio.TryGetProperty("lectioId", out var id)
                   && id.ValueKind == JsonValueKind.String
                   && !string.IsNullOrWhiteSpace(id.GetString());
        }
        catch
        {
            return false;
        }
    }

    private static string? GetString(JsonElement el, string name) =>
        el.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String ? p.GetString() : null;

    private static string Pretty(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string Trim(string s) =>
        s.Length <= 400 ? s : s[..400] + "…";

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

    private sealed record StudentRow(string LectioId, string Name, string? ClassName, string? Xprs);
    private sealed record CandidateRow(string LectioId, string Name, string? ClassName, string? Xprs);
}
