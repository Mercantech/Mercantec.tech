    private void ToggleSelectAllFiltered(ChangeEventArgs _)
    {
        var keys = VisibleHolds.Select(h => h.LectioHoldKey).Where(k => !string.IsNullOrWhiteSpace(k)).ToList();
        if (keys.Count == 0) return;
        if (keys.All(k => _selectedHoldKeys.Contains(k)))
        {
            foreach (var k in keys)
                _selectedHoldKeys.Remove(k);
