@page "/lectio"
@using System.Net.Http.Json
@using System.Text.Json
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Lectio</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="/login">Log ind</a></p>
}
else
{
    var isTeacher = Redirect.CurrentAppRole() == AppRole.Underviser;

    <h1>Lectio</h1>
    <p class="text-muted mb-2">
        Data fra Lectio-Collector.
        @(isTeacher ? "Som underviser kan du se alle elever." : "Som elev ser du kun dig selv (efter kobling).")
    </p>
    <p class="mb-3">
        App-rolle: <strong>@(isTeacher ? "underviser" : "elev")</strong>
        @if (Auth.Roles.Count > 0)
        {
            <span class="text-muted"> · Auth: @string.Join(", ", Auth.Roles)</span>
        }
    </p>

    @if (isTeacher)
    {
        <div class="mb-3 d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="@(_teacherTab == TeacherTab.Hold ? "https://lc.mags.dk/hold" : "https://lc.mags.dk/programmeringselever")" target="_blank" rel="noopener">
                Åbn i Lectio-Collector
            </a>
            <button class="btn btn-outline-secondary" disabled="@_loading" @onclick="LoadAsync">
                @(_loading ? "Henter…" : "Genindlæs")
            </button>
        </div>
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(_teacherTab == TeacherTab.Elever ? "active" : null)"
                        @onclick="() => _teacherTab = TeacherTab.Elever">
                    Programmeringselever
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_teacherTab == TeacherTab.Hold ? "active" : null)"
                        @onclick="() => SwitchToHoldTabAsync()">
                    Hold
                </button>
            </li>
        </ul>
        <p class="text-muted small">
            Data spejles fra lc.mags.dk. Elever kobler selv via navnematch; hold er de samme som i Collector.
        </p>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_loading)
    {
        <p>Henter Lectio-data…</p>
    }
    else if (isTeacher && _teacherTab == TeacherTab.Hold)
    {
        <section class="mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <h2 class="h5 mb-0">
                    Hold (@FilteredHolds.Count())
                    @if (_holdSummary is not null)
                    {
                        <span class="text-muted fw-normal small">
                            · @_holdSummary.HoldCount i Collector
                            · @_holdSummary.UniqueStudents unikke elever
                        </span>
                    }
                </h2>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(_holdScope == HoldScope.Tracked ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetHoldScopeAsync(HoldScope.Tracked)">
                        Tracked
                    </button>
                    <button type="button" class="btn @(_holdScope == HoldScope.Saved ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetHoldScopeAsync(HoldScope.Saved)">
                        Alle gemte
                    </button>
                </div>
            </div>
            <div class="mb-2" style="max-width: 20rem;">
                <input class="form-control form-control-sm" @bind="_holdFilter" @bind:event="oninput"
                       placeholder="Filtrér hold, år, fag…" />
            </div>
            @if (_holds.Count == 0 && _error is null)
            {
                <p class="text-muted">Ingen hold returneret. Track hold i Collector først.</p>
            }
            else if (_holds.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Hold</th>
                                <th>År</th>
                                <th>Elever</th>
                                <th>Periode</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in FilteredHolds)
                            {
                                <tr>
                                    <td>
                                        <div>@h.Name</div>
                                        <code class="small text-muted">@h.LectioHoldKey</code>
                                        @if (!string.IsNullOrWhiteSpace(h.FagId))
                                        {
                                            <div class="small text-muted">Fag @h.FagId</div>
                                        }
                                    </td>
                                    <td>@(h.YearLabel ?? h.Year ?? "—")</td>
                                    <td>@h.MemberCount</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(h.StartLabel) || !string.IsNullOrWhiteSpace(h.EndLabel))
                                        {
                                            <span>@(h.StartLabel ?? "?") – @(h.EndLabel ?? "?")</span>
                                            @if (!string.IsNullOrWhiteSpace(h.DateSource))
                                            {
                                                <div class="small text-muted">@h.DateSource</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (h.IsTracked)
                                        {
                                            <span class="badge text-bg-success">Tracked</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Gemt</span>
                                        }
                                    </td>
                                    <td class="text-nowrap">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                disabled="@(_creatingHoldKey == h.LectioHoldKey)"
                                                @onclick="() => CreateForloebFromHoldAsync(h)">
                                            @(_creatingHoldKey == h.LectioHoldKey ? "Opretter…" : "Opret forløb")
                                        </button>
                                        <a href="@($"https://lc.mags.dk/hold/{Uri.EscapeDataString(h.LectioHoldKey)}")" target="_blank" rel="noopener">Åbn</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(_holdFilter) && !FilteredHolds.Any())
                {
                    <p class="text-muted small">Ingen hold matcher filteret.</p>
                }
                @if (_importResult is not null)
                {
                    <div class="alert alert-success mt-3">
                        Forløb oprettet: <a href="@($"/forloeb/{_importResult.ForloebId}")">@_importResult.Name</a>
                        — @_importResult.Total medlemmer (@_importResult.Claimed claimed, @_importResult.Shadows shadow).
                    </div>
                }
            }
        </section>
    }
    else if (isTeacher)
    {
        <section class="mb-4">
            <h2 class="h5">Programmeringselever (@_students.Count)</h2>
            @if (_students.Count == 0 && _error is null)
            {
                <p class="text-muted">Ingen elever returneret. Tjek at Collector er synkroniseret, eller åbn Collector direkte.</p>
            }
            else if (_students.Count > 0)
            {
                <div class="mb-2" style="max-width: 20rem;">
                    <input class="form-control form-control-sm" @bind="_teacherFilter" @bind:event="oninput"
                           placeholder="Filtrér på navn, klasse, læreplads…" />
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Navn</th>
                                <th>Klasse</th>
                                <th>XPRS</th>
                                <th>Læreplads</th>
                                <th>Forløb</th>
                                <th>VUF</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in FilteredStudents)
                            {
                                var expanded = _expandedId == s.LectioId;
                                <tr>
                                    <td>
                                        <button type="button"
                                                class="btn btn-link btn-sm p-0 text-decoration-none me-1"
                                                title="@(expanded ? "Skjul forløb" : "Vis alle forløb")"
                                                disabled="@(_loadingPlanId == s.LectioId)"
                                                @onclick="() => ToggleForloebAsync(s.LectioId)">
                                            @(expanded ? "▼" : "▶")
                                        </button>
                                        <div class="d-inline-block align-middle">
                                            <div>@s.Name</div>
                                            <code class="small text-muted">@s.LectioId</code>
                                        </div>
                                    </td>
                                    <td>@(s.ClassName ?? "—")</td>
                                    <td>
                                        @(s.Xprs ?? "—")
                                        @if (!string.IsNullOrWhiteSpace(s.AgreementType))
                                        {
                                            <div class="small text-muted">@s.AgreementType</div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.WorkplaceName))
                                        {
                                            <div>@s.WorkplaceName</div>
                                            @if (!string.IsNullOrWhiteSpace(s.WorkplaceCvr))
                                            {
                                                <div class="small text-muted">CVR @s.WorkplaceCvr</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(s.WorkplacePhone))
                                            {
                                                <div class="small text-muted">@s.WorkplacePhone</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.ForloebName))
                                        {
                                            <div>@s.ForloebName</div>
                                            @if (!string.IsNullOrWhiteSpace(s.ForloebDates))
                                            {
                                                <div class="small text-muted">@s.ForloebDates</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.VufEarned is not null || s.VufRequired is not null)
                                        {
                                            <span class="@(s.VufOk == true ? "text-success" : "")">
                                                @(s.VufEarned?.ToString() ?? "?")/@(s.VufRequired?.ToString() ?? "?")
                                            </span>
                                            @if (s.VufPercent is not null)
                                            {
                                                <div class="small text-muted">@s.VufPercent.Value.ToString("0.#") %</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@($"https://lc.mags.dk/elev/{s.LectioId}")" target="_blank" rel="noopener">Åbn</a>
                                    </td>
                                </tr>
                                @if (expanded)
                                {
                                    <tr class="table-light">
                                        <td colspan="7" class="py-3">
                                            @if (_loadingPlanId == s.LectioId)
                                            {
                                                <span class="text-muted">Henter studieplan…</span>
                                            }
                                            else if (_planErrors.TryGetValue(s.LectioId, out var planErr))
                                            {
                                                <span class="text-danger">@planErr</span>
                                            }
                                            else if (_plans.TryGetValue(s.LectioId, out var plan) && plan.Periods.Count > 0)
                                            {
                                                var timeline = BuildTimeline(plan.Periods);
                                                <div class="fw-semibold mb-2">Alle forløb (@plan.Periods.Count)</div>
                                                @if (!string.IsNullOrWhiteSpace(plan.ClassName))
                                                {
                                                    <div class="small text-muted mb-2">Klasse i studieplan: @plan.ClassName</div>
                                                }
                                                <div class="forloeb-expand">
                                                    <div class="forloeb-list">
                                                        <table class="table table-sm table-bordered mb-0 bg-white">
                                                            <thead>
                                                                <tr>
                                                                    <th>Forløb</th>
                                                                    <th>Start</th>
                                                                    <th>Slut</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var p in plan.Periods)
                                                                {
                                                                    <tr>
                                                                        <td>@p.Name</td>
                                                                        <td>@(p.StartLabel ?? "—")</td>
                                                                        <td>@(p.EndLabel ?? "—")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="forloeb-timeline">
                                                        @if (timeline is null)
                                                        {
                                                            <p class="text-muted small mb-0">Ingen datoer til tidslinje.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="timeline-axis">
                                                                @foreach (var tick in timeline.Ticks)
                                                                {
                                                                    <span class="timeline-tick" style="left: @(tick.Left.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%">@tick.Label</span>
                                                                }
                                                                @if (timeline.TodayLeft is double todayLeft)
                                                                {
                                                                    <span class="timeline-today" style="left: @(todayLeft.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%" title="I dag"></span>
                                                                }
                                                            </div>
                                                            <div class="timeline-rows">
                                                                @foreach (var bar in timeline.Bars)
                                                                {
                                                                    <div class="timeline-row" title="@bar.Tooltip">
                                                                        <div class="timeline-label">@bar.Name</div>
                                                                        <div class="timeline-track">
                                                                            <div class="timeline-bar @(bar.IsCurrent ? "is-current" : null) @(bar.IsPast ? "is-past" : null) @(bar.IsFuture ? "is-future" : null)"
                                                                                 style="left: @(bar.Left.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%; width: @(bar.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%">
                                                                            </div>
                                                                            @if (timeline.TodayLeft is double t2)
                                                                            {
                                                                                <span class="timeline-today-track" style="left: @(t2.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="timeline-legend small text-muted mt-2">
                                                                <span class="timeline-legend-swatch is-past"></span> Afsluttet
                                                                <span class="timeline-legend-swatch is-current ms-2"></span> Igangværende
                                                                <span class="timeline-legend-swatch is-future ms-2"></span> Kommende
                                                                @if (timeline.TodayLeft is not null)
                                                                {
                                                                    <span class="ms-2">· lodret streg = i dag</span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Ingen forløb i cachet studieplan.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(_teacherFilter) && !FilteredStudents.Any())
                {
                    <p class="text-muted small">Ingen elever matcher filteret.</p>
                }
            }
        </section>
    }
    else if (_linked)
    {
        <section class="mb-4">
            <h2 class="h5">Mine data</h2>
            @if (_linkOk)
            {
                <p class="text-success">Kobling gemt.</p>
            }
            @if (_meStudent is not null)
            {
                <pre class="bg-light border rounded p-3 small">@_meStudent</pre>
            }
            else if (_meJson is not null)
            {
                <pre class="bg-light border rounded p-3 small">@_meJson</pre>
            }
        </section>
    }
    else
    {
        <section class="mb-4">
            <h2 class="h5">Kobl din Lectio-profil</h2>
            <p class="text-muted">
                Vi foreslår kun profiler der matcher dit Auth-navn
                @if (!string.IsNullOrWhiteSpace(_authName))
                {
                    <text>(<strong>@_authName</strong>)</text>
                }
                — du kan ikke se andre elevers data.
            </p>

            @if (_candidates.Count == 1)
            {
                var c = _candidates[0];
                <div class="border rounded p-3 mb-3" style="max-width: 32rem;">
                    <p class="mb-2">Er du <strong>@c.Name</strong>?</p>
                    <p class="small text-muted mb-3">
                        @(c.ClassName ?? "Ukendt klasse")
                        @if (!string.IsNullOrWhiteSpace(c.Xprs))
                        {
                            <text> · @c.Xprs</text>
                        }
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" disabled="@_busy" @onclick="() => LinkCandidateAsync(c.LectioId)">
                            @(_busy ? "Kobler…" : "Ja — kobl mig")
                        </button>
                        <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="DismissCandidates">
                            Nej
                        </button>
                    </div>
                </div>
            }
            else if (_candidates.Count > 1)
            {
                <p>Vælg dig selv blandt forslagene:</p>
                <div class="list-group mb-3" style="max-width: 32rem;">
                    @foreach (var c in _candidates)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(_selectedLectioId == c.LectioId ? "active" : null)"
                                disabled="@_busy"
                                @onclick="() => _selectedLectioId = c.LectioId">
                            <strong>@c.Name</strong>
                            <span class="d-block small @( _selectedLectioId == c.LectioId ? "" : "text-muted")">
                                @(c.ClassName ?? "Ukendt klasse")
                                @if (!string.IsNullOrWhiteSpace(c.Xprs))
                                {
                                    <text> · @c.Xprs</text>
                                }
                            </span>
                        </button>
                    }
                </div>
                <button class="btn btn-primary"
                        disabled="@(_busy || string.IsNullOrEmpty(_selectedLectioId))"
                        @onclick="() => LinkCandidateAsync(_selectedLectioId!)">
                    @(_busy ? "Kobler…" : "Bekræft kobling")
                </button>
            }
            else if (_dismissed || _candidates.Count == 0)
            {
                <div class="alert alert-warning" style="max-width: 36rem;">
                    <p class="mb-2">Ingen automatisk match på dit Auth-navn.</p>
                    <p class="mb-0 small">
                        Bed en underviser om at koble dig i Lectio-Collector
                        (<a href="https://lc.mags.dk" target="_blank" rel="noopener">lc.mags.dk</a>).
                        Af sikkerhedshensyn kan du ikke indtaste et vilkårligt Lectio-id her.
                    </p>
                </div>
            }
        </section>
    }

    <p><a href="@Redirect.PostLoginPath()">Tilbage til dashboard</a></p>
}

@code {
    private string? _error;
    private string? _meJson;
    private string? _meStudent;
    private string? _authName;
    private string? _selectedLectioId;
    private string _teacherFilter = "";
    private string _holdFilter = "";
    private string? _expandedId;
    private string? _loadingPlanId;
    private string? _creatingHoldKey;
    private ImportResult? _importResult;
    private bool _busy;
    private bool _linkOk;
    private bool _loading;
    private bool _linked;
    private bool _dismissed;
    private TeacherTab _teacherTab = TeacherTab.Elever;
    private HoldScope _holdScope = HoldScope.Tracked;
    private HoldSummaryRow? _holdSummary;
    private readonly List<StudentRow> _students = [];
    private readonly List<CandidateRow> _candidates = [];
    private readonly List<HoldRow> _holds = [];
    private readonly Dictionary<string, StudentPlan> _plans = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _planErrors = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<StudentRow> FilteredStudents
    {
        get
        {
            var q = _teacherFilter.Trim();
            if (q.Length == 0) return _students;
            return _students.Where(s =>
                Contains(s.Name, q)
                || Contains(s.ClassName, q)
                || Contains(s.Xprs, q)
                || Contains(s.WorkplaceName, q)
                || Contains(s.ForloebName, q)
                || Contains(s.LectioId, q)
                || Contains(s.AgreementType, q));
        }
    }

    private IEnumerable<HoldRow> FilteredHolds
    {
        get
        {
            var q = _holdFilter.Trim();
            if (q.Length == 0) return _holds;
            return _holds.Where(h =>
                Contains(h.Name, q)
                || Contains(h.LectioHoldKey, q)
                || Contains(h.Year, q)
                || Contains(h.YearLabel, q)
                || Contains(h.FagId, q));
        }
    }

    private static bool Contains(string? hay, string needle) =>
        !string.IsNullOrEmpty(hay)
        && hay.Contains(needle, StringComparison.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _loading = true;
        _error = null;
        _students.Clear();
        _candidates.Clear();
        _holds.Clear();
        _holdSummary = null;
        _plans.Clear();
        _planErrors.Clear();
        _expandedId = null;
        _loadingPlanId = null;
        _linked = false;
        _meStudent = null;
        StateHasChanged();

        try
        {
            var meRes = await Http.GetAsync("lectio/me");
            var meBody = await meRes.Content.ReadAsStringAsync();
            if (!meRes.IsSuccessStatusCode)
            {
                _error = $"Kunne ikke hente /lectio/me ({(int)meRes.StatusCode}): {Trim(meBody)}";
                return;
            }

            _meJson = Pretty(meBody);
            _linked = HasLectioLink(meBody);

            if (Redirect.CurrentAppRole() == AppRole.Elev)
            {
                if (_linked)
                {
                    var studentRes = await Http.GetAsync("lectio/me/student");
                    var studentBody = await studentRes.Content.ReadAsStringAsync();
                    if (studentRes.IsSuccessStatusCode)
                        _meStudent = Pretty(studentBody);
                    else if ((int)studentRes.StatusCode != 403)
                        _error = $"Mine data ({(int)studentRes.StatusCode}): {Trim(studentBody)}";
                }
                else if (!_dismissed)
                {
                    await LoadCandidatesAsync();
                }
            }
            else
            {
                var listRes = await Http.GetAsync("lectio/programmeringselever");
                var listBody = await listRes.Content.ReadAsStringAsync();
                if (!listRes.IsSuccessStatusCode)
                {
                    _error = $"Programmeringselever ({(int)listRes.StatusCode}): {Trim(listBody)}. " +
                             "Åbn Collector direkte, eller tjek at din Auth-rolle er Underviser/Admin.";
                    return;
                }

                ParseStudents(listBody);
                await LoadHoldsAsync(clearError: false);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCandidatesAsync()
    {
        var res = await Http.GetAsync("lectio/me/lectio-candidates");
        var body = await res.Content.ReadAsStringAsync();
        if (!res.IsSuccessStatusCode)
        {
            _error = $"Kandidater ({(int)res.StatusCode}): {Trim(body)}";
            return;
        }

        using var doc = JsonDocument.Parse(body);
        var root = doc.RootElement;
        _authName = GetString(root, "authName");
        if (!root.TryGetProperty("candidates", out var arr) || arr.ValueKind != JsonValueKind.Array)
            return;

        foreach (var item in arr.EnumerateArray())
        {
            _candidates.Add(new CandidateRow(
                LectioId: GetString(item, "lectioId") ?? "",
                Name: GetString(item, "name") ?? "—",
                ClassName: GetString(item, "className"),
                Xprs: GetString(item, "xprs")
            ));
        }

        if (_candidates.Count == 1)
            _selectedLectioId = _candidates[0].LectioId;
    }

    private void ParseStudents(string json)
    {
        using var doc = JsonDocument.Parse(json);
        if (!doc.RootElement.TryGetProperty("students", out var arr) || arr.ValueKind != JsonValueKind.Array)
            return;

        foreach (var item in arr.EnumerateArray())
        {
            string? workplaceName = null;
            string? workplaceCvr = null;
            string? workplacePhone = null;
            if (item.TryGetProperty("workplace", out var wp) && wp.ValueKind == JsonValueKind.Object)
            {
                workplaceName = GetString(wp, "name");
                workplaceCvr = GetString(wp, "cvr");
                workplacePhone = GetString(wp, "phone");
            }

            string? forloebName = null;
            string? forloebDates = null;
            if (item.TryGetProperty("h6", out var h6) && h6.ValueKind == JsonValueKind.Object)
            {
                forloebName = GetString(h6, "name");
                var start = FormatDate(h6, "startDate");
                var end = FormatDate(h6, "endDate");
                if (!string.IsNullOrWhiteSpace(start) || !string.IsNullOrWhiteSpace(end))
                    forloebDates = $"{start ?? "?"} – {end ?? "?"}";
                var level = GetString(h6, "level") ?? (h6.TryGetProperty("level", out var lv) && lv.ValueKind == JsonValueKind.Number
                    ? lv.ToString()
                    : null);
                if (!string.IsNullOrWhiteSpace(level) && !string.IsNullOrWhiteSpace(forloebName))
                    forloebName = $"{level}: {forloebName}";
                else if (!string.IsNullOrWhiteSpace(level))
                    forloebName = level;
            }

            int? vufEarned = null, vufRequired = null;
            double? vufPercent = null;
            bool? vufOk = null;
            if (item.TryGetProperty("vuf", out var vuf) && vuf.ValueKind == JsonValueKind.Object)
            {
                vufEarned = GetInt(vuf, "earned");
                vufRequired = GetInt(vuf, "required");
                vufPercent = GetDouble(vuf, "percent");
                if (vuf.TryGetProperty("ok", out var ok) && (ok.ValueKind is JsonValueKind.True or JsonValueKind.False))
                    vufOk = ok.GetBoolean();
            }

            _students.Add(new StudentRow(
                LectioId: GetString(item, "lectioId") ?? "",
                Name: GetString(item, "name") ?? "—",
                ClassName: GetString(item, "className"),
                Xprs: GetString(item, "xprsElevType"),
                AgreementType: GetString(item, "agreementType"),
                WorkplaceName: workplaceName,
                WorkplaceCvr: workplaceCvr,
                WorkplacePhone: workplacePhone,
                ForloebName: forloebName,
                ForloebDates: forloebDates,
                VufEarned: vufEarned,
                VufRequired: vufRequired,
                VufPercent: vufPercent,
                VufOk: vufOk
            ));
        }
    }

    private async Task LinkCandidateAsync(string lectioId)
    {
        if (string.IsNullOrWhiteSpace(lectioId)) return;
        _busy = true;
        _linkOk = false;
        _error = null;
        try
        {
            var res = await Http.PutAsJsonAsync("lectio/me/lectio-link", new { lectioId = lectioId.Trim() });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _error = Trim(body);
                return;
            }

            _linkOk = true;
            _dismissed = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void DismissCandidates()
    {
        _dismissed = true;
        _candidates.Clear();
        _selectedLectioId = null;
    }

    private async Task SwitchToHoldTabAsync()
    {
        _teacherTab = TeacherTab.Hold;
        if (_holds.Count == 0 && !_loading)
            await LoadHoldsAsync(clearError: true);
    }

    private async Task SetHoldScopeAsync(HoldScope scope)
    {
        if (_holdScope == scope) return;
        _holdScope = scope;
        await LoadHoldsAsync(clearError: true);
    }

    private async Task CreateForloebFromHoldAsync(HoldRow hold)
    {
        if (string.IsNullOrWhiteSpace(hold.LectioHoldKey)) return;
        _creatingHoldKey = hold.LectioHoldKey;
        _importResult = null;
        _error = null;
        try
        {
            var res = await Http.PostAsJsonAsync("forloeb/from-lectio", new
            {
                lectioHoldKey = hold.LectioHoldKey,
                name = hold.Name
            });
            var body = await res.Content.ReadAsStringAsync();
            if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // Allerede importeret — gå til eksisterende forløb hvis muligt
                using var doc = JsonDocument.Parse(body);
                if (doc.RootElement.TryGetProperty("forloebId", out var fid)
                    && fid.TryGetGuid(out var forloebId))
                {
                    Nav.NavigateTo($"/forloeb/{forloebId}");
                    return;
                }

                _error = Trim(body);
                return;
            }

            if (!res.IsSuccessStatusCode)
            {
                _error = Trim(body);
                return;
            }

            using var ok = JsonDocument.Parse(body);
            var root = ok.RootElement;
            var id = root.GetProperty("id").GetGuid();
            var name = GetString(root, "name") ?? hold.Name;
            var total = 0;
            var claimed = 0;
            var shadows = 0;
            if (root.TryGetProperty("imported", out var imported) && imported.ValueKind == JsonValueKind.Object)
            {
                total = GetInt(imported, "total") ?? 0;
                claimed = GetInt(imported, "claimed") ?? 0;
                shadows = GetInt(imported, "shadows") ?? 0;
            }

            _importResult = new ImportResult(id, name, total, claimed, shadows);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _creatingHoldKey = null;
        }
    }

    private async Task LoadHoldsAsync(bool clearError)
    {
        if (clearError) _error = null;
        _holds.Clear();
        _holdSummary = null;
        try
        {
            var path = _holdScope == HoldScope.Tracked ? "lectio/holds/tracked" : "lectio/holds/saved";
            var res = await Http.GetAsync(path);
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _error = $"Hold ({(int)res.StatusCode}): {Trim(body)}";
                return;
            }

            ParseHolds(body);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ParseHolds(string json)
    {
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;

        if (root.TryGetProperty("summary", out var summary) && summary.ValueKind == JsonValueKind.Object)
        {
            _holdSummary = new HoldSummaryRow(
                GetInt(summary, "holdCount") ?? 0,
                GetInt(summary, "memberCount") ?? 0,
                GetInt(summary, "uniqueStudents") ?? 0);
        }
        else if (root.TryGetProperty("count", out var count) && count.TryGetInt32(out var c))
        {
            _holdSummary = new HoldSummaryRow(c, 0, 0);
        }

        if (!root.TryGetProperty("holds", out var arr) || arr.ValueKind != JsonValueKind.Array)
            return;

        foreach (var item in arr.EnumerateArray())
        {
            var start = ParseDateOnly(item, "startDate");
            var end = ParseDateOnly(item, "endDate");
            var isTracked = item.TryGetProperty("isTracked", out var t)
                            && t.ValueKind == JsonValueKind.True;
            _holds.Add(new HoldRow(
                Id: GetString(item, "id") ?? "",
                LectioHoldKey: GetString(item, "lectioHoldKey") ?? "",
                Name: GetString(item, "name") ?? "—",
                Year: GetString(item, "year"),
                YearLabel: GetString(item, "yearLabel"),
                FagId: GetString(item, "fagId"),
                MemberCount: GetInt(item, "memberCount") ?? 0,
                StartLabel: start?.ToString("dd.MM.yyyy"),
                EndLabel: end?.ToString("dd.MM.yyyy"),
                DateSource: GetString(item, "dateSource"),
                IsTracked: isTracked));
        }
    }

    private async Task ToggleForloebAsync(string lectioId)
    {
        if (string.Equals(_expandedId, lectioId, StringComparison.OrdinalIgnoreCase))
        {
            _expandedId = null;
            return;
        }

        _expandedId = lectioId;
        if (_plans.ContainsKey(lectioId) || _planErrors.ContainsKey(lectioId))
            return;

        _loadingPlanId = lectioId;
        try
        {
            var res = await Http.GetAsync($"lectio/students/{Uri.EscapeDataString(lectioId)}/studieplan");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _planErrors[lectioId] = $"Studieplan ({(int)res.StatusCode}): {Trim(body)}";
                return;
            }

            _plans[lectioId] = ParsePlan(body);
            _planErrors.Remove(lectioId);
        }
        catch (Exception ex)
        {
            _planErrors[lectioId] = ex.Message;
        }
        finally
        {
            _loadingPlanId = null;
        }
    }

    private static StudentPlan ParsePlan(string json)
    {
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        var className = GetString(root, "className");
        var periods = new List<PeriodRow>();

        if (TryGetArray(root, "schoolPeriods", out var arr)
            || TryGetArray(root, "SchoolPeriods", out arr))
        {
            foreach (var item in arr.EnumerateArray())
            {
                var name = GetString(item, "name") ?? GetString(item, "Name") ?? "—";
                var start = ParseDateOnly(item, "startDate") ?? ParseDateOnly(item, "StartDate");
                var end = ParseDateOnly(item, "endDate") ?? ParseDateOnly(item, "EndDate");
                periods.Add(new PeriodRow(
                    name,
                    start?.ToString("dd.MM.yyyy"),
                    end?.ToString("dd.MM.yyyy"),
                    start,
                    end));
            }
        }

        return new StudentPlan(className, periods);
    }

    private static TimelineView? BuildTimeline(IReadOnlyList<PeriodRow> periods)
    {
        var dated = periods
            .Where(p => p.StartDate is not null && p.EndDate is not null && p.EndDate >= p.StartDate)
            .OrderBy(p => p.StartDate)
            .ToList();
        if (dated.Count == 0)
            return null;

        var rangeStart = dated.Min(p => p.StartDate!.Value);
        var rangeEnd = dated.Max(p => p.EndDate!.Value);
        // Lidt luft i enderne
        rangeStart = rangeStart.AddMonths(-1);
        rangeEnd = rangeEnd.AddMonths(1);
        var totalDays = Math.Max(1, rangeEnd.DayNumber - rangeStart.DayNumber);
        var today = DateOnly.FromDateTime(DateTime.Today);

        double Pct(DateOnly d) =>
            100.0 * (d.DayNumber - rangeStart.DayNumber) / totalDays;

        double? todayLeft = today >= rangeStart && today <= rangeEnd ? Pct(today) : null;

        var bars = dated.Select(p =>
        {
            var left = Pct(p.StartDate!.Value);
            var right = Pct(p.EndDate!.Value);
            var width = Math.Max(0.8, right - left);
            var isPast = p.EndDate < today;
            var isFuture = p.StartDate > today;
            var isCurrent = !isPast && !isFuture;
            return new TimelineBar(
                p.Name,
                left,
                width,
                isPast,
                isCurrent,
                isFuture,
                $"{p.Name}: {p.StartLabel} – {p.EndLabel}");
        }).ToList();

        var ticks = new List<TimelineTick>();
        var year = rangeStart.Year;
        while (year <= rangeEnd.Year)
        {
            var jan1 = new DateOnly(year, 1, 1);
            if (jan1 >= rangeStart && jan1 <= rangeEnd)
                ticks.Add(new TimelineTick(Pct(jan1), year.ToString()));
            year++;
        }

        if (ticks.Count == 0)
        {
            ticks.Add(new TimelineTick(0, rangeStart.ToString("MMM yyyy")));
            ticks.Add(new TimelineTick(100, rangeEnd.ToString("MMM yyyy")));
        }

        return new TimelineView(bars, ticks, todayLeft);
    }

    private static bool TryGetArray(JsonElement el, string name, out JsonElement arr)
    {
        if (el.TryGetProperty(name, out arr) && arr.ValueKind == JsonValueKind.Array)
            return true;
        arr = default;
        return false;
    }

    private static bool HasLectioLink(string meJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(meJson);
            if (!doc.RootElement.TryGetProperty("lectio", out var lectio))
                return false;
            if (lectio.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
                return false;
            return lectio.TryGetProperty("lectioId", out var id)
                   && id.ValueKind == JsonValueKind.String
                   && !string.IsNullOrWhiteSpace(id.GetString());
        }
        catch
        {
            return false;
        }
    }

    private static string? GetString(JsonElement el, string name) =>
        el.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String ? p.GetString() : null;

    private static int? GetInt(JsonElement el, string name)
    {
        if (!el.TryGetProperty(name, out var p) || p.ValueKind == JsonValueKind.Null) return null;
        return p.TryGetInt32(out var i) ? i : null;
    }

    private static double? GetDouble(JsonElement el, string name)
    {
        if (!el.TryGetProperty(name, out var p) || p.ValueKind == JsonValueKind.Null) return null;
        return p.TryGetDouble(out var d) ? d : null;
    }

    private static string? FormatDate(JsonElement el, string name)
    {
        var d = ParseDateOnly(el, name);
        return d?.ToString("dd.MM.yyyy");
    }

    private static DateOnly? ParseDateOnly(JsonElement el, string name)
    {
        if (!el.TryGetProperty(name, out var p) || p.ValueKind == JsonValueKind.Null) return null;
        if (p.ValueKind == JsonValueKind.String)
        {
            var raw = p.GetString();
            if (string.IsNullOrWhiteSpace(raw)) return null;
            if (DateOnly.TryParse(raw, out var d)) return d;
            if (DateTimeOffset.TryParse(raw, out var dto)) return DateOnly.FromDateTime(dto.Date);
            return null;
        }

        if (p.TryGetDateTimeOffset(out var dt))
            return DateOnly.FromDateTime(dt.Date);
        return null;
    }

    private static string Pretty(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string Trim(string s) =>
        s.Length <= 400 ? s : s[..400] + "…";

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

