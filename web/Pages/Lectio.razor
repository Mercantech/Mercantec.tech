    private async Task EnsureAuthUsersAsync()
    {
        if (_authUsersLoaded || _authUsersLoading)
            return;

        _authUsersLoading = true;
        _authUsersError = null;
        try
        {
            var response = await Http.GetAsync("users");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _authUsers = [];
                _authUsersError = "Kun en administrator i Mercantec Auth kan hente brugerlisten.";
                _authUsersLoaded = true;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _authUsers = [];
                _authUsersError = "Auth-brugerlisten kunne ikke hentes.";
                _authUsersLoaded = true;
                return;
            }

            _authUsers = await response.Content.ReadFromJsonAsync<List<AuthUserRow>>() ?? [];
            _authUsersLoaded = true;
        }
        catch (Exception ex)
        {
            _authUsers = [];
            _authUsersError = ex.Message;
            _authUsersLoaded = true;
        }
        finally
        {
            _authUsersLoading = false;
        }
    }

    private async Task TeacherLinkAsync()
    {
        var lectioId = ResolvedLinkLectioId;
        var authSub = ResolvedLinkAuthSub;
        if (string.IsNullOrWhiteSpace(lectioId) || authSub is null)
            return;

        _busy = true;
        _teacherLinkOk = false;
        _teacherLinkError = null;
        _teacherLinkSummary = null;
        _error = null;
        try
        {
            var res = await Http.PutAsJsonAsync("lectio/me/lectio-link", new
            {
                lectioId = lectioId.Trim(),
                authSub
            });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _teacherLinkError = Trim(body);
                return;
            }

            var authLabel = _linkAuthUser?.DisplayName
                            ?? (_linkAuthUser?.Email)
                            ?? authSub.Value.ToString();
            var lectioLabel = _linkLectioStudent?.Name ?? lectioId.Trim();
            _teacherLinkSummary = $"{authLabel} ↔ {lectioLabel}";
            _teacherLinkOk = true;
            RememberAuthLink(lectioId.Trim(), authSub.Value);
        }
        catch (Exception ex)
        {
            _teacherLinkError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void RememberAuthLink(string lectioId, Guid authSub)
    {
        if (string.IsNullOrWhiteSpace(lectioId))
            return;
        _authLinks[lectioId] = authSub;
        _authLinkChecked.Add(lectioId);
    }

    private async Task EnsureAuthLinksAsync(IEnumerable<string> lectioIds)
    {
        var pending = lectioIds
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(id => !_authLinkChecked.Contains(id))
            .ToList();
        if (pending.Count == 0)
            return;

        try
        {
            var res = await Http.PostAsJsonAsync("lectio/auth-links/resolve", new { lectioIds = pending });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _authLinksError = $"Auth-koblinger ({(int)res.StatusCode}): {Trim(body)}";
                return;
            }

            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.TryGetProperty("links", out var links) && links.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in links.EnumerateArray())
                {
                    var id = GetString(item, "lectioId");
                    if (string.IsNullOrWhiteSpace(id))
                        continue;
                    if (!item.TryGetProperty("authSub", out var subEl))
                        continue;
                    var raw = subEl.ValueKind == JsonValueKind.String ? subEl.GetString() : subEl.ToString();
                    if (Guid.TryParse(raw, out var sub) && sub != Guid.Empty)
                        _authLinks[id] = sub;
                }
            }

            foreach (var id in pending)
                _authLinkChecked.Add(id);
            _authLinksError = null;
        }
        catch (Exception ex)
        {
            _authLinksError = $"Auth-koblinger kunne ikke hentes: {ex.Message}";
        }
    }

