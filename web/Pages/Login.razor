@page "/login"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Log ind</PageTitle>

<section class="panel" style="max-width:32rem">
    @if (!string.IsNullOrEmpty(_error))
    {
        <header class="page-title"><div><h1>Login fejlede</h1><p>@_error</p></div></header>
        <button type="button" class="action" @onclick="StartLogin" disabled="@_busy">@(_busy ? "Sender…" : "Prøv igen")</button>
    }
    else if (Auth.IsAuthenticated)
    {
        <header class="page-title"><div><h1>Log ind</h1><p>Sender dig til dit dashboard…</p></div></header>
    }
    else
    {
        <header class="page-title"><div><h1>Log ind</h1><p>Sender dig til Mercantec Auth…</p></div></header>
    }
</section>

@code {
    private bool _busy;
    private bool _started;
    private string? _error;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        _ = TryStartAsync();
    }

    private void OnAuth() => _ = InvokeAsync(TryStartAsync);

    private async Task TryStartAsync()
    {
        if (!Auth.IsInitialized || _started)
            return;

        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo(Redirect.PostLoginPath());
            return;
        }

        await StartLogin();
    }

    private async Task StartLogin()
    {
        if (_busy)
            return;

        _started = true;
        _busy = true;
        _error = null;
        try
        {
            await Auth.BeginLoginAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
            _started = false;
        }
    }

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
