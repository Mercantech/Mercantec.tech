@page "/login"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Log ind</PageTitle>

<section class="panel" style="max-width:32rem">
    @if (!string.IsNullOrEmpty(_error))
    {
        <header class="page-title"><div><h1>Login fejlede</h1><p>@_error</p></div></header>
        <button type="button" class="action" @onclick="StartLogin" disabled="@_busy">@(_busy ? "Sender…" : "Prøv igen")</button>
    }
    else if (!Auth.IsInitialized)
    {
        <p>Indlæser…</p>
    }
    else if (Auth.IsAuthenticated)
    {
        <header class="page-title"><div><h1>Log ind</h1><p>Sender dig videre…</p></div></header>
    }
    else
    {
        <header class="page-title"><div><h1>Log ind</h1><p>Fortsæt med Mercantec Auth for at åbne LUP.</p></div></header>
        <button type="button" class="action" @onclick="StartLogin" disabled="@_busy">@(_busy ? "Sender…" : "Log ind")</button>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private bool _busy;
    private bool _redirecting;
    private string? _error;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
    }

    protected override Task OnParametersSetAsync() => RedirectIfAuthenticated();

    private void OnAuth() => InvokeAsync(async () =>
    {
        await RedirectIfAuthenticated();
        StateHasChanged();
    });

    private async Task RedirectIfAuthenticated()
    {
        if (Auth.IsInitialized && Auth.IsAuthenticated && !_redirecting)
        {
            _redirecting = true;
            Nav.NavigateTo(await Auth.ConsumeLoginReturnPathAsync(ReturnUrl) ?? Redirect.PostLoginPath(), replace: true);
        }
    }

    private async Task StartLogin()
    {
        if (_busy || !Auth.IsInitialized || Auth.IsAuthenticated)
            return;

        _busy = true;
        _error = null;
        try
        {
            await Auth.BeginLoginAsync(ReturnUrl);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
