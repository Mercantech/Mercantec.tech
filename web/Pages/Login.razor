@page "/login"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav

<PageTitle>Log ind</PageTitle>

<section class="panel" style="max-width:32rem">
    <header class="page-title"><div><h1>Log ind</h1><p>Du sendes til Mercantec Auth. Login sker med PKCE, og logout her rydder kun denne app.</p></div></header>
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="callout">@_error</p>
    }
    <button class="action" @onclick="StartLogin" disabled="@_busy">@(_busy ? "Sender…" : "Log ind med Mercantec Auth")</button>
</section>

@code {
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task StartLogin()
    {
        _busy = true;
        _error = null;
        try
        {
            await Auth.BeginLoginAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
