@page "/search"
@page "/explore/projects"
@page "/explore/modules"
@page "/badges"
@page "/help"
@page "/sources"
@using Mercantec.Tech.Web.Demo
@inject NavigationManager Nav
@inject AuthService Auth
@implements IDisposable

<PageTitle>@Title</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated && PathKey is not ("help" or "sources"))
{
    <p>Du skal være logget ind. <a href="/login">Log ind</a></p>
}
else if (PathKey == "search")
{
    <header class="page-title"><div><h1>Søg</h1><p>Eksempelindeks over forløb, quests, badges og projekter.</p></div></header>
    <DemoTodo Issue="28" Text="Søgningen leder kun i eksempeldata på denne side." />
    <label class="field">Søg<input @bind="_query" @bind:event="oninput" placeholder="H3, MQTT, Rune Run …" /></label>
    <div class="panel">
        @foreach (var hit in Hits)
        {
            <div class="row">
                <span class="mark"><span class="mark-glyph">@hit.Kind[0]</span></span>
                <div><h3><a href="@hit.Href">@hit.Title</a></h3><p>@hit.Kind · @hit.Text</p></div>
                <a class="secondary" href="@hit.Href">Åbn</a>
            </div>
        }
        @if (!Hits.Any())
        {
            <p>Ingen træffere i eksemplet.</p>
        }
    </div>
}
else if (PathKey == "explore/projects")
{
    <header class="page-title"><div><h1>Fælles galleri</h1><p>Projekter med like og kommentar. Handlinger gemmes ikke.</p></div></header>
    <DemoTodo Text="Like og kommentar er slået fra. Der er ikke et issue-nummer på porteføljen endnu." />
    @foreach (var project in DemoCatalog.Projects.Where(p => p.Visibility == "Fælles"))
    {
        <article class="panel" style="margin-bottom:14px">
            <img src="lup/assets/project-cover.jpg" alt="" style="width:100%;max-height:180px;object-fit:cover;border-radius:10px" />
            <h2>@project.Name</h2>
            <p>@project.Owner · @project.Tag</p>
            <p>@project.Desc</p>
            <p>@project.Likes likes</p>
            <button type="button" class="secondary" disabled>Like</button>
            @foreach (var comment in project.Comments)
            {
                <p><strong>@comment.Author.</strong> @comment.Text</p>
            }
            <label class="field">Kommentar<textarea disabled placeholder="TODO: kommentar gemmes ikke"></textarea></label>
        </article>
    }
}
else if (PathKey == "explore/modules")
{
    <header class="page-title"><div><h1>Fag og emner</h1><p>Emnerne fra eksempelkataloget.</p></div></header>
    <DemoTodo Issue="29" Text="Emnerne er ikke et gemt forløbsdokument." />
    @foreach (var course in DemoCatalog.Courses)
    {
        <section class="panel" style="margin-bottom:12px">
            <h2>@course.Name</h2>
            @foreach (var subject in course.Subjects)
            {
                <div class="row"><span class="mark"><span class="mark-glyph">@subject.Name[0]</span></span><div><h3>@subject.Name</h3><p>@subject.Desc</p></div></div>
            }
        </section>
    }
}
else if (PathKey == "badges")
{
    <header class="page-title"><div><h1>Badgekatalog</h1><p>Fem niveauer: Lille, Mellem, Stor, Mega, Ultra mega.</p></div></header>
    <DemoTodo Issue="25" Text="Rang er kun vist. Den gemmes ikke som karrierevalg." />
    <BadgeWall />
}
else if (PathKey == "help")
{
    <header class="page-title"><div><h1>Hjælp</h1><p>Sådan hænger LUP sammen.</p></div></header>
    <article class="article">
        <h2>Din læring</h2>
        <p>Overblikket viser dine rigtige medlemskaber. Læring, quests og kalender er eksempelindhold, indtil de gemmes.</p>
        <h2>Status</h2>
        <p>Prikken i headeren er et eksempel. Rød betyder vigtigt, orange kan gøres, og grøn betyder at intet mangler.</p>
        <h2>Profil</h2>
        <p>Navnet kommer fra din konto. Temaet gemmes kun i denne browser. Det giver ikke adgang.</p>
    </article>
}
else
{
    <header class="page-title"><div><h1>Om LUP</h1><p>Lokal UndervisningsPlatform.</p></div></header>
    <article class="article">
        <h2>Et fælles sted at lære og bygge</h2>
        <p>LUP samler forløb, faglige materialer, quests og din personlige udvikling. Kasper og Mathias underviser på eksempel-forløbene.</p>
        <p>Produktet hedder LUP i fladen. Domænet er stadig mercantec.tech, og login er Mercantec Auth.</p>
        <p><a href="https://github.com/Mercantech/Mercantec.tech" target="_blank" rel="noopener">Projektets repository</a></p>
    </article>
}

@code {
    private string _query = "";

    private string PathKey
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(['?', '#']);
            if (cut >= 0)
                relative = relative[..cut];
            return relative.Trim('/');
        }
    }

    private string Title => PathKey switch
    {
        "search" => "Søg",
        "explore/projects" => "Galleri",
        "explore/modules" => "Fag og emner",
        "badges" => "Badges",
        "help" => "Hjælp",
        _ => "Om LUP"
    };

    private IEnumerable<Hit> Hits
    {
        get
        {
            var q = _query.Trim();
            var all = new List<Hit>();
            foreach (var course in DemoCatalog.Courses)
                all.Add(new("Forløb", course.Name, course.Desc, $"/learning/{course.Id}"));
            foreach (var quest in DemoCatalog.Quests)
                all.Add(new("Quest", quest.Name, quest.Desc, "/quests"));
            foreach (var badge in DemoCatalog.Badges)
                all.Add(new("Badge", badge.Name, badge.Desc, "/badges"));
            foreach (var project in DemoCatalog.Projects)
                all.Add(new("Projekt", project.Name, project.Desc, "/explore/projects"));
            return string.IsNullOrEmpty(q)
                ? all.Take(8)
                : all.Where(h => h.Title.Contains(q, StringComparison.OrdinalIgnoreCase) || h.Text.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private sealed record Hit(string Kind, string Title, string Text, string Href);

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        Nav.LocationChanged += OnLocation;
    }

    private void OnAuth() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        Nav.LocationChanged -= OnLocation;
    }
}
