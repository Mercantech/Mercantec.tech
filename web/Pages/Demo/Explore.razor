@page "/search"
@page "/explore/projects"
@page "/badges"
@page "/help"
@page "/sources"
@using Mercantec.Tech.Web.Demo
@using Mercantec.Tech.Web.Public
@inject NavigationManager Nav
@inject AuthService Auth
@implements IDisposable

<PageTitle>@Title</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated && PathKey == "explore/modules")
{
    <p>Du skal være logget ind. <a href="/login">Log ind</a></p>
}
else if (PathKey == "search")
{
    <header class="page-title"><div><h1>Søg</h1><p>Find forløb, fag, emner, projekter og badgekrav.</p></div></header>
    <label class="field">Søg<input @bind="_query" @bind:event="oninput" placeholder="H3, MQTT, Rune Run …" /></label>
    <div class="panel">
        @foreach (var hit in Hits)
        {
            <div class="row">
                <span class="mark"><span class="mark-glyph">@hit.Kind[0]</span></span>
                <div><h3><a href="@hit.Href">@hit.Title</a></h3><p>@hit.Kind · @hit.Description</p></div>
                <a class="secondary" href="@hit.Href">Åbn</a>
            </div>
        }
        @if (!Hits.Any())
        {
            <p>Ingen resultater. Prøv et andet søgeord.</p>
        }
    </div>
}
else if (PathKey == "explore/projects")
{
    <header class="page-title"><div><h1>Offentlige projekter</h1><p>Projekteksemplerne er markeret DEMO.</p></div>@if (Auth.IsAuthenticated) { <a class="secondary" href="/projects/mine">Mine projekter</a> }</header><PublicProjectGallery />
    @if (Auth.IsAuthenticated) { <div class="headrow"><h2>Delt i holdets galleri</h2></div><ProjectGallery /> }
}
else if (PathKey == "explore/modules")
{
    <header class="page-title"><div><h1>Fag og emner</h1><p>Gå på opdagelse, eller find det næste emne i dit forløb.</p></div></header>@foreach (var course in DemoCatalog.Courses) { <div class="headrow"><h2>@course.Name</h2><a href="/learning/@course.Id">Åbn forløbet</a></div><SubjectCards Course="course" /> }
}
else if (PathKey == "badges")
{
    @if (Auth.IsAuthenticated) { <header class="page-title"><div><h1>Badgekatalog</h1></div><a class="secondary" href="/progress/badges">Mine badges</a></header><BadgeGallery /> } else { <PublicBadgeCatalog /> }
}
else if (PathKey == "help")
{
    <header class="page-title"><div><h1>Hjælp</h1><p>Sådan hænger LUP sammen.</p></div></header>
    <article class="article">
        <h2>Din læring</h2>
        <p>Overblikket samler dine hold og giver dig genveje til forløbsplaner, fag og materialer. Åbn et forløb for at finde uger, dage og emner.</p>
        <h2>Status</h2>
        <p>Rød betyder vigtigt, orange er noget, du kan gøre, og grøn betyder, at intet mangler. Grøn, blå og gul i kalenderen viser fremmøde, online fremmøde og arbejde hjemme.</p>
        <h2>Profil</h2>
        <p>Navnet kommer fra din konto. Temaet gemmes kun i denne browser. Det giver ikke adgang.</p>
    </article>
}
else
{
    <header class="page-title"><div><h1>Om LUP</h1><p>Lokal UndervisningsPlatform.</p></div></header>
    <article class="article">
        <h2>Et fælles sted at lære og bygge</h2>
        <p>LUP samler forløb, faglige materialer, quests og din personlige udvikling. Kasper og Mathias underviser på forløbene.</p>
        <p>Produktet hedder LUP i fladen. Domænet er stadig mercantec.tech, og login er Mercantec Auth.</p>
        <p><a href="https://github.com/Mercantech/Mercantec.tech" target="_blank" rel="noopener">Projektets repository</a></p>
    </article>
}

@code {
    private string _query = "";

    private string PathKey
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(['?', '#']);
            if (cut >= 0)
                relative = relative[..cut];
            return relative.Trim('/');
        }
    }

    private string Title => PathKey switch
    {
        "search" => "Søg",
        "explore/projects" => "Galleri",
        "explore/modules" => "Fag og emner",
        "badges" => "Badges",
        "help" => "Hjælp",
        _ => "Om LUP"
    };

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    protected override void OnParametersSet() => _query = Query ?? "";
    private IEnumerable<PublicSearchHit> Hits
    {
        get
        {
            var hits = PublicCatalog.Search(_query);
            if (!Auth.IsAuthenticated) return hits;
            var quests = DemoCatalog.Quests.Where(q => string.IsNullOrWhiteSpace(_query) || (q.Name + " " + q.Desc).Contains(_query, StringComparison.OrdinalIgnoreCase))
                .Select(q => new PublicSearchHit("Quest", q.Name, q.Desc, "/quests/" + q.Id));
            return hits.Concat(quests);
        }
    }

    protected override void OnInitialized() { Auth.AuthStateChanged += OnAuth; Nav.LocationChanged += OnLocation; }
    private void OnAuth() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { Auth.AuthStateChanged -= OnAuth; Nav.LocationChanged -= OnLocation; }
}
