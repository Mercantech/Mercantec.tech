@page "/learning"
@page "/learning/{CourseId}"
@page "/learning/{CourseId}/subjects"
@page "/learning/{CourseId}/subjects/{SubjectId}"
@page "/learning/{CourseId}/subjects/{SubjectId}/{LessonId}"
@page "/learning/{CourseId}/weeks/{Week:int}"
@page "/learning/{CourseId}/days/{Date}"
@page "/learning/{CourseId}/calendar"
@page "/calendar"
@page "/quests"
@page "/activities"
@page "/education"
@inject NavigationManager Nav
@inject AuthService Auth
@inject LearningContext CourseContext
@implements IDisposable
<PageTitle>@Title · LUP</PageTitle>
@if (!Auth.IsInitialized) { <p>Indlæser…</p> }
else if (!Auth.IsAuthenticated) { <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p> }
else if (CourseId is null && string.IsNullOrEmpty(CourseContext.CourseId) && PathKey is "calendar" or "quests" or "journal") { <section class="hero-empty"><h1>Dit næste forløb venter</h1><p>Dine aktiviteter og din uge vises, når du er aktiv på et forløb.</p><div class="actions"><a class="action" href="/learning">Udforsk læring</a><a class="secondary" href="/projects/mine">Mine projekter</a></div></section> }
else if (CourseId is not null && Course is null) { <div class="empty"><h1>Forløbet findes ikke</h1><a href="/learning">Tilbage til min læring</a></div> }
else if (PathKey == "calendar" || PathKey.EndsWith("/calendar")) {
    @if (Course is not null) { <CourseNavigation Course="Course" Current="Ugekalender" /> }
    <header class="page-title"><div><h1>Min uge</h1><p>Undervisning, quests og tid til at arbejde videre.</p></div></header>
    <WeekCalendar CourseId="@(CourseId ?? CourseContext.CourseId)" />
}
else if (PathKey == "activities") {
    <header class="page-title"><div><h1>Det sker lige nu</h1><p>Dine afstemninger og quests, samlet ét sted.</p></div></header>
    <div class="lup-status-legend"><span class="lup-state-important"><i class="lup-status-dot"></i>Vigtigt</span><span class="lup-state-optional"><i class="lup-status-dot"></i>Kan gøre</span><span class="lup-state-ready"><i class="lup-status-dot"></i>Intet mangler</span></div>
    <ActivitiesBoard />
}
else if (PathKey == "quests") {
    <header class="page-title"><div><h1>Quests og afleveringer</h1><p>Questen er opgaven. Afleveringen er dit svar på den.</p></div></header>
    <div class="filters">@foreach (var f in new[] { "Alle", "Main", "Side", "Daily" }) { <button class="filter" aria-pressed="@(_filter == f)" @onclick="() => _filter = f">@f</button> }</div>
    <QuestList Filter="@_filter" CourseId="@(CourseFilter ?? CourseContext.CourseId)" />
}
else if (PathKey == "education") {
    <header class="page-title"><div><h1>Din vej gennem uddannelsen</h1><p>Fra fundament til svendeprøve. Se, hvad du bygger videre på.</p></div></header>
    <div class="actions" style="margin-bottom:18px"><a class="action" href="/courses/template">Åbn alle undervisningsplaner</a><a class="secondary" href="/lup">LUP-tidslinje</a></div>
    <div class="education-roadmap">@foreach (var plan in CourseTemplateCatalog.Hovedforlob) { <a class="education-step" href="@plan.Path"><span class="education-number">@plan.Short</span><div><h2>@plan.Short · @plan.Title</h2><p>@plan.Lead</p><span class="pill">@plan.DurationLabel</span></div></a> }</div>
    <div class="headrow" style="margin-top:28px"><h2>Valgfag</h2></div>
    <div class="tiles">@foreach (var plan in CourseTemplateCatalog.Valgfag) { <a class="course-card" href="@plan.Path"><div><span class="pill">@plan.DurationLabel</span><h2>@plan.Short</h2><p>@plan.Lead</p><span class="course-card-cta">Åbn planen <UiIcon Name="arrow" /></span></div></a> }</div>
}
else if (Course is not null) {
    <CourseNavigation Course="Course" Current="@ContextLabel" />
    @if (SubjectId is not null) {
        var subject = Course.Subjects.FirstOrDefault(s => s.Id == SubjectId);
        var lesson = LearningContent.Lessons.FirstOrDefault(l => l.Subject == SubjectId && l.Id == LessonId);
        @if (subject is null || (LessonId is not null && lesson is null)) { <div class="empty"><h1>Indholdet findes ikke</h1><a href="/learning/@Course.Id/subjects">Se fag og emner</a></div> }
        else {
            <header class="page-title"><div><h1>@(lesson?.Name ?? subject.Name)</h1><p>@(lesson?.Lead ?? subject.Desc)</p></div></header>
            <div class="course-document"><aside class="course-toc"><a href="/learning/@Course.Id/subjects">Alle fag</a><h2>@subject.Name</h2>@foreach (var l in LearningContent.Lessons.Where(l => l.Subject == SubjectId)) { <a class="@(LessonId == l.Id ? "current" : "")" href="/learning/@Course.Id/subjects/@SubjectId/@l.Id">@l.Name</a> }</aside>
            <article class="article">@if (lesson is not null) { <span class="pill">Fagligt emne</span><h2>@lesson.Name</h2><p>@lesson.Body</p><h3>Det arbejder du hen imod</h3><div class="callout">@lesson.Goal</div><h3>Prøv det af</h3><p>Arbejd i små skridt. Vis din løsning til en makker, og forklar, hvad du har valgt, før du bygger videre.</p><a class="secondary" href="/quests?course=@Course.Id">Find en quest i forløbet</a> }
            else { <h2>Arbejd dig gennem emnerne</h2>@foreach (var l in LearningContent.Lessons.Where(l => l.Subject == SubjectId)) { <a class="lesson-link" href="/learning/@Course.Id/subjects/@SubjectId/@l.Id"><span><strong>@l.Name</strong><small>@l.Lead</small></span><UiIcon Name="arrow" /></a> } }</article></div>
        }
    }
    else if (PathKey.EndsWith("/subjects")) {
        <header class="page-title"><div><h1>Fag og emner</h1><p>@Course.Name · Dyk ned i materialet, og arbejd i dit eget tempo.</p></div></header><SubjectCards Course="Course" />
    }
    else if (Week is not null || Date is not null) {
        var day = DateOnly.TryParse(Date, out var parsed) ? parsed : LearningContent.Start(Course.Id).AddDays(((Week ?? 1) - 1) * 7);
        var weekIndex = Math.Clamp((day.DayNumber - LearningContent.Start(Course.Id).DayNumber) / 7, 0, Course.Weeks.Length - 1);
        <header class="page-title"><div><span class="pill">Uge @(weekIndex + 1)</span><h1>@(Date is not null ? day.ToString("dddd d. MMMM", Danish) : Course.Weeks[weekIndex])</h1><p>@Course.Weeks[weekIndex] · @Course.Name</p></div></header>
        <div class="cols"><article class="article"><h2>Dagens fokus</h2><p>@Course.Desc</p><h3>Materialer og arbejde</h3><SubjectCards Course="Course" /><h3>Quests i forløbet</h3><QuestList CourseId="@Course.Id" /></article><aside class="panel"><h2>Din uge</h2>@for (var d = 0; d < 5; d++) { var date = LearningContent.Start(Course.Id).AddDays(weekIndex * 7 + d); <a class="day-link" href="/learning/@Course.Id/days/@date.ToString("yyyy-MM-dd")">@date.ToString("ddd d.", Danish)<span class="v2-dot @(d == 3 ? "online" : d == 4 ? "home" : "physical")"></span></a> }</aside></div>
    }
    else {
        <img class="v2-cover" src="lup/assets/@LearningContent.Cover(Course.Id)" alt="@(Course.Id == "h3" ? "Elektronik og enheder til H3-forløbet" : "Illustreret spilverden til Game Design")" />
        <header class="page-title course-title"><div><span class="context">@Course.Duration · @Course.Teacher</span><h1>@Course.Name</h1><p>@Course.Desc</p></div><a class="secondary" href="/learning/@Course.Id/calendar"><UiIcon Name="calendar" />Se ugekalender</a></header>
        <div class="course-document"><aside class="course-toc"><h2>I dette forløb</h2><a href="/learning/@Course.Id#about">Om forløbet</a><a href="/learning/@Course.Id#weeks">Ugeplan</a><a href="/learning/@Course.Id/subjects">Fag og emner</a><a href="/quests?course=@Course.Id">Quests og afleveringer</a><a href="/journal">Logbog</a></aside>
        <article class="course-paper"><section id="about"><h2>@(Course.Id == "h3" ? "Fra sensor til noget, der virker." : "Byg et spil. Forstå valgene.")</h2><p>@Course.Desc</p><div class="callout"><strong>@(Course.Id == "h3" ? "En løsning, hele vejen igennem" : "Godkend dit GDD, før du bygger")</strong><p>@(Course.Id == "h3" ? "Sensor, backend, database og dashboard skal spille sammen. Vi bygger i små skridt og afprøver forbindelserne undervejs." : "Først bygger vi Rune Run sammen. Derefter bruger du erfaringerne i dit eget spil. Dit indledende GDD skal godkendes, før udviklingen begynder.")</p></div></section>
        <section id="weeks"><div class="headrow"><h2>Din plan, uge for uge</h2><span>@Course.Duration</span></div>
        @for (var w = 0; w < Course.Weeks.Length; w++) { var wi = w; <details class="course-week" open="@(w == (Course.Id == "h3" ? 2 : 0))"><summary><span class="week-number">@(w + 1)</span><span><strong>@Course.Weeks[w]</strong><small>@LearningContent.Start(Course.Id).AddDays(w * 7).ToString("d. MMM", Danish) – @LearningContent.Start(Course.Id).AddDays(w * 7 + 4).ToString("d. MMM", Danish)</small></span><span class="week-chevron">⌄</span></summary><div class="week-days">@for (var d = 0; d < 5; d++) { var date = LearningContent.Start(Course.Id).AddDays(wi * 7 + d); <a class="v2-day-row" href="/learning/@Course.Id/days/@date.ToString("yyyy-MM-dd")"><strong>@date.ToString("dddd", Danish)</strong><span>@Course.Weeks[wi]</span><span class="v2-presence"><i class="v2-dot @(d == 3 ? "online" : d == 4 ? "home" : "physical")"></i>@(d == 3 ? "Online" : d == 4 ? "Hjemme" : "Fremmøde")</span></a> }<a class="week-open" href="/learning/@Course.Id/weeks/@(w + 1)">Åbn hele ugen <UiIcon Name="arrow" /></a></div></details> }
        </section><section><div class="headrow"><h2>Fagene i forløbet</h2></div><SubjectCards Course="Course" /></section></article></div>
    }
}
else {
    <header class="page-title"><div><h1>Min læring</h1><p>Dit forløb er dit udgangspunkt. Materialer, dage og quests hænger sammen her.</p></div></header>
    <div class="tiles">@foreach (var course in DemoCatalog.Courses) { <a class="course-card" href="/learning/@course.Id"><img src="lup/assets/@LearningContent.Cover(course.Id)" alt="" /><div><span class="pill">@course.Duration</span><h2>@course.Name</h2><p>@course.Desc</p><span class="course-card-cta">Åbn forløbet <UiIcon Name="arrow" /></span></div></a> }</div>
}
@code {
    [Parameter] public string? CourseId { get; set; }
    [Parameter] public string? SubjectId { get; set; }
    [Parameter] public string? LessonId { get; set; }
    [Parameter] public int? Week { get; set; }
    [Parameter] public string? Date { get; set; }
    [SupplyParameterFromQuery(Name = "course")] public string? CourseFilter { get; set; }
    private string _filter = "Alle";
    private static readonly System.Globalization.CultureInfo Danish = System.Globalization.CultureInfo.GetCultureInfo("da-DK");
    private string PathKey => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
    private DemoCatalog.Course? Course => DemoCatalog.Courses.FirstOrDefault(c => c.Id == CourseId);
    private string ContextLabel => SubjectId is not null ? Course?.Subjects.FirstOrDefault(s => s.Id == SubjectId)?.Name ?? "Emner" : Date is not null ? "Dagsplan" : Week is not null ? $"Uge {Week}" : "";
    private string Title => Course?.Name ?? PathKey switch { "calendar" => "Min uge", "quests" => "Quests og afleveringer", "journal" => "Min logbog", "activities" => "Aktiviteter", "education" => "Uddannelse og læringsmål", _ => "Min læring" };
    protected override void OnInitialized() { Auth.AuthStateChanged += OnAuth; Nav.LocationChanged += OnLocation; CourseContext.Changed += OnContext; }
    public override Task SetParametersAsync(ParameterView parameters) { CourseId = null; SubjectId = null; LessonId = null; Week = null; Date = null; return base.SetParametersAsync(parameters); }
    private void OnAuth() => InvokeAsync(StateHasChanged);
    private void OnContext() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { Auth.AuthStateChanged -= OnAuth; Nav.LocationChanged -= OnLocation; CourseContext.Changed -= OnContext; }
}
