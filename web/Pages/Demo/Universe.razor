@page "/progress"
@page "/progress/badges"
@page "/projects/mine"
@page "/profile/character"
@page "/apartment"
@page "/universe/shop"
@page "/universe/unlocks"
@page "/games"
@page "/games/avatar-demo"
@page "/notifications"
@page "/onboarding"
@using Mercantec.Tech.Web.Demo
@inject NavigationManager Nav
@inject AuthService Auth
@implements IDisposable

<PageTitle>@Title</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="/login">Log ind</a></p>
}
else if (PathKey == "progress")
{
    <header class="page-title"><div><h1>Din udvikling</h1><p>Det, du lærer, bygger videre. På tværs af forløb og projekter.</p></div><a class="secondary" href="/universe/unlocks">Se kommende oplåsninger</a></header>
    <div class="v3-wallet-panel"><div><strong>Level @DemoCatalog.Level</strong><span>Dit karriere-level</span></div><div><strong>1.240</strong><span>Samlet XP</span></div><div class="v3-gold"><strong><i class="v3-gold-dot"></i>320</strong><span>Guld</span></div></div>
    <section class="panel progress-overview"><h2>På vej mod level 8</h2><div class="v3-level-track"><span style="width:20%"></span></div><p>40 af 200 XP · 160 XP til næste level</p></section>
    <div class="cols"><section class="panel"><h2>Forløbs-XP</h2><div class="row"><span class="mark"><UiIcon Name="chip" /></span><div><h3><a href="/learning/h3">H3 · 2026</a></h3><p>Fra sensor til dashboard</p></div><strong>420 XP</strong></div><div class="row"><span class="mark"><UiIcon Name="game" /></span><div><h3><a href="/learning/game">Game design fra bunden</a></h3><p>Rune Run og dit eget spil</p></div><strong>320 XP</strong></div></section><aside class="panel"><h2>Brug dine fremskridt</h2><p>Find nyt avatartøj og møbler, og se de badges, der åbner særlige ting.</p><div class="actions"><a class="secondary" href="/universe/shop">Til butikken</a><a class="secondary" href="/progress/badges">Mine badges</a></div></aside></div>
}
else if (PathKey == "progress/badges")
{
    <header class="page-title"><div><h1>Mine badges</h1><p>Din samling af faglige fremskridt.</p></div><a class="secondary" href="/badges">Se hele kataloget</a></header><BadgeGallery OwnedOnly="true" />
}
else if (PathKey == "projects/mine")
{
    <header class="page-title"><div><h1>Mine projekter</h1><p>Dit arbejde, dine idéer og det, du vælger at dele.</p></div></header><ProjectGallery OwnedOnly="true" />
}
else if (PathKey == "profile/character")
{
    <header class="page-title"><div><h1>Min avatar og garderobe</h1><p>Dit udtryk følger dig ind i dit univers og prøvespillet.</p></div></header><AvatarEditor />
}
else if (PathKey == "apartment")
{
    <header class="page-title"><div><h1>Dit eget lille sted</h1><p>Vælg et møbel i inventaret, og indret din 2D-lejlighed.</p></div><a class="secondary" href="/universe/shop">Find flere møbler</a></header><ApartmentView />
}
else if (PathKey == "universe/shop")
{
    <header class="page-title"><div><h1>Butik til dit univers</h1><p>Møbler til dit rum og tøj til din fælles spilavatar.</p></div></header><ShopGallery />
}
else if (PathKey == "universe/unlocks")
{
    <header class="page-title"><div><h1>Det næste, du kan låse op</h1><p>Se både levelkrav og badges. En oplåsning åbner for køb med guld.</p></div><a class="secondary" href="/universe/shop">Til butikken</a></header>
    <div class="v4-shop-summary"><div><strong>Level @DemoCatalog.Level</strong><p>160 XP til næste level · @DemoCatalog.Gold guld</p></div></div>
    <div class="v4-roadmap">@foreach (var level in DemoCatalog.Shop.Select(i => i.Level).Distinct().Order().Where(l => l > DemoCatalog.Level)) { <section class="v4-level-node @(level == 8 ? "next" : "")"><h2>Level @level <span class="pill">@(level == 8 ? "Næste oplåsning" : "Låst")</span></h2>@foreach (var item in DemoCatalog.Shop.Where(i => i.Level == level)) { <UnlockRow Item="item" /> }</section> }</div>
    <details class="v4-past-levels"><summary>Se allerede nåede levels</summary><div class="v4-roadmap">@foreach (var level in DemoCatalog.Shop.Select(i => i.Level).Distinct().Order().Where(l => l <= DemoCatalog.Level)) { <section class="v4-level-node reached"><h2>Level @level <span class="pill green">Level nået</span></h2>@foreach (var item in DemoCatalog.Shop.Where(i => i.Level == level)) { <UnlockRow Item="item" /> }</section> }</div></details>
    <div class="headrow"><h2>Badges åbner særlige ting</h2></div><section class="panel">@foreach (var item in DemoCatalog.Shop.Where(i => i.BadgeId is not null)) { <UnlockRow Item="item" /> }</section>
    <section class="panel" style="margin-top:20px"><h2>En gave på vejen</h2><p>@DemoCatalog.Gift.Name gives direkte ved level @DemoCatalog.Gift.Level. Gaven står ikke til salg.</p><UiIcon Name="gift" /></section>
}
else if (PathKey == "games/avatar-demo")
{
    <header class="page-title"><div><h1>Rune Run Mini</h1><p>Saml tre runer, og find portalen med din avatar.</p></div></header><AvatarGame />
}
else if (PathKey == "games")
{
    <header class="page-title"><div><h1>Spil</h1><p>Prøv en rute, udforsk et spil, og lad dig inspirere.</p></div></header>
    <img src="lup/assets/game-cover.jpg" alt="" style="width:100%;max-height:200px;object-fit:cover;border-radius:12px;margin-bottom:16px" />
    <table class="table">
        <thead><tr><th>Elev</th><th>Spil</th><th>Point</th></tr></thead>
        <tbody>
            @foreach (var score in DemoCatalog.Highscores)
            {
                <tr><td>@score.Name</td><td>@score.Game</td><td>@score.Points</td></tr>
            }
        </tbody>
    </table>
    <a class="action" href="/games/avatar-demo">Prøv Rune Run Mini med din avatar</a>
}
else if (PathKey == "notifications")
{
    <header class="page-title"><div><h1>Notifikationer</h1><p>Seneste nyt fra dine projekter og forløb.</p></div></header>
    <div class="panel">
        <div class="row"><span class="mark"><span class="mark-glyph">1</span></span><div><h3>Maja kommenterede Rune Run</h3><p>Den hurtige rute føles fair. <a href="/explore/projects">Åbn galleriet</a></p></div></div>
        <div class="row"><span class="mark"><span class="mark-glyph">2</span></span><div><h3>Aflevering venter</h3><p>Indledende GDD til eget spil er sendt til vurdering.</p></div></div>
    </div>
}
else
{
    <header class="page-title"><div><h1>Velkommen til LUP</h1><p>Find dit forløb, og gør LUP til dit eget.</p></div></header>
    <form class="panel">
        <label class="field">Hvad vil du i gang med?<select disabled><option>Mit forløb</option><option>Mit univers</option></select></label>
        <button type="button" class="action" disabled>Gem og gå videre</button>
    </form>
}

@code {
    private string PathKey
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(['?', '#']);
            if (cut >= 0)
                relative = relative[..cut];
            return relative.Trim('/');
        }
    }

    private string Title => PathKey switch
    {
        "progress" => "Udvikling",
        "progress/badges" => "Mine badges",
        "projects/mine" => "Mine projekter",
        "profile/character" => "Avatar",
        "apartment" => "Lejlighed",
        "universe/shop" => "Butik",
        "universe/unlocks" => "Oplåsninger",
        "games" => "Spil",
        "notifications" => "Notifikationer",
        _ => "Onboarding"
    };

    private static string CellMark(int index) => index switch
    {
        9 => "Bord",
        10 => "Plante",
        _ => ""
    };

    private static string CellLabel(int index) => index switch
    {
        9 => "Skrivebord",
        10 => "Plante",
        _ => "Tomt felt"
    };

    protected override void OnInitialized() { Auth.AuthStateChanged += OnAuth; Nav.LocationChanged += OnLocation; }
    private void OnAuth() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { Auth.AuthStateChanged -= OnAuth; Nav.LocationChanged -= OnLocation; }
}
