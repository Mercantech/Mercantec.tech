@page "/teacher/planner"
@page "/teacher/reviews"
@page "/teacher/students"
@page "/teacher/content"
@page "/teacher/badges"
@using Mercantec.Tech.Web.Demo
@inject NavigationManager Nav
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject DemoWorld World
@implements IDisposable

<PageTitle>@Title</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else if (Redirect.CurrentAppRole() != AppRole.Underviser)
{
    <p>Siden er for undervisere. <a href="/student">Gå til elevoverblik</a></p>
}
else if (PathKey == "teacher/planner")
{
    <header class="page-title"><div><h1>Min kalender</h1><p>Din Outlook-uge via Azure · planlæg quests ved siden af</p></div></header>
    <WeekCalendar CourseId="h3" Teacher="true" />
}
else if (PathKey == "teacher/reviews")
{
    <header class="page-title"><div><h1>Afleveringer til vurdering</h1><p>Én indsendt quest fra Alex.</p></div></header>
    <article class="panel">
        <h2>Indledende GDD til eget spil</h2>
        <p>Alex Jensen · indsendt. Et kort 2D-spil med rutevalg og én bane.</p>
        <p><a href="https://example.com/gdd" target="_blank" rel="noopener">Link i afleveringen</a></p>
        <div class="actions">
            <button type="button" class="action" disabled>Godkend</button>
            <button type="button" class="secondary" disabled>Giv feedback</button>
        </div>
    </article>
}
else if (PathKey == "teacher/students")
{
    <header class="page-title"><div><h1>Elever</h1><p>Følg eleverne og deres faglige udvikling. Find holdets medlemskaber under Lectio.</p></div></header>
    <p><a class="action" href="/lectio">Åbn Lectio</a></p>
    <div class="panel">
        <div class="row"><span class="mark"><span class="mark-glyph">AJ</span></span><div><h3>Alex Jensen</h3><p>H3 · level 7 · 5 badges</p></div></div>
        <div class="row"><span class="mark"><span class="mark-glyph">MH</span></span><div><h3>Maja Holm</h3><p>Game Design · har kommenteret Rune Run</p></div></div>
        <div class="row"><span class="mark"><span class="mark-glyph">NB</span></span><div><h3>Noah Berg</h3><p>Game Design · highscore 1.495</p></div></div>
    </div>
}
else if (PathKey == "teacher/content")
{
    <header class="page-title"><div><h1>Fagligt indhold</h1><p>Fag og emner fra H3 og Game Design.</p></div></header>
    @foreach (var course in DemoCatalog.Courses)
    {
        <section class="panel" style="margin-bottom:12px">
            <h2>@course.Name</h2>
            @foreach (var subject in course.Subjects)
            {
                <p>@subject.Name — @subject.Desc</p>
            }
        </section>
    }
}
else if (PathKey == "teacher/badges")
{
    <header class="page-title"><div><h1>Tildel badges</h1><p>Emne, niveau og et kort grundlag.</p></div></header>
    <form class="panel">
        <label class="field">Elev<select disabled><option>Alex Jensen</option></select></label>
        <label class="field">Badge<select disabled><option>Core Loop</option></select></label>
        <label class="field">Niveau<select disabled><option>2 · Mellem</option></select></label>
        <label class="field">Grundlag<textarea disabled>Alex forklarede core loop med Rune Run.</textarea></label>
        <button type="button" class="action" disabled>Tildel</button>
    </form>
}

@code {
    private string PathKey
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(['?', '#']);
            if (cut >= 0)
                relative = relative[..cut];
            return relative.Trim('/');
        }
    }

    private string Title => PathKey switch
    {
        "teacher/planner" => "Planlægning",
        "teacher/reviews" => "Afleveringer",
        "teacher/students" => "Elever",
        "teacher/content" => "Fagligt indhold",
        "teacher/badges" => "Tildel badges",
        _ => "Afstemninger"
    };

    protected override async Task OnInitializedAsync() { Auth.AuthStateChanged += OnAuth; Nav.LocationChanged += OnLocation; World.Changed += OnAuth; await World.EnsureAsync(); }
    private void OnAuth() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { Auth.AuthStateChanged -= OnAuth; Nav.LocationChanged -= OnLocation; World.Changed -= OnAuth; }
}
