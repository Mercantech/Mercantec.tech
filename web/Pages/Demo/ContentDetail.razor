@page "/quests/{QuestId}"
@page "/quests/{QuestId}/submit"
@page "/badges/{BadgeId}"
@inject AuthService Auth
@inject NavigationManager Nav
@inject DemoWorld World
@implements IDisposable
<PageTitle>@Title · LUP</PageTitle>
@if (!Auth.IsInitialized) { <p>Indlæser…</p> }
else if (BadgeId is not null) { <PublicBadgeRequirements BadgeId="@BadgeId" /> }
else if (!Auth.IsAuthenticated) { <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p> }
else if (Quest is not null) {
    <CourseNavigation Course="Course!" Current="@Quest.Name" />
    <header class="page-title"><div><span class="pill">@Quest.Type quest</span><h1>@Quest.Name</h1><p>@Course!.Name</p></div></header>
    <div class="v3-step-strip"><strong>1. Læs questen</strong><span>›</span><span>2. Lav afleveringen</span><span>›</span><span>3. Få feedback</span></div>
    <div class="cols"><article class="article"><h2>Opgaven</h2><p>@Quest.Desc</p><h3>Det skal du vise</h3><p>Vis dit arbejde, forklar dine vigtigste valg, og dokumentér, at løsningen kan afprøves.</p><div class="v3-reward-line"><UiIcon Name="star" />100 XP <span>+</span><i class="v3-gold-dot"></i>20 guld ved godkendelse</div>
    <div class="actions"><button type="button" class="secondary v4-done-button" aria-pressed="@DemoWorld.Pressed(World.IsDone(Quest.Id))" @onclick="() => World.ToggleDone(Quest.Id)">@(World.IsDone(Quest.Id) ? "✓ Udført" : "Markér udført")</button><button type="button" class="action" disabled title="Aflevering bliver tilgængelig, når quests er tilkoblet forløbet">Lav aflevering</button><a class="secondary" href="/quests?course=@Quest.Course">Alle forløbets quests</a></div></article><aside class="panel"><h2>Din aflevering</h2><span class="pill orange">Ikke afleveret</span><p>Dit svar og underviserens feedback er private. Et projekt i galleriet oprettes særskilt.</p><h3>Forløb</h3><p><a href="/learning/@Quest.Course">@Course.Name</a></p></aside></div>
}

else { <div class="empty"><h1>Siden findes ikke</h1><a href="/learning">Tilbage til min læring</a></div> }
@code {
    [Parameter] public string? QuestId { get; set; }
    [Parameter] public string? BadgeId { get; set; }
    private DemoCatalog.Quest? Quest => DemoCatalog.Quests.FirstOrDefault(q => q.Id == QuestId);
    private DemoCatalog.Course? Course => DemoCatalog.Courses.FirstOrDefault(c => c.Id == Quest?.Course);
    private string Title => Quest?.Name ?? Mercantec.Tech.Web.Public.PublicCatalog.FindBadge(BadgeId)?.Name ?? "Indhold";
    public override Task SetParametersAsync(ParameterView parameters) { QuestId = null; BadgeId = null; return base.SetParametersAsync(parameters); }
    protected override async Task OnInitializedAsync() { Auth.AuthStateChanged += OnAuth; World.Changed += OnAuth; if (Auth.IsAuthenticated) await World.EnsureAsync(); }
    private void OnAuth() => InvokeAsync(StateHasChanged);
    public void Dispose() { Auth.AuthStateChanged -= OnAuth; World.Changed -= OnAuth; }
}
