@page "/emojis"
@using Mercantec.Tech.Web.Emojis
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject EmojiClient Emojis
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Emojis</PageTitle>

@if (!Auth.IsInitialized)
{
    <p role="status">Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    @if (HasExtensionImport)
    {
        <section class="panel emoji-upload">
            <h1>Tilføj billedet som emoji</h1>
            <p>Log ind med din underviserkonto for at hente billedet fra LUP-udvidelsen. Kladden gemmes i udvidelsen i op til 30 minutter.</p>
            <button class="action" @onclick="StartExtensionLogin" disabled="@_importLoginBusy">Log ind og fortsæt</button>
            @if (_importStatus is not null) { <p role="alert">@_importStatus</p> }
        </section>
    }
    else { <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p> }
}
else
{
    <header class="page-title">
        <div>
            <h1>Emojis</h1>
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="callout" role="alert">@_error</p>
    }
    @if (_notice is not null)
    {
        <p class="callout" role="status">@_notice</p>
    }

    @if (CanManage)
    {
        @if (HasExtensionImport && !_extensionImportComplete)
        {
            <section class="panel emoji-import" aria-label="Billede fra LUP-udvidelsen">
                <p role="status">@(_importStatus ?? "Henter billedet fra LUP-udvidelsen…")</p>
                <p class="emoji-hint">Gennemgå navn og beskrivelse, og tryk Upload for at tilføje emojien til biblioteket.</p>
            </section>
        }
        <form class="panel emoji-upload" @onsubmit="Upload" @onsubmit:preventDefault>
            <h2>Tilføj emoji</h2>
            <label class="field">Kort navn
                <input value="@_name" @oninput="EditName" maxlength="32" required placeholder="lup" autocomplete="off" />
            </label>
            <p class="emoji-hint">2–32 tegn: bogstaver, tal, _ og -. I teksten bliver det <kbd>:navn:</kbd>.</p>
            <label class="field">@(_importPreview is null ? "Billede" : "Vælg et andet billede")
                <InputFile @key="_fileKey" OnChange="ChooseFile" accept="image/png,image/jpeg,image/gif,image/webp" />
            </label>
            <p class="emoji-hint">PNG, JPEG, GIF eller WebP. Højst 256 KB.@if (_file is not null) { <span> Valgt: @_file.Name</span> }</p>
            @if (_file is not null)
            {
                <EmojiBackgroundEditor File="_file" FileChanged="ApplyEditedImage" BusyChanged="BackgroundBusyChanged" Disabled="_busy" />
                <label class="field">ALT-tekst<input value="@_altText" @oninput="EditAlt" maxlength="240" /></label>
                <label class="field">Kategori<select value="@_uploadCategory" @onchange="EditCategory">@foreach (var category in EmojiPickerCatalog.Categories.Where(item => item.Id != "all")) { <option value="@category.Id">@(category.Id == "custom" ? "Andet" : category.Label)</option> }</select></label>
                <label class="field">Søgeord<input value="@_keywords" @oninput="EditKeywords" maxlength="500" placeholder="Adskil med komma" /></label>
                <p class="emoji-hint">Højst 12 søgeord på hver højst 32 tegn.</p>
                @if (_analyzing) { <p role="status" class="emoji-hint">Analyserer billedet og foreslår metadata…</p><button type="button" class="secondary" @onclick="StopAnalysis">Stop analyse</button> }
                else if (_analysisMessage is not null) { <p role="status" class="emoji-hint">@_analysisMessage</p> }
            }
            <button class="action" disabled="@(_busy || _analyzing || _backgroundBusy || _file is null || !ValidUpload)">Upload</button>
        </form>
    }
    else
    {
        <p class="emoji-hint">Kun undervisere kan uploade, omdøbe og slette. Du kan se og bruge emojis.</p>
    }

    <section class="panel" aria-labelledby="emoji-library-title">
        <h2 id="emoji-library-title">Bibliotek</h2>
        <p class="emoji-attribution">Standardpakken bruger grafik fra Twitter og øvrige bidragydere til <a href="https://github.com/jdecked/twemoji/tree/v17.0.1">Twemoji v17.0.1</a>, udgivet under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
        @if (_items is null)
        {
            <p role="status">Henter emojis…</p>
        }
        else if (_items.Count == 0)
        {
            <div class="empty"><h3>Ingen emojis endnu</h3><p>@(CanManage ? "Upload det første billede ovenfor." : "Underviseren har ikke lagt billeder op endnu.")</p></div>
        }
        else
        {
            <ul class="emoji-library">
                @foreach (var item in _items)
                {
                    <li>
                        <img src="@item.ContentUrl" alt="@(string.IsNullOrWhiteSpace(item.AltText) ? $":{item.Name}:" : item.AltText)" title="@($":{item.Name}:")" />
                        <div>
                            <strong>:@item.Name:</strong>
                            @if (CanManage && _renaming == item.Id)
                            {
                                <form @onsubmit="() => SaveRename(item.Id)" @onsubmit:preventDefault>
                                    <label class="field">Nyt navn
                                        <input @bind="_rename" maxlength="32" required />
                                    </label>
                                    <label class="field">ALT-tekst<input @bind="_renameAlt" maxlength="240" /></label>
                                    <label class="field">Kategori<select @bind="_renameCategory">@foreach (var category in EmojiPickerCatalog.Categories.Where(choice => choice.Id != "all")) { <option value="@category.Id">@(category.Id == "custom" ? "Andet" : category.Label)</option> }</select></label>
                                    <label class="field">Søgeord<input @bind="_renameKeywords" maxlength="500" placeholder="Adskil med komma" /></label>
                                    <div class="actions">
                                        <button class="action" disabled="@_busy">Gem</button>
                                        <button type="button" class="secondary" @onclick="CancelRename">Annuller</button>
                                    </div>
                                </form>
                            }
                            else if (CanManage)
                            {
                                <div class="actions">
                                    <button type="button" class="secondary" disabled="@_busy" @onclick="() => BeginRename(item)">Omdøb</button>
                                    @if (_confirmDelete == item.Id)
                                    {
                                        <button type="button" class="secondary" disabled="@_busy" @onclick="() => Delete(item.Id)">Slet :@item.Name:</button>
                                        <button type="button" class="secondary" @onclick="() => _confirmDelete = null">Annuller</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="secondary" disabled="@_busy" @onclick="() => _confirmDelete = item.Id">Slet</button>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel" aria-labelledby="emoji-try-title">
        <h2 id="emoji-try-title">Prøv vælgeren</h2>
        <p class="emoji-hint">Komponenten bruges også i sidetitler og i afleveringstekst.</p>
        <label class="field">Tekst
            <input @bind="_sample" maxlength="200" placeholder="Skriv :navn: eller vælg en emoji" />
        </label>
        <EmojiPicker Disabled="_items is null" OnPick="InsertSample" />
        <p class="emoji-prose"><EmojiText @key="_catalogVersion" Text="@_sample" /></p>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "lupImport")] public string? ExtensionImportId { get; set; }
    private bool HasExtensionImport => Guid.TryParseExact(ExtensionImportId, "D", out _);
    private IJSObjectReference? _importModule;
    private DotNetObjectReference<Index>? _importSelf;
    private string? _startedImportId, _importStatus, _importPreview;
    private int _importHandle;
    private bool _importLoginBusy, _extensionImportHandled, _extensionImportComplete;
    private readonly CancellationTokenSource _life = new();
    private IReadOnlyList<CustomEmojiItem>? _items;
    private IBrowserFile? _file;
    private string _name = "";
    private string _altText = "", _uploadCategory = "custom", _keywords = "";
    private string _renameAlt = "", _renameCategory = "custom", _renameKeywords = "";
    private bool _analyzing;
    private string? _analysisMessage;
    private CancellationTokenSource? _analysisRequest;
    private int _fileGeneration;
    private readonly HashSet<string> _editedMetadata = [];
    private bool ValidUpload => EmojiUploadDraft.IsValidName(_name) && !string.IsNullOrWhiteSpace(_altText)
        && _altText.Length <= 240 && EmojiUploadDraft.ParseKeywords(_keywords) is var words && words.Count <= 12 && words.All(word => word.Length <= 32);
    private string _sample = "";
    private string _rename = "";
    private string? _error, _notice;
    private Guid? _renaming, _confirmDelete;
    private int _fileKey, _catalogVersion;
    private bool _busy, _backgroundBusy;
    private bool CanManage => Redirect.ShowsTeacherChrome;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        if (Auth.IsInitialized && Auth.IsAuthenticated) await Load();
    }

    private void OnAuth() => InvokeAsync(async () =>
    {
        if (Auth.IsAuthenticated) await Load();
        StateHasChanged();
    });

    private async Task Load()
    {
        try
        {
            _items = await Emojis.List(refresh: true, _life.Token);
            _error = null;
            _catalogVersion++;
        }
        catch (EmojiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { }
    }

    private async Task ChooseFile(InputFileChangeEventArgs e)
    {
        _extensionImportHandled = true;
        _importPreview = null;
        if (HasExtensionImport) _importStatus = "Du har valgt et billede manuelt.";
        await ChooseImage(e.File);
    }

    private async Task ChooseImage(IBrowserFile file)
    {
        _backgroundBusy = false;
        CancelAnalysis();
        var generation = ++_fileGeneration;
        _file = file;
        var suggestion = EmojiUploadDraft.SuggestName(_file.Name, (_items ?? []).Select(item => item.Name));
        if (!_editedMetadata.Contains("name")) _name = suggestion;
        if (!_editedMetadata.Contains("alt")) _altText = suggestion.Replace('_', ' ');
        if (!_editedMetadata.Contains("category")) _uploadCategory = "custom";
        if (!_editedMetadata.Contains("keywords")) _keywords = "";
        _error = null;
        _analysisMessage = null;
        if (_file.Size == 0 || _file.Size > EmojiClient.MaxBytes) { _analysisMessage = "Vælg et billede med indhold på højst 256 KB."; return; }
        var request = CancellationTokenSource.CreateLinkedTokenSource(_life.Token);
        _analysisRequest = request;
        _analyzing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var stream = _file.OpenReadStream(EmojiClient.MaxBytes, request.Token);
            var result = await Emojis.Analyze(stream, _file.Name, request.Token);
            if (request.IsCancellationRequested || generation != _fileGeneration) return;
            if (!_editedMetadata.Contains("alt")) _altText = result.AltText;
            if (!_editedMetadata.Contains("category")) _uploadCategory = result.Category;
            if (!_editedMetadata.Contains("keywords")) _keywords = string.Join(", ", result.Keywords ?? []);
            _analysisMessage = "Analyse klar.";
        }
        catch (OperationCanceledException) { }
        catch (Exception error) when (error is EmojiException or IOException)
        {
            if (!request.IsCancellationRequested && generation == _fileGeneration)
                _analysisMessage = error is EmojiException ? error.Message : "Billedet kunne ikke analyseres. Udfyld felterne manuelt.";
        }
        finally
        {
            if (ReferenceEquals(_analysisRequest, request)) { _analysisRequest = null; _analyzing = false; }
            request.Dispose();
        }
    }

    private void EditName(ChangeEventArgs args) { _name = args.Value?.ToString() ?? ""; _editedMetadata.Add("name"); }
    private void EditAlt(ChangeEventArgs args) { _altText = args.Value?.ToString() ?? ""; _editedMetadata.Add("alt"); }
    private void EditCategory(ChangeEventArgs args) { _uploadCategory = args.Value?.ToString() ?? "custom"; _editedMetadata.Add("category"); }
    private void EditKeywords(ChangeEventArgs args) { _keywords = args.Value?.ToString() ?? ""; _editedMetadata.Add("keywords"); }
    private void CancelAnalysis() { _analysisRequest?.Cancel(); _analysisRequest = null; _analyzing = false; }
    private void StopAnalysis() { CancelAnalysis(); _analysisMessage = "Analysen er stoppet. Du kan udfylde felterne manuelt."; }

    private Task BackgroundBusyChanged(bool busy)
    {
        _backgroundBusy = busy;
        if (busy) { CancelAnalysis(); ++_fileGeneration; }
        return Task.CompletedTask;
    }

    private Task ApplyEditedImage(IBrowserFile file)
    {
        if (_life.IsCancellationRequested || _busy) return Task.CompletedTask;
        CancelAnalysis();
        ++_fileGeneration;
        _file = file;
        _error = null;
        _analysisMessage = "Billedet er ændret. Navn og beskrivelse er bevaret.";
        return Task.CompletedTask;
    }

    private async Task Upload()
    {
        if (!CanManage || _file is null || _busy || _analyzing || _backgroundBusy || !ValidUpload) return;
        if (_file.Size > EmojiClient.MaxBytes) { _error = "Billedet må højst være 256 KB."; return; }
        _busy = true;
        _error = _notice = null;
        try
        {
            await using var stream = _file.OpenReadStream(EmojiClient.MaxBytes);
            var metadata = new EmojiUploadMetadata(_altText.Trim(), _uploadCategory, EmojiUploadDraft.ParseKeywords(_keywords));
            var created = await Emojis.Upload(_name, stream, _file.Name, _life.Token, metadata);
            _extensionImportComplete = true;
            _importPreview = null;
            if (HasExtensionImport && _importModule is not null)
            {
                // Upload succeeded even if the extension was disabled while the form was open.
                try { await _importModule.InvokeVoidAsync("complete", ExtensionImportId); }
                catch (JSException) { }
            }
            _name = "";
            _altText = _keywords = "";
            _uploadCategory = "custom";
            _editedMetadata.Clear();
            _file = null;
            _fileKey++;
            _notice = $":{created.Name}: er lagt i biblioteket.";
            await Load();
        }
        catch (IOException) { _error = "Billedet må højst være 256 KB."; }
        catch (EmojiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { }
        finally { _busy = false; }
    }

    private void BeginRename(CustomEmojiItem item)
    {
        _renaming = item.Id;
        _rename = item.Name;
        _renameAlt = item.AltText;
        _renameCategory = item.Category;
        _renameKeywords = string.Join(", ", item.Keywords ?? []);
        _confirmDelete = null;
    }

    private void CancelRename() => _renaming = null;

    private async Task SaveRename(Guid id)
    {
        if (!CanManage || _busy) return;
        _busy = true;
        _error = _notice = null;
        try
        {
            var metadata = new EmojiUploadMetadata(_renameAlt, _renameCategory, EmojiUploadDraft.ParseKeywords(_renameKeywords));
            var updated = await Emojis.Rename(id, _rename, _life.Token, metadata);
            _renaming = null;
            _notice = $"Navnet er nu :{updated.Name}:.";
            await Load();
        }
        catch (EmojiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { }
        finally { _busy = false; }
    }

    private async Task Delete(Guid id)
    {
        if (!CanManage || _busy) return;
        _busy = true;
        _error = _notice = null;
        try
        {
            await Emojis.Delete(id, _life.Token);
            _confirmDelete = null;
            _notice = "Emojien er slettet. Steder der brugte den, viser det korte navn i stedet.";
            await Load();
        }
        catch (EmojiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { }
        finally { _busy = false; }
    }

    private void InsertSample(CustomEmojiItem emoji)
    {
        _sample = EmojiInsert.Append(_sample, emoji.Name, 200);
        if (_items?.Any(item => item.Id == emoji.Id) != true)
        {
            _items = (_items ?? []).Append(emoji).OrderBy(item => item.Name).ToList();
            _catalogVersion++;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasExtensionImport || !CanManage || _items is null || _startedImportId == ExtensionImportId || _life.IsCancellationRequested) return;
        _startedImportId = ExtensionImportId;
        try
        {
            _importModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/lup-emoji-import.js");
            if (_importHandle != 0) await _importModule.InvokeVoidAsync("stop", _importHandle);
            _importSelf ??= DotNetObjectReference.Create(this);
            _importHandle = await _importModule.InvokeAsync<int>("start", _importSelf, ExtensionImportId);
        }
        catch (JSException) { _importStatus = "Kunne ikke kontakte LUP-udvidelsen. Genindlæs siden, eller vælg billedet manuelt."; await InvokeAsync(StateHasChanged); }
    }

    private async Task StartExtensionLogin()
    {
        if (_importLoginBusy || !HasExtensionImport) return;
        _importLoginBusy = true;
        try
        {
            _importModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/lup-emoji-import.js");
            await _importModule.InvokeVoidAsync("prepareLogin", ExtensionImportId);
            await Auth.BeginLoginAsync();
        }
        catch (Exception error) when (error is JSException or HttpRequestException or InvalidOperationException)
        { _importLoginBusy = false; _importStatus = "Login kunne ikke startes. Prøv igen."; }
    }

    [JSInvokable]
    public async Task<bool> ReceiveExtensionDraft(ExtensionEmojiDraft? draft)
    {
        if (_life.IsCancellationRequested || !CanManage || !HasExtensionImport || _extensionImportHandled || _file is not null || draft is null) return false;
        var file = draft.ToBrowserFile();
        if (file is null) { await ExtensionImportError("Udvidelsen sendte ikke et gyldigt billede på højst 256 KB."); return false; }
        _extensionImportHandled = true;
        _importPreview = $"data:{file.ContentType};base64,{draft.Base64}";
        _importStatus = "Billedet er klar. Du kan rette felterne nedenfor før upload.";
        await ChooseImage(file);
        if (!_life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        return true;
    }

    [JSInvokable]
    public Task ExtensionImportError(string message)
    {
        if (_life.IsCancellationRequested || _extensionImportHandled) return Task.CompletedTask;
        _importStatus = string.IsNullOrWhiteSpace(message) ? "Kunne ikke hente billedet fra udvidelsen." : message[..Math.Min(message.Length, 300)];
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        CancelAnalysis();
        Auth.AuthStateChanged -= OnAuth;
        _life.Cancel();
        if (_importModule is not null)
        {
            try { await _importModule.InvokeVoidAsync("stop", _importHandle); await _importModule.DisposeAsync(); }
            catch (JSException) { }
        }
        _importSelf?.Dispose();
        _life.Dispose();
    }
}
