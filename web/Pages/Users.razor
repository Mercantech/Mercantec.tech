@page "/users"
@using Mercantec.Tech.Web.Lectio
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Brugere</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else if (!Redirect.ShowsTeacherChrome)
{
    <p>Siden er for undervisere. <a href="/student">Gå til elevoverblik</a></p>
}
else
{
    <header class="page-title">
        <div>
            <h1>Brugere</h1>
            <p>
                Konti i Mercantec Auth. Admin, Underviser, Teacher og Instructor vises som undervisere.
                Øvrige konti er elever. Brugere koblet til Lectio er <em>på platformen</em> — åbn elev-overblikket med «Se som elev».
            </p>
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="callout">@_error</p>
    }
    else if (_users is null)
    {
        <p>Henter brugere…</p>
    }
    else
    {
        <div class="stats">
            <div class="stat"><strong>@_users.Count</strong><span>brugere</span></div>
            <div class="stat"><strong>@TeacherCount</strong><span>undervisere</span></div>
            <div class="stat"><strong>@StudentCount</strong><span>elever</span></div>
            <div class="stat"><strong>@PlatformCount</strong><span>på platformen</span></div>
        </div>
        @if (_linksError is not null)
        {
            <p class="callout warn">@_linksError</p>
        }
        <label class="field">Find en bruger
            <input type="search" @bind="_query" @bind:event="oninput" placeholder="Navn eller e-mail" autocomplete="off" />
        </label>
        <div class="filters" aria-label="Filtrér brugere">
            <button type="button" class="filter" aria-pressed="@(_filter == "alle")" @onclick='() => _filter = "alle"'>Alle</button>
            <button type="button" class="filter" aria-pressed="@(_filter == "underviser")" @onclick='() => _filter = "underviser"'>Undervisere</button>
            <button type="button" class="filter" aria-pressed="@(_filter == "elev")" @onclick='() => _filter = "elev"'>Elever</button>
            <button type="button" class="filter" aria-pressed="@(_filter == "platform")" @onclick='() => _filter = "platform"'>På platformen</button>
        </div>
        @if (Visible.Count == 0)
        {
            <div class="empty"><h2>Ingen brugere matcher</h2><p>Prøv et andet navn, en anden e-mail eller et andet filter.</p></div>
        }
        else
        {
            <div class="panel">
                @foreach (var user in Visible)
                {
                    var link = PlatformLinkFor(user.Id);
                    <div class="row">
                        <span class="mark">@Initial(user.DisplayName)</span>
                        <div>
                            <h3>@user.DisplayName</h3>
                            <p>@(user.Email ?? "Ingen e-mail")</p>
                            <p class="meta">
                                @if (user.IsDisabled)
                                {
                                    <span class="pill orange">Deaktiveret</span>
                                }
                                <span class="pill @(user.AppRole == "underviser" ? null : "green")">@(user.AppRole == "underviser" ? "Underviser" : "Elev")</span>
                                @if (link is not null)
                                {
                                    <span class="pill green" title="Koblet til Lectio @link.LectioId">På platformen</span>
                                    @if (!string.IsNullOrWhiteSpace(link.ClassName))
                                    {
                                        <span>@link.ClassName</span>
                                    }
                                }
                                else if (_linksLoaded)
                                {
                                    <span class="pill">Ikke koblet</span>
                                }
                                @if (user.Roles.Length > 0)
                                {
                                    <span>@string.Join(", ", user.Roles)</span>
                                }
                            </p>
                        </div>
                        @if (link is not null)
                        {
                            <button type="button"
                                    class="secondary"
                                    title="Se elev-overblik som denne Auth-bruger"
                                    @onclick="() => ViewAsStudent(user, link)">
                                Se som elev
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }
}

@code {
    private string? _error;
    private string? _linksError;
    private string _query = "";
    private string _filter = "alle";
    private List<UserRow>? _users;
    private bool _linksLoaded;
    private IReadOnlyDictionary<Guid, AuthPlatformLinks.Link> _platformByAuth =
        new Dictionary<Guid, AuthPlatformLinks.Link>();

    private int TeacherCount => _users?.Count(user => user.AppRole == "underviser") ?? 0;
    private int StudentCount => _users?.Count(user => user.AppRole != "underviser") ?? 0;
    private int PlatformCount => _users?.Count(user => _platformByAuth.ContainsKey(user.Id)) ?? 0;

    private IReadOnlyList<UserRow> Visible
    {
        get
        {
            if (_users is null)
                return [];

            IEnumerable<UserRow> rows = _users;
            if (_filter is "underviser" or "elev")
                rows = rows.Where(user => user.AppRole == _filter);
            else if (_filter == "platform")
                rows = rows.Where(user => _platformByAuth.ContainsKey(user.Id));

            var query = _query.Trim();
            if (query.Length > 0)
            {
                rows = rows.Where(user =>
                    user.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || (user.Email?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return rows.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Auth.IsInitialized || !Auth.IsAuthenticated || !Redirect.ShowsTeacherChrome)
            return;

        _error = null;
        try
        {
            var response = await Http.GetAsync("users");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _users = [];
                _error = "Kun en administrator i Mercantec Auth kan se brugerlisten.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _users = [];
                _error = "Brugerlisten kunne ikke hentes.";
                return;
            }

            _users = await response.Content.ReadFromJsonAsync<List<UserRow>>() ?? [];
            await LoadPlatformLinksAsync();
        }
        catch (Exception ex)
        {
            _users = [];
            _error = ex.Message;
        }
    }

    private async Task LoadPlatformLinksAsync()
    {
        _linksError = null;
        _linksLoaded = false;
        _platformByAuth = new Dictionary<Guid, AuthPlatformLinks.Link>();

        try
        {
            var listRes = await Http.GetAsync("lectio/programmeringselever");
            var listBody = await listRes.Content.ReadAsStringAsync();
            if (!listRes.IsSuccessStatusCode)
            {
                _linksError = $"Lectio-elever kunne ikke hentes ({(int)listRes.StatusCode}) — «Se som elev» er midlertidigt utilgængelig.";
                return;
            }

            var lectioIds = AuthPlatformLinks.ExtractLectioIds(listBody);
            if (lectioIds.Count == 0)
            {
                _linksLoaded = true;
                return;
            }

            var resolveRes = await Http.PostAsJsonAsync("lectio/auth-links/resolve", new { lectioIds });
            var resolveBody = await resolveRes.Content.ReadAsStringAsync();
            if (!resolveRes.IsSuccessStatusCode)
            {
                _linksError = $"Auth-koblinger kunne ikke hentes ({(int)resolveRes.StatusCode}).";
                return;
            }

            _platformByAuth = AuthPlatformLinks.MapByAuthSub(listBody, resolveBody);
            _linksLoaded = true;
        }
        catch (Exception ex)
        {
            _linksError = $"Platform-koblinger: {ex.Message}";
        }
    }

    private AuthPlatformLinks.Link? PlatformLinkFor(Guid authSub) =>
        _platformByAuth.TryGetValue(authSub, out var link) ? link : null;

    private void ViewAsStudent(UserRow user, AuthPlatformLinks.Link link)
    {
        if (string.IsNullOrWhiteSpace(link.LectioId))
            return;

        var name = string.IsNullOrWhiteSpace(link.Name) ? user.DisplayName : link.Name;
        ViewAs.Enter(link.LectioId, name, link.ClassName, user.Id, "/users");
        Nav.NavigateTo("/student");
    }

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private static string Initial(string name)
    {
        var trimmed = name.Trim();
        return trimmed.Length == 0 ? "?" : char.ToUpperInvariant(trimmed[0]).ToString();
    }

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

    private sealed record UserRow(Guid Id, string DisplayName, string? Email, bool IsDisabled, string AppRole, string[] Roles);
}
