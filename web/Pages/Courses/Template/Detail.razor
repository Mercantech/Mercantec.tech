@page "/courses/template/{Slug}"
@using Mercantec.Tech.Web.Courses
@inject AuthService Auth

@if (Course is null)
{
    <PageTitle>Ukendt forløb</PageTitle>
}
else
{
    <PageTitle>@Course.Short · Undervisningsplan</PageTitle>
}

<nav class="breadcrumbs" aria-label="Brødkrummer">
    <a href="/courses/template">Undervisningsplaner</a>
    <span>›</span>
    <span aria-current="page">@(Course?.Short ?? Slug)</span>
</nav>

<CourseTemplateView Course="Course" ShowLearningLink="@Auth.IsAuthenticated" />

@code {
    [Parameter] public string Slug { get; set; } = "";

    private CourseTemplate? Course =>
        Slug.Equals("template", StringComparison.OrdinalIgnoreCase)
            ? CourseTemplateCatalog.Blank
            : CourseTemplateCatalog.Find(Slug);
}
