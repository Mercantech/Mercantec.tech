@page "/courses/template"
@using Mercantec.Tech.Web.Courses
@inject AuthService Auth

<PageTitle>Undervisningsplaner · LUP</PageTitle>

<header class="page-title">
    <div>
        <h1>Undervisningsplaner</h1>
        <p>Mål, indhold og materialer til hovedforløb og valgfag.</p>
    </div>
    <div class="actions">
        @if (Auth.IsAuthenticated) { <a class="secondary" href="/courses/template/template">Åbn skabelonen</a> }
        <a class="secondary" href="/lup">LUP-tidslinje</a>
    </div>
</header>



<div class="headrow"><h2>Hovedforløb</h2><span>H1–H6</span></div>
<div class="tiles" style="margin-bottom:28px">
    @foreach (var course in CourseTemplateCatalog.Hovedforlob)
    {
        <a class="course-card" href="@course.Path">
            <div>
                <span class="pill">@course.DurationLabel</span>
                <h2>@course.Short</h2>
                <p>@course.Lead</p>
                <span class="course-card-cta">Åbn planen <UiIcon Name="arrow" /></span>
            </div>
        </a>
    }
</div>

<div class="headrow"><h2>Valgfag</h2><span>Deploy Or Die · Game Design · Machine Learning</span></div>
<div class="tiles">
    @foreach (var course in CourseTemplateCatalog.Valgfag)
    {
        <a class="course-card" href="@course.Path">
            <div>
                <span class="pill">@course.DurationLabel</span>
                <h2>@course.Short</h2>
                <p>@course.Lead</p>
                <span class="course-card-cta">Åbn planen <UiIcon Name="arrow" /></span>
            </div>
        </a>
    }
</div>
