@page "/courses"
@using System.Net.Http.Json
@using System.Text.Json
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Mine hold · LUP</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else if (!Redirect.ShowsTeacherChrome)
{
    <header class="page-title"><div><h1>Mine hold</h1><p>Find dit holds forløb, quests, afleveringer og grupper.</p></div></header>
    @if (_loading)
    {
        <p role="status">Henter dine hold…</p>
    }
    else if (_error is not null)
    {
        <div class="empty"><h2>Dine hold kunne ikke hentes</h2><p role="alert">@_error</p><button type="button" class="secondary" @onclick="LoadAsync">Prøv igen</button></div>
    }
    else if (_memberships.Count == 0)
    {
        <div class="empty"><h2>Ingen hold endnu</h2><p>@(ViewAs.IsActive && ViewAs.AuthSub is null ? "Denne elevprofil har endnu ingen tilknyttet LUP-konto. Åbn et hold med din underviseradgang for at se elevvisningen." : "Når en underviser tilføjer dig til et hold, finder du det her. Kontakt underviseren, hvis dit hold mangler.")</p></div>
    }
    else
    {
        <div class="panel">
            @foreach (var m in _memberships)
            {
                <div class="row student-course-row">
                    <span class="mark"><span class="mark-glyph">@(string.IsNullOrEmpty(m.ForloebName) ? "?" : m.ForloebName[..1])</span></span>
                    <div class="student-course-copy"><h2><a href="/courses/@m.ForloebId">@m.ForloebName</a></h2>@if (m.HoldName != m.ForloebName) { <p>@m.HoldName</p> }<nav class="student-course-links" aria-label="@($"Genveje til {m.ForloebName}")"><a href="/courses/@m.ForloebId?view=content">Forløb</a><a href="/courses/@m.ForloebId?view=quests">Quests og afleveringer</a><a href="/courses/@m.ForloebId?view=groups">Grupper</a></nav></div>
                    <a class="secondary" href="@($"/courses/{m.ForloebId}")" aria-label="@($"Åbn holdet {m.ForloebName}")">Åbn hold</a>
                </div>
            }
        </div>
    }
}
else
{
    <header class="page-title">
        <div>
            <h1>Mine hold</h1>
            <p>Opret manuelt, eller hent et hold ind fra Lectio.</p>
        </div>
        <div class="actions">
            <a class="secondary" href="/courses/template">Undervisningsplaner</a>
            <a class="secondary" href="/lectio">Fra Lectio-hold</a>
            <button type="button" class="action" @onclick="() => _showCreate = !_showCreate">@(_showCreate ? "Skjul" : "Nyt hold")</button>
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="callout">@_error</p>
    }

    @if (_showCreate)
    {
        <form class="panel" style="max-width:28rem;margin-bottom:16px">
            <h2>Opret hold</h2>
            <label class="field">Navn<input @bind="_newName" maxlength="200" /></label>
            <label class="field">Beskrivelse (valgfri)<textarea rows="2" @bind="_newDescription"></textarea></label>
            <button type="button" class="action" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))" @onclick="CreateAsync">@(_busy ? "Opretter…" : "Opret")</button>
        </form>
    }

    @if (_loading)
    {
        <p>Henter hold…</p>
    }
    else if (_items.Count == 0)
    {
        <div class="empty"><h2>Ingen hold endnu</h2><p>Opret et manuelt, eller vælg et hold under Lectio.</p></div>
    }
    else
    {
        <div class="panel">
            @foreach (var f in _items)
            {
                <div class="row">
                    <span class="mark"><span class="mark-glyph">@f.Name[..1]</span></span>
                    <div>
                        <h3>@f.Name</h3>
                        <p>
                            @f.MemberCount medlemmer
                            @if (f.ShadowCount > 0)
                            {
                                <span> (@f.ShadowCount shadow)</span>
                            }
                            · @f.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")
                            @if (!string.IsNullOrWhiteSpace(f.Description))
                            {
                                <span> · @f.Description</span>
                            }
                        </p>
                    </div>
                    <a class="secondary" href="@($"/courses/{f.Id}")">Åbn</a>
                </div>
            }
        </div>
    }
}

@code {
    private bool _loading;
    private bool _busy;
    private bool _showCreate;
    private string? _error;
    private string _newName = "";
    private string _newDescription = "";
    private readonly List<ForloebRow> _items = [];
    private readonly List<MembershipCard> _memberships = [];

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        ViewAs.Changed += OnAuth;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Auth.IsInitialized || !Auth.IsAuthenticated)
            return;

        if (!Redirect.ShowsTeacherChrome)
        {
            await LoadMembershipsAsync();
            return;
        }

        _loading = true;
        _error = null;
        _items.Clear();
        try
        {
            var res = await Http.GetAsync("forloeb");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _error = body.Length > 300 ? body[..300] + "…" : body;
                return;
            }

            using var doc = JsonDocument.Parse(body);
            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var keys = new List<string>();
                if (item.TryGetProperty("lectioHoldKeys", out var keysEl) && keysEl.ValueKind == JsonValueKind.Array)
                {
                    foreach (var k in keysEl.EnumerateArray())
                    {
                        if (k.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(k.GetString()))
                            keys.Add(k.GetString()!);
                    }
                }

                var primary = item.TryGetProperty("lectioHoldKey", out var lk) && lk.ValueKind == JsonValueKind.String
                    ? lk.GetString()
                    : null;
                if (keys.Count == 0 && !string.IsNullOrWhiteSpace(primary))
                    keys.Add(primary);

                _items.Add(new ForloebRow(
                    item.GetProperty("id").GetGuid(),
                    item.GetProperty("name").GetString() ?? "—",
                    item.TryGetProperty("description", out var d) && d.ValueKind == JsonValueKind.String ? d.GetString() : null,
                    item.TryGetProperty("memberCount", out var mc) && mc.TryGetInt32(out var mci) ? mci : 0,
                    item.TryGetProperty("shadowCount", out var sc) && sc.TryGetInt32(out var sci) ? sci : 0,
                    primary,
                    keys,
                    item.TryGetProperty("createdAtUtc", out var ca) && ca.TryGetDateTimeOffset(out var dto) ? dto : DateTimeOffset.MinValue
                ));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMembershipsAsync()
    {
        _loading = true;
        _error = null;
        _memberships.Clear();
        try
        {
            if (ViewAs.IsActive && ViewAs.AuthSub is null)
                return;

            var url = ViewAs.IsActive && ViewAs.AuthSub is Guid sub
                ? $"me/memberships?asUser={sub:D}"
                : "me/memberships";
            var rows = await Http.GetFromJsonAsync<List<MembershipCard>>(url) ?? [];
            _memberships.AddRange(rows);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _error = "Kontrollér forbindelsen, og prøv igen. Hvis holdet stadig mangler, kan din underviser kontrollere din tilknytning.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var res = await Http.PostAsJsonAsync("forloeb", new
            {
                name = _newName.Trim(),
                description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim()
            });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _error = body.Length > 300 ? body[..300] + "…" : body;
                return;
            }

            using var doc = JsonDocument.Parse(body);
            var id = doc.RootElement.GetProperty("id").GetGuid();
            Nav.NavigateTo($"/courses/{id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() { Auth.AuthStateChanged -= OnAuth; ViewAs.Changed -= OnAuth; }

    private sealed record MembershipCard(Guid Id, Guid HoldId, string HoldName, Guid ForloebId, string ForloebName, string Source, DateTimeOffset CreatedAtUtc);

    private sealed record ForloebRow(
        Guid Id,
        string Name,
        string? Description,
        int MemberCount,
        int ShadowCount,
        string? LectioHoldKey,
        List<string> LectioHoldKeys,
        DateTimeOffset CreatedAtUtc);
}
