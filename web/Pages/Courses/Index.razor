@page "/courses"
@using Mercantec.Tech.Web.Navigation
@implements IDisposable

<PageTitle>Mine hold · LUP</PageTitle>

@if (!Auth.IsInitialized)
{
    <p role="status">Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else
{
    <header class="page-title">
        <div>
            <h1>Mine hold</h1>
            <p>@(CanTeach ? "Find dine hold, eller opret et nyt manuelt eller fra Lectio." : "Find dit holds forløb, quests, afleveringer og grupper.")</p>
        </div>
        @if (CanTeach)
        {
            <div class="actions">
                <a class="secondary" href="/courses/template">Undervisningsplaner</a>
                <button type="button" class="secondary" aria-expanded="@_showCreate.ToString().ToLowerInvariant()" aria-controls="manual-hold-create" @onclick="ToggleCreate">Nyt hold manuelt</button>
            </div>
        }
    </header>

    @if (CanTeach)
    {
        <CourseLectioImport @key="Auth.Subject" OpenInitially="OpenLectio" ExistingHolds="ImportedLectioHolds" OnImported="ReloadAfterLectioImport" />
        @if (_showCreate)
        {
            <form id="manual-hold-create" class="panel hold-create" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <h2>Opret hold manuelt</h2>
                <label class="field">Navn<input @bind="_newName" @bind:event="oninput" maxlength="200" required /></label>
                <label class="field">Beskrivelse (valgfri)<textarea rows="2" @bind="_newDescription"></textarea></label>
                <div class="actions">
                    <button type="submit" class="action" disabled="@(_creating || string.IsNullOrWhiteSpace(_newName))">@(_creating ? "Opretter…" : "Opret")</button>
                    <button type="button" class="secondary" disabled="@_creating" @onclick="ToggleCreate">Annullér</button>
                </div>
                @if (_createError is not null) { <p role="alert">@_createError</p> }
            </form>
        }
    }

    @if (_loading)
    {
        <p role="status">Henter dine hold…</p>
    }
    else if (_loadError is not null)
    {
        <div class="empty"><h2>Dine hold kunne ikke hentes</h2><p role="alert">@_loadError</p><button type="button" class="secondary" @onclick="RetryLoad">Prøv igen</button></div>
    }
    else if (_holds.Length == 0)
    {
        <div class="empty"><h2>Ingen hold endnu</h2><p>@EmptyMessage</p></div>
    }
    else
    {
        var visible = VisibleHolds();
        <div class="hold-filters" aria-label="Filtrér hold">
            <label class="field">
                Find hold
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søg på holdnavn eller forløb" />
            </label>
            <label class="field">
                Kilde
                <select @bind="_source">
                    <option value="">Alle kilder</option>
                    <option value="lectio">Lectio</option>
                    <option value="manual">Manuelt oprettet</option>
                </select>
            </label>
            @if (!ViewAs.IsActive)
            {
                <label class="hold-favorites-filter"><input type="checkbox" @bind="_favoritesOnly" /> Vis kun favoritter</label>
            }
        </div>

        @if (visible.Length == 0)
        {
            <div class="empty">
                <h2>Ingen hold matcher</h2>
                <p>Prøv en anden søgning, eller nulstil filtrene.</p>
                <button type="button" class="secondary" @onclick="ClearFilters">Nulstil filtre</button>
            </div>
        }
        else
        {
            <div class="hold-grid">
                @foreach (var hold in visible)
                {
                    var href = $"/courses/{hold.ForloebId:D}";
                    <article class="hold-card" @key="hold.HoldId">
                        <div class="hold-card-top">
                            <div class="hold-card-badges" aria-label="Holdoplysninger">
                                <span class="hold-badge source">@(HasLectio(hold) ? "Lectio" : "Manuelt oprettet")</span>
                                @if (CanEdit(hold))
                                {
                                    <span class="hold-badge">@(hold.MemberCount == 1 ? "1 medlem" : $"{hold.MemberCount} medlemmer")</span>
                                    @if (hold.UnlinkedMemberCount > 0)
                                    {
                                        <span class="hold-badge unlinked">@hold.UnlinkedMemberCount uden LUP-konto</span>
                                    }
                                }
                            </div>
                            @if (!ViewAs.IsActive)
                            {
                                <button type="button" class="hold-favorite @(hold.IsFavorite ? "is-favorite" : null)"
                                        aria-label="@($"Favorit: {hold.HoldName}")" aria-pressed="@hold.IsFavorite.ToString().ToLowerInvariant()"
                                        title="@(hold.IsFavorite ? "Fjern fra favoritter" : "Føj til favoritter")"
                                        disabled="@_savingFavorites.Contains(hold.HoldId)" @onclick="() => ToggleFavorite(hold)">
                                    <UiIcon Name="star" />
                                </button>
                            }
                        </div>

                        <div>
                            <h2><a href="@href">@hold.HoldName</a></h2>
                            @if (!string.Equals(hold.HoldName, hold.ForloebName, StringComparison.OrdinalIgnoreCase))
                            {
                                <p class="hold-program"><span>Forløb</span> @hold.ForloebName</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(hold.Description))
                            {
                                <p class="hold-description">@hold.Description</p>
                            }
                        </div>

                        @if (HasLectio(hold) && SourceNames(hold) is { } sourceNames)
                        {
                            <p class="hold-context"><span>Lectio-hold</span> @sourceNames</p>
                        }
                        <p class="hold-context">Oprettet <time datetime="@hold.CreatedAtUtc.ToString("O")">@HoldDate(hold.CreatedAtUtc)</time></p>

                        @if (_renameId == hold.HoldId)
                        {
                            <form class="hold-rename" @onsubmit="() => RenameAsync(hold)" @onsubmit:preventDefault>
                                <label class="field">Holdets navn<input @ref="_renameInput" @bind="_renameValue" @bind:event="oninput" maxlength="200" required /></label>
                                <div class="actions">
                                    <button type="submit" class="action" disabled="@(_renaming || string.IsNullOrWhiteSpace(_renameValue))">Gem navn</button>
                                    <button type="button" class="secondary" disabled="@_renaming" @onclick="CancelRename">Annullér</button>
                                </div>
                            </form>
                        }

                        @if (_cardMessages.TryGetValue(hold.HoldId, out var message))
                        {
                            <p class="hold-message" role="@(message.IsError ? "alert" : "status")">@message.Text</p>
                        }

                        <div class="hold-card-footer">
                            <nav class="hold-links" aria-label="@($"Genveje til {hold.HoldName}")">
                                <a href="@WorkspaceNavigation.View(hold.ForloebId, "content")">Forløb</a>
                                <a href="@WorkspaceNavigation.View(hold.ForloebId, "quests")">Quests og afleveringer</a>
                                <a href="@WorkspaceNavigation.View(hold.ForloebId, "groups")">Grupper</a>
                            </nav>
                            <div class="actions">
                                <a class="secondary" href="@href" aria-label="@($"Åbn holdet {hold.HoldName}")">Åbn hold</a>
                                @if (CanEdit(hold) && _renameId != hold.HoldId)
                                {
                                    <button type="button" class="secondary" aria-label="@($"Omdøb {hold.HoldName}")" disabled="@_renaming" @onclick="() => BeginRename(hold)">Omdøb</button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
}
