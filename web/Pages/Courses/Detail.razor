@page "/courses/{Id:guid}"
@implements IDisposable

<PageTitle>@(_workspace?.Name ?? "Hold") · LUP</PageTitle>
@if (!Auth.IsInitialized || _loading)
{
    <p role="status">Henter holdets overblik…</p>
}
else if (!Auth.IsAuthenticated)
{
    <section class="panel"><h1>Dit hold samles her</h1><p>Log ind for at åbne forløb, quests og grupper.</p><a class="action" href="/login">Log ind</a></section>
}
else if (_workspace is null)
{
    <section class="panel"><h1>Holdet kunne ikke åbnes</h1><p role="alert">@_error</p><div class="actions"><button class="secondary" @onclick="Reload">Prøv igen</button><a class="secondary" href="/courses">Alle hold</a></div></section>
}
else
{
    <div class="hold-workspace">
        <nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/courses">Forløb og hold</a><span aria-hidden="true">/</span><span>@_workspace.Name</span></nav>
        <header class="hold-header">
            <div class="hold-identity"><span class="hold-emblem"><UiIcon Name="terminal" /></span><div><h1>@_workspace.Name</h1><p>@(CanManage ? "Din kommandocentral for undervisningen" : "Dit fælles sted for undervisningen")</p></div></div>
            <div class="hold-header-actions"><span class="hold-member-count"><UiIcon Name="people" /> @_workspace.MemberCount elever</span><a class="@(CanManage ? "action" : "secondary")" href="@EditorHref"><UiIcon Name="book" />@(CanManage ? "Åbn forløbseditor" : "Åbn undervisningen")</a></div>
        </header>
        @if (_error is not null) { <p class="hold-error" role="alert">@_error</p> }
        @if (_notice is not null) { <p class="hold-notice" role="status">@_notice</p> }
        <nav class="hold-nav" aria-label="Holdets værktøjer">
            @foreach (var tab in Tabs)
            {
                <a class="@(ActiveView == tab.Key ? "is-current" : null)" href="@ViewHref(tab.Key)" aria-current="@(ActiveView == tab.Key ? "page" : null)"><UiIcon Name="@tab.Icon" /><span>@tab.Label</span>@if (tab.Count is int count) { <small>@count</small> }</a>
            }
        </nav>
        @if (ActiveView == "overview")
        {
            @if (CanManage && _workspace.Progress is SubmissionProgress progress)
            {
                <section class="hold-progress" aria-label="Obligatoriske elevafleveringer"><a href="@ViewHref("submissions")"><strong>@progress.Delivered<span> / @progress.Expected</span></strong><span>elevafleveringer modtaget</span></a><a href="@ViewHref("submissions")"><strong>@progress.Missing</strong><span>mangler aflevering</span></a><a class="@(progress.Overdue > 0 ? "needs-action" : null)" href="@($"{ViewHref("submissions")}&status=overdue")"><strong>@progress.Overdue</strong><span>mangler efter fristen</span></a><a href="@ViewHref("submissions")"><strong>@_workspace.PendingReviews</strong><span>afleveringer til vurdering</span></a></section>
                <p class="hold-progress-note">Elevtallene dækker obligatoriske, udgivne quests. En gruppeaflevering dækker dens deltagere.</p>
            }
            <div class="hold-overview">
                <div class="hold-main">
                    <section class="hold-launchpad" aria-labelledby="hold-start-heading">
                        <div class="hold-section-heading"><div><h2 id="hold-start-heading">@(CanManage ? "Hvad skal holdet arbejde med?" : "Klar til næste skridt?")</h2><p>@(CanManage ? "Planlæg indholdet, sæt opgaver i gang, og saml eleverne." : "Find undervisningen, se dine opgaver, og mød din gruppe.")</p></div></div>
                        @if (FeaturedCourse is WorkspaceCourse activeCourse)
                        {
                            <a class="hold-editor-entry" href="@TeachingCourseHref(activeCourse.Id)"><span class="hold-tool-icon"><UiIcon Name="book" /></span><div><small>@(activeCourse.Published ? "Holdets forløb" : "Forløbskladde")</small><h3>@activeCourse.Title</h3><p>@activeCourse.Description</p><span class="hold-entry-link">Fortsæt i forløbet <UiIcon Name="arrow" /></span></div></a>
                        }
                        else
                        {
                            <a class="hold-editor-entry" href="@ViewHref("content")"><span class="hold-tool-icon"><UiIcon Name="book" /></span><div><h3>@(CanManage ? "Saml undervisningen i et forløb" : "Find dit næste forløb")</h3><p>@(CanManage ? "Giv forløbet en periode og læringsmål. Saml sider, quests og materialer ét sted." : "Åbn de forløb og materialer, din underviser har udgivet.")</p><span class="hold-entry-link">@(CanManage ? "Opret og organisér forløb" : "Åbn holdets forløb") <UiIcon Name="arrow" /></span></div></a>
                        }
                        <div class="hold-tool-list">
                            <a href="@ViewHref("quests", CanManage)"><span class="hold-tool-icon quest"><UiIcon Name="target" /></span><div><h3>@(CanManage ? "Opret en quest" : "Find dine quests")</h3><p>Main, daily og side quests med afleveringer og feedback.</p></div><UiIcon Name="arrow" /></a>
                            <a href="@ViewHref("calendar", CanManage)"><span class="hold-tool-icon calendar"><UiIcon Name="calendar" /></span><div><h3>@(CanManage ? "Planlæg en begivenhed" : "Se holdets kalender")</h3><p>Undervisning, milepæle og afleveringsfrister samlet.</p></div><UiIcon Name="arrow" /></a>
                            <a href="@ViewHref("groups")"><span class="hold-tool-icon groups"><UiIcon Name="people" /></span><div><h3>@(CanManage ? "Saml eleverne i grupper" : "Mød dine grupper")</h3><p>@(CanManage ? "Vælg selv, eller lad grupperouletten fordele eleverne." : "Se, hvem du arbejder sammen med i dine grupper.")</p></div><UiIcon Name="arrow" /></a>
                        </div>
                    </section>
                    <section class="hold-recent" aria-labelledby="hold-content-heading">
                        <div class="hold-section-heading"><h2 id="hold-content-heading">Seneste forløbsindhold</h2><a href="@ViewHref("content")">Se alt indhold</a></div>
                        @if (_workspace.Pages.Length == 0) { <div class="hold-empty"><UiIcon Name="book" /><p>@(CanManage ? "Der er plads til det første forløb. Opret en side i editoren, og udgiv den, når den er klar." : "Underviseren har endnu ikke udgivet indhold til holdet.")</p></div> }
                        @foreach (var page in _workspace.Pages.Take(4))
                        {
                            <a class="hold-page-row" href="@PageHref(page.Id)"><UiIcon Name="book" /><div><strong>@(page.Title)</strong><small>Opdateret @LocalDate(page.UpdatedAtUtc)</small></div>@if (CanManage) { <span class="hold-state @(page.PublishedAtUtc is null || page.HasUnpublishedChanges ? "draft" : null)">@PageState(page)</span> }<UiIcon Name="arrow" /></a>
                        }
                    </section>
                </div>
                <aside class="hold-aside" aria-label="Næste aktiviteter og opfølgning">
                    @if (CanManage)
                    {
                        <section class="hold-followup"><div class="hold-section-heading"><h2>Til opfølgning</h2><UiIcon Name="check" /></div><a class="hold-review-count" href="@AssignmentsHref"><strong>@_workspace.PendingReviews</strong><span>afleveringer venter på feedback</span></a>
                        @foreach (var review in _workspace.Reviews.Take(3)) { <a class="hold-review-row" href="@($"{ViewHref("submissions")}&quest={review.QuestId}&status=submitted")"><span>@review.Title</span><b>@review.Count</b></a> }
                        @if (_workspace.DraftQuestCount > 0) { <a class="hold-draft-link" href="@ViewHref("quests")">@_workspace.DraftQuestCount questkladder er klar til næste skridt</a> }
                        </section>
                    }
                    <section class="hold-agenda"><div class="hold-section-heading"><h2>Det næste på holdet</h2><a href="@ViewHref("calendar")">Kalender</a></div>
                        @if (_workspace.Agenda.Length == 0) { <p class="hold-aside-empty">Ingen kommende begivenheder eller frister endnu.</p> }
                        @foreach (var item in _workspace.Agenda)
                        {
                            var date = LocalTime(item.StartUtc);
                            <a class="hold-agenda-item" href="@(item.Kind == "deadline" ? QuestHref(item.Id) : $"{ViewHref("calendar")}&event={item.Id}")"><time datetime="@item.StartUtc.ToString("O")"><strong>@date.ToString("dd")</strong><span>@date.ToString("MMM", Danish)</span></time><div><small>@(item.Kind == "deadline" ? "Afleveringsfrist" : "Begivenhed") · @date.ToString("HH:mm")</small><h3>@item.Title</h3>@if (!string.IsNullOrWhiteSpace(item.Location)) { <p>@item.Location</p> }</div></a>
                        }
                    </section>
                    <a class="hold-resource-link" href="@ViewHref("materials")"><UiIcon Name="folder" /><div><strong>Holdets materialer</strong><span>@_workspace.MaterialCount filer til undervisningen</span></div><UiIcon Name="arrow" /></a>
                    @if (CanManage) { <a class="hold-resource-link" href="/teacher/polls"><UiIcon Name="chart" /><div><strong>Tag temperaturen på holdet</strong><span>Start en afstemning i undervisningen</span></div><UiIcon Name="arrow" /></a> }
                </aside>
            </div>
        }
        else if (ActiveView == "content")
        {
            <HoldCourses HoldId="_workspace.HoldId" CourseId="TeachingCourseId" OnChanged="RefreshSummary" />
        }
        else if (ActiveView == "submissions" && CanManage)
        {
            <HoldSubmissionOverview HoldId="_workspace.HoldId" CourseId="TeachingCourseId" QuestId="RequestedQuestId" Filter="SubmissionFilter" />
        }
        else if (ActiveView == "quests")
        {
            <HoldQuests @key="(Id, Create, ViewAs.IsActive)" HoldId="_workspace.HoldId" StartCreating="Create" OnChanged="RefreshSummary" />
        }
        else if (ActiveView == "calendar")
        {
            <HoldCalendar @key="(Id, Create, ViewAs.IsActive)" HoldId="_workspace.HoldId" StartCreating="Create" EventId="RequestedEventId" OnChanged="RefreshSummary" />
        }
        else if (ActiveView == "groups")
        {
            <HoldGroups @key="_workspace.HoldId" HoldId="_workspace.HoldId" OnSaved="RefreshSummary" />
        }
        else if (ActiveView == "materials")
        {
            <HoldMaterials @key="_workspace.HoldId" HoldId="_workspace.HoldId" CanManage="CanManage" OnChanged="RefreshSummary" />
        }
        else if (ActiveView == "settings" && CanManage)
        {
            <section class="hold-content-panel"><div class="hold-section-heading"><div><h2>Hold og tilknytning</h2><p>Administrér elevlisten og holdets forbindelse til Lectio.</p></div><a class="secondary" href="/lectio">Åbn Lectio</a></div>
                @if (_workspace.LectioKeys.Length > 0) { <ul class="hold-lectio-list">@foreach (var key in _workspace.LectioKeys) { <li><a href="@($"https://lc.mags.dk/hold/{Uri.EscapeDataString(key)}")" target="_blank" rel="noopener">Lectio-hold @key <UiIcon Name="external" /></a></li> }</ul> }
                else { <p>Holdet er oprettet manuelt. Du kan hente og organisere Lectio-hold fra Lectio-siden.</p> }
                <form class="hold-member-form" @onsubmit="AddMember" @onsubmit:preventDefault><h3>Tilføj en elev</h3><label class="field">Elevens navn<input @bind="_memberName" maxlength="200" required /></label><label class="field">Lectio-id<input @bind="_memberLectio" maxlength="64" /></label><details><summary>Tilknyt via brugerkonto</summary><label class="field">Kontoens Auth-id<input @bind="_memberSub" placeholder="GUID" /></label></details><p>Angiv elevens Lectio-id eller kontoens Auth-id for at knytte den rigtige elev til holdet.</p><button class="action" disabled="@_adding">@(_adding ? "Tilføjer…" : "Tilføj elev")</button></form>
            </section>
        }
    </div>
}
