@page "/"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Mercantec.tech</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (Auth.IsAuthenticated)
{
    <p>Sender dig til dit dashboard…</p>
}
else
{
    <header class="page-title">
        <div>
            <h1>Et sted at lære, bygge og vise det frem.</h1>
            <p>Mercantec.tech samler undervisning, projekter og faglig progression.</p>
        </div>
    </header>
    <section class="hero">
        <div>
            <h2>Fra det første forsøg til noget, der virker.</h2>
            <p>Find dine forløb og det næste skridt i dit arbejde.</p>
            @if (_error is not null)
            {
                <p class="callout">@_error</p>
            }
            <button type="button" class="action" @onclick="StartLogin" disabled="@_busy">@(_busy ? "Sender…" : "Log ind")</button>
        </div>
        <div class="scene" role="img" aria-label="Illustration af en lille spilbane">
            <div class="island">
                <div class="ground-left"></div>
                <div class="ground-right"></div>
                <div class="ground"></div>
                <div class="cube"><span></span></div>
                <div class="cube b"><span></span></div>
                <div class="cube c"><span></span></div>
                <div class="cube player"><span></span></div>
            </div>
        </div>
    </section>
}

@code {
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        RedirectIfAuthenticated();
    }

    private void RedirectIfAuthenticated()
    {
        if (Auth.IsInitialized && Auth.IsAuthenticated)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task StartLogin()
    {
        _busy = true;
        _error = null;
        try
        {
            await Auth.BeginLoginAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        RedirectIfAuthenticated();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
