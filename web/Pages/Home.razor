@page "/"
@inject HttpClient Http

<PageTitle>Mercantec.tech</PageTitle>

<h1>Mercantec.tech</h1>
<p>Central læringsplatform — Blazor PWA + .NET API.</p>

@if (_error is not null)
{
    <p class="text-danger">API: @_error</p>
}
else if (_health is null)
{
    <p>Tjekker API…</p>
}
else
{
    <p class="text-success">API: <strong>@_health.status</strong> (@_health.service)</p>
}

@code {
    private HealthDto? _health;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _health = await Http.GetFromJsonAsync<HealthDto>("health");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private sealed record HealthDto(string status, string service, DateTime utc);
}
