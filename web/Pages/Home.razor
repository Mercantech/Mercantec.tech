@page "/"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Mercantec.tech</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (Auth.IsAuthenticated)
{
    <p>Sender dig til dit dashboard…</p>
}
else
{
    <header class="page-title"><div><h1>LUP</h1><p>Lokal UndervisningsPlatform på mercantec.tech.</p></div></header>
    <div class="actions">
        <a class="action" href="/login">Log ind</a>
        <a class="secondary" href="/privacy">Privatliv</a>
    </div>

    @if (_error is not null)
    {
        <p class="callout">API: @_error</p>
    }
    else if (_health is not null)
    {
        <p>API: <strong>@_health.status</strong></p>
    }
}

@code {
    private HealthDto? _health;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        await LoadHealthAsync();
        RedirectIfAuthenticated();
    }

    private void RedirectIfAuthenticated()
    {
        if (Auth.IsInitialized && Auth.IsAuthenticated)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task LoadHealthAsync()
    {
        try
        {
            _health = await Http.GetFromJsonAsync<HealthDto>("health");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        RedirectIfAuthenticated();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

    private sealed record HealthDto(string status, string service, DateTime utc);
}
