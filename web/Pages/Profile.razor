@page "/profile"
@using Mercantec.Tech.Web.Characters
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ViewAsStudentContext ViewAs
@inject DemoWorld World
@implements IDisposable

<PageTitle>Min profil · LUP</PageTitle>

<div class="profile-page">
    @if (!Auth.IsInitialized)
    {
        <p role="status">Indlæser profil…</p>
    }
    else if (!Auth.IsAuthenticated)
    {
        <header class="page-title">
            <div><h1>Min profil</h1><p>Log ind for at åbne din profil og dit univers.</p></div>
        </header>
        <a class="action" href="@Auth.LoginPath()">Log ind</a>
    }
    else if (ViewAs.IsActive)
    {
        <header class="page-title">
            <div><h1>Min profil</h1><p>Afslut elevvisning for at åbne din egen profil.</p></div>
        </header>
        <button type="button" class="action" @onclick="ViewAs.Exit">Afslut elevvisning</button>
    }
    else
    {
        <header class="profile-header">
            <h1>Min profil</h1>
            <nav aria-label="På profilsiden" class="profile-jump-links">
                <a href="/profile#mit-univers"><UiIcon Name="folder" />Mit univers</a>
                <a href="/profile#indstillinger"><UiIcon Name="sliders" />Indstillinger</a>
            </nav>
        </header>

        <section class="profile-identity" aria-labelledby="profile-name">
            <div class="profile-avatar">
                @if (World.AvatarProfileReady)
                {
                    <AvatarIcon Size="112" />
                }
                else
                {
                    <UiIcon Name="people" />
                }
            </div>
            <div class="profile-identity-body">
                <ProfileNameEditor LoginName="@LoginName" @key="Auth.Subject" />
                <p>@RoleLabel</p>
                <div class="profile-identity-actions">
                    <a class="action" href="@AvatarCollectionHref">Vælg avatar</a>
                    <a class="secondary" href="/arena"><UiIcon Name="game" />Spil LUP Arena</a>
                </div>
            </div>
        </section>

        <section id="mit-univers" class="profile-section" tabindex="-1" aria-labelledby="profile-universe-title">
            <h2 id="profile-universe-title">Mit univers</h2>
            <div class="profile-categories">
                @foreach (var category in Categories)
                {
                    <section class="profile-category" aria-labelledby="@category.Id">
                        <h3 id="@category.Id"><span class="profile-category-icon"><UiIcon Name="@category.Icon" /></span>@category.Title</h3>
                        <ul>
                            @foreach (var link in category.Links)
                            {
                                <li><a href="@link.Href">@link.Label<UiIcon Name="chevron" /></a></li>
                            }
                        </ul>
                    </section>
                }
            </div>
        </section>

        <section id="indstillinger" class="profile-section panel profile-settings" tabindex="-1" aria-labelledby="profile-settings-title">
            <div class="profile-section-heading">
                <span class="profile-category-icon"><UiIcon Name="sliders" /></span>
                <h2 id="profile-settings-title">Indstillinger</h2>
            </div>
            <ProfileThemeSettings />
        </section>

        <section class="profile-section profile-account" aria-labelledby="profile-account-title">
            <h2 id="profile-account-title">Konto</h2>
            <dl class="profile-account-details">
                @if (!string.IsNullOrWhiteSpace(Auth.Email))
                {
                    <div><dt>E-mail</dt><dd>@Auth.Email</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Auth.LoginMethod))
                {
                    <div><dt>Loginmetode</dt><dd>@Auth.LoginMethod</dd></div>
                }
            </dl>
            <nav aria-label="Kontogenveje" class="profile-account-links">
                <a href="@Redirect.PostLoginPath()">Mit overblik</a>
                <a href="/lectio">Lectio-kobling</a>
                <a href="/rights">Mine rettigheder</a>
                <a href="/privacy">Privatliv</a>
                <a href="/help">Hjælp</a>
            </nav>
            <button type="button" class="secondary" @onclick="Logout">Log ud</button>
        </section>
    }
</div>

@code {
    private static readonly ProfileCategory[] Categories =
    [
        new("profile-progress", "Fremskridt", "chart",
        [
            new("/progress", "XP, level og guld"),
            new("/progress/badges", "Mine badges"),
            new("/universe/unlocks", "Oplåsninger")
        ]),
        new("profile-characters", "Karakterer og spil", "game",
        [
            new("/profile/character", "Min avatarsamling"),
            new("/characters", "Mød karaktererne"),
            new(ArenaFighters.RosterPath, "Kæmpere og oplåsning"),
            new("/games", "Spil")
        ]),
        new("profile-projects", "Projekter", "folder",
        [
            new("/projects/mine", "Mine projekter"),
            new("/explore/projects", "Projektgalleri")
        ]),
        new("profile-room", "Lejlighed og butik", "home",
        [
            new("/apartment", "Min lejlighed"),
            new("/universe/shop", "Butik"),
            new("/gifts", "Mine gaver")
        ])
    ];

    private string? _scrollLocation;

    private string? LoginName => Auth.DisplayName is { Length: > 0 } name && name != Auth.Subject ? name : null;
    private string AvatarCollectionHref => World.AvatarProfileReady
        ? ArenaFighters.CollectionPath(World.SelectedAvatarId)
        : "/profile/character";
    private string RoleLabel => Redirect.ShowsTeacherChrome ? "Underviser" : "Elev";

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnChanged;
        ViewAs.Changed += OnChanged;
        World.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Auth.IsAuthenticated || ViewAs.IsActive)
        {
            _scrollLocation = null;
            return;
        }

        var location = Nav.Uri;
        if (_scrollLocation == location)
            return;

        _scrollLocation = location;
        var fragment = Nav.ToAbsoluteUri(location).Fragment;
        if (fragment is "#mit-univers" or "#indstillinger")
            await Js.InvokeVoidAsync("lupProfileUi.scrollToSection", fragment[1..]);
    }

    private async Task Logout()
    {
        await Auth.LogoutLocalAsync();
        Nav.NavigateTo("/");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => OnChanged();

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnChanged;
        ViewAs.Changed -= OnChanged;
        World.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private sealed record ProfileCategory(string Id, string Title, string Icon, ProfileLink[] Links);
    private sealed record ProfileLink(string Href, string Label);
}
