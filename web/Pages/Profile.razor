@page "/profile"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Brugeroplysninger</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du er ikke logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else
{
    <header class="page-title"><div><h1>Min profil</h1></div></header>
    <section class="panel">
        <h2>@(Auth.DisplayName ?? "—")</h2>
        <p>@(Auth.Email ?? "—")</p>
        <p>Rolle: <strong>@Redirect.CurrentAppRole()</strong></p>
        <p>Login: @(Auth.LoginMethod ?? "—")</p>
        <p>Subject: <code>@(Auth.Subject ?? "—")</code></p>
        @if (Auth.Roles.Count == 0)
        {
            <p>Ingen role-claims.</p>
        }
        else
        {
            <p>Auth-roller: @string.Join(", ", Auth.Roles)</p>
        }
    </section>
    <section class="panel" style="margin-top:16px">
        <h2>Fra API</h2>
        @if (_meError is not null)
        {
            <p>@_meError</p>
        }
        else if (_meJson is null)
        {
            <p>Henter…</p>
        }
        else
        {
            <pre style="white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px">@_meJson</pre>
        }
    </section>
    <div class="actions">
        <a class="action" href="@Redirect.PostLoginPath()">Gå til overblik</a>
        <a class="secondary" href="/rights">Mine rettigheder</a>
        <a class="secondary" href="/privacy">Privatliv</a>
        <button type="button" class="secondary" @onclick="Logout">Log ud</button>
    </div>
}

@code {
    private string? _meJson;
    private string? _meError;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        await EnsureAndLoadAsync();
    }

    private async Task EnsureAndLoadAsync()
    {
        if (!Auth.IsInitialized)
            return;

        // Ingen redirect til /login her — det ville starte OAuth-race efter lokal logout.
        if (!Auth.IsAuthenticated)
            return;

        await LoadMeAsync();
    }

    private async Task LoadMeAsync()
    {
        try
        {
            var doc = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("me");
            _meJson = System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            _meError = null;
        }
        catch (Exception ex)
        {
            _meError = ex.Message;
            _meJson = null;
        }
    }

    private async Task Logout()
    {
        await Auth.LogoutLocalAsync();
        Nav.NavigateTo("/");
    }

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        await EnsureAndLoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
