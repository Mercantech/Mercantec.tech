@page "/auth/callback"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Logger ind…</PageTitle>

<section class="panel" style="max-width:32rem">
    @if (!string.IsNullOrEmpty(_error))
    {
        <header class="page-title"><div><h1>Login fejlede</h1><p>@_error</p></div></header>
        <a class="action" href="/login">Prøv igen</a>
    }
    else
    {
        <header class="page-title"><div><h1>Logger ind</h1><p>Fuldfører login med Mercantec Auth…</p></div></header>
    }
</section>

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var code = GetQuery(uri, "code");
        var state = GetQuery(uri, "state");
        var error = GetQuery(uri, "error");

        var ok = await Auth.CompleteLoginAsync(code, state, error);
        if (ok)
        {
            string? importReturn = null;
            try
            {
                await using var access = await JS.InvokeAsync<IJSObjectReference>("import", "./js/extension-access.js");
                importReturn = await access.InvokeAsync<string?>("consumeLoginReturnPath");
            }
            catch (JSException) { }
            try
            {
                await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/lup-emoji-import.js");
                var emojiReturn = await module.InvokeAsync<string?>("consumeLoginReturnPath");
                importReturn ??= emojiReturn;
            }
            catch (JSException) { }
            Nav.NavigateTo(importReturn ?? Redirect.PostLoginPath());
        }
        else
            _error = error ?? "Kunne ikke fuldføre login (state/code).";
    }

    private static string? GetQuery(Uri uri, string key)
    {
        var query = uri.Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]) == key)
                return Uri.UnescapeDataString(kv[1]);
        }
        return null;
    }
}
