@page "/student"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Mercantec.Tech.Web.Lectio
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@inject HttpClient Http
@inject LearningContext CourseContext
@implements IDisposable

<PageTitle>Dit overblik · LUP</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    var displayName = ViewAs.IsActive ? ViewAs.DisplayName : Auth.DisplayName;
    var firstName = string.IsNullOrEmpty(displayName) ? null : displayName.Split(' ')[0];
    var next = ResolveNextStep();

    <div class="student-home">
        <section class="student-hero" aria-labelledby="student-hero-title">
            <div class="student-hero-atmosphere" aria-hidden="true"></div>
            <div class="student-hero-copy">
                <p class="student-brand">LUP</p>
                <h1 id="student-hero-title">@(firstName is null ? "Din vej gennem uddannelsen" : $"{firstName} — din vej gennem uddannelsen")</h1>
                <p class="student-lead">@HeroLead()</p>
                <div class="actions student-hero-actions">
                    <a class="action" href="@next.Href">@next.Label <UiIcon Name="arrow" /></a>
                    @if (_linked && !string.IsNullOrWhiteSpace(_lectioId))
                    {
                        <a class="secondary" href="/lectio">Lectio-profil</a>
                    }
                    else if (!_linked)
                    {
                        <a class="secondary" href="/lectio">Kobl Lectio</a>
                    }
                </div>
            </div>
        </section>

        <div class="student-status" role="list" aria-label="Din status">
            <div class="student-status-item" role="listitem">
                <span class="student-status-label">Lectio</span>
                @if (_lectioLoading)
                {
                    <strong>Henter…</strong>
                }
                else if (_linked)
                {
                    <strong class="is-ok">Koblet</strong>
                    <span>@(_snapshot?.ClassName ?? "Din elevprofil er klar")</span>
                }
                else
                {
                    <strong class="is-warn">Ikke koblet</strong>
                    <span>Skema og VUF venter på kobling</span>
                }
            </div>
            <div class="student-status-item" role="listitem">
                <span class="student-status-label">Hold</span>
                @if (_memberships is null && _membershipError is null)
                {
                    <strong>Henter…</strong>
                }
                else if (_membershipError is not null)
                {
                    <strong class="is-warn">Kunne ikke hentes</strong>
                }
                else if (_memberships!.Count == 0)
                {
                    <strong>Ingen hold endnu</strong>
                    <span>Når du tilføjes, lander de her</span>
                }
                else
                {
                    <strong>@_memberships.Count hold</strong>
                    <span>@_memberships[0].ForloebName · @_memberships[0].HoldName</span>
                }
            </div>
            <div class="student-status-item" role="listitem">
                <span class="student-status-label">Næste skridt</span>
                <strong>@next.Title</strong>
                <span>@next.Detail</span>
            </div>
        </div>

        <section class="student-section student-vuf @_vufTone" aria-labelledby="student-vuf-title">
            <div class="student-section-head">
                <h2 id="student-vuf-title">VUF</h2>
                <p>Status fra Lectio — vi viser kun det, Collector allerede har beregnet.</p>
            </div>
            @if (!_linked)
            {
                <p class="student-inline-note">Kobl din Lectio-profil for at se, om du har VUF nok.</p>
                <div class="actions"><a class="secondary" href="/lectio">Kobl Lectio</a></div>
            }
            else if (_lectioLoading)
            {
                <p class="student-inline-note">Henter VUF…</p>
            }
            else if (_snapshot?.Vuf is { IsMissing: true } or null)
            {
                <p class="student-inline-note">VUF-data mangler i Lectio lige nu. Prøv igen senere, eller spørg din underviser.</p>
            }
            else
            {
                var vuf = _snapshot!.Vuf;
                var width = Studieplan.VufWidth(vuf);
                <div class="student-vuf-readout">
                    <div class="student-vuf-score">
                        <strong>@(vuf.Earned?.ToString() ?? "?")<span>/@(vuf.Required?.ToString() ?? "?")</span></strong>
                        <span class="student-vuf-state">
                            @if (vuf.Ok == true)
                            {
                                <text>Du har VUF nok</text>
                            }
                            else if (vuf.Ok == false)
                            {
                                <text>Du mangler VUF</text>
                            }
                            else
                            {
                                <text>VUF-status ukendt</text>
                            }
                        </span>
                    </div>
                    @if (width is double w)
                    {
                        <div class="student-vuf-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(w))" aria-label="VUF-fremgang">
                            <span style="width: @(w.ToString("0.###", CultureInfo.InvariantCulture))%"></span>
                        </div>
                        <p class="student-vuf-meta">
                            @(vuf.Percent is double p ? $"{p.ToString("0.#", CultureInfo.GetCultureInfo("da-DK"))} %" : $"{w.ToString("0.#", CultureInfo.GetCultureInfo("da-DK"))} %")
                            @if (!string.IsNullOrWhiteSpace(_snapshot.ForloebName))
                            {
                                <text> · @_snapshot.ForloebName</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(_snapshot.ForloebDates))
                            {
                                <text> · @_snapshot.ForloebDates</text>
                            }
                        </p>
                    }
                </div>
            }
        </section>

        <section class="student-section" aria-labelledby="student-timeline-title">
            <div class="student-section-head">
                <h2 id="student-timeline-title">Din forløbstidslinje</h2>
                <p>Skoleperioder fra din Lectio-studieplan — hvor du er, og hvad der kommer.</p>
            </div>
            @if (!_linked)
            {
                <p class="student-inline-note">Tidslinjen åbner, når Lectio er koblet.</p>
            }
            else if (_planLoading)
            {
                <p class="student-inline-note">Henter studieplan…</p>
            }
            else if (_planError is not null)
            {
                <p class="student-inline-note" role="status">@_planError</p>
            }
            else if (_plan is null || _plan.Periods.Count == 0)
            {
                <p class="student-inline-note">Ingen forløb i den cachede studieplan endnu.</p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_plan.ClassName))
                {
                    <p class="student-inline-note">Klasse i studieplan: @_plan.ClassName · @_plan.Periods.Count forløb</p>
                }
                <ForloebTimeline Timeline="_timeline" />
            }
        </section>

        <section class="student-section" aria-labelledby="student-holds-title">
            <div class="student-section-head">
                <h2 id="student-holds-title">Mine hold</h2>
                <p>Forløb du er medlem af her på LUP.</p>
            </div>
            @if (_membershipError is not null)
            {
                <p class="student-inline-note" role="status">Dine hold kunne ikke hentes.</p>
                <div class="actions"><a class="secondary" href="/courses">Åbn mine forløb</a></div>
            }
            else if (_memberships is null)
            {
                <p class="student-inline-note">Henter dine hold…</p>
            }
            else if (_memberships.Count == 0)
            {
                <p class="student-inline-note">Når en underviser tilføjer dig til et hold, kan du finde det her.</p>
                <div class="actions"><a class="secondary" href="/learning">Udforsk forløb</a></div>
            }
            else
            {
                <ul class="student-hold-list">
                    @foreach (var m in _memberships)
                    {
                        <li>
                            <a href="@($"/courses/{m.ForloebId}")">
                                <span class="mark"><UiIcon Name="book" /></span>
                                <span>
                                    <strong>@m.ForloebName</strong>
                                    <em>@m.HoldName</em>
                                </span>
                                <span class="student-hold-open">Åbn</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (ActiveCourse is not null)
        {
            <section class="student-section student-continue" aria-labelledby="student-continue-title">
                <div class="student-section-head">
                    <h2 id="student-continue-title">Fortsæt hvor du slap</h2>
                    <p>@ActiveCourse.Name — dit aktive læringsforløb i LUP.</p>
                </div>
                <div class="actions">
                    <a class="action" href="/learning/@ActiveCourse.Id">Åbn mit forløb <UiIcon Name="arrow" /></a>
                    <a class="secondary" href="/calendar">Min uge</a>
                    <a class="secondary" href="/quests">Quests</a>
                </div>
            </section>
        }
    </div>
}

@code {
    private DemoCatalog.Course? ActiveCourse => DemoCatalog.Courses.FirstOrDefault(c => c.Id == CourseContext.CourseId);

    private bool _linked;
    private bool _lectioLoading;
    private bool _planLoading;
    private string? _lectioId;
    private string? _planError;
    private string? _membershipError;
    private StudentSnapshot? _snapshot;
    private StudentPlan? _plan;
    private TimelineView? _timeline;
    private List<MembershipRow>? _memberships;
    private string _vufTone = "";

    private bool CanUseStudentUi =>
        Auth.IsAuthenticated
        && (Redirect.CurrentAppRole() == AppRole.Elev || ViewAs.IsActive);

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        ViewAs.Changed += OnViewAs;
        CourseContext.Changed += OnContext;
        EnsureAccess();
        await LoadElevDataAsync();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Elev && !ViewAs.IsActive)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task LoadElevDataAsync()
    {
        if (!Auth.IsInitialized || !CanUseStudentUi)
            return;

        await Task.WhenAll(LoadLectioAsync(), LoadMembershipsAsync());
    }

    private async Task LoadLectioAsync()
    {
        _lectioLoading = true;
        _linked = false;
        _lectioId = null;
        _snapshot = null;
        _plan = null;
        _timeline = null;
        _planError = null;
        _vufTone = "";
        try
        {
            if (ViewAs.IsActive)
            {
                await LoadViewAsLectioAsync(ViewAs.LectioId!);
                return;
            }

            var meRes = await Http.GetAsync("lectio/me");
            if (!meRes.IsSuccessStatusCode)
            {
                _linked = false;
                return;
            }

            var meBody = await meRes.Content.ReadAsStringAsync();
            _lectioId = Studieplan.ExtractLectioId(meBody);
            _linked = !string.IsNullOrWhiteSpace(_lectioId);
            if (!_linked)
                return;

            var studentRes = await Http.GetAsync("lectio/me/student");
            if (studentRes.IsSuccessStatusCode)
            {
                var studentBody = await studentRes.Content.ReadAsStringAsync();
                _snapshot = Studieplan.ParseStudentSnapshot(studentBody);
                if (!string.IsNullOrWhiteSpace(_snapshot?.LectioId))
                    _lectioId = _snapshot.LectioId;
                ApplyVufTone();
            }

            await LoadStudieplanAsync(_lectioId!);
        }
        catch
        {
            _linked = false;
        }
        finally
        {
            _lectioLoading = false;
        }
    }

    private async Task LoadViewAsLectioAsync(string lectioId)
    {
        _lectioId = lectioId;
        _linked = true;
        try
        {
            var listRes = await Http.GetAsync("lectio/programmeringselever");
            var listBody = await listRes.Content.ReadAsStringAsync();
            if (listRes.IsSuccessStatusCode)
            {
                _snapshot = Studieplan.FindStudentSnapshot(listBody, lectioId)
                    ?? new StudentSnapshot(
                        LectioId: lectioId,
                        Name: ViewAs.DisplayName,
                        ClassName: ViewAs.ClassName,
                        WorkplaceName: null,
                        ForloebName: null,
                        ForloebDates: null,
                        ForloebStart: null,
                        ForloebEnd: null,
                        Vuf: new VufStatus(null, null, null, null));
                ApplyVufTone();
            }
            else
            {
                _snapshot = new StudentSnapshot(
                    LectioId: lectioId,
                    Name: ViewAs.DisplayName,
                    ClassName: ViewAs.ClassName,
                    WorkplaceName: null,
                    ForloebName: null,
                    ForloebDates: null,
                    ForloebStart: null,
                    ForloebEnd: null,
                    Vuf: new VufStatus(null, null, null, null));
            }

            await LoadStudieplanAsync(lectioId);
        }
        catch
        {
            _linked = true;
            _snapshot ??= new StudentSnapshot(
                LectioId: lectioId,
                Name: ViewAs.DisplayName,
                ClassName: ViewAs.ClassName,
                WorkplaceName: null,
                ForloebName: null,
                ForloebDates: null,
                ForloebStart: null,
                ForloebEnd: null,
                Vuf: new VufStatus(null, null, null, null));
        }
    }

    private void ApplyVufTone()
    {
        _vufTone = _snapshot?.Vuf.Ok switch
        {
            true => "is-ok",
            false => "is-bad",
            _ => _snapshot?.Vuf.IsMissing == true ? "is-missing" : ""
        };
    }

    private async Task LoadStudieplanAsync(string lectioId)
    {
        _planLoading = true;
        _planError = null;
        try
        {
            var res = await Http.GetAsync($"lectio/students/{Uri.EscapeDataString(lectioId)}/studieplan");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _planError = $"Studieplan kunne ikke hentes ({(int)res.StatusCode}).";
                return;
            }

            _plan = Studieplan.ParsePlan(body);
            _timeline = Studieplan.BuildTimeline(_plan.Periods);
        }
        catch (Exception ex)
        {
            _planError = ex.Message;
        }
        finally
        {
            _planLoading = false;
        }
    }

    private async Task LoadMembershipsAsync()
    {
        if (!Auth.IsInitialized || !CanUseStudentUi)
            return;

        _membershipError = null;
        try
        {
            var url = ViewAs.IsActive && ViewAs.AuthSub is Guid sub
                ? $"me/memberships?asUser={sub:D}"
                : "me/memberships";
            // Under view-as uden Auth-kobling: ingen elev-medlemskaber at vise.
            if (ViewAs.IsActive && ViewAs.AuthSub is null)
            {
                _memberships = [];
                return;
            }

            _memberships = await Http.GetFromJsonAsync<List<MembershipRow>>(url) ?? [];
        }
        catch (Exception ex)
        {
            _memberships = [];
            _membershipError = ex.Message;
        }
    }

    private string HeroLead()
    {
        if (!_linked)
            return "Kobl Lectio, se din VUF og følg forløbene på én tidslinje.";
        if (_snapshot?.Vuf.Ok == false)
            return "Du mangler VUF ifølge Lectio — se status og din tidslinje herunder.";
        if (_snapshot?.Vuf.Ok == true)
            return "VUF er på plads. Her er dit overblik over hold, forløb og næste skridt.";
        if (_timeline?.Bars.Any(b => b.IsCurrent) == true)
            return "Du er midt i et forløb — tidslinjen viser, hvor du står, og hvad der venter.";
        return "Dit overblik over Lectio-kobling, VUF og gang gennem uddannelsen.";
    }

    private NextStep ResolveNextStep()
    {
        if (!_linked)
            return new NextStep("Kobl Lectio", "Få skema, VUF og studieplan med over", "/lectio", "Kobl Lectio");

        if (_snapshot?.Vuf.Ok == false)
            return new NextStep("Få VUF på plads", "Lectio siger, at du mangler VUF", "/lectio", "Se VUF i Lectio");

        if (ActiveCourse is not null)
            return new NextStep("Fortsæt forløbet", ActiveCourse.Name, $"/learning/{ActiveCourse.Id}", "Åbn mit forløb");

        if (_memberships is { Count: > 0 })
        {
            var m = _memberships[0];
            return new NextStep("Åbn dit hold", m.ForloebName, $"/courses/{m.ForloebId}", "Åbn hold");
        }

        var current = _timeline?.Bars.FirstOrDefault(b => b.IsCurrent);
        if (current is not null)
            return new NextStep("Du er i gang", current.Name, "/learning", "Udforsk læring");

        return new NextStep("Udforsk læring", "Find dit næste kapitel", "/learning", "Udforsk forløb");
    }

    private void OnContext() => InvokeAsync(StateHasChanged);

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        await LoadElevDataAsync();
        StateHasChanged();
    });

    private void OnViewAs() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        await LoadElevDataAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        ViewAs.Changed -= OnViewAs;
        CourseContext.Changed -= OnContext;
    }

    private sealed record MembershipRow(Guid Id, Guid HoldId, string HoldName, Guid ForloebId, string ForloebName, string Source, DateTimeOffset CreatedAtUtc);
    private sealed record NextStep(string Title, string Detail, string Href, string Label);
}
