@page "/student"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Mercantec.Tech.Web.Lectio
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@inject HttpClient Http
@inject LearningContext CourseContext
@inject DemoWorld World
@implements IDisposable

<PageTitle>Dit overblik · LUP</PageTitle>

@if (!Auth.IsInitialized) { <p>Indlæser…</p> }
else if (!Auth.IsAuthenticated) { <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p> }
else if (!CanUseStudentUi) { <p><a href="@Redirect.PostLoginPath()">Gå til dit overblik</a></p> }
else
{
    var displayName = ViewAs.IsActive ? ViewAs.DisplayName : Auth.DisplayName;
    var firstName = string.IsNullOrEmpty(displayName) ? null : displayName.Split(' ')[0];

    <div class="student-home">
        <header class="page-title"><div><h1>Goddag@(string.IsNullOrEmpty(firstName) ? "" : $", {firstName}").</h1><p>Din dag, dit næste skridt og plads til at bygge videre.</p></div><a class="secondary student-activities-link" href="/notifications"><UiIcon Name="check" />Mine handlinger</a></header>
        <div class="cols student-dashboard">
            <div class="student-main">
                <section class="panel student-holds" aria-labelledby="student-holds-title">
                    <div class="student-panel-head"><div><h2 id="student-holds-title">Mine hold</h2><p>Din undervisning, dine quests og dine grupper samlet.</p></div><a class="student-panel-link" href="/courses">Se alle hold <UiIcon Name="arrow" /></a></div>
                    @if (_membershipError is not null) { <p class="student-inline-note" role="alert">Dine hold kunne ikke hentes.</p><button type="button" class="student-retry" @onclick="LoadMembershipsAsync">Prøv igen</button> }
                    else if (_memberships is null) { <p class="student-inline-note" role="status">Henter dine hold…</p> }
                    else if (_memberships.Count == 0) { <p class="student-inline-note">@(ViewAs.IsActive && ViewAs.AuthSub is null ? "Denne elevprofil har endnu ingen tilknyttet LUP-konto. Åbn et hold med din underviseradgang for at se elevvisningen." : "Når en underviser tilføjer dig til et hold, finder du det her. Kontakt underviseren, hvis dit hold mangler.")</p> }
                    else { @foreach (var m in _memberships) { <div class="row student-hold-row"><span class="mark"><UiIcon Name="book" /></span><div><h3><a href="/courses/@m.ForloebId">@m.ForloebName</a></h3>@if (m.HoldName != m.ForloebName) { <p>@m.HoldName</p> }<nav class="student-hold-links" aria-label="@($"Genveje til {m.ForloebName}")"><a href="/courses/@m.ForloebId?view=content">Forløb</a><a href="/courses/@m.ForloebId?view=quests">Quests og afleveringer</a><a href="/courses/@m.ForloebId?view=groups">Grupper</a></nav></div><a class="secondary" href="/courses/@m.ForloebId" aria-label="@($"Åbn holdet {m.ForloebName}")">Åbn hold</a></div> } }
                </section>
                @if (!ViewAs.IsActive)
                {
                    <section class="panel"><h2>Din notesbog</h2><p>Saml dine faglige noter og skriv logbog. Alle undervisere kan læse og kommentere.</p><div class="actions"><a class="action" href="/notebook">Åbn min notesbog</a><a class="secondary" href="/journal">Skriv logbog</a></div></section>
                }
                @if (ActiveCourse is not null)
                {
                    <section class="v3-next" aria-labelledby="student-course-title"><div class="v3-next-copy"><span class="pill">Eksempelforløb · @ActiveCourse.Name</span><h2 id="student-course-title">@(ActiveCourse.Id == "h3" ? "Fra sensor til noget, der virker." : "Byg et spil. Forstå valgene.")</h2><p>@ActiveCourse.Desc</p><div class="actions"><a class="action" href="/learning/@ActiveCourse.Id">Udforsk eksempelforløb <UiIcon Name="arrow" /></a></div><div class="v3-quick-links"><a href="/calendar">Eksempeluge</a><a href="/afleveringer">Quests og afleveringer</a><a href="/journal">Min logbog</a></div></div><img src="lup/assets/@LearningContent.Cover(ActiveCourse.Id)" alt="@(ActiveCourse.Id == "h3" ? "Elektronik og enheder fra H3-forløbet" : "Spilverden fra Game Design-forløbet")" /></section>
                }
                else
                {
                    <section class="hero-empty"><h2>Dit næste kapitel starter her</h2><p>Udforsk faglige emner, og byg videre i dit univers, mens du venter på dit næste forløb.</p><div class="actions"><a class="action" href="/learning">Udforsk forløb</a><a class="secondary" href="/projects/mine">Mine projekter</a></div></section>
                }
                <nav class="dashboard-links" aria-label="Genveje til din dag"><a href="/learning"><UiIcon Name="book" /><h2>Min læring</h2><p>Forløb, fag og emner</p></a>@if (ActiveCourse is not null) { <a href="/calendar"><UiIcon Name="calendar" /><h2>Min uge</h2><p>Undervisning og quests</p></a> }<a href="/projects/mine"><UiIcon Name="code" /><h2>Mine projekter</h2><p>Fra idé til løsning</p></a></nav>

                <section class="panel student-lectio" aria-labelledby="student-lectio-title" aria-busy="@DemoWorld.Pressed(_lectioLoading)">
                    <div class="student-panel-head"><div><h2 id="student-lectio-title">Lectio og VUF</h2><p>Dit skema, din klasse og din status fra Lectio.</p></div>@if (_linked) { <a class="student-panel-link" href="/lectio">Åbn Lectio <UiIcon Name="arrow" /></a> }</div>
                    @if (_lectioLoading) { <p class="student-inline-note" role="status">Henter dine Lectio-oplysninger…</p> }
                    else if (!_linked)
                    {
                        <div class="student-link-prompt"><span class="mark"><UiIcon Name="calendar" /></span><div><h3>@(_lectioError is null ? "Dit skema kan følge med" : "Lectio kunne ikke hentes")</h3><p>@(_lectioError ?? "Kobl din Lectio-profil for at se din klasse, VUF og studieplan her.")</p></div>@if (_lectioError is null) { <a class="secondary" href="/lectio">Kobl Lectio</a> } else { <button type="button" class="secondary" @onclick="LoadElevDataAsync">Prøv igen</button> }</div>
                    }
                    else
                    {
                        <div class="student-lectio-grid">
                            <div class="student-lectio-profile"><span class="student-status-caption">Din Lectio-profil</span><div class="student-profile-line"><strong>@(_snapshot?.ClassName ?? "Din elevprofil")</strong><span class="pill green">Koblet</span></div>@if (!string.IsNullOrWhiteSpace(_snapshot?.ForloebName)) { <p>@_snapshot.ForloebName</p> }@if (!string.IsNullOrWhiteSpace(_snapshot?.ForloebDates)) { <small>@_snapshot.ForloebDates</small> }</div>
                            <div class="student-vuf @_vufTone">
                                <span class="student-status-caption">VUF</span>
                                @if (_lectioError is not null) { <p class="student-inline-note" role="status">@_lectioError</p><button type="button" class="student-retry" @onclick="LoadElevDataAsync">Prøv igen</button> }
                                else if (_snapshot?.Vuf is { IsMissing: true } or null) { <p class="student-inline-note">Der er ingen VUF-oplysninger i Lectio lige nu.</p> }
                                else
                                {
                                    var vuf = _snapshot!.Vuf;
                                    var width = Studieplan.VufWidth(vuf);
                                    <div class="student-vuf-readout"><strong>@(vuf.Earned?.ToString() ?? "?")<span> / @(vuf.Required?.ToString() ?? "?")</span></strong><span class="student-vuf-state">@(vuf.Ok == true ? "Du har VUF nok" : vuf.Ok == false ? "Du mangler VUF" : "VUF-status ukendt")</span></div>
                                    @if (width is double w) { <div class="student-vuf-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(w))" aria-label="VUF-fremgang"><span style="width:@(w.ToString("0.###", CultureInfo.InvariantCulture))%"></span></div><small class="student-vuf-percent">@(vuf.Percent is double p ? p.ToString("0.#", Danish) : w.ToString("0.#", Danish)) %</small> }
                                }
                            </div>
                        </div>
                    }
                </section>

                <details class="panel student-timeline-panel">
                    <summary><span><strong>Din forløbstidslinje</strong><small>@(_timeline?.Bars.FirstOrDefault(b => b.IsCurrent)?.Name ?? (_plan?.Periods.Count > 0 ? $"{_plan.Periods.Count} forløb i din studieplan" : "Dine skoleperioder fra Lectio"))</small></span><UiIcon Name="calendar" /><span class="student-disclosure" aria-hidden="true">⌄</span></summary>
                    <div class="student-timeline-content">
                        @if (_lectioLoading || _planLoading) { <p class="student-inline-note" role="status">Henter studieplan…</p> }
                        else if (!_linked && _lectioError is not null) { <p class="student-inline-note" role="status">@_lectioError</p><button type="button" class="student-retry" @onclick="LoadElevDataAsync">Prøv igen</button> }
                        else if (!_linked) { <p class="student-inline-note">Kobl din Lectio-profil for at se, hvor du er i uddannelsen, og hvad der kommer.</p><a class="student-panel-link" href="/lectio">Åbn Lectio <UiIcon Name="arrow" /></a> }
                        else if (_planError is not null) { <p class="student-inline-note" role="status">@_planError</p><button type="button" class="student-retry" @onclick="LoadElevDataAsync">Prøv igen</button> }
                        else if (_plan is null || _plan.Periods.Count == 0) { <p class="student-inline-note">Der er ingen forløb med datoer i din studieplan endnu.</p> }
                        else { @if (!string.IsNullOrWhiteSpace(_plan.ClassName)) { <p class="student-plan-class">@_plan.ClassName</p> }<ForloebTimeline Timeline="_timeline" /> }
                    </div>
                </details>
            </div>

            <aside class="aside student-universe" aria-label="Din udvikling og dit univers">
                <section class="panel student-progress"><h2>Din udvikling</h2><div class="v3-wallet-panel"><div><strong>@DemoCatalog.Level</strong><span>Level</span></div><div class="v3-gold"><strong>@World.Gold.ToString("N0", Danish)</strong><span>Guld</span></div></div><div class="student-xp-total"><strong>@DemoCatalog.Xp.ToString("N0", Danish) XP</strong><span>i alt</span></div><div class="v3-level-track" role="progressbar" aria-label="XP i dit nuværende level" aria-valuemin="0" aria-valuemax="@XpPerLevel" aria-valuenow="@XpInLevel"><span style="width:@(XpInLevel * 100 / XpPerLevel)%"></span></div><p class="student-next-level">@XpRemaining XP til level @(DemoCatalog.Level + 1)</p><a href="/progress">Se XP og belønninger</a></section>
                <section class="panel student-avatar"><h2>Dit eget sted</h2><div class="person"><AvatarSprite /><p>Din figur og dine idéer har også et hjem her.</p></div><div class="actions"><a class="secondary" href="/profile/character">Min avatar</a><a class="secondary" href="/apartment">Min lejlighed</a></div></section>
                <section class="panel student-next-badge"><h2>Dit næste badge</h2><BadgeMark Rank="NextBadge.Rank" Icon="@NextBadge.Icon" /><h3>@NextBadge.Name</h3><p>@NextBadge.Desc</p><a class="student-panel-link" href="/badges/@NextBadge.Id">Se dit næste skridt <UiIcon Name="arrow" /></a><a class="student-badge-collection" href="/progress/badges">Se dine @EarnedBadges badges</a></section>
            </aside>
        </div>
    </div>
}

@code {
    private DemoCatalog.Course? ActiveCourse => DemoCatalog.Courses.FirstOrDefault(c => c.Id == CourseContext.CourseId);

    private static readonly CultureInfo Danish = CultureInfo.GetCultureInfo("da-DK");
    private const int XpPerLevel = 200;
    private int XpInLevel => DemoCatalog.Xp % XpPerLevel;
    private int XpRemaining => XpPerLevel - XpInLevel;
    private int EarnedBadges => DemoCatalog.Badges.Count(b => b.Rank > 0);
    private DemoCatalog.Badge NextBadge => DemoCatalog.Badges.First(b => b.Id == (ActiveCourse?.Id == "game" ? "gdd" : "mqtt"));
    private string? _lectioError;
    private bool _linked;
    private bool _lectioLoading;
    private bool _planLoading;
    private string? _lectioId;
    private string? _planError;
    private string? _membershipError;
    private StudentSnapshot? _snapshot;
    private StudentPlan? _plan;
    private TimelineView? _timeline;
    private List<MembershipRow>? _memberships;
    private string _vufTone = "";

    private bool CanUseStudentUi =>
        Auth.IsAuthenticated
        && (Redirect.CurrentAppRole() == AppRole.Elev || ViewAs.IsActive);

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        ViewAs.Changed += OnViewAs;
        CourseContext.Changed += OnContext;
        World.Changed += OnContext;
        await World.EnsureAsync();
        EnsureAccess();
        await LoadElevDataAsync();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo(Auth.LoginPath());
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Elev && !ViewAs.IsActive)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task LoadElevDataAsync()
    {
        if (!Auth.IsInitialized || !CanUseStudentUi)
            return;

        await Task.WhenAll(LoadLectioAsync(), LoadMembershipsAsync());
    }

    private async Task LoadLectioAsync()
    {
        _lectioLoading = true;
        _lectioError = null;
        _linked = false;
        _lectioId = null;
        _snapshot = null;
        _plan = null;
        _timeline = null;
        _planError = null;
        _vufTone = "";
        try
        {
            if (ViewAs.IsActive)
            {
                await LoadViewAsLectioAsync(ViewAs.LectioId!);
                return;
            }

            var meRes = await Http.GetAsync("lectio/me");
            if (!meRes.IsSuccessStatusCode)
            {
                _lectioError = "Din Lectio-status kunne ikke hentes. Prøv igen om lidt.";
                return;
            }

            var meBody = await meRes.Content.ReadAsStringAsync();
            _lectioId = Studieplan.ExtractLectioId(meBody);
            _linked = !string.IsNullOrWhiteSpace(_lectioId);
            if (!_linked)
                return;

            var studentRes = await Http.GetAsync("lectio/me/student");
            if (studentRes.IsSuccessStatusCode)
            {
                var studentBody = await studentRes.Content.ReadAsStringAsync();
                _snapshot = Studieplan.ParseStudentSnapshot(studentBody);
                if (!string.IsNullOrWhiteSpace(_snapshot?.LectioId))
                    _lectioId = _snapshot.LectioId;
                ApplyVufTone();
            }

            else
            {
                _lectioError = "Dine Lectio-oplysninger kunne ikke hentes. Prøv igen om lidt.";
            }

            await LoadStudieplanAsync(_lectioId!);
        }
        catch
        {
            _lectioError = "Forbindelsen til Lectio er afbrudt. Prøv igen om lidt.";
        }
        finally
        {
            _lectioLoading = false;
        }
    }

    private async Task LoadViewAsLectioAsync(string lectioId)
    {
        _lectioId = lectioId;
        _linked = true;
        try
        {
            var listRes = await Http.GetAsync("lectio/programmeringselever");
            var listBody = await listRes.Content.ReadAsStringAsync();
            if (listRes.IsSuccessStatusCode)
            {
                _snapshot = Studieplan.FindStudentSnapshot(listBody, lectioId)
                    ?? new StudentSnapshot(
                        LectioId: lectioId,
                        Name: ViewAs.DisplayName,
                        ClassName: ViewAs.ClassName,
                        WorkplaceName: null,
                        ForloebName: null,
                        ForloebDates: null,
                        ForloebStart: null,
                        ForloebEnd: null,
                        Vuf: new VufStatus(null, null, null, null));
                ApplyVufTone();
            }
            else
            {
                _snapshot = new StudentSnapshot(
                    LectioId: lectioId,
                    Name: ViewAs.DisplayName,
                    ClassName: ViewAs.ClassName,
                    WorkplaceName: null,
                    ForloebName: null,
                    ForloebDates: null,
                    ForloebStart: null,
                    ForloebEnd: null,
                    Vuf: new VufStatus(null, null, null, null));
            }

            await LoadStudieplanAsync(lectioId);
        }
        catch
        {
            _linked = true;
            _snapshot ??= new StudentSnapshot(
                LectioId: lectioId,
                Name: ViewAs.DisplayName,
                ClassName: ViewAs.ClassName,
                WorkplaceName: null,
                ForloebName: null,
                ForloebDates: null,
                ForloebStart: null,
                ForloebEnd: null,
                Vuf: new VufStatus(null, null, null, null));
        }
    }

    private void ApplyVufTone()
    {
        _vufTone = _snapshot?.Vuf.Ok switch
        {
            true => "is-ok",
            false => "is-bad",
            _ => _snapshot?.Vuf.IsMissing == true ? "is-missing" : ""
        };
    }

    private async Task LoadStudieplanAsync(string lectioId)
    {
        _planLoading = true;
        _planError = null;
        try
        {
            var res = await Http.GetAsync($"lectio/students/{Uri.EscapeDataString(lectioId)}/studieplan");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                _planError = "Din studieplan kunne ikke hentes. Prøv igen om lidt.";
                return;
            }

            _plan = Studieplan.ParsePlan(body);
            _timeline = Studieplan.BuildTimeline(_plan.Periods);
        }
        catch
        {
            _planError = "Din studieplan kunne ikke hentes. Prøv igen om lidt.";
        }
        finally
        {
            _planLoading = false;
        }
    }

    private async Task LoadMembershipsAsync()
    {
        if (!Auth.IsInitialized || !CanUseStudentUi)
            return;

        _membershipError = null;
        try
        {
            var url = ViewAs.IsActive && ViewAs.AuthSub is Guid sub
                ? $"me/memberships?asUser={sub:D}"
                : "me/memberships";
            // Under view-as uden Auth-kobling: ingen elev-medlemskaber at vise.
            if (ViewAs.IsActive && ViewAs.AuthSub is null)
            {
                _memberships = [];
                return;
            }

            _memberships = await Http.GetFromJsonAsync<List<MembershipRow>>(url) ?? [];
        }
        catch (Exception ex)
        {
            _memberships = [];
            _membershipError = ex.Message;
        }
    }

    private void OnContext() => InvokeAsync(StateHasChanged);

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        await LoadElevDataAsync();
        StateHasChanged();
    });

    private void OnViewAs() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        await LoadElevDataAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        ViewAs.Changed -= OnViewAs;
        CourseContext.Changed -= OnContext;
        World.Changed -= OnContext;
    }

    private sealed record MembershipRow(Guid Id, Guid HoldId, string HoldName, Guid ForloebId, string ForloebName, string Source, DateTimeOffset CreatedAtUtc);
}
