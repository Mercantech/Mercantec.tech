@page "/student"
@using System.Text.Json
@using System.Net.Http.Json
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@inject HttpClient Http
@inject DemoWorld World
@using Mercantec.Tech.Web.Demo
@using Mercantec.Tech.Web.Pages.Demo
@implements IDisposable

<PageTitle>Elev</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <header class="page-title"><div><h1>Goddag@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName.Split(' ')[0]}")</h1><p>Dine hold fra platformen. Quests og XP i menuen er eksempelindhold.</p></div></header>

    @if (_showLectioCta)
    {
        <div class="callout">
            <p>Kobl din Lectio-profil for at se dine elevdata her.</p>
            <a class="action" href="/lectio">Kobl Lectio</a>
        </div>
    }

    <section class="panel">
        <h2>Mine medlemskaber</h2>
        @if (_membershipError is not null)
        {
            <p>@_membershipError</p>
        }
        else if (_memberships is null)
        {
            <p>Henter…</p>
        }
        else if (_memberships.Count == 0)
        {
            <div class="empty"><h2>Ingen hold endnu</h2><p>Når en underviser tilføjer dig, vises holdet her.</p></div>
        }
        else
        {
            @foreach (var m in _memberships)
            {
                <div class="row">
                    <span class="mark"><span class="mark-glyph">@(string.IsNullOrEmpty(m.ForloebName) ? "?" : m.ForloebName[..1])</span></span>
                    <div><h3><a href="@($"/courses/{m.ForloebId}")">@m.ForloebName</a></h3><p>@m.HoldName · @m.Source</p></div>
                    <a class="secondary" href="@($"/courses/{m.ForloebId}")">Åbn</a>
                </div>
            }
        }
    </section>

    <section class="panel" style="margin-top:18px">
        <DemoTodo Text="Avataren, lejligheden og butikken er en demo. De gemmes kun i denne browser." />
        <div class="cols">
            <a class="tile" href="/profile/character">
                <div class="v2-home-sprite"><AvatarSprite /></div>
                <h2>Din avatar</h2>
                <p>Hud, hår og garderobe følger med i prøvespillet.</p>
            </a>
            <a class="tile" href="/apartment">
                <h2>Din lejlighed</h2>
                <p>Placér, flyt og fjern møbler i rummet på 8×6 felter.</p>
            </a>
            <a class="tile" href="/universe/shop">
                <h2>Butik</h2>
                <p>Køb tøj og møbler for demo-guld.</p>
            </a>
        </div>
    </section>
}

@code {
    private bool _showLectioCta;
    private string? _membershipError;
    private List<MembershipRow>? _memberships;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        World.Changed += OnWorld;
        EnsureAccess();
        await World.EnsureAsync();
        await CheckLectioLinkAsync();
        await LoadMembershipsAsync();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Elev)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task CheckLectioLinkAsync()
    {
        _showLectioCta = false;
        if (!Auth.IsInitialized || !Auth.IsAuthenticated || Redirect.CurrentAppRole() != AppRole.Elev)
            return;

        try
        {
            var res = await Http.GetAsync("lectio/me");
            if (!res.IsSuccessStatusCode)
            {
                _showLectioCta = true;
                return;
            }

            var body = await res.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(body);
            if (!doc.RootElement.TryGetProperty("lectio", out var lectio)
                || lectio.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
            {
                _showLectioCta = true;
                return;
            }

            _showLectioCta = !(lectio.TryGetProperty("lectioId", out var id)
                               && id.ValueKind == JsonValueKind.String
                               && !string.IsNullOrWhiteSpace(id.GetString()));
        }
        catch
        {
            _showLectioCta = true;
        }
    }

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        await CheckLectioLinkAsync();
        await LoadMembershipsAsync();
        StateHasChanged();
    });

    private async Task LoadMembershipsAsync()
    {
        if (!Auth.IsInitialized || !Auth.IsAuthenticated || Redirect.CurrentAppRole() != AppRole.Elev)
            return;

        _membershipError = null;
        try
        {
            _memberships = await Http.GetFromJsonAsync<List<MembershipRow>>("me/memberships") ?? [];
        }
        catch (Exception ex)
        {
            _memberships = [];
            _membershipError = ex.Message;
        }
    }

    private void OnWorld() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        World.Changed -= OnWorld;
    }

    private sealed record MembershipRow(Guid Id, Guid HoldId, string HoldName, Guid ForloebId, string ForloebName, string Source, DateTimeOffset CreatedAtUtc);
}
