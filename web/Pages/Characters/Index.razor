@page "/characters"
@using Mercantec.Tech.Web.Characters

<PageTitle>Karakterer · LUP</PageTitle>
<div class="characters">
    <header class="characters-intro">
        <p class="characters-eyebrow">LUPs univers</p>
        <h1>Mød karaktererne</h1>
        <p>Mød underviserne i Game Design, SQL, backendprogrammering, Machine Learning, IoT og embedded, cybersikkerhed, softwaretest og DevNet. Lær at fejlfinde med Gummianden, og se, hvad Vatson arbejder med hos VATek.</p>
        <a class="characters-library-link" href="/library?category=characters">Karakterer i Oversigt <span aria-hidden="true">→</span></a>
    </header>

    <div class="character-grid">
        @foreach (var character in CharacterCatalog.All)
        {
            <CharacterCard Character="@character" />
        }
    </div>

    <p class="characters-footnote">Vælg en karakter for at se mere om deres fag, personlighed og plads i undervisningen.</p>
</div>
