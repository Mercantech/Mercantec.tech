@page "/characters/{Slug}"
@using Mercantec.Tech.Web.Characters
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

@if (_character is not { } character)
{
    <PageTitle>Karakteren blev ikke fundet · LUP</PageTitle>
    <div class="characters character-not-found">
        <h1>Karakteren blev ikke fundet</h1>
        <p>Find underviserne og hjælperne på karaktersiden.</p>
        <a class="action" href="/characters">Se alle karakterer</a>
    </div>
}
else
{
    <PageTitle>@character.Name · Karakterer · LUP</PageTitle>
    <div class="characters character-detail character-@character.Slug" @key="character.Slug">
        <nav class="character-breadcrumbs" aria-label="Brødkrumme">
            <a href="/library?category=characters">Oversigt</a><span aria-hidden="true">/</span>
            <a href="/characters">Karakterer</a><span aria-hidden="true">/</span><span aria-current="page">@character.Name</span>
        </nav>
        <section class="character-hero" aria-labelledby="character-name">
            <div class="character-portrait-panel">
                <div class="character-art character-main-art">
                    @if (SelectedAppearance is { } portrait)
                    {
                        <img src="@portrait.Image" alt="@portrait.Alt" width="384" height="384" />
                    }
                    @if (character.ComingSoon) { <span class="character-status">På vej</span> }
                </div>
                @if (character.Appearances.Count > 1)
                {
                    <div class="character-appearance-picker" role="group" aria-label="@($"Vælg udtryk for {character.Name}")">
                        @for (var i = 0; i < character.Appearances.Count; i++)
                        {
                            var index = i;
                            var appearance = character.Appearances[index];
                            <button type="button" aria-pressed="@(_appearanceIndex == index ? "true" : "false")" @onclick="() => _appearanceIndex = index">
                                <img src="@appearance.Image" alt="" width="64" height="64" loading="lazy" />
                                <span>@appearance.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="character-bio">
                <p class="characters-eyebrow">@character.Home</p>
                <h1 id="character-name">@character.Name</h1>
                <p class="character-subtitle">@character.Role</p>
                <p class="character-description">@character.Description</p>
                <ul class="character-tags" aria-label="Kendetegn">
                    @foreach (var tag in character.Tags) { <li>@tag</li> }
                </ul>
                <div class="character-links">
                    @foreach (var link in character.Links)
                    {
                        <a class="secondary" href="@link.Href" target="@(link.External ? "_blank" : null)" rel="@(link.External ? "noopener noreferrer" : null)">
                            @link.Label
                            @if (link.External) { <span class="character-link-icon" aria-hidden="true">↗</span><span class="visually-hidden"> (åbner i ny fane)</span> }
                        </a>
                    }
                </div>
                @if (!Auth.IsAuthenticated && character.Links.Any(link => link.RequiresLogin))
                {
                    <p class="character-login-note">Log ind i LUP for at bruge værktøjerne.</p>
                }
            </div>
        </section>

        <div class="character-features">
            @foreach (var feature in character.Features)
            {
                <section><h2>@feature.Title</h2><p>@feature.Description</p></section>
            }
        </div>

        @if (ArenaFighters.ForCharacter(character.Path) is { } fighter)
        {
            var requirements = ArenaFighters.Requirements(fighter.Id);
            <section class="character-arena" aria-labelledby="character-arena-title">
                <div class="character-arena-info">
                    <span class="character-arena-icon"><UiIcon Name="game" /></span>
                    <div>
                        <h2 id="character-arena-title">@fighter.Name i LUP Arena</h2>
                        @if (requirements.Count > 0)
                        {
                            <ul class="character-arena-requirements" aria-label="Krav for at låse karakteren op">
                                @foreach (var requirement in requirements)
                                {
                                    <li>@requirement</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="character-arena-links">
                    <a class="action" href="@ArenaFighters.PlayPath">Åbn Arena</a>
                    <a class="secondary" href="@ArenaFighters.RosterPath">Se alle kæmpere</a>
                    <a class="secondary" href="@ArenaFighters.CollectionPath(fighter.Id)">Min avatarsamling</a>
                </div>
            </section>
        }

        <CharacterAnimationGallery CharacterSlug="@character.Slug" CharacterName="@character.Name" Subject="@character.AnimationSubject" Items="@character.Animations" />

        <CharacterArtworkGallery CharacterSlug="@character.Slug" HeadingId="character-reactions-title"
                                 Title="@($"{character.Name}s emojis og reaktioner")"
                                 Description="@(character.ReactionsDescription ?? "Små udtryk til både de gode idéer og den kode, der driller. Alle reaktioner har transparent baggrund. Åbn dem i fuld størrelse, eller hent en PNG.")"
                                 Items="@character.Reactions" Compact="true" LargePreviews="@character.LargeReactionPreviews" Searchable="@(character.Reactions.Count > 24)" />

        <CharacterArtworkGallery CharacterSlug="@character.Slug" HeadingId="character-scenes-title"
                                 Title="@($"{character.Name} i nye miljøer")"
                                 Description="@character.ScenesDescription"
                                 Items="@character.Scenes" />

        <CharacterIllustrationGallery CharacterSlug="@character.Slug" CharacterName="@character.Name"
                                      Description="@character.IllustrationsDescription" KindLabel="@character.IllustrationsLabel"
                                      Items="@character.Illustrations" />

        <nav class="character-other-profiles" aria-label="Mød de andre karakterer">
            <span>Mød også</span>
            @foreach (var other in CharacterCatalog.All.Where(item => item.Slug != character.Slug))
            {
                <a href="@other.Path">@other.Name <span aria-hidden="true">→</span></a>
            }
            <a class="character-all-link" href="/characters">Alle karakterer</a>
        </nav>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }
    private CharacterProfile? _character;
    private int _appearanceIndex;
    private string? _handledLocation;
    private (string Id, string Location)? _pendingSection;
    private CharacterAppearance? SelectedAppearance => _appearanceIndex == 0 ? _character?.DisplayPortrait : _character?.Appearances.ElementAtOrDefault(_appearanceIndex);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet()
    {
        var next = CharacterCatalog.Find(Slug);
        if (_character?.Slug != next?.Slug)
        {
            _appearanceIndex = 0;
            _handledLocation = null;
            _pendingSection = null;
        }
        _character = next;
        QueueSection(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() =>
    {
        if (args.Location == Nav.Uri && QueueSection(args.Location)) StateHasChanged();
    });

    private bool QueueSection(string location)
    {
        if (_character is not { } character || _handledLocation == location) return false;

        var uri = Nav.ToAbsoluteUri(location);
        var characterPath = Nav.ToAbsoluteUri(character.Path).AbsolutePath;
        if (!string.Equals(uri.AbsolutePath.TrimEnd('/'), characterPath, StringComparison.OrdinalIgnoreCase)) return false;

        _handledLocation = location;
        var fragment = Uri.UnescapeDataString(uri.Fragment.TrimStart('#'));
        var section = character.Materials.FirstOrDefault(material => material.SectionId == fragment)?.SectionId;
        _pendingSection = section is null ? null : (section, location);
        return _pendingSection.HasValue;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingSection is not { } section) return;
        _pendingSection = null;
        await Js.InvokeVoidAsync("lupCharacterUi.scrollToSection", section.Id, section.Location);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
