@page "/characters/{Slug}"
@using Mercantec.Tech.Web.Characters
@inject AuthService Auth

@if (_character is not { } character)
{
    <PageTitle>Karakteren blev ikke fundet · LUP</PageTitle>
    <div class="characters character-not-found">
        <h1>Karakteren blev ikke fundet</h1>
        <p>Find underviserne og hjælperne på karaktersiden.</p>
        <a class="action" href="/characters">Se alle karakterer</a>
    </div>
}
else
{
    <PageTitle>@character.Name · Karakterer · LUP</PageTitle>
    <div class="characters character-detail character-@character.Slug" @key="character.Slug">
        <nav class="character-breadcrumbs" aria-label="Brødkrumme">
            <a href="/characters">Karakterer</a><span aria-hidden="true">/</span><span aria-current="page">@character.Name</span>
        </nav>
        <section class="character-hero" aria-labelledby="character-name">
            <div class="character-portrait-panel">
                <div class="character-art character-main-art">
                    @if (SelectedAppearance is { } portrait)
                    {
                        <img src="@portrait.Image" alt="@portrait.Alt" width="384" height="384" />
                    }
                    @if (character.ComingSoon) { <span class="character-status">På vej</span> }
                </div>
                @if (character.Appearances.Count > 1)
                {
                    <div class="character-appearance-picker" role="group" aria-label="@($"Vælg udtryk for {character.Name}")">
                        @for (var i = 0; i < character.Appearances.Count; i++)
                        {
                            var index = i;
                            var appearance = character.Appearances[index];
                            <button type="button" aria-pressed="@(_appearanceIndex == index ? "true" : "false")" @onclick="() => _appearanceIndex = index">
                                <img src="@appearance.Image" alt="" width="64" height="64" loading="lazy" />
                                <span>@appearance.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="character-bio">
                <p class="characters-eyebrow">@character.Home</p>
                <h1 id="character-name">@character.Name</h1>
                <p class="character-subtitle">@character.Role</p>
                <p class="character-description">@character.Description</p>
                <ul class="character-tags" aria-label="Kendetegn">
                    @foreach (var tag in character.Tags) { <li>@tag</li> }
                </ul>
                <div class="character-links">
                    @foreach (var link in character.Links)
                    {
                        <a class="secondary" href="@link.Href" target="@(link.External ? "_blank" : null)" rel="@(link.External ? "noopener noreferrer" : null)">
                            @link.Label
                            @if (link.External) { <span class="character-link-icon" aria-hidden="true">↗</span><span class="visually-hidden"> (åbner i ny fane)</span> }
                        </a>
                    }
                </div>
                @if (!Auth.IsAuthenticated && character.Links.Any(link => link.RequiresLogin))
                {
                    <p class="character-login-note">Log ind i LUP for at bruge værktøjerne.</p>
                }
            </div>
        </section>

        <div class="character-features">
            @foreach (var feature in character.Features)
            {
                <section><h2>@feature.Title</h2><p>@feature.Description</p></section>
            }
        </div>

        <CharacterAnimationGallery CharacterSlug="@character.Slug" CharacterName="@character.Name" Items="@character.Animations" />

        <CharacterArtworkGallery CharacterSlug="@character.Slug" HeadingId="character-reactions-title"
                                 Title="@($"{character.Name}s emojis og reaktioner")"
                                 Description="Små udtryk til både de gode idéer og den kode, der driller. Alle reaktioner har transparent baggrund. Åbn dem i fuld størrelse, eller hent en PNG."
                                 Items="@character.Reactions" Compact="true" />

        <CharacterArtworkGallery CharacterSlug="@character.Slug" HeadingId="character-scenes-title"
                                 Title="@($"{character.Name} i nye miljøer")"
                                 Description="Fra en stille læsestund til et mysterium om en tabt række. Små fortællinger med professoren, som du kan åbne eller hente."
                                 Items="@character.Scenes" />

        @if (character.Illustrations.Count > 0)
        {
            <section class="character-gallery" aria-labelledby="character-gallery-title">
                <header>
                    <h2 id="character-gallery-title">@character.Name i undervisningen</h2>
                    <p>Illustrationer fra Game Design-forløbet. Vælg et billede for at se det i fuld størrelse.</p>
                </header>
                <div class="character-gallery-grid">
                    @foreach (var illustration in character.Illustrations)
                    {
                        <figure>
                            <a href="@illustration.Image" target="_blank" rel="noopener noreferrer" aria-label="@($"Se {illustration.Title} i fuld størrelse (åbner i ny fane)")">
                                <img src="@illustration.Image" alt="@illustration.Alt" width="@illustration.Width" height="@illustration.Height" loading="lazy" decoding="async" />
                            </a>
                            <figcaption>@illustration.Title</figcaption>
                        </figure>
                    }
                </div>
            </section>
        }

        <nav class="character-other-profiles" aria-label="Mød de andre karakterer">
            <span>Mød også</span>
            @foreach (var other in CharacterCatalog.All.Where(item => item.Slug != character.Slug))
            {
                <a href="@other.Path">@other.Name <span aria-hidden="true">→</span></a>
            }
            <a class="character-all-link" href="/characters">Alle karakterer</a>
        </nav>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }
    private CharacterProfile? _character;
    private int _appearanceIndex;
    private CharacterAppearance? SelectedAppearance => _character?.Appearances.ElementAtOrDefault(_appearanceIndex);

    protected override void OnParametersSet()
    {
        var next = CharacterCatalog.Find(Slug);
        if (_character?.Slug != next?.Slug) _appearanceIndex = 0;
        _character = next;
    }
}
