@page "/arena"
@page "/games/arena"
@layout ArenaLayout
@implements IAsyncDisposable

<PageTitle>LUP Arena</PageTitle>
<div class="arena-shell @(_screen == "main" ? "is-main" : "") @(IsBattle ? "is-battle" : "")" @onkeydown="MenuKey">
    <div class="arena-keyart" aria-hidden="true"></div>
    <header class="arena-topbar">
        <a href="/universe" class="arena-home" aria-label="Tilbage til LUP"><span class="arena-lup-mark">LUP</span><span>Tilbage til LUP</span></a>
        <div class="arena-top-actions">
            @if (_room is not null) { <span class="arena-room-tag">@_room.Code</span> }
            <button class="arena-icon-button" @onclick="ToggleSound" aria-label="@(_sound ? "Slå lyd fra" : "Slå lyd til")" aria-pressed="@(_sound ? "true" : "false")">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" />@if(_sound){<path d="M17 8c3 2 3 6 0 8M20 5c5 4 5 10 0 14" />}else{<path d="m17 9 5 6m0-6-5 6" />}</svg>
            </button>
            <button class="arena-account" @onclick="OpenFighters" disabled="@(_practice || _room is not null)"><img src="@Portrait(_selectedAvatarId)" alt="" /><span>@AccountName</span></button>
        </div>
    </header>
    @if (_error is not null) { <div class="arena-notice" role="alert"><span>@_error</span><button @onclick="ClearError" aria-label="Luk besked">×</button></div> }
    @if (_reconnecting) { <div class="arena-reconnecting" role="status">Forbinder igen…</div> }

    @if (_screen == "main")
    {
        <main class="arena-main-menu">
            <h1 class="arena-wordmark"><span>LUP</span>ARENA</h1>
            <nav class="arena-menu" aria-label="Spilmenu">
                <button class="arena-menu-button arena-menu-primary" @onclick="OpenOnline"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="m6 6 16 16M22 6 6 22M6 6h6M6 6v6m16-6h-6m6 0v6M6 22h6m-6 0v-6m16 6h-6m6 0v-6" /></svg><span>Spil online</span></button>
                <button class="arena-menu-button" @onclick="OpenSetup"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 21h20M8 21V9h12v12M11 9V5h6v4M11 14h6" /></svg><span>Træning</span></button>
                <button class="arena-menu-button" @onclick="OpenFighters"><svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="9" r="4"/><path d="M6 24v-4a8 8 0 0 1 16 0v4M9 24h10" /></svg><span>Kæmpere</span></button>
                <button class="arena-menu-button" @onclick="ShowSettings"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M5 8h18M5 20h18M10 4v8M19 16v8" /></svg><span>Indstillinger</span></button>
            </nav>
        </main>
    }

    @if (_screen is "setup" or "fighters")
    {
        <main class="arena-screen arena-selection-screen">
            <header class="arena-screen-header"><button class="arena-back" @onclick="Back"><span>‹</span> Tilbage</button><h1>@(_screen == "fighters" ? "Kæmpere" : "Træning")</h1><a href="/profile/character" class="arena-subtle-link">Min samling</a></header>
            <div class="arena-selection-layout">
                <section class="arena-roster" aria-label="Vælg kæmper">
                    @foreach (var avatar in AvatarCatalog.All)
                    {
                        var owned = Owns(avatar.Id);
                        <button class="arena-fighter @(_selectedAvatarId == avatar.Id ? "is-selected" : "")" disabled="@(!owned || _loading)" @onclick="() => SelectFighter(avatar.Id)" aria-pressed="@(_selectedAvatarId == avatar.Id ? "true" : "false")">
                            <img src="@Portrait(avatar.Id)" alt="" /><span><strong>@FighterName(avatar.Id)</strong><small>@(owned ? FighterRole(avatar.Id) : "Låst")</small></span><span class="arena-choice-mark">@(_selectedAvatarId == avatar.Id ? "✓" : "")</span>
                        </button>
                    }
                </section>
                <section class="arena-fighter-showcase" aria-label="@FighterName(_selectedAvatarId)"><img src="@Portrait(_selectedAvatarId)" alt="@FighterName(_selectedAvatarId)" /><div><h2>@FighterName(_selectedAvatarId)</h2><p>@FighterSpecial</p></div></section>
            </div>
            @if (_screen == "setup")
            {
                <section class="arena-stage-picker" aria-label="Vælg bane"><div class="arena-stage-cards">@foreach(var stage in ArenaCatalog.Stages) { <button class="arena-stage-card @(_stageId == stage.Id ? "is-selected" : "")" @onclick="() => SelectStage(stage.Id)" aria-pressed="@(_stageId == stage.Id ? "true" : "false")"><img src="@StageArt(stage.Id)" alt="" /><span>@stage.Name</span><i>@(_stageId == stage.Id ? "✓" : "")</i></button> }</div></section>
                <footer class="arena-screen-footer"><div class="arena-rules"><label>Liv <select @bind="_stocks"><option value="1">1</option><option value="3">3</option><option value="5">5</option></select></label><label>Tid <select @bind="_minutes"><option value="3">3 min.</option><option value="5">5 min.</option><option value="8">8 min.</option></select></label></div><button class="arena-action arena-action-gold" @onclick="StartTraining" disabled="@(_loading || !_artReady || _busy)">@(_loading ? "Indlæser…" : "Start")</button></footer>
            }
            else { <footer class="arena-screen-footer"><span></span><button class="arena-action arena-action-gold" @onclick="Back">Vælg</button></footer> }
        </main>
    }

    @if (_screen == "online")
    {
        <main class="arena-screen arena-online-screen">
            <header class="arena-screen-header"><button class="arena-back" @onclick="Back" disabled="@(_room is not null)"><span>‹</span> Tilbage</button><h1>@(_room is null ? "Spil online" : "Kamprum")</h1>@if (_room is not null) { <button class="arena-subtle-link" @onclick="LeaveRoom">Forlad</button> }</header>
            @if (_room is null)
            {
                <div class="arena-online-layout">
                    <section class="arena-online-form">
                        <button class="arena-selected-fighter" @onclick="OpenOnlineFighters"><img src="@Portrait(_selectedAvatarId)" alt="" /><span>@FighterName(_selectedAvatarId)</span><small>Skift</small></button>
                        @if (!Auth.IsAuthenticated) { <a class="arena-action arena-action-gold" href="@Auth.LoginPath()">Log ind</a> }
                        else
                        {
                            <button class="arena-action arena-action-gold" @onclick="CreateRoom" disabled="@(_busy || _loading || !_artReady)">@(_busy ? "Forbinder…" : "Opret rum")</button>
                            <label class="arena-public-option"><input type="checkbox" @bind="_isPublic" /> Offentligt rum</label>
                            <div class="arena-or"><span>eller</span></div>
                            <div class="arena-join"><input aria-label="Rumkode" placeholder="Rumkode" maxlength="6" @bind="_joinCode" @bind:event="oninput" @onkeydown="JoinKey" disabled="@_busy" /><button class="arena-action" @onclick="JoinRoom" disabled="@(_busy || _loading || !_artReady || _joinCode.Trim().Length != 6)">Deltag</button></div>
                            <button class="arena-subtle-link arena-refresh" @onclick="LoadRooms" disabled="@_busy">Åbne rum</button>
                            @if (_roomsLoaded) { <div class="arena-public-rooms">@if (_rooms.Count == 0) { <p>Ingen åbne rum.</p> }@foreach(var room in _rooms) { <button @onclick="() => JoinPublicRoom(room.Code)"><strong>@room.Code</strong><span>@room.Players.Count / 4</span></button> }</div> }
                        }
                    </section>
                    <section class="arena-online-stage" aria-label="Bane og regler"><div class="arena-stage-cards">@foreach(var stage in ArenaCatalog.Stages) { <button class="arena-stage-card @(_stageId == stage.Id ? "is-selected" : "")" @onclick="() => SelectStage(stage.Id)" aria-pressed="@(_stageId == stage.Id ? "true" : "false")"><img src="@StageArt(stage.Id)" alt="" /><span>@stage.Name</span><i>@(_stageId == stage.Id ? "✓" : "")</i></button> }</div><div class="arena-rules"><label>Liv <select @bind="_stocks"><option value="1">1</option><option value="3">3</option><option value="5">5</option></select></label><label>Tid <select @bind="_minutes"><option value="3">3 min.</option><option value="5">5 min.</option><option value="8">8 min.</option></select></label></div></section>
                </div>
            }
            else
            {
                <div class="arena-lobby-heading"><button class="arena-room-code" @onclick="CopyInvite" title="Kopiér invitation"><strong>@_room.Code</strong><span>@(_copied ? "Kopieret" : "Invitér")</span></button><span>@(_room.IsPublic ? "Offentligt" : "Privat")</span></div>
                <div class="arena-lobby-roster">@foreach(var player in _room.Players) { <article class="arena-lobby-player" style="--player-color:@player.Color"><img src="@Portrait(player.AvatarId)" alt="" /><div><h2>@player.Name</h2><p>@(player.IsBot ? "Computer" : player.Id == _room.HostId ? "Vært" : FighterName(player.AvatarId))</p></div><span class="arena-player-ready">@(!player.Connected ? "Forbinder…" : player.Ready ? "Klar" : "Venter")</span></article> }@for(var i=_room.Players.Count;i<4;i++){<div class="arena-lobby-empty"><span>+</span><p>Ledig plads</p></div>}</div>
                <div class="arena-lobby-bottom"><div class="arena-lobby-stage"><img src="@StageArt(_stageId)" alt="" /><span>@SelectedStage.Name</span><span>@_stocks liv · @_minutes min.</span></div><div class="arena-lobby-buttons">@if (_phase == "lobby") { if(IsHost) { <button class="arena-action arena-action-subtle" @onclick="AddBot" disabled="@(_room.Players.Count >= 4)">Tilføj computer</button> }<button class="arena-action @(_ready ? "arena-action-subtle" : "")" @onclick="ToggleReady">@(_ready ? "Klar ✓" : "Gør klar")</button>@if(IsHost) { <button class="arena-action arena-action-gold" @onclick="StartOnline" disabled="@(!_room.Players.All(p => p.Ready && p.Connected) || _room.Players.Count < 2)">Start</button> } }</div></div>
            }
        </main>
    }

    @if (_screen == "settings")
    {
        <main class="arena-screen arena-settings-screen"><header class="arena-screen-header"><button class="arena-back" @onclick="Back"><span>‹</span> Tilbage</button><h1>Indstillinger</h1></header><div class="arena-settings-layout"><section class="arena-settings-options"><button @onclick="ToggleSound"><span>Lyd</span><strong>@(_sound ? "Til" : "Fra")</strong></button><button @onclick="Fullscreen"><span>Fuld skærm</span><strong>Åbn</strong></button>@if (_practice || _room is not null) { <button class="arena-exit-action" @onclick="ReturnMain"><span>Afslut kamp</span></button> }</section><section class="arena-controls-detail" aria-label="Styring"><h2>Styring</h2><dl><div><dt>A / D</dt><dd>Bevæg</dd></div><div><dt>W / S</dt><dd>Retning</dd></div><div><dt>Space</dt><dd>Hop / dobbelthop</dd></div><div><dt>J</dt><dd>Angreb</dd></div><div><dt>K</dt><dd>Special</dd></div><div><dt>W + K</dt><dd>Redningshop</dd></div><div><dt>Hold I</dt><dd>Kraftslag</dd></div><div><dt>L / Shift / U</dt><dd>Skjold / undvig / greb</dd></div></dl><h3>Controller</h3><p>A hop · X angreb · B special · Y greb<br />RT skjold · LB undvig · RB kraftslag</p></section></div></main>
    }

    <section class="arena-play @(IsBattle ? "is-visible" : "")" aria-label="Kampbane" aria-hidden="@(!IsBattle)">
        <div class="arena-play-toolbar"><button @onclick="ShowSettings" class="arena-back">Menu</button><span>@(_practice ? "Træning" : _room?.Code ?? "Arena")</span><div><span id="arena-ping">@(_room is null ? "" : "Forbinder…")</span><button class="arena-icon-button" @onclick="Fullscreen" aria-label="Fuld skærm"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9V3h6m6 0h6v6M3 15v6h6m6 0h6v-6"/></svg></button></div></div>
        <div class="arena-canvas-wrap">
            <canvas @ref="_canvas" width="1280" height="720" tabindex="0" aria-label="Kampbane. A og D bevæger, Space hopper, J angriber, K bruger special."></canvas>
            @if (_result is not null && _phase == "finished") { <div class="arena-result" role="status"><span>Kamp slut</span><img src="@Portrait(_result.Fighters.FirstOrDefault(f=>f.Id==_result.WinnerId)?.AvatarId ?? "starter")" alt="" /><h2>@WinnerName</h2><div class="arena-scoreboard">@foreach(var fighter in _result.Fighters.OrderByDescending(x=>x.Stocks).ThenByDescending(x=>x.KOs)) { <div><strong style="color:@fighter.Color">@fighter.Name</strong><span>@fighter.KOs KO</span></div> }</div><div class="arena-result-actions"><button class="arena-action arena-action-gold" @onclick="Rematch" disabled="@(_room is not null && !IsHost)">Revanche</button><button class="arena-action arena-action-subtle" @onclick="ReturnMain">Menu</button></div></div> }
        </div>
        <div class="arena-battle-footer"><span><kbd>A D</kbd> Bevæg <kbd>Space</kbd> Hop <kbd>J</kbd> Angreb <kbd>K</kbd> Special</span><button @onclick="ShowSettings">Styring</button></div>
        <div class="arena-touch" aria-label="Touchkontroller"><div class="arena-touch-directions"><button data-arena-key="KeyW" aria-label="Op">▲</button><button data-arena-key="KeyA" aria-label="Venstre">◀</button><button data-arena-key="KeyS" aria-label="Ned">▼</button><button data-arena-key="KeyD" aria-label="Højre">▶</button></div><div class="arena-touch-actions"><button data-arena-key="KeyL">Skjold</button><button data-arena-key="ShiftLeft">Undvig</button><button data-arena-key="KeyU">Greb</button><button data-arena-key="KeyI">Kraftslag</button><button data-arena-key="KeyJ">Slå</button><button data-arena-key="KeyK">Special</button><button data-arena-key="Space">Hop</button></div></div>
    </section>
</div>
