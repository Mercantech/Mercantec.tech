@page "/arena"
@page "/games/arena"
@implements IAsyncDisposable

<PageTitle>LUP Arena · Spil med din avatar</PageTitle>
<div class="arena-page">
    <header class="arena-heading">
        <div><a href="/universe" class="arena-back">Mit univers / Arena</a><h1>LUP Arena<span class="arena-title-dot"></span></h1><p>Din avatar. Dine venner. Én kamp om at blive på banen.</p></div>
        <button class="arena-button arena-quiet" @onclick="ToggleSound" aria-pressed="@_sound">@(_sound ? "Lyd til" : "Lyd fra")</button>
    </header>
    @if (_error is not null) { <div class="arena-notice" role="alert"><span>@_error</span><button @onclick="ClearError" aria-label="Luk besked">×</button></div> }
    @if (_reconnecting) { <div class="arena-notice" role="status">Forbindelsen blev afbrudt. Forbinder igen…</div> }
    <div class="arena-layout">
        <section class="arena-play" aria-label="Kampbane">
            <div class="arena-play-toolbar"><span class="arena-live"><i></i>@(_practice ? "Træning mod computeren" : _room is not null ? "Online · " + _room.Code : "Klar til kamp")</span><div class="arena-toolbar-actions"><span id="arena-ping" aria-live="off">@(_room is null ? "1–4 spillere" : "Forbinder…")</span><button class="arena-text-button" @onclick="Fullscreen">Fuld skærm</button></div></div>
            <div class="arena-canvas-wrap">
                <canvas @ref="_canvas" width="1280" height="720" tabindex="0" aria-label="LUP Arena. Brug A og D til at gå, mellemrum til hop, J til angreb og K til specialangreb."></canvas>
                @if (!_playing && _room is null && !_practice) {
                    <div class="arena-start-overlay"><span class="arena-stage-label">@SelectedStage.Name</span><h2>Tag kampen<br />med op på taget.</h2><p>Skub modstanderne ud. Gem et hop til vejen hjem.</p><button class="arena-button arena-primary" @onclick="StartPractice" disabled="@_busy">Prøv en kamp <span>↗</span></button><small>Spil med det samme mod computeren</small></div>
                }
                @if (_result is not null && _phase == "finished") {
                    <div class="arena-result" role="status"><span>Kampen er afgjort</span><h2>@WinnerName vinder!</h2><p>@(_practice ? "Klar til endnu en runde?" : "God kamp. Tag en revanche med de samme spillere.")</p><div class="arena-scoreboard">@foreach(var fighter in _result.Fighters.OrderByDescending(x => x.Stocks).ThenByDescending(x => x.KOs)) { <div><strong style="color:@fighter.Color">@fighter.Name</strong><span>@fighter.KOs KO · @fighter.Falls fald</span></div> }</div><button class="arena-button arena-primary" @onclick="Rematch" disabled="@(_room is not null && !IsHost)">Revanche</button>@if (_room is not null && !IsHost) { <small>Værten kan starte revanche.</small> }</div>
                }
            </div>
            <div class="arena-controls-summary"><span><kbd>A</kbd><kbd>D</kbd> Bevæg</span><span><kbd>Space</kbd> Hop × 2</span><span><kbd>J</kbd> Slå</span><span><kbd>K</kbd> Special</span><span><kbd>L</kbd> Skjold</span><button @onclick="() => _showControls = !_showControls">@(_showControls ? "Skjul taster" : "Alle taster")</button></div>
            <div class="arena-touch" aria-label="Touchkontroller"><div class="arena-touch-directions"><button data-arena-key="KeyW" aria-label="Op">▲</button><button data-arena-key="KeyA" aria-label="Gå til venstre">◀</button><button data-arena-key="KeyS" aria-label="Ned">▼</button><button data-arena-key="KeyD" aria-label="Gå til højre">▶</button></div><div class="arena-touch-actions"><button data-arena-key="KeyL">Skjold</button><button data-arena-key="ShiftLeft">Undvig</button><button data-arena-key="KeyU">Grib</button><button data-arena-key="KeyI">Kraftslag</button><button data-arena-key="KeyJ">Slå</button><button data-arena-key="KeyK">Special</button><button data-arena-key="Space">Hop</button></div></div>
            @if (_showControls) { <div class="arena-controls-detail"><div><h3>Find din rytme</h3><p>Jo mere skade, jo længere flyver du. Du mister et liv uden for banen. Sidste spiller på banen vinder.</p></div><dl><div><dt>A / D eller ← / →</dt><dd>Bevæg dig og vælg angrebsretning</dd></div><div><dt>W / S eller ↑ / ↓</dt><dd>Retning · ned gennem små platforme</dd></div><div><dt>Space</dt><dd>Hop og dobbelthop</dd></div><div><dt>J / K</dt><dd>Angreb / special · kombiner med retning</dd></div><div><dt>Hold I, slip I</dt><dd>Oplad og udløs et kraftslag</dd></div><div><dt>L / Shift / U</dt><dd>Skjold / undvig / grib og kast</dd></div><div><dt>W + K i luften</dt><dd>Red dig tilbage med et opadgående specialangreb</dd></div><div><dt>Controller</dt><dd>Venstre pind · A hop · X angreb · B special · Y greb · RT skjold</dd></div></dl></div> }
        </section>
        <aside class="arena-sidebar">
            @if (_room is null) {
                <section class="arena-panel"><div class="arena-section-heading"><h2>Vælg din kæmper</h2><a href="/profile/character">Din samling</a></div><p class="arena-hint">Dine avatarer fra profilen er med.</p><div class="arena-fighters">@foreach (var avatar in AvatarCatalog.All) { var owned = Owns(avatar.Id); <button class="arena-fighter @(_selectedAvatarId == avatar.Id ? "is-selected" : "")" disabled="@(!owned || _busy || _practice)" @onclick="() => SelectFighter(avatar.Id)" aria-pressed="@(_selectedAvatarId == avatar.Id)"><span class="arena-fighter-portrait @avatar.Id">@if(avatar.FaceImage is not null) { <img src="@avatar.FaceImage" alt="" /> } else { <span>☺</span> }</span><span><strong>@(avatar.Id == "starter" ? "Din avatar" : avatar.Name)</strong><small>@(owned ? FighterRole(avatar.Id) : "Lås op i din profil")</small></span><span class="arena-fighter-check">@(owned ? _selectedAvatarId == avatar.Id ? "●" : "○" : "⌑")</span></button> }</div><div class="arena-fighter-description"><span class="arena-ability-icon">✦</span><div><strong>@FighterSpecial</strong><p>@FighterDescription</p></div></div></section>
                <section class="arena-panel arena-online-panel"><h2>Venner på hver sin computer</h2><p>Opret et rum, og send koden til dem, du vil spille med.</p>@if (!Auth.IsAuthenticated) { <a class="arena-button arena-primary" href="@Auth.LoginPath()">Log ind for at spille online</a> } else { <button class="arena-button arena-primary" @onclick="CreateRoom" disabled="@(_busy || _practice)">@(_busy ? "Forbinder…" : "Opret et rum")<span>＋</span></button> }<div class="arena-join"><input aria-label="Rumkode" placeholder="Rumkode" maxlength="6" @bind="_joinCode" @bind:event="oninput" @onkeydown="JoinKey" disabled="@(_busy || _practice)" /><button class="arena-button arena-quiet" @onclick="JoinRoom" disabled="@(_busy || _practice || !Auth.IsAuthenticated || _joinCode.Trim().Length != 6)">Deltag</button></div><label class="arena-public-option"><input type="checkbox" @bind="_isPublic" disabled="@_practice" /> Vis mit rum på listen</label>@if (Auth.IsAuthenticated) { <button class="arena-text-button" @onclick="LoadRooms" disabled="@_busy">Find åbne rum</button> }@if (_roomsLoaded) { <div class="arena-public-rooms">@if (_rooms.Count == 0) { <p>Ingen åbne rum lige nu. Opret det første.</p> }@foreach(var room in _rooms) { <button @onclick="() => JoinPublicRoom(room.Code)"><strong>@room.Code</strong><span>@room.Players.Count / 4 spillere · Deltag</span></button> }</div> }</section>
            } else {
                <section class="arena-panel arena-room-panel"><div class="arena-section-heading"><h2>Dit kamprum</h2><span class="arena-room-status">@(_room.IsPublic ? "Åbent rum" : "Kun med kode")</span></div><button class="arena-room-code" @onclick="CopyInvite" title="Kopiér invitationslink"><span>@_room.Code</span><small>@(_copied ? "Link kopieret!" : "Kopiér invitation")</small></button><p class="arena-hint">Åbn invitationen på en anden computer, eller indtast rumkoden her i Arena.</p><div class="arena-player-list">@foreach(var player in _room.Players) { <div><span class="arena-player-number" style="--player-color:@player.Color">@(_room.Players.IndexOf(player)+1)</span><span><strong>@player.Name @(player.Id == _playerId ? "(dig)" : "")</strong><small>@(AvatarCatalog.Find(player.AvatarId)?.Name ?? "Avatar") @(player.IsBot ? "· Computer" : player.Id == _room.HostId ? "· Vært" : "")</small></span><span class="arena-ready-status">@(!player.Connected ? "Venter…" : player.Ready ? "Klar ✓" : "Vælger")</span></div> }@for(var i=_room.Players.Count;i<4;i++){<div class="arena-empty-player"><span class="arena-player-number">＋</span><span>Plads til en ven</span></div>}</div>@if (_phase == "lobby") { <button class="arena-button @(_ready ? "arena-quiet" : "arena-primary")" @onclick="ToggleReady">@(_ready ? "Klar ✓ · klik for at vente" : "Jeg er klar")</button>@if(IsHost) { <button class="arena-button arena-primary" @onclick="StartOnline" disabled="@(!_room.Players.All(p => p.Ready && p.Connected) || _room.Players.Count < 2)">Start kampen</button><button class="arena-text-button" @onclick="AddBot" disabled="@(_room.Players.Count >= 4)">Tilføj en computerspiller</button> }}<button class="arena-text-button arena-leave" @onclick="LeaveRoom">Forlad rummet</button></section>
            }
            @if (_practice) { <section class="arena-panel"><h2>Øvelse gør mester</h2><p>Prøv angreb i luften og specialangreb med retning. W + K hjælper dig tilbage til banen.</p><button class="arena-button arena-quiet" @onclick="StopPractice">Afslut træning</button></section> }
        </aside>
    </div>
    <section class="arena-stage-section"><div class="arena-section-heading"><div><h2>Find din hjemmebane</h2><p>Tre arenaer. Samme mål: bliv på banen.</p></div><div class="arena-rules"><label>Liv <select @bind="_stocks" @bind:after="ConfigureRoom" disabled="@SettingsDisabled"><option value="1">1</option><option value="3">3</option><option value="5">5</option></select></label><label>Tid <select @bind="_minutes" @bind:after="ConfigureRoom" disabled="@SettingsDisabled"><option value="3">3 min.</option><option value="5">5 min.</option><option value="8">8 min.</option></select></label></div></div><div class="arena-stages">@foreach(var stage in ArenaCatalog.Stages) { <button class="arena-stage-card @(_stageId == stage.Id ? "is-selected" : "")" @onclick="() => SelectStage(stage.Id)" disabled="@SettingsDisabled" aria-pressed="@(_stageId == stage.Id)"><span class="arena-stage-art @stage.Id"><span class="arena-mini-platform"></span><span class="arena-mini-platform"></span><span class="arena-mini-platform"></span><span class="arena-mini-platform"></span><i></i></span><span class="arena-stage-card-text"><strong>@stage.Name</strong><small>@stage.Description</small></span><span class="arena-stage-selected">@(_stageId == stage.Id ? "Valgt ✓" : "Vælg bane")</span></button> }</div></section>
    <footer class="arena-footnote"><span>Bygget til LUPs egne avatarer</span><span>Tip: Høj skade betyder større tilbageskub. Et godt forsvar vinder kampe.</span></footer>
</div>
