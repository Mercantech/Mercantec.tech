@page "/rights"
@inject AuthService Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Mine rettigheder</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else
{
    <header class="page-title"><div><h1>Dine data og rettigheder</h1><p>Indsigt og sletteanmodning. Læs også <a href="/privacy">privatlivssiden</a>.</p></div></header>
    <div class="cols">
    <section class="panel">
        <h2>Mine oplysninger</h2>
        <p>Downloader en JSON-fil med de oplysninger, API’et kender om dig.</p>
        <button class="action" disabled="@_exporting" @onclick="ExportAsync">
            @(_exporting ? "Henter…" : "Download mine data")
        </button>
        @if (_exportError is not null)
        {
            <p>@_exportError</p>
        }
        @if (_exportOk)
        {
            <p>Download startet.</p>
        }
        <hr class="line" />
        <h2>Sletteanmodning</h2>
        <p>Du får en reference og næste skridt. Auth og Lectio håndteres separat.</p>
        <label class="field" for="reason">Begrundelse (valgfri)
            <textarea id="reason" rows="3" @bind="_reason"></textarea>
        </label>
        <button class="secondary" disabled="@_deleting" @onclick="RequestDeletionAsync">
            @(_deleting ? "Sender…" : "Send sletteanmodning")
        </button>
        @if (_deleteError is not null)
        {
            <p>@_deleteError</p>
        }
        @if (_deleteResult is not null)
        {
            <div class="callout">
                <p><strong>Modtaget.</strong> Reference: <code>@_deleteResult.Reference</code></p>
                <ul>
                    @foreach (var step in _deleteResult.NextSteps)
                    {
                        <li>@step</li>
                    }
                </ul>
                <p>Kontakt: <a href="mailto:@_deleteResult.Contact">@_deleteResult.Contact</a></p>
            </div>
        }
    </section>
    <aside class="panel">
        <h2>Privatliv</h2>
        <p>Læs om datakilder og adgang.</p>
        <a href="/privacy">Se privatlivssiden</a>
        <p><a href="/profile">Tilbage til profil</a></p>
    </aside>
    </div>
}

@code {
    private string? _reason;
    private bool _exporting;
    private bool _exportOk;
    private string? _exportError;
    private bool _deleting;
    private string? _deleteError;
    private DeletionResponse? _deleteResult;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        if (Auth.IsInitialized && !Auth.IsAuthenticated)
            Nav.NavigateTo(Auth.LoginPath());
    }

    private async Task ExportAsync()
    {
        _exporting = true;
        _exportOk = false;
        _exportError = null;
        try
        {
            var response = await Http.GetAsync("privacy/export");
            if (!response.IsSuccessStatusCode)
            {
                _exportError = $"Kunne ikke hente eksport ({(int)response.StatusCode}).";
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                           ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                           ?? $"mercantec-tech-data-{DateTime.UtcNow:yyyyMMdd}.json";
            var base64 = Convert.ToBase64String(bytes);
            await Js.InvokeVoidAsync("mercantecDownload.fromBase64", fileName, "application/json", base64);
            _exportOk = true;
        }
        catch (Exception ex)
        {
            _exportError = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task RequestDeletionAsync()
    {
        _deleting = true;
        _deleteError = null;
        _deleteResult = null;
        try
        {
            var response = await Http.PostAsJsonAsync("privacy/deletion-request", new { reason = _reason });
            if (!response.IsSuccessStatusCode)
            {
                _deleteError = $"Anmodning fejlede ({(int)response.StatusCode}).";
                return;
            }

            _deleteResult = await response.Content.ReadFromJsonAsync<DeletionResponse>(
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        if (Auth.IsInitialized && !Auth.IsAuthenticated)
            Nav.NavigateTo(Auth.LoginPath());
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

    private sealed record DeletionResponse(
        bool Received,
        string Reference,
        DateTime RequestedAtUtc,
        string Sub,
        string[] NextSteps,
        string Contact);
}
