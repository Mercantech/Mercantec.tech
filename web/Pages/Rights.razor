@page "/rights"
@inject AuthService Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Mine rettigheder</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Du skal være logget ind. <a href="/login">Log ind</a></p>
}
else
{
    <h1>Mine rettigheder</h1>
    <p class="text-muted">
        Indsigt og sletteanmodning for data i Mercantec.tech.
        Læs også <a href="/privacy">privatlivssiden</a>.
    </p>

    <section class="mb-4">
        <h2 class="h5">Ret til indsigt — eksporter mine data</h2>
        <p>Downloader en JSON-fil med de oplysninger, API’et kender om dig (claims + platform-status).</p>
        <button class="btn btn-primary" disabled="@_exporting" @onclick="ExportAsync">
            @(_exporting ? "Henter…" : "Download mine data")
        </button>
        @if (_exportError is not null)
        {
            <p class="text-danger mt-2">@_exportError</p>
        }
        @if (_exportOk)
        {
            <p class="text-success mt-2">Download startet.</p>
        }
    </section>

    <section class="mb-4">
        <h2 class="h5">Sletteanmodning</h2>
        <p>
            Sender en anmodning til platformen. Fuld automatisk sletning (inkl. Auth/Lectio) er endnu ikke på plads —
            du får en reference og næste skridt.
        </p>
        <div class="mb-2">
            <label class="form-label" for="reason">Begrundelse (valgfri)</label>
            <textarea id="reason" class="form-control" rows="3" @bind="_reason"></textarea>
        </div>
        <button class="btn btn-outline-danger" disabled="@_deleting" @onclick="RequestDeletionAsync">
            @(_deleting ? "Sender…" : "Send sletteanmodning")
        </button>
        @if (_deleteError is not null)
        {
            <p class="text-danger mt-2">@_deleteError</p>
        }
        @if (_deleteResult is not null)
        {
            <div class="alert alert-info mt-3">
                <p class="mb-1"><strong>Modtaget.</strong> Reference: <code>@_deleteResult.Reference</code></p>
                <ul class="mb-0">
                    @foreach (var step in _deleteResult.NextSteps)
                    {
                        <li>@step</li>
                    }
                </ul>
                <p class="mb-0 mt-2">Kontakt: <a href="mailto:@_deleteResult.Contact">@_deleteResult.Contact</a></p>
            </div>
        }
    </section>

    <p>
        <a href="/profile">Tilbage til profil</a>
        ·
        <a href="/privacy">Privatliv</a>
    </p>
}

@code {
    private string? _reason;
    private bool _exporting;
    private bool _exportOk;
    private string? _exportError;
    private bool _deleting;
    private string? _deleteError;
    private DeletionResponse? _deleteResult;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        if (Auth.IsInitialized && !Auth.IsAuthenticated)
            Nav.NavigateTo("/login");
    }

    private async Task ExportAsync()
    {
        _exporting = true;
        _exportOk = false;
        _exportError = null;
        try
        {
            var response = await Http.GetAsync("privacy/export");
            if (!response.IsSuccessStatusCode)
            {
                _exportError = $"Kunne ikke hente eksport ({(int)response.StatusCode}).";
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                           ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                           ?? $"mercantec-tech-data-{DateTime.UtcNow:yyyyMMdd}.json";
            var base64 = Convert.ToBase64String(bytes);
            await Js.InvokeVoidAsync("mercantecDownload.fromBase64", fileName, "application/json", base64);
            _exportOk = true;
        }
        catch (Exception ex)
        {
            _exportError = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task RequestDeletionAsync()
    {
        _deleting = true;
        _deleteError = null;
        _deleteResult = null;
        try
        {
            var response = await Http.PostAsJsonAsync("privacy/deletion-request", new { reason = _reason });
            if (!response.IsSuccessStatusCode)
            {
                _deleteError = $"Anmodning fejlede ({(int)response.StatusCode}).";
                return;
            }

            _deleteResult = await response.Content.ReadFromJsonAsync<DeletionResponse>(
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        if (Auth.IsInitialized && !Auth.IsAuthenticated)
            Nav.NavigateTo("/login");
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

    private sealed record DeletionResponse(
        bool Received,
        string Reference,
        DateTime RequestedAtUtc,
        string Sub,
        string[] NextSteps,
        string Contact);
}
