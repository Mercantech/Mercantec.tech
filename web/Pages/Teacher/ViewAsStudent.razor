@page "/teacher/view-as/{LectioId}"
@using System.Text.Json
@using Mercantec.Tech.Web.Lectio
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@inject HttpClient Http
@implements IDisposable

<PageTitle>Se som elev · LUP</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <p>Åbner elev-UI…</p>
}

@code {
    [Parameter] public string LectioId { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        EnsureAccess();
        if (Auth.IsInitialized && Auth.IsAuthenticated && Redirect.CurrentAppRole() == AppRole.Underviser)
            await BootstrapAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsInitialized || !Auth.IsAuthenticated || Redirect.CurrentAppRole() != AppRole.Underviser)
            return;
        if (string.IsNullOrWhiteSpace(LectioId))
            return;
        await BootstrapAsync();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Underviser)
        {
            ViewAs.Exit();
            Nav.NavigateTo(Redirect.PostLoginPath());
        }
    }

    private async Task BootstrapAsync()
    {
        var id = (LectioId ?? "").Trim();
        if (string.IsNullOrWhiteSpace(id))
        {
            Nav.NavigateTo("/lectio");
            return;
        }

        if (!ViewAs.IsActive || !string.Equals(ViewAs.LectioId, id, StringComparison.OrdinalIgnoreCase))
            ViewAs.Enter(id, ViewAs.DisplayName, ViewAs.ClassName, ViewAs.AuthSub, ViewAs.ReturnUrl ?? "/lectio");

        await EnrichFromListAsync(id);
        Nav.NavigateTo("/student");
    }

    private async Task EnrichFromListAsync(string lectioId)
    {
        try
        {
            var listRes = await Http.GetAsync("lectio/programmeringselever");
            var listBody = await listRes.Content.ReadAsStringAsync();
            if (listRes.IsSuccessStatusCode)
            {
                var snapshot = Studieplan.FindStudentSnapshot(listBody, lectioId);
                if (snapshot is not null)
                {
                    ViewAs.Enter(
                        lectioId,
                        snapshot.Name ?? ViewAs.DisplayName,
                        snapshot.ClassName ?? ViewAs.ClassName,
                        ViewAs.AuthSub,
                        ViewAs.ReturnUrl ?? "/lectio");
                }
            }

            if (ViewAs.AuthSub is not null)
                return;

            var res = await Http.PostAsJsonAsync("lectio/auth-links/resolve", new { lectioIds = new[] { lectioId } });
            if (!res.IsSuccessStatusCode)
                return;

            await using var stream = await res.Content.ReadAsStreamAsync();
            using var doc = await JsonDocument.ParseAsync(stream);
            if (!doc.RootElement.TryGetProperty("links", out var links) || links.ValueKind != JsonValueKind.Array)
                return;

            foreach (var item in links.EnumerateArray())
            {
                var linkId = item.TryGetProperty("lectioId", out var lid) && lid.ValueKind == JsonValueKind.String
                    ? lid.GetString()
                    : null;
                if (!string.Equals(linkId, lectioId, StringComparison.OrdinalIgnoreCase))
                    continue;
                if (!item.TryGetProperty("authSub", out var subEl))
                    continue;
                var raw = subEl.ValueKind == JsonValueKind.String ? subEl.GetString() : subEl.ToString();
                if (Guid.TryParse(raw, out var sub) && sub != Guid.Empty)
                    ViewAs.Enter(lectioId, ViewAs.DisplayName, ViewAs.ClassName, sub, ViewAs.ReturnUrl);
            }
        }
        catch
        {
            // Preview bootstrap er best-effort — elev-UI kan stadig åbnes.
        }
    }

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        if (Auth.IsAuthenticated && Redirect.CurrentAppRole() == AppRole.Underviser)
            await BootstrapAsync();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
