@page "/teacher"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Underviser</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <header class="page-title"><div><h1>Goddag@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName.Split(' ')[0]}")</h1><p>Forløb og Lectio er live. Planlægning og afstemninger er eksempelindhold.</p></div></header>
    <div class="tiles">
        <a class="tile" href="/courses"><h2>Forløb og hold</h2><p>Opret, importér og se medlemmer.</p></a>
        <a class="tile" href="/lectio"><h2>Lectio</h2><p>Elever, hold og studieplaner fra Collector.</p></a>
        <a class="tile" href="/teacher/reviews"><h2>Vurdering</h2><p>Eksempel på en indsendt quest.</p></a>
        <a class="tile" href="/teacher/polls"><h2>Afstemninger</h2><p>Eksempel på åbne spørgsmål.</p></a>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        EnsureAccess();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Underviser)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        EnsureAccess();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
