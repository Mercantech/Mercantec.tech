@page "/teacher"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Underviser</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <header class="page-title"><div><h1>Goddag@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName.Split(' ')[0]}")</h1><p>Dit overblik over undervisning, elever og det næste, der skal ske.</p></div></header>
    <div class="tiles">
        <a class="tile" href="/courses"><UiIcon Name="book" /><h2>Mine hold</h2><p>Undervisning, opgaver og afstemninger på hvert hold.</p></a>
        <a class="tile" href="/lectio"><UiIcon Name="calendar" /><h2>Lectio</h2><p>Elever, hold, Auth-kobling og «se som elev».</p></a>
        <a class="tile" href="/notifications"><UiIcon Name="check" /><h2>Til opfølgning</h2><p>Se holdenes afleveringer, der venter på feedback.</p></a>
        <a class="tile" href="/library"><UiIcon Name="book" /><h2>Bibliotek</h2><p>Undervisningsplaner, fag, projekter og badgekrav.</p></a>
        <a class="tile" href="/teacher/notebooks"><UiIcon Name="book" /><h2>Elevnotesbøger</h2><p>Følg noter og logbog og giv kommentarer.</p></a>
        <a class="tile" href="/teacher/notebook-templates"><UiIcon Name="book" /><h2>Logbogsskabeloner</h2><p>Fælles skabeloner til daglige, ugentlige og frie refleksioner.</p></a>
    </div>
    <div class="headrow"><h2>Planen for klassen</h2><a href="/teacher/planner">Åbn planlægningen</a></div><WeekCalendar CourseId="h3" />
}

@code {
    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        ViewAs.Changed += OnAuth;
        EnsureAccess();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo(Auth.LoginPath());
            return;
        }

        if (ViewAs.IsActive)
        {
            Nav.NavigateTo("/student");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Underviser)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        EnsureAccess();
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        ViewAs.Changed -= OnAuth;
    }
}
