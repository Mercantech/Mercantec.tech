@page "/teacher"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Underviser</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <header class="page-title"><div><h1>Goddag@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName.Split(' ')[0]}")</h1><p>Dit overblik over undervisning, elever og det næste, der skal ske.</p></div></header>
    <div class="tiles">
        <a class="tile" href="/courses"><UiIcon Name="book" /><h2>Forløb og hold</h2><p>Opret, importér og se medlemmer.</p></a>
        <a class="tile" href="/lectio"><UiIcon Name="calendar" /><h2>Lectio</h2><p>Elever, hold, Auth-kobling og «se som elev».</p></a>
        <a class="tile" href="/teacher/reviews"><UiIcon Name="check" /><h2>Vurdering</h2><p>Afleveringer, der venter på feedback.</p></a>
        <a class="tile" href="/teacher/polls"><UiIcon Name="chart" /><h2>Afstemninger</h2><p>Klassens stemning og fælles valg.</p></a>
    </div>
    <div class="headrow"><h2>Planen for klassen</h2><a href="/teacher/planner">Åbn planlægningen</a></div><WeekCalendar CourseId="h3" />
}

@code {
    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        EnsureAccess();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Underviser)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        EnsureAccess();
        StateHasChanged();
    });

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
