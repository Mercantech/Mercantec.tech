@page "/elev"
@using System.Text.Json
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@inject HttpClient Http
@implements IDisposable

<PageTitle>Elev</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <div class="role-shell elev-shell mb-4">
        <p class="role-badge">Elev</p>
        <h1>Elev-dashboard</h1>
        <p class="text-muted">Velkommen@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName}"). Her lander dine forløb, quests og projekter.</p>
        <p class="small mb-0">Auth-roller: @RoleSummary()</p>
    </div>

    @if (_showLectioCta)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
            <span>Kobl din Lectio-profil for at se dine elevdata her.</span>
            <a class="btn btn-sm btn-primary" href="/lectio">Kobl Lectio</a>
        </div>
    }

    <div class="border rounded p-4 bg-light">
        <h2 class="h5">Tom shell (Sprint 0)</h2>
        <p class="mb-0">Indhold kommer i senere sprints (mine forløb, quests, logbog …).</p>
    </div>

    <p class="mt-3"><a href="/profil">Se mine brugeroplysninger</a></p>
}

@code {
    private bool _showLectioCta;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuth;
        EnsureAccess();
        await CheckLectioLinkAsync();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Elev)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private async Task CheckLectioLinkAsync()
    {
        _showLectioCta = false;
        if (!Auth.IsInitialized || !Auth.IsAuthenticated || Redirect.CurrentAppRole() != AppRole.Elev)
            return;

        try
        {
            var res = await Http.GetAsync("lectio/me");
            if (!res.IsSuccessStatusCode)
            {
                _showLectioCta = true;
                return;
            }

            var body = await res.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(body);
            if (!doc.RootElement.TryGetProperty("lectio", out var lectio)
                || lectio.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
            {
                _showLectioCta = true;
                return;
            }

            _showLectioCta = !(lectio.TryGetProperty("lectioId", out var id)
                               && id.ValueKind == JsonValueKind.String
                               && !string.IsNullOrWhiteSpace(id.GetString()));
        }
        catch
        {
            _showLectioCta = true;
        }
    }

    private void OnAuth() => _ = InvokeAsync(async () =>
    {
        EnsureAccess();
        await CheckLectioLinkAsync();
        StateHasChanged();
    });

    private string RoleSummary() =>
        Auth.Roles.Count == 0 ? "(ingen — typisk almindelig bruger)" : string.Join(", ", Auth.Roles);

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
