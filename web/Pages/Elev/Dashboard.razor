@page "/elev"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Elev</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else
{
    <div class="role-shell elev-shell mb-4">
        <p class="role-badge">Elev</p>
        <h1>Elev-dashboard</h1>
        <p class="text-muted">Velkommen@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName}"). Her lander dine forløb, quests og projekter.</p>
        <p class="small mb-0">Auth-roller: @RoleSummary()</p>
    </div>

    <div class="border rounded p-4 bg-light">
        <h2 class="h5">Tom shell (Sprint 0)</h2>
        <p class="mb-0">Indhold kommer i senere sprints (mine forløb, quests, logbog …).</p>
    </div>

    <p class="mt-3"><a href="/profil">Se mine brugeroplysninger</a></p>
}

@code {
    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        EnsureAccess();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Elev)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        EnsureAccess();
        StateHasChanged();
    });

    private string RoleSummary() =>
        Auth.Roles.Count == 0 ? "(ingen — typisk almindelig bruger)" : string.Join(", ", Auth.Roles);

    public void Dispose() => Auth.AuthStateChanged -= OnAuth;
}
