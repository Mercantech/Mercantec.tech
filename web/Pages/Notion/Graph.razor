@page "/notion/graph"
@page "/notion/graph/{CollectionId:guid}"
@implements IAsyncDisposable

<PageTitle>@(_graph?.Title is { Length: > 0 } title ? $"{title} · Graf" : "Graf") · LUP</PageTitle>
@if (!Auth.IsInitialized) { <p role="status">Indlæser…</p> }
else if (!Auth.IsAuthenticated)
{
    <section class="notion-welcome panel"><h1>Graf</h1><p>Log ind for at se, hvordan holdets sider linker til hinanden.</p><a class="action" href="/login">Log ind</a></section>
}
else
{
    <header class="page-title">
        <div>
            <nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/courses">Forløb og hold</a><span>›</span><a href="@PagesHref">Holdets indhold</a><span>›</span><span>Graf</span></nav>
            <p class="notion-graph-kicker">Graph view</p>
            <h1>@(_graph?.Title ?? "Graf")</h1>
            <p>Siderne i kollektionen og de interne links mellem dem. En større cirkel betyder, at flere sider linker dertil.</p>
        </div>
        <a class="secondary" href="@PagesHref">Tilbage til siderne</a>
    </header>
    @if (_error is not null) { <div class="notion-error" role="alert">@_error <button class="secondary" @onclick="Retry" disabled="@_busy">Prøv igen</button></div> }
    @if (_loading) { <p role="status">Henter grafen…</p> }
    else if (_holds.Length == 0)
    {
        <section class="panel notion-welcome"><h2>Du er ikke tilknyttet et hold endnu</h2><p>Når du bliver tilføjet til et hold, kan du åbne grafen fra holdets sider.</p><a class="secondary" href="/courses">Forløb og hold</a></section>
    }
    else if (_graph is null)
    {
        <section class="panel notion-graph-picker-panel">
            @if (_holds.Length > 1)
            {
                <label class="field">Hold<select value="@_holdId" @onchange="ChangeHold">@foreach (var hold in _holds) { <option value="@hold.Id">@hold.Name</option> }</select></label>
            }
            @if (Collections().Any())
            {
                <h2>Vælg en kollektion</h2>
                <p>Grafen viser siderne under den valgte rod eller mappe.</p>
                <ul>
                    @foreach (var item in Collections())
                    {
                        <li style="--page-depth:@item.Depth"><a href="@GraphPath(item.Page.Id)">@item.Page.Title</a></li>
                    }
                </ul>
            }
            else
            {
                <h2>Der er endnu ingen sider på holdet</h2>
                <p>Opret en side under holdets indhold. Grafen kan tegnes, når siderne linker til hinanden.</p>
                <a class="secondary" href="@PagesHref">Holdets indhold</a>
            }
        </section>
    }
    else
    {
        <div class="notion-graph-bar">
            <label class="field">Kollektion
                <select value="@_graph.CollectionId" @onchange="ChangeCollection">
                    @foreach (var item in Collections()) { <option value="@item.Page.Id">@OptionLabel(item)</option> }
                </select>
            </label>
            @if (_holds.Length > 1)
            {
                <label class="field">Hold<select value="@_holdId" @onchange="ChangeHold">@foreach (var hold in _holds) { <option value="@hold.Id">@hold.Name</option> }</select></label>
            }
        </div>
        @if (_graph.Edges.Length == 0)
        {
            <section class="notion-graph-empty panel">
                <h2>Der er ingen interne links i denne kollektion</h2>
                <p>Grafen tegnes, når en side linker til en anden side i samme kollektion. Skriv <kbd>@@</kbd> og vælg en side, eller indsæt et link til en side.</p>
                @if (_graph.Nodes.Length > 0)
                {
                    <ul>
                        @foreach (var node in _graph.Nodes) { <li><a href="@PagePath(node.Id)">@node.Title</a></li> }
                    </ul>
                }
            </section>
        }
        else
        {
            <div class="notion-graph-stage" @ref="_stage" tabindex="0" aria-label="Graf over sidernes links. Piletaster flytter grafen, plus og minus zoomer." @oncontextmenu:preventDefault>
                <div class="notion-graph-host" @ref="_host" @key="_graph.CollectionId"></div>
                <div class="notion-graph-controls">
                    <button type="button" class="secondary" @onclick="() => Zoom(-1)" aria-label="Zoom ud">−</button>
                    <button type="button" class="secondary" @onclick="() => Zoom(1)" aria-label="Zoom ind">+</button>
                    <button type="button" class="secondary" @onclick="() => Zoom(0)">Tilpas</button>
                </div>
            </div>
            <p class="notion-graph-hint">Scroll for at zoome. Træk for at flytte grafen. Piletaster flytter den, og Shift gør skridtet større. Højreklik på en cirkel for at åbne siden@(_graph.CanRename ? " eller omdøbe den" : "").</p>
            <details class="notion-graph-links" open="@_scriptFailed">
                <summary>Sidelinks som tekst</summary>
                <ul>
                    @foreach (var edge in _graph.Edges)
                    {
                        <li><a href="@PagePath(edge.FromId)">@Title(edge.FromId)</a> linker til <a href="@PagePath(edge.ToId)">@Title(edge.ToId)</a></li>
                    }
                    @foreach (var node in Isolated())
                    {
                        <li><a href="@PagePath(node.Id)">@node.Title</a> har ingen links i kollektionen</li>
                    }
                </ul>
            </details>
        }
    }
}
@if (_menuPage is Guid menuId)
{
    <button type="button" class="notion-graph-backdrop" @onclick="CloseMenu" aria-label="Luk menu"></button>
    <div class="notion-graph-menu" role="menu" style="left:@(_menuX.ToString(System.Globalization.CultureInfo.InvariantCulture))px;top:@(_menuY.ToString(System.Globalization.CultureInfo.InvariantCulture))px" @onkeydown="MenuKey">
        <p>@Title(menuId)</p>
        <a class="secondary" role="menuitem" href="@PagePath(menuId)" @ref="_menuFirst">Åbn</a>
        @if (_graph?.CanRename == true)
        {
            @if (_renaming)
            {
                <form @onsubmit="RenameMenuPage" @onsubmit:preventDefault>
                    <label>Ny titel<input @ref="_renameInput" @bind="_renameTitle" maxlength="200" required /></label>
                    <div class="notion-graph-menu-actions"><button class="action" disabled="@(_busy || string.IsNullOrWhiteSpace(_renameTitle))">Gem</button><button type="button" class="secondary" @onclick="CloseMenu">Annuller</button></div>
                </form>
            }
            else { <button type="button" class="secondary" role="menuitem" @onclick="BeginRename">Omdøb</button> }
        }
    </div>
}
