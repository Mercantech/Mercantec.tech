@page "/notion/{PageId:guid}"
@using Mercantec.Tech.Web.Notion
@implements IAsyncDisposable

<NotionTabTitle Title="@_current?.Title" />
<NavigationLock OnBeforeInternalNavigation="BeforeNavigation" />
<link rel="stylesheet" href="@EditorAssets.Style" />
@if (!Auth.IsInitialized) { <p role="status">Indlæser…</p> }
else if (!Auth.IsAuthenticated)
{
    <section class="notion-welcome panel"><h1>Holdets indhold</h1><p>Log ind for at åbne undervisningssider fra dine hold.</p><a class="action" href="@Auth.LoginPath()">Log ind</a></section>
}
else
{
    @if (!_loading && _holdsLoaded && _holds.Length == 0 && _current is null && _holdId == Guid.Empty)
    {
        @PageFeedback
        <section class="panel notion-welcome"><h1>Du er ikke tilknyttet et hold endnu</h1><p>Når du bliver tilføjet til et hold, vises dets udgivne indhold her.</p><a class="secondary" href="/courses">Forløb og hold</a></section>
    }
    else
    {
        <div @ref="_workspaceElement" class="notion-workspace @(_sidebarOpen ? "sidebar-open" : null) @(_workspaceFocused ? "notion-focus-mode" : null)" data-edge-to-edge="true" data-sidebar-ready="@_sidebarReady.ToString().ToLowerInvariant()" data-focus-mode="@_workspaceFocused.ToString().ToLowerInvariant()">
            @if (_sidebarOpen) { <button id="notion-sidebar-backdrop" class="notion-sidebar-backdrop" type="button" tabindex="-1" aria-label="Luk sidemenu" @onclick="() => SetSidebarOpen(false)"></button> }
            <aside id="notion-sidebar" class="notion-sidebar" tabindex="-1" hidden="@(!_sidebarOpen)" role="@(_sidebarMobile && _sidebarOpen ? "dialog" : null)" aria-modal="@(_sidebarMobile && _sidebarOpen ? "true" : null)" aria-label="Notesbogens sider">
                <div class="notion-sidebar-heading"><div><span class="notion-sidebar-eyebrow">@(_holdId == Guid.Empty ? "Teori" : "Undervisning")</span><h2>Sider</h2></div><button type="button" class="notion-icon-button notion-sidebar-close" aria-label="Skjul sidemenu" title="Skjul sidemenu" @onclick="() => SetSidebarOpen(false)"><UiIcon Name="panel" /></button></div>
                @if (_holdId != Guid.Empty) { <label class="notion-hold-picker"><span class="notion-visually-hidden">Vælg hold</span><select value="@_holdId" @onchange="ChangeHold" disabled="@(_busy || !_holdsLoaded)">@if (!_holdsLoaded) { <option value="@_holdId">Henter hold…</option> }@foreach (var hold in _holds) { <option value="@hold.Id">@hold.Name</option> }</select></label> }
                <div class="notion-page-search"><UiIcon Name="search" /><label class="notion-visually-hidden" for="notion-page-search">Find en side</label><input id="notion-page-search" type="search" value="@_pageSearch" @oninput="SearchPages" @onkeydown="SearchKeyDown" placeholder="Find en side…" autocomplete="off" />@if (_pageSearch.Length > 0) { <button type="button" class="notion-icon-button" aria-label="Ryd sidesøgning" @onclick="ClearPageSearch"><UiIcon Name="close" /></button> }</div>
                @if (Authoring) { <button type="button" class="notion-sidebar-create" @onclick="() => BeginCreate(false)" disabled="@_busy" aria-label="Opret dokument"><UiIcon Name="plus" />Ny side</button> }
                <div class="notion-page-list-heading"><span>@(_pageSearch.Trim().Length > 0 ? "Søgeresultater" : "Alle sider")</span><span aria-live="polite">@(_pageSearch.Trim().Length > 0 ? $"{_pageRows.Count} af {_totalPages}" : _totalPages.ToString())</span></div>
                @if (_navigationLoading) { <p class="notion-sidebar-status" role="status">Henter sideoversigt…</p> }
                @if (_navigationError is not null) { <p class="notion-sidebar-status" role="status">@_navigationError <button class="secondary" @onclick="RetryNavigation" disabled="@_navigationLoading">Prøv oversigten igen</button></p> }
                @if (_sidebarOpen)
                {
                    @if (_pageRows.Count > 60 && _activeRow is not null) { <div class="notion-current-page"><span>Du er her</span>@PageRowContent(_activeRow)</div> }
                    <nav @key="_listVersion" class="notion-page-list" aria-label="Dokumentsider">
                        @if (_pageRows.Count > 60) { <Virtualize Items="_virtualRows" Context="item" ItemSize="44" OverscanCount="4">@PageRowContent(item)</Virtualize> }
                        else { @foreach (var item in _pageRows) { @PageRowContent(item) } }
                        @if (_pageRows.Count == 0 && !_loading && !_navigationLoading && _navigationError is null)
                        {
                            <div class="notion-sidebar-empty" role="status">@if (_pageSearch.Trim().Length > 0) { <p>Ingen sider matcher “@_pageSearch.Trim()”.</p><button type="button" @onclick="ClearPageSearch">Vis alle sider</button> } else { <p>@(Authoring ? "Dit hold har ingen sider endnu." : "Der er ingen udgivne sider endnu.")</p> }</div>
                        }
                    </nav>
                }
                @if (_creating && Authoring)
                {
                    <form class="notion-create" @onsubmit="CreatePage" @onsubmit:preventDefault><label class="field">@(_newParent is null ? "Ny side" : "Ny underside")<input @bind="_newTitle" maxlength="200" required placeholder="Sidens titel" /></label><EmojiPicker Disabled="_busy" OnPick="InsertNewTitleEmoji" /><div class="notion-actions"><button class="action" disabled="@(_busy || string.IsNullOrWhiteSpace(_newTitle))">Opret</button><button type="button" class="secondary" @onclick="() => _creating = false">Annuller</button></div></form>
                }
                <details class="notion-sidebar-tools"><summary><UiIcon Name="sliders" />@(_holdId == Guid.Empty ? "Notesbogsværktøjer" : "Holdværktøjer")<span aria-hidden="true">⌄</span></summary><nav aria-label="Notesbogsværktøjer"><a href="/notion"><UiIcon Name="book" />Alle notesbøger</a>@if (_holdId != Guid.Empty) { <a href="@WorkspaceHref()"><UiIcon Name="book" />Holdets overblik</a><a href="@WorkspaceHref("groups")"><UiIcon Name="people" />Elever og grupper</a><a href="@HoldGraphHref"><UiIcon Name="chart" />Graf for holdet</a> }<button type="button" @onclick="RetryNavigation" disabled="@_navigationLoading"><UiIcon Name="loop" />Opdatér sidelisten</button></nav></details>
                <div class="notion-sidebar-resize" role="separator" aria-label="Sideoversigtens bredde" aria-orientation="vertical" aria-valuemin="180" aria-valuemax="420" aria-valuenow="268" tabindex="0"></div>
            </aside>
            <section class="notion-document" aria-label="@(IsEditing ? "Dokumenteditor" : "Udgivet dokument")">
                <div class="notion-document-toolbar">
                    <h1 class="notion-visually-hidden">@(_current?.Title ?? (_holdId == Guid.Empty ? "Teorinotesbog" : "Holdets indhold"))</h1>
                    <div class="notion-toolbar-nav">
                        <button type="button" class="notion-sidebar-toggle" aria-controls="notion-sidebar" aria-expanded="@(_sidebarOpen && !_workspaceFocused ? "true" : "false")" aria-label="@(_sidebarOpen && !_workspaceFocused ? "Skjul sidemenu" : "Vis sidemenu")" title="@(_sidebarOpen && !_workspaceFocused ? "Skjul sidemenu" : "Vis sidemenu")" @onclick="ToggleSidebar"><UiIcon Name="panel" /><span>Sider</span></button>
                        <button type="button" class="notion-focus-toggle" disabled="@(!_sidebarReady || _sidebarModule is null)" aria-pressed="@_workspaceFocused.ToString().ToLowerInvariant()" aria-label="@(_workspaceFocused ? "Afslut fokus" : "Fokus")" title="@(_workspaceFocused ? "Gendan sidekolonnerne" : "Skjul sidekolonnerne og fokusér på dokumentet")" @onclick="ToggleWorkspaceFocus"><UiIcon Name="screen" /><span>@(_workspaceFocused ? "Afslut fokus" : "Fokus")</span></button>
                    </div>
                    @if (_current is not null)
                    {
                        @if (IsEditing)
                        {
                            var titlePageId = _current.PageId;
                            <form class="notion-title-form" @onsubmit="RenamePage" @onsubmit:preventDefault>
                                <div class="notion-title-field">
                                    <label class="notion-visually-hidden" for="notion-title">Sidens titel</label>
                                    <input id="notion-title" class="notion-title" @bind="_title" @bind:event="oninput" @onblur="RenamePage" maxlength="200" placeholder="Sidens titel" disabled="@_busy" aria-busy="@_savingTitle" />
                                    @if (_title.Contains(':')) { <span class="notion-title-preview" aria-label="Sådan vises titlen" title="@_title"><EmojiText Text="@_title" /></span> }
                                </div>
                                <EmojiPicker @key="titlePageId" Disabled="_busy" TriggerLabel="Tilføj emoji til sidens titel" OnPick="emoji => InsertTitleEmoji(titlePageId, emoji)" />
                            </form>
                        }
                        else { <div class="notion-toolbar-title notion-published-title"><EmojiText Text="@_current.Title" /></div> }
                    }
                    <div class="notion-toolbar-actions">
                        @if (_current is not null)
                        {
                            @if (IsEditing) { <span class="notion-save-status @_status" role="status" title="@StatusLabel"><i aria-hidden="true"></i><span class="notion-save-label">@StatusLabel</span></span> }
                            else { <span class="notion-save-status saved"><i aria-hidden="true"></i><span class="notion-save-label">Udgivet @(_current.PublishedAtUtc?.ToLocalTime().ToString("d. MMM"))</span></span> }
                        }
                        <span class="notion-ai-toggle-slot"></span>
                        @if (_current is not null)
                        {
                            @if (IsEditing)
                            {
                                <button type="button" class="action notion-publish-button" aria-label="@(_current.PublishedAtUtc is null ? (_holdId == Guid.Empty ? "Udgiv til LUP" : "Udgiv til holdet") : "Opdatér udgivelsen")" disabled="@(_busy || !_mounted || _status is "connecting" or "offline" or "error")" @onclick="PublishPage">@(_current.PublishedAtUtc is null ? "Udgiv" : "Opdatér")</button>
                            }
                            <details class="notion-document-more">
                                <summary aria-label="Flere sidehandlinger"><UiIcon Name="more" /><span>Mere</span></summary>
                                <div class="notion-document-menu">
                                    <p class="notion-publication-status">@(_current.PublishedAtUtc is null ? "Kladde" : $"Udgivet {_current.PublishedAtUtc.Value.ToLocalTime():d. MMM HH:mm}")</p>
                                    <nav class="breadcrumbs notion-toolbar-breadcrumbs" aria-label="Brødkrummer"><a href="/notion">Notesbøger</a><span>›</span><a href="@WorkspaceHref()">Undervisning</a><span>›</span><span>@(_holdId == Guid.Empty ? "Teori" : "Holdets indhold")</span></nav>
                                    <button type="button" disabled="@(!_mounted)" @onclick="PresentPage"><UiIcon Name="screen" />Præsenter</button>
                                    @if (IsEditing && _current.PublishedAtUtc is not null)
                                    {
                                        <a href="@PageHref(_current.PageId, true)">Se udgivet</a>
                                        <button type="button" disabled="@_busy" @onclick="UnpublishPage">Træk udgivelse tilbage</button>
                                    }
                                    <button type="button" @onclick="CopyLink"><UiIcon Name="external" />Kopiér link</button>
                                    <a href="@GraphHref(_current.CollectionId ?? CollectionRoot(_current.PageId))"><UiIcon Name="chart" />Graf for kollektionen</a>
                                    @if (IsEditing)
                                    {
                                        <button type="button" @onclick="() => _codexHistoryPageId = _current.PageId"><UiIcon Name="loop" />Codex-ændringer</button>
                                        <button type="button" disabled="@_busy" @onclick="() => BeginCreate(true)"><UiIcon Name="plus" />Ny underside</button>
                                        <button type="button" disabled="@_busy" @onclick="RefreshContext"><UiIcon Name="loop" />@(_holdId == Guid.Empty ? "Opdatér sideoversigt" : "Opdatér holddata")</button>
                                    }
                                    else
                                    {
                                        <button type="button" disabled="@_busy" @onclick="Retry"><UiIcon Name="loop" />Opdatér siden</button>
                                        @if (CanManageHold) { <a href="@PageHref(_current.PageId, false)"><UiIcon Name="code" />Til kladden</a> }
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </div>
                @PageFeedback
                @if (_showGroups && CanManageHold && _holdId != Guid.Empty)
                {
                    <section class="panel notion-group-panel"><div class="notion-actions"><button class="secondary" @onclick="() => _showGroups = false">Luk gruppeværktøj</button><a href="@WorkspaceHref("groups")" class="secondary">Åbn holdets grupper</a></div><HoldGroups @key="(_holdId, _groupPanelGeneration)" HoldId="_holdId" WorkspaceId="@(_returnContext?.WorkspaceId ?? Guid.Empty)" CourseId="_returnContext?.CourseId" InitialSelection="_groupSelection" OnSaved="RefreshContext" /></section>
                }
                @if (_loading) { <p class="notion-document-loading" role="status">Henter siden…</p> }
                else if (_current is null)
                {
                    <div class="notion-document-empty"><span aria-hidden="true">▤</span><h2>@(Authoring ? "Ingen sider" : "Ingen udgivne sider")</h2>@if (Authoring) { <button class="action" @onclick="() => BeginCreate(false)">Opret side</button> }</div>
                }
                else
                {
                    @if (_statusDetail.Length > 0 && _status is "error" or "offline") { <p class="notion-connection-warning" role="alert">@_statusDetail</p> }
                    <div @key="(_current.PageId, _generation)" class="notion-editor-root" @ref="_editorElement"></div>@if (!string.IsNullOrEmpty(MentionNotice)) { <MentionReceipt SourceId="_current.PageId" Loaded="_mounted" Notice="@MentionNotice" /> }<ReferenceBacklinks Kind="notion-page" Id="@_current.PageId.ToString()" Revision="_current.DraftRevision" PublishedOnly="ForceReadOnly" />
                }
            </section>
            <div class="notion-ai-slot" aria-label="AI-arbejdsområde"></div>
        </div>
        @if (IsEditing && _codexHistoryPageId is Guid historyPageId && _current?.PageId == historyPageId)
        {
            <NotionCodexChanges @key="historyPageId" PageId="historyPageId" OnClose="() => _codexHistoryPageId = null" />
        }
    }
}

@code {
    private RenderFragment PageFeedback => @<text>
        @if (_error is not null) { <div class="notion-error" role="alert">@_error <button class="secondary" @onclick="Retry" disabled="@_busy">Prøv igen</button></div> }
        @if (_notice is not null) { <p class="notion-notice" role="status">@_notice</p> }
        @if (_resourcesError is not null) { <div class="notion-error" role="alert">@_resourcesError <button class="secondary" @onclick="async () => await EnsureNotionResources()">Hent holddata igen</button></div> }
    </text>;

    private RenderFragment PageRowContent(PageRow item) => @<div @key="item.Page.Id" class="notion-page-row" style="--page-depth:@item.Depth">
        @if (_pagesWithChildren.Contains(item.Page.Id) && _pageSearch.Trim().Length == 0) { <button type="button" class="notion-branch-toggle @(_expandedPages.Contains(item.Page.Id) ? "is-expanded" : null)" aria-expanded="@(_expandedPages.Contains(item.Page.Id) ? "true" : "false")" aria-label="@($"Fold {item.Page.Title} {(_expandedPages.Contains(item.Page.Id) ? "sammen" : "ud")}")" @onclick="() => ToggleBranch(item.Page.Id)"><UiIcon Name="chevron" /></button> } else { <span class="notion-branch-spacer" aria-hidden="true"></span> }
        <button type="button" class="notion-page @(item.Page.Id == _current?.PageId ? "is-current" : null)" aria-current="@(item.Page.Id == _current?.PageId ? "page" : null)" title="@item.Page.Title" disabled="@_busy" @onclick="() => OpenPage(item.Page.Id)"><UiIcon Name="@(_pagesWithChildren.Contains(item.Page.Id) ? "folder" : "file")" /><span class="notion-page-label"><EmojiText Text="@item.Page.Title" />@if (_pageSearch.Trim().Length > 0 && ParentTitle(item.Page) is string parent) { <small class="notion-page-parent"><EmojiText Text="@parent" /></small> }</span>@if (Authoring && (item.Page.PublishedAtUtc is null || item.Page.HasUnpublishedChanges)) { <span class="notion-draft-dot" title="@(item.Page.PublishedAtUtc is null ? "Kladde" : "Ny kladde")"><span class="notion-visually-hidden">@(item.Page.PublishedAtUtc is null ? "Kladde" : "Ny kladde")</span></span> }</button>
    </div>;
}
