@using Mercantec.Tech.Web.Navigation
@page "/notion/holds/{HoldId:guid}/groups"
@inject AuthService Auth
@inject ViewAsStudentContext ViewAs
@inject HttpClient Http
@implements IDisposable

<PageTitle>Holdets grupper · LUP</PageTitle>
@if (!Auth.IsInitialized) { <p role="status">Indlæser…</p> }
else if (!Auth.IsAuthenticated) { <p><a href="/login">Log ind</a> for at åbne holdets grupper.</p> }
else
{
    <header class="page-title"><div><nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/courses">Mine hold</a><span>›</span><a href="@WorkspaceHref("groups")">Klassen</a><span>›</span><span>Elever og grupper</span></nav><h1>Holdets grupper</h1><p>Grupperne hører til holdet og kan bruges på flere sider.</p></div><a class="secondary" href="@WorkspaceHref()">Holdets indhold</a></header>
    <div class="panel"><HoldGroups HoldId="HoldId" WorkspaceId="@(_returnContext?.WorkspaceId ?? Guid.Empty)" CourseId="_returnContext?.CourseId" InitialSelection="Selection" /></div>
}
@code {
    [Parameter] public Guid HoldId { get; set; }
    [SupplyParameterFromQuery(Name="members")] public string? Members { get; set; }
    [SupplyParameterFromQuery(Name = "workspace")] public Guid? WorkspaceQuery { get; set; }
    [SupplyParameterFromQuery(Name = "course")] public Guid? CourseQuery { get; set; }
    private readonly CancellationTokenSource _life = new();
    private WorkspaceRouteContext? _returnContext;
    private int _generation;
    private string WorkspaceHref(string view = "content") => _returnContext?.View(view) ?? WorkspaceNavigation.Hold(HoldId, view);
    protected override void OnInitialized() { Auth.AuthStateChanged += Changed; ViewAs.Changed += Changed; }
    protected override Task OnParametersSetAsync() => LoadContext();
    private void Changed() => _ = InvokeAsync(async () => { await LoadContext(); StateHasChanged(); });
    private async Task LoadContext()
    {
        var generation = ++_generation; _returnContext = null;
        if (!Auth.IsAuthenticated || WorkspaceNavigation.NonEmpty(WorkspaceQuery) is null && WorkspaceNavigation.NonEmpty(CourseQuery) is null) return;
        try
        {
            var context = await WorkspaceNavigation.Resolve(Http, HoldId, WorkspaceQuery, CourseQuery, ViewAs.IsActive, _life.Token);
            if (generation == _generation && !_life.IsCancellationRequested) _returnContext = context;
        }
        catch (OperationCanceledException) { }
    }
    public void Dispose() { Auth.AuthStateChanged -= Changed; ViewAs.Changed -= Changed; _life.Cancel(); _life.Dispose(); }
    private Guid[] Selection => (Members ?? "").Split(',').Select(s => Guid.TryParse(s, out var id) ? id : Guid.Empty).Where(id => id != Guid.Empty).Distinct().Take(100).ToArray();
}
