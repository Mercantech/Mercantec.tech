{
  "manifest_version": 3,
  "name": "LUP",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Tilføj billeder fra nettet som emojis på LUP.dk.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["https://lup.dk/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.mjs", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "action": { "default_title": "LUP", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://lup.dk/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
