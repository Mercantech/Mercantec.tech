<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Notebooks/default-template.json" LogicalName="Mercantec.Tech.Api.DefaultNotebookTemplate.json" />
    <EmbeddedResource Include="Emojis/Standard/*.png" LogicalName="standard-emojis/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Updates/Images/*.webp" LogicalName="platform-updates/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Updates/coverage.json" LogicalName="platform-updates/coverage.json" />
    <EmbeddedResource Include="Updates/Notes/*.json" LogicalName="platform-updates/notes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Integrations\OpenAI\editor-block-prompt.txt">
      <LogicalName>Mercantec.Tech.Api.EditorBlockPrompt.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the existing editorial metadata directly; frontend and references share one source. -->
    <Compile Include="../web/Courses/CourseTemplateCatalog.cs" Link="References/Catalog/CourseTemplateCatalog.cs" />
    <Compile Include="../web/Public/PublicCatalog.cs" Link="References/Catalog/PublicCatalog.cs" />
    <Compile Include="../web/Demo/DemoCatalog.cs" Link="References/Catalog/DemoCatalog.cs" />
    <Compile Include="../web/Demo/LearningContent.cs" Link="References/Catalog/LearningContent.cs" />
    <Compile Include="../web/Characters/CharacterCatalog.cs" Link="References/Catalog/CharacterCatalog.cs" />
    <Compile Include="../web/Characters/VatsonEmojiCatalog.cs" Link="References/Catalog/VatsonEmojiCatalog.cs" />
    <Compile Include="../web/Characters/WhaleMaterials.cs" Link="References/Catalog/WhaleMaterials.cs" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <ProjectReference Include="../shared/Mercantec.Tech.Contracts.csproj" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

</Project>
