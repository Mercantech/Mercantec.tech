POSTGRES_USER=mercantec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mercantec
CONNECTION_STRING=Host=mercantec-tech-db;Port=5432;Database=mercantec;Username=mercantec;Password=change-me
CORS_SPA_ORIGINS=https://mercantec.tech;https://lup.dk;https://www.lup.dk;http://localhost:3000
AUTH_ISSUER=https://auth.mercantec.tech
AUTH_AUDIENCE=mercantec-apps
JWKS_URI=https://auth.mercantec.tech/.well-known/jwks.json
Lectio__BaseUrl=https://lc.mags.dk/api/

# MinIO/Silo (S3-kompatibel object storage) — aldrig commit rigtige credentials
# Compose bruger image pgsty/silo (quay.io/minio/* giver 401)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=mercantec-tech
OBJECT_STORAGE_ENDPOINT=http://mercantec-tech-minio:9000
# Lokal browser-adgang til presigned URL'er — LAD VÆRE TOM i Dokploy/prod
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000
# Admin UI (Console): lokalt http://localhost:9001 med docker-compose.local.yml
# Prod: https://minio.mercantec.tech (kun Console; S3 API forbliver intern)
# Brug stærk MINIO_ROOT_PASSWORD i Dokploy — aldrig default minioadmin i prod
MINIO_BROWSER_REDIRECT_URL=https://minio.mercantec.tech

# Valgfri isoleret HTTPS-origin til HTML-, Unity- og Godot-webbuilds.
# Tom værdi slår spilafvikling fra. DNS og reverse proxy skal sættes op særskilt.
WEB_PREVIEW_ORIGIN=
WEB_PREVIEW_APP_ORIGIN=https://mercantec.tech
# Semikolonseparerede IP-adresser på betroede reverse proxies til HTTPS/Host-headere.
REVERSE_PROXY_KNOWN_PROXIES=

# Optional override; blank uses the automatically generated persistent service key.
# At least 32 random characters when set. Never commit real credentials.
NOTION_SERVICE_SECRET=

# Microsoft Graph — underviserkalender (samme app som Plan; Calendars.Read application)
# Aldrig commit rigtige credentials — sæt i Dokploy / lokal .env
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Valgfri Auth sub/e-mail → Azure UPN (Mathias/Kasper er default i compose)
# AZURE_TEACHER_UPN_MAP=d969fced-f7be-46d4-9bb9-5a2f03ca6974=mags@mercantec.dk;mathiasgsteenberg@gmail.com=mags@mercantec.dk;kasc@mercantec.dk=kasc@mercantec.dk
